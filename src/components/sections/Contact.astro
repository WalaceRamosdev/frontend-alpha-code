---
import Button from "../ui/Button.astro";
---

<section id="contact">
    <div class="container">
        <div class="cta-card fade-up-contact">
            <div class="cta-content text-center">
                <h2>🚀 PRONTO PARA TRANSFORMAR SEU NEGÓCIO DIGITAL?</h2>
                <p>
                    Fale com um especialista e descubra como podemos criar um
                    site que realmente vende para sua empresa.
                    <br /><strong
                        >⏳ Atendimento personalizado | Resposta em até 2h |
                        Orçamento sem compromisso</strong
                    >
                </p>
                <div class="actions">
                    <Button
                        href="/planos"
                        variant="primary"
                        size="lg"
                        class="glow-effect pulse-anim"
                    >
                        📱 COMEÇAR AGORA
                    </Button>
                </div>
            </div>
            <div class="glow-bg"></div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function ensureContactVisible() {
        const contactEls = document.querySelectorAll("#contact .fade-up-contact");
        contactEls.forEach((el) => {
            (el as HTMLElement).style.opacity = "1";
            (el as HTMLElement).style.transform = "none";
        });
    }

    function initContactAnimation() {
        const section = document.getElementById("contact");
        if (!section) return;

        const safetyTimer = setTimeout(ensureContactVisible, 3000);

        gsap.fromTo(
            section.querySelectorAll(".fade-up-contact"),
            { y: 50, scale: 0.95, opacity: 0 },
            {
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",
                    once: true,
                },
                y: 0,
                scale: 1,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                immediateRender: false,
                onComplete: () => clearTimeout(safetyTimer)
            }
        );
    }

    document.addEventListener("astro:page-load", initContactAnimation);
</script>

<style>
    #contact {
        padding: 50px 0 100px;
    }

    @keyframes pulse-soft {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7);
        }
        70% {
            transform: scale(1.02);
            box-shadow: 0 0 0 10px rgba(220, 38, 38, 0);
        }
        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0);
        }
    }

    /* Target the button component wrapper for animation */
    #contact :global(.pulse-anim) {
        animation: pulse-soft 2s infinite;
    }
    #contact :global(.pulse-anim:hover) {
        animation: none;
        transform: scale(1.05);
    }

    .cta-card {
        background: linear-gradient(
            145deg,
            rgba(20, 20, 20, 0.9),
            rgba(10, 10, 10, 0.95)
        );
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 30px;
        padding: 60px 20px;
        position: relative;
        overflow: hidden;
        text-align: center;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
    }

    .cta-content {
        position: relative;
        z-index: 2;
    }

    .glow-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 100%;
        background: radial-gradient(
            circle,
            rgba(138, 28, 38, 0.2) 0%,
            transparent 70%
        );
        z-index: 1;
        pointer-events: none;
    }

    h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: inline-block;
        font-weight: 800;
    }

    p {
        font-size: 1.25rem;
        color: var(--color-text-secondary);
        margin-bottom: 2rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    p strong {
        color: var(--color-text-main);
    }

    .actions {
        display: flex;
        justify-content: center;
        margin-top: 2.5rem;
    }

    @media (max-width: 768px) {
        h2 {
            font-size: 1.8rem;
        }
        .cta-card {
            padding: 40px 10px; /* Reduced side padding */
        }
        /* Ensure button text fits */
        .btn-content {
            white-space: nowrap;
            font-size: 0.95rem; /* Slightly smaller font if needed */
        }
    }
</style>
