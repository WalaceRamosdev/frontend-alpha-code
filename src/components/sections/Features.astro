---
import Card from "../ui/Card.astro";
---

<section id="why">
    <div class="container">
        <div class="section-header">
            <h2 class="fade-up-title">
                Por que <span class="text-primary">Nos Escolher?</span>
            </h2>
            <p class="fade-up-title delay-1">
                Não entregamos apenas sites. Entregamos resultados mensuráveis.
            </p>
        </div>
        <div class="grid-3 features-grid">
            <Card class="feature-card">
                <div class="icon-box">
                    <img
                        src="/assets/seloGarantia.svg"
                        width="50"
                        height="50"
                        alt="Selo de Credibilidade"
                        loading="lazy"
                        class="img-fluid"
                    />
                </div>
                <h3>Estratégia Primeiro</h3>
                <p>
                    Antes de escrever código, estudamos seu público,
                    concorrentes e palavras-chave que convertem para garantir
                    resultados desde o lançamento.
                </p>
            </Card>
            <Card class="feature-card">
                <div class="icon-box">
                    <img
                        src="/assets/vendaOnline.svg"
                        width="60"
                        height="60"
                        alt="Ícone Venda Online"
                        loading="lazy"
                        class="img-fluid"
                    />
                </div>
                <h3>Design que Converte</h3>
                <p>
                    Cada cor, botão e texto é posicionado estrategicamente para
                    guiar o visitante até a compra, não apenas para enfeitar a
                    tela.
                </p>
            </Card>
            <Card class="feature-card">
                <div class="icon-box">
                    <img
                        src="/assets/foguete.svg"
                        width="55"
                        height="55"
                        alt="Ícone Resultados Rápidos"
                        loading="lazy"
                        class="img-fluid"
                    />
                </div>
                <h3>SEO desde o Dia 1</h3>
                <p>
                    Seu site já nasce otimizado para o Google, seguindo todas as
                    diretrizes técnicas para economizar meses de trabalho de
                    otimização depois.
                </p>
            </Card>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        let mm = gsap.matchMedia();
        const section = document.getElementById("why");
        if (!section) return;

        const header = section.querySelector(".section-header");
        const grid = section.querySelector(".features-grid");

        mm.add("(min-width: 769px)", () => {
            // Desktop: Full animations
            gsap.fromTo(
                section.querySelectorAll(".fade-up-title"),
                { opacity: 0, y: 50 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.2,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: header,
                        start: "top 90%",
                    },
                },
            );

            gsap.fromTo(
                section.querySelectorAll(".feature-card"),
                { opacity: 0, y: 50 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.2,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: grid,
                        start: "top 85%",
                    },
                },
            );
        });

        mm.add("(max-width: 768px)", () => {
            // Mobile: Minimalist (Low CPU usage)
            gsap.fromTo(
                section.querySelectorAll(".fade-up-title, .feature-card"),
                { opacity: 0.2, y: 10 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.4,
                    stagger: 0.05,
                    scrollTrigger: {
                        trigger: section,
                        start: "top 98%",
                    },
                },
            );
        });
    });
</script>

<style>
    #why {
        padding: 100px 0;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 768px) {
        #why {
            padding: 60px 0;
        }
    }

    .section-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 4rem;
        width: 100%;
    }

    .section-header h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        width: 100%;
    }

    .section-header p {
        max-width: 650px;
        margin: 0 auto;
        color: var(--color-text-secondary);
        font-size: 1.1rem;
        text-align: center;
        width: 100%;
    }

    .icon-box {
        margin-bottom: 25px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .icon-box img {
        /* Brilho branco intenso: filter serve para transformar qualquer cor em branco puro */
        filter: brightness(0) invert(1)
            drop-shadow(0 0 12px rgba(255, 255, 255, 0.8)) !important;
        max-height: 100%;
        width: auto;
        opacity: 1 !important;
        transition: all 0.3s ease;
    }

    .feature-card:hover .icon-box img {
        transform: scale(1.1);
        filter: brightness(0) invert(1)
            drop-shadow(0 0 20px rgba(255, 255, 255, 1)) !important;
    }

    .img-fluid {
        height: auto;
    }

    .card {
        text-align: center;
    }
</style>
