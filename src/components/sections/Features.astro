---
// src/components/sections/Features.astro
import Card from "../ui/Card.astro";
---

<style>
    .features-grid-container {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 3.5rem;
        align-items: stretch;
    }
    @media (min-width: 768px) {
        .features-grid-container {
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
        }
    }

    .feature-card-elite {
        background: rgba(15, 15, 15, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(16px) !important;
        padding: 3rem 2rem !important;
        border-radius: 32px !important;
        text-align: center;
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }

    .feature-card-elite:hover {
        transform: translateY(-12px);
        background: rgba(20, 20, 20, 0.6) !important;
        border-color: rgba(138, 28, 38, 0.3) !important;
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8);
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2rem;
        position: relative;
        transition: all 0.5s ease;
    }

    .feature-card-elite:hover .icon-wrapper {
        background: rgba(138, 28, 38, 0.1);
        transform: rotate(10deg);
    }

    .icon-wrapper::after {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: 24px;
        padding: 1px;
        background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask-composite: exclude;
        -webkit-mask-composite: destination-out;
    }

    .icon-wrapper img {
        width: 40px;
        height: 40px;
        filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(255,255,255,0.3));
        transition: all 0.5s ease;
    }

    .feature-card-elite:hover .icon-wrapper img {
        filter: brightness(0) invert(1) drop-shadow(0 0 15px rgba(138,28,38,1));
        transform: scale(1.1);
    }

    .feature-title {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 1.25rem;
        letter-spacing: -0.02em;
    }

    .feature-desc {
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.7;
        font-size: 0.95rem;
    }
</style>

<section id="why" class="bg-black py-24 relative overflow-hidden">
    <!-- Ambient Light -->
    <div class="absolute bottom-0 left-0 w-full h-[500px] bg-gradient-to-t from-primary/5 to-transparent pointer-events-none"></div>

    <div class="container">
        <div class="text-center mb-20">
            <span class="text-primary text-[11px] font-black uppercase tracking-[5px] mb-4 block">Diferenciais Alpha</span>
            <h2 class="text-4xl md:text-6xl font-black text-white mt-4 font-outfit uppercase tracking-tighter">
                Estratégia <span class="text-primary">Inescapável</span>
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg mt-6">
                Não somos uma fábrica de sites. Somos parceiros de escala focados em converter sua audiência em faturamento real.
            </p>
        </div>

        <div class="features-grid-container">
            <!-- Feature 1 -->
            <div class="feature-card-elite">
                <div class="icon-wrapper">
                    <img src="/assets/seloGarantia.svg" alt="Estratégia Primeiro" loading="lazy" />
                </div>
                <h3 class="feature-title">Estratégia Primeiro</h3>
                <p class="feature-desc">
                    Antes de escrever qualquer código, estudamos seu mercado e concorrentes para garantir que seu site já nasça líder de audiência.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="feature-card-elite">
                <div class="icon-wrapper">
                    <img src="/assets/vendaOnline.svg" alt="Design que Converte" loading="lazy" />
                </div>
                <h3 class="feature-title">Design que Converte</h3>
                <p class="feature-desc">
                    Cada cor, botão e texto é posicionado seguindo triggers psicológicos de vendas para guiar o visitante até a conversão final.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="feature-card-elite">
                <div class="icon-wrapper">
                    <img src="/assets/foguete.svg" alt="SEO do Dia 1" loading="lazy" />
                </div>
                <h3 class="feature-title">SEO desde o Dia 1</h3>
                <p class="feature-desc">
                    Seu site é construído sobre as diretrizes mais modernas do Google, garantindo indexação rápida e autoridade orgânica imediata.
                </p>
            </div>
        </div>
    </div>
</section>
