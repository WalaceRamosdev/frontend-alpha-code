---
import Card from "../ui/Card.astro";
---

<section id="why">
    <div class="container">
        <div class="section-header">
            <h2 class="fade-up-title">
                Sem site, você é <br /><span class="text-primary"
                    >INVISÍVEL</span
                > no Google.
            </h2>
            <p class="fade-up-title delay-1">
                O Instagram é alugado.<br />Seu site é sua casa própria digital.<br
                />É lá que você converte curiosos em clientes pagantes.
            </p>
        </div>
        <div class="grid-3 features-grid">
            <Card class="feature-card">
                <div class="icon-box">
                    <img
                        src="/assets/seloGarantia.svg"
                        width="50"
                        alt="Selo de Credibilidade"
                        loading="lazy"
                        class="img-fluid"
                    />
                </div>
                <h3>Autoridade Instantânea</h3>
                <p>
                    Seu cliente te pesquisa no Google antes de fechar. Se não
                    encontrar um site profissional, ele assume que você é amador
                    e vai para o concorrente.
                </p>
            </Card>
            <Card class="feature-card">
                <div class="icon-box">
                    <img
                        src="/assets/vendaOnline.svg"
                        width="60"
                        alt="Ícone Venda Online"
                        loading="lazy"
                        class="img-fluid"
                    />
                </div>
                <h3>Vendedor 24/7</h3>
                <p>
                    Seu site nunca dorme. Ele explica seu serviço, quebra
                    objeções e agenda consultas enquanto você descansa ou atende
                    seus pacientes.
                </p>
            </Card>
            <Card class="feature-card">
                <div class="icon-box">
                    <img
                        src="/assets/foguete.svg"
                        width="55"
                        alt="Ícone Resultados Rápidos"
                        loading="lazy"
                        class="img-fluid"
                    />
                </div>
                <h3>Clientes Qualificados</h3>
                <p>
                    Chega de depender do algoritmo. Atraia pessoas que já estão
                    buscando pelo seu serviço no Google e estão prontas para te
                    contratar.
                </p>
            </Card>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        let mm = gsap.matchMedia();

        const section = document.getElementById("why");
        if (!section) return;

        const header = section.querySelector(".section-header");
        const grid = section.querySelector(".features-grid");

        mm.add("(min-width: 769px)", () => {
            // Desktop Animations
            gsap.fromTo(
                section.querySelectorAll(".fade-up-title"),
                { opacity: 0, y: 50 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.2,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: header,
                        start: "top 90%",
                    },
                },
            );

            gsap.fromTo(
                section.querySelectorAll(".feature-card"),
                { opacity: 0, y: 50 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.2,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: grid,
                        start: "top 85%",
                    },
                },
            );
        });

        mm.add("(max-width: 768px)", () => {
            // Simple reveal for mobile (less CPU intensive)
            gsap.fromTo(
                section.querySelectorAll(".fade-up-title, .feature-card"),
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.1,
                    scrollTrigger: {
                        trigger: section,
                        start: "top 95%",
                    },
                },
            );
        });
    });
</script>

<style>
    #why {
        padding: 100px 0;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 768px) {
        #why {
            padding: 60px 0;
        }
    }

    .section-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 4rem;
        width: 100%;
    }

    .section-header h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        width: 100%;
    }

    .section-header p {
        max-width: 650px;
        margin: 0 auto;
        color: var(--color-text-secondary);
        font-size: 1.1rem;
        text-align: center;
        width: 100%;
    }

    .icon-box {
        margin-bottom: 25px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .icon-box img {
        filter: brightness(0) invert(1);
        max-height: 100%;
        width: auto;
        opacity: 0.9;
        transition: all 0.3s ease;
    }

    /* Drop shadow only on desktop to save mobile performance */
    @media (min-width: 769px) {
        .icon-box img {
            filter: brightness(0) invert(1)
                drop-shadow(0 0 12px rgba(255, 255, 255, 0.4));
        }

        .feature-card:hover .icon-box img {
            transform: scale(1.1);
            filter: brightness(0) invert(1)
                drop-shadow(0 0 20px rgba(255, 255, 255, 0.8));
            opacity: 1;
        }
    }

    .img-fluid {
        height: auto;
    }

    .card {
        text-align: center;
    }
</style>
