---
// src/components/sections/Process.astro
import Card from "../ui/Card.astro";

const steps = [
    {
        number: "01",
        title: "Briefing & Estratégia",
        desc: "Mergulhamos no seu mercado para definir a arquitetura de vendas ideal.",
        icon: "🎯",
    },
    {
        number: "02",
        title: "Design de Elite",
        desc: "Interface exclusiva focada em autoridade e experiência premium.",
        icon: "🎨",
    },
    {
        number: "03",
        title: "Desenvolvimento Alpha",
        desc: "Código ultra-rápido (Astro.js) otimizado para SEO e conversão.",
        icon: "💻",
    },
    {
        number: "04",
        title: "Testes & Performance",
        desc: "Validação em múltiplos dispositivos e nota máxima no PageSpeed.",
        icon: "🚀",
    },
    {
        number: "05",
        title: "Lançamento & Suporte",
        desc: "Seu ativo digital online e pronto para escalar seus resultados.",
        icon: "🛡️",
    },
];
---

<style>
    .process-grid-elite {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 3rem;
        position: relative;
        align-items: stretch;
    }
    @media (min-width: 1024px) {
        .process-grid-elite {
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
        }
    }

    /* Timeline Line Desktop */
    @media (min-width: 1024px) {
        .process-grid-elite::after {
            content: "";
            position: absolute;
            top: 45px;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(138, 28, 38, 0.4), transparent);
            z-index: 0;
        }
    }

    .process-step-elite {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .step-number-elite {
        width: 90px;
        height: 90px;
        background: #080808;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2rem;
        position: relative;
        transition: all 0.5s ease;
    }

    .process-step-elite:hover .step-number-elite {
        border-color: rgba(138, 28, 38, 0.5);
        box-shadow: 0 0 30px rgba(138, 28, 38, 0.2);
        transform: translateY(-5px);
    }

    .number-text {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 900;
        background: linear-gradient(135deg, #fff, rgba(255,255,255,0.2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .step-card-elite {
        background: rgba(15, 15, 15, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(20px) !important;
        border-radius: 28px !important;
        padding: 2.5rem 1.75rem !important;
        text-align: center;
        width: 100%;
        height: 100%;
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .process-step-elite:hover .step-card-elite {
        border-color: rgba(138, 28, 38, 0.4) !important;
        background: rgba(20, 20, 20, 0.7) !important;
        transform: translateY(-8px);
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
    }

    .step-title-elite {
        color: #fff;
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 0.75rem;
        letter-spacing: -0.04em;
    }

    .step-desc-elite {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        line-height: 1.7;
    }

    .step-icon-badge {
        font-size: 1.5rem;
        margin-bottom: 1.25rem;
        display: block;
    }
</style>

<section id="process" class="bg-black py-24 relative">
    <div class="container">
        <div class="text-center mb-24">
            <span class="text-primary text-[11px] font-black uppercase tracking-[5px] mb-4 block">Workflow Profissional</span>
            <h2 class="text-4xl md:text-6xl font-black text-white mt-4 font-outfit uppercase tracking-tighter">
                Sua Fábrica de <span class="text-primary">Resultados</span>
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg mt-6">
                Um pipeline testado e refinado para transformar ideias brutas em ferramentas de lucro previsível.
            </p>
        </div>

        <div class="process-grid-elite">
            {steps.map((step) => (
                <div class="process-step-elite group">
                    <div class="step-number-elite">
                        <span class="number-text tracking-tighter">{step.number}</span>
                    </div>
                    <div class="step-card-elite">
                        <span class="step-icon-badge">{step.icon}</span>
                        <h3 class="step-title-elite">{step.title}</h3>
                        <p class="step-desc-elite">{step.desc}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
