---
import Card from "../ui/Card.astro";
---

<section id="services" class="bg-alt">
    <div class="container">
        <div class="section-header">
            <h2 class="fade-up-services">
                O que <span class="text-primary">Entregamos</span>
            </h2>
            <p class="fade-up-services delay-1 section-desc">
                Somos a referência em <a href="/"
                    >criação de sites para empresas</a
                > que buscam dominar o digital.
            </p>
        </div>
        <div class="services-list">
            <a href="/servicos/pagina-agendamento" class="service-link">
                <Card variant="service" class="service-card-anim">
                    <div class="service-icon">🚀</div>
                    <div class="service-info">
                        <h3>Landing Page de Alta Conversão</h3>
                        <p>
                            Página única, focada 100% em transformar visitante
                            em cliente. Ideal para médicos e advogados que fazem
                            tráfego pago (Ads).
                        </p>
                        <span class="service-tag">Foco em Vendas</span>
                    </div>
                </Card>
            </a>
            <a href="/servicos/site-profissional-saude" class="service-link">
                <Card variant="service" class="service-card-anim">
                    <div class="service-icon">🏛️</div>
                    <div class="service-info">
                        <h3>Site Institucional Premium</h3>
                        <p>
                            Múltiplas páginas (Home, Sobre, Serviços, Blog) para
                            quem constrói uma marca sólida. Transmite robustez,
                            confiança e tradição.
                        </p>
                        <span class="service-tag">Foco em Autoridade</span>
                    </div>
                </Card>
            </a>
            <a
                href="/servicos/blog-seo-profissionais-saude"
                class="service-link"
            >
                <Card variant="service" class="service-card-anim">
                    <div class="service-icon">🔍</div>
                    <div class="service-info">
                        <h3>SEO e Posicionamento Google</h3>
                        <p>
                            Otimização técnica para que seu nome apareça quando
                            alguém pesquisar "advogado em [sua cidade]" ou
                            "clínica [x]".
                        </p>
                        <span class="service-tag">Foco em Tráfego Gratuito</span
                        >
                    </div>
                </Card>
            </a>
            <a href="/servicos/link-profissional" class="service-link">
                <Card variant="service" class="service-card-anim">
                    <div class="service-icon">📱</div>
                    <div class="service-info">
                        <h3>Link Profissional (Bio)</h3>
                        <p>
                            Sua central de contatos personalizada. Substitua o
                            Linktree por algo que realmente converte e carrega
                            instantaneamente.
                        </p>
                        <span class="service-tag">Foco em Social Media</span>
                    </div>
                </Card>
            </a>
            <a href="/servicos/google-meu-negocio" class="service-link">
                <Card variant="service" class="service-card-anim">
                    <div class="service-icon">📍</div>
                    <div class="service-info">
                        <h3>Google Meu Negócio</h3>
                        <p>
                            Apareça no topo do Google Maps quando pacientes
                            buscarem por serviços na sua região. Domine as
                            buscas locais.
                        </p>
                        <span class="service-tag">Foco em Tráfego Local</span>
                    </div>
                </Card>
            </a>
            <a href="/servicos/manutencao-site" class="service-link">
                <Card variant="service" class="service-card-anim">
                    <div class="service-icon">🛠️</div>
                    <div class="service-info">
                        <h3>Manutenção e Suporte</h3>
                        <p>
                            Cuidamos da saúde do seu site enquanto você cuida
                            dos seus pacientes. Segurança, velocidade e
                            atualizações garantidas.
                        </p>
                        <span class="service-tag">Foco em Tranquilidade</span>
                    </div>
                </Card>
            </a>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function ensureServicesVisible() {
        const servicesEls = document.querySelectorAll("#services .fade-up-services, #services .service-card-anim");
        servicesEls.forEach((el) => {
            (el as HTMLElement).style.opacity = "1";
            (el as HTMLElement).style.transform = "none";
        });
    }

    function initServicesAnimation() {
        const section = document.getElementById("services");
        if (!section) return;

        const safetyTimer = setTimeout(ensureServicesVisible, 3000);

        const header = section.querySelector(".section-header");
        const list = section.querySelector(".services-list");

        gsap.fromTo(
            section.querySelectorAll(".fade-up-services"),
            { opacity: 0, y: 30 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.1,
                ease: "power2.out",
                immediateRender: false,
                scrollTrigger: {
                    trigger: header,
                    start: "top 90%",
                    once: true,
                },
            }
        );

        gsap.fromTo(
            section.querySelectorAll(".service-card-anim"),
            { opacity: 0, y: 50 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.1,
                ease: "power2.out",
                immediateRender: false,
                scrollTrigger: {
                    trigger: list,
                    start: "top 85%",
                    once: true,
                },
                onComplete: () => clearTimeout(safetyTimer)
            }
        );
    }

    document.addEventListener("astro:page-load", initServicesAnimation);
</script>

<style>
    #services {
        padding: 100px 0;
    }
    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }
    .section-desc {
        max-width: 600px;
        margin: 1rem auto;
        color: var(--color-text-secondary);
        font-size: 1.1rem;
    }
    .services-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
        margin-top: 50px;
    }

    /* Target Cards inside Services */
    .service-link {
        display: block;
        height: 100%;
        text-decoration: none;
    }

    #services :global(.service-card-anim) {
        display: flex;
        flex-direction: column;
        padding: 40px 30px !important;
        background: rgba(20, 20, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        height: 100%;
    }

    #services :global(.service-card-anim:hover) {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
        border-color: rgba(var(--color-primary-rgb), 0.3);
    }

    .service-info {
        text-align: center;
        flex-grow: 1; /* Pushes content to fill space */
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .service-icon {
        font-size: 3.5rem;
        margin-bottom: 2rem;
        text-align: center;
        filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.1));
    }
    .service-info h3 {
        margin-bottom: 1.2rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
    }
    .service-info p {
        flex-grow: 1; /* This ensures the tag is pushed to the bottom */
        margin-bottom: 2rem;
        color: var(--color-text-secondary);
        font-size: 1rem;
        line-height: 1.6;
    }
    .service-tag {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(var(--color-primary-rgb), 0.1);
        color: var(--color-primary);
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 50px;
        margin-top: auto; /* Fallback alignment */
        align-self: center;
        letter-spacing: 0.5px;
        border: 1px solid rgba(var(--color-primary-rgb), 0.2);
    }

    @media (max-width: 768px) {
        .services-list {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        #services :global(.service-card-anim) {
            padding: 30px 20px !important;
        }
    }
</style>
