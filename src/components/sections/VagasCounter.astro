---
---
<div class="analysis-meter">
    <div class="meter-info">
        <span>Status das Vagas:</span>
        <span class="vagas-remaining">Poucas Unidades</span>
    </div>
    <div class="meter">
        <div class="fill" id="vagas-fill" style="width: 0%"></div>
    </div>
    <div class="meter-footer">
        <small><span id="vagas-percentage">0</span>% preenchidas este mês</small>
        <small class="pulse">🔥 Alta Procura</small>
    </div>
</div>

<script>
    const initCounter = () => {
        const fill = document.getElementById('vagas-fill');
        const percent = document.getElementById('vagas-percentage');
        
        if (fill && percent) {
            // Let the CSS transition do the work for the bar
            fill.style.width = '88%';
            
            // Animate the text
            let count = 0;
            const target = 88;
            const duration = 2000; // 2 seconds
            const increment = target / (duration / 20);
            
            const timer = setInterval(() => {
                count += increment;
                if (count >= target) {
                    percent.innerText = target.toString();
                    clearInterval(timer);
                } else {
                    percent.innerText = Math.floor(count).toString();
                }
            }, 20);
        }
    };

    // Run when visible
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                initCounter();
                observer.disconnect();
            }
        });
    }, { threshold: 0.5 });

    const target = document.querySelector('.analysis-meter');
    if (target) observer.observe(target);
</script>

<style>
    .analysis-meter {
        background: rgba(255, 255, 255, 0.02);
        padding: 1.5rem;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        margin-top: 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .meter-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.8rem;
    }

    .meter-info span {
        font-weight: 700;
        font-size: 0.85rem;
        color: #fff;
    }

    .vagas-remaining {
        color: #8a1c26 !important;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.75rem !important;
    }

    .meter {
        height: 10px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 0.8rem;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);
    }

    .fill {
        height: 100%;
        background: linear-gradient(90deg, #8a1c26, #df2a3a);
        box-shadow: 0 0 15px rgba(138, 28, 38, 0.5);
        border-radius: 10px;
        transition: width 2s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .meter-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .meter-footer small {
        color: rgba(255, 255, 255, 0.4);
        font-weight: 500;
        font-size: 0.75rem;
    }

    .pulse {
        color: #df2a3a !important;
        animation: pulse-text 2s infinite;
        font-weight: 700 !important;
    }

    @keyframes pulse-text {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
</style>
