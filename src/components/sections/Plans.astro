---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import { getSession } from "../../lib/auth";

const session = await getSession(Astro.request);
const isLoggedIn = !!session;
---

<section id="plans" class="bg-alt">
    <div class="container">
        <div class="section-header">
            <h2 class="fade-up-plans">
                Investimento <span class="text-primary">Inteligente</span>
            </h2>
            <p class="fade-up-plans delay-1 section-desc">
                Escolha o plano ideal para escalar seu faturamento.
            </p>
        </div>

        <div class="pricing-grid">
            <!-- Plan 1 -->
            <Card variant="price" class="plan-regular plan-card-anim">
                <div class="price-header">
                    <h3>LANDING PAGE</h3>
                    <span class="plan-subtitle-tag">Foco em Vendas</span>
                    {isLoggedIn ? (
                        <div class="final-price-wrapper">
                            <small class="currency">R$</small> 697
                        </div>
                    ) : (
                        <div class="quote-trigger-wrapper">
                            <Button 
                                href="/login" 
                                variant="outline" 
                                size="sm" 
                                class="w-full"
                            >
                                Ver Preços →
                            </Button>
                        </div>
                    )}
                    <div class="price-microtext">
                        🚀 Estrutura profissional de alta conversão.
                    </div>
                </div>

                <div class="plan-benefits">
                    <ul class="benefits-list">
                        <li>
                            <span class="check">✓</span> Página Única de Alta Conversão
                        </li>
                        <li>
                            <span class="check">✓</span> Copywriting Persuasivo
                        </li>
                        <li>
                            <span class="check">✓</span> Carregamento Instantâneo
                        </li>
                        <li>
                            <span class="check">✓</span> Botão WhatsApp Estratégico
                        </li>
                    </ul>
                </div>

                <div class="action-btn">
                    <Button
                        href="/pedido?plan=simples"
                        variant="outline"
                        class="w-full"
                    >
                        QUERO ESTE →
                    </Button>
                </div>
            </Card>

            <!-- Plan 2 (Featured) -->
            <Card variant="price" class="featured plan-card-anim">
                <div class="badge-gold">MAIS PEDIDO</div>
                <div class="price-header">
                    <h3>SITE INSTITUCIONAL</h3>
                    <span class="plan-subtitle-tag">Autoridade Digital</span>
                    <div class="price text-primary price-highlight">
                        {isLoggedIn ? (
                            <div class="final-price-wrapper">
                                <small class="currency">R$</small> 1.297
                            </div>
                        ) : (
                            <div class="quote-trigger-wrapper">
                                <Button 
                                    href="/login" 
                                    variant="primary" 
                                    size="sm" 
                                    class="w-full"
                                >
                                    Solicitar Orçamento
                                </Button>
                            </div>
                        )}
                        <div class="price-microtext">
                            ⭐ A escolha ideal para empresas em crescimento.
                        </div>
                    </div>
                </div>

                <div class="plan-benefits">
                    <ul class="benefits-list">
                        <li>
                            <span class="check">✓</span> Até 5 Páginas Estratégicas
                        </li>
                        <li>
                            <span class="check">✓</span> SEO Local (Google Maps)
                        </li>
                        <li>
                            <span class="check">✓</span> Design Premium Exclusivo
                        </li>
                        <li>
                            <span class="check">✓</span> Blog para Marketing de Conteúdo
                        </li>
                    </ul>
                </div>

                <div class="action-btn">
                    <Button
                        href="/pedido?plan=completa"
                        variant="primary"
                        class="w-full btn-glow"
                    >
                        QUERO ESTE →
                    </Button>
                </div>
            </Card>

            <!-- Plan 3 -->
            <Card
                variant="price"
                class="plan-regular plan-gold-premium plan-card-anim"
            >
                <div class="badge-secondary-discreet">ALTA PERFORMANCE</div>
                <div class="price-header">
                    <h3>SITE PROFISSIONAL +</h3>
                    <span class="plan-subtitle-tag">Dominância de Mercado</span>
                    <p class="plan-premium-hook">
                        Máquina de vendas e autoridade digital definitiva.
                    </p>
                    <div class="price price-highlight">
                        {isLoggedIn ? (
                            <div class="final-price-wrapper">
                                <small class="currency">R$</small> 1.997
                            </div>
                        ) : (
                            <div class="quote-trigger-wrapper">
                                <Button 
                                    href="/login" 
                                    variant="outline" 
                                    size="sm" 
                                    class="w-full"
                                >
                                    Ver Condições VIP
                                </Button>
                            </div>
                        )}
                        <div class="price-microtext">
                            💎 Máxima performance e autoridade digital.
                        </div>
                    </div>
                </div>

                <div class="plan-benefits">
                    <ul class="benefits-list">
                        <li>
                            <span class="check">✓</span> Estrutura Completa de Funil
                        </li>
                        <li>
                            <span class="check">✓</span> SEO Técnico Avançado
                        </li>
                        <li>
                            <span class="check">✓</span> Integração CRM/E-mail Mkt
                        </li>
                        <li>
                            <span class="check">✓</span> Consultoria de Estratégia
                            (1h)
                        </li>
                    </ul>
                </div>

                <div class="action-btn">
                    <Button
                        href="/pedido?plan=premium"
                        variant="outline"
                        class="w-full"
                    >
                        QUERO ESTE →
                    </Button>
                </div>
            </Card>
        </div>

        <div class="pricing-footer fade-up-plans delay-2">
            <p>* Projetos personalizados. Fale com um consultor.</p>
            <p class="maintenance-note">
                Manutenção opcional disponível por R$ 100/mês.
            </p>
            <a href="/sistemas-personalizados" class="niche-note-link">
                <p class="niche-note">
                    📍 Restaurantes, Clínicas e Lanchonetes:{" "}
                    {isLoggedIn ? (
                        <strong>A partir de R$ 1.997</strong>
                    ) : (
                        <strong>Consultar Sistemas de Elite</strong>
                    )}
                </p>
            </a>
        </div>
        <div class="compare-cta fade-up-plans delay-3">
            <Button href="/planos" variant="outline" class="btn-large">
                Ver Comparativo Detalhado
                <span class="arrow">→</span>
            </Button>
        </div>
    </div>
</section>

<script>
    import { getLazyGsap } from "../../utils/lazyGsap";

    (async () => {
        const { gsap } = await getLazyGsap();
        const section = document.getElementById("plans");
        if (!section || !gsap) return;

        const header = section.querySelector(".section-header");
        const grid = section.querySelector(".pricing-grid");

        gsap.fromTo(
            section.querySelectorAll(".fade-up-plans"),
            { opacity: 0, y: 40 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.2,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: header,
                    start: "top 90%",
                },
            },
        );

        gsap.fromTo(
            section.querySelectorAll(".plan-card-anim"),
            { opacity: 0, y: 60 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.2,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: grid,
                    start: "top 85%",
                },
            },
        );

        // Detecção de moeda para Portugal
        if (
            navigator.language === "pt-PT" ||
            navigator.languages.includes("pt-PT")
        ) {
            document.querySelectorAll(".currency").forEach((el) => {
                el.textContent = "€";
            });
            // Opcional: Ajustar nota de manutenção
            const maintenanceNote = document.querySelector(".maintenance-note");
            if (maintenanceNote) {
                maintenanceNote.innerHTML = maintenanceNote.innerHTML.replace(
                    "R$ 100",
                    "100 €",
                );
            }
        }
    })();
</script>

<style>
    #plans {
        padding: 120px 0;
        position: relative;
    }

    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-desc {
        max-width: 600px;
        margin: 1rem auto;
        color: var(--color-text-container);
    }

    .section-header h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .section-header p {
        font-size: 1.1rem;
        color: var(--color-text-light);
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
        align-items: flex-start;
        position: relative;
        z-index: 2;
        justify-content: center; /* Ensure centered if single item */
    }

    /* Global targeting for Card component root elements */
    /* Global targeting for Card component root elements */
    /* Global targeting for Card component root elements */
    #plans :global(.price-card) {
        padding: 2.5rem 1.5rem !important;
        display: flex;
        flex-direction: column;
        align-items: center; /* Center-aligned for clean look */
        height: 100%;
        box-sizing: border-box;
        border-radius: 24px !important;
        background: rgba(15, 15, 15, 0.6); /* Glassy default */
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
    }

    #plans :global(.price-card:hover) {
        transform: translateY(-10px);
        border-color: rgba(255, 255, 255, 0.15);
        background: rgba(20, 20, 20, 0.8);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
    }

    .plan-benefits {
        margin: 20px 0;
        flex-grow: 1;
    }

    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
    }

    .benefits-list li {
