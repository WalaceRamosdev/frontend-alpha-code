        max-width: 280px;
        text-align: center;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* Force visibility in featured card */
    #plans :global(.featured .price-microtext) {
        color: #fff !important;
        opacity: 0.95;
    }

    .final-price-wrapper {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 5px;
        width: 100%;
    }

    .price small {
        font-size: 1.5rem;
