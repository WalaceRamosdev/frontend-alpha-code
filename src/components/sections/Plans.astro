    .timer-divider {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.2);
        padding-top: 2px;
        font-weight: 800;
        display: flex;
        align-items: center;
    }

    .countdown-timer {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .timer-item {
        display: flex;
        flex-direction: column;
        align-items: center;
