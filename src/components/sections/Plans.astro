    }

    .price {
        font-size: 3.5rem; /* Massive, confident price */
        font-weight: 800;
        color: #fff;
        line-height: 1;
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 5px;
        letter-spacing: -1px;
    }

    .price-promo-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 5px;
        width: 100%;
    }

    .old-price {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.4);
        text-decoration: line-through;
        font-weight: 500;
    }

    .savings-seal {
        background: #25d366;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 900;
        padding: 3px 12px;
        border-radius: 50px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .seal-strong {
        background: linear-gradient(135deg, #d4af37, #f9e272, #d4af37);
        background-size: 200% 200%;
        color: #000;
        font-size: 0.75rem;
        padding: 5px 15px;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.5);
        animation: shimmer 2s infinite linear;
        border: 1px solid #fff;
    }

    @keyframes shimmer {
        0% {
            background-position: 0% 50%;
        }
        100% {
