        font-weight: 400;
    }

    .price-highlight {
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
        transform: scale(1.05);
        display: inline-flex;
        transform-origin: center;
        transition: transform 0.3s ease;
    }

    .featured .price-highlight {
