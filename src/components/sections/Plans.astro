    }

    .price-header {
        margin-bottom: 20px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 20px;
    }

    .price-header h3 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
        color: #fff;
    }

    .plan-subtitle-tag {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--color-primary);
        background: rgba(138, 28, 38, 0.1);
        padding: 4px 12px;
        border-radius: 50px;
        margin-bottom: 0.5rem;
        font-weight: 700;
        border: 1px solid rgba(138, 28, 38, 0.2);
    }

    .plan-premium-hook {
        font-size: 0.85rem;
        color: #d4af37;
        font-weight: 600;
        margin-bottom: 1.5rem;
        max-width: 250px;
