---
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";

// Import images for optimization
import psicologaDesktop from "../../assets/projects/psicologa-desktop.webp";
import psicologaMobile from "../../assets/projects/psicologa-mobile.webp";
import advocaciaDesktop from "../../assets/projects/advocacia-desktop.webp";
import advocaciaMobile from "../../assets/projects/advocacia-mobile.webp";
import professorDesktop from "../../assets/projects/professor-desktop.webp";
import professorMobile from "../../assets/projects/professor-mobile.webp";
import nexusDesktop from "../../assets/projects/nexus-desktop.webp";
import nexusMobile from "../../assets/projects/nexus-mobile.webp";
interface Props {
    title?: string;
    description?: string;
    badge?: string;
    ctaText?: string;
}

const {
    title = "🚨 VOCÊ ESTÁ PERDENDO DINHEIRO TODOS OS DIAS !",
    description = "Todos os dias, pessoas procuram ativamente por profissionais capacitados para resolver um problema real. Sem um site forte, claro e confiável, você simplesmente não existe para elas.<br/><br/>Elas entram, não encontram segurança, não entendem seu valor e vão direto para quem está preparado para converter.<br/><br/>Nós criamos sites estrategicamente construídos para transformar essa busca ativa em agendamentos automáticos, 24 horas por dia.<br/><br/><strong>+247% aumento médio em conversão | +156% mais tráfego qualificado | 98% de satisfação</strong>",
    badge = "Estratégia Digital de Alta Performance",
    ctaText = "QUERO UM SITE QUE VENDA",
} = Astro.props;
---

<section id="hero">
    <div class="hero-background desktop-only">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="grid-overlay"></div>
    </div>

    <div class="container hero-container-grid">
        <div class="hero-text">
            <div class="badge fade-up">
                <span class="badge-dot"></span>
                <Fragment set:html={badge} />
            </div>
            <h1 class="hero-title-lcp">
                Criação de Sites Profissionais <br><span class="text-primary">de Alta Performance</span>
            </h1>
            <h2 class="text-xl md:text-2xl text-white/80 font-medium mb-6 fade-up">
                O Site Que Sua Empresa Realmente Merece
            </h2>
            <p class="fade-up">
                Não fazemos apenas sites bonitos. Criamos <strong>ativos digitais de alta performance</strong> que transformam visitantes em clientes 24 horas por dia.
            </p>
            <div class="hero-cta fade-up">
                <Button
                    href="https://wa.me/5521999064502?text=Olá! Vim pelo site e gostaria de ter mais informações sobre os sistemas."
                    size="lg"
                    variant="primary"
                    class="glow-effect"
                    target="_blank"
                >
                    <span class="btn-content">SOLICITAR ORÇAMENTO</span>
                </Button>
                <Button 
                    href="https://wa.me/5521999064502?text=Olá! Vim pelo site e gostaria de um orçamento." 
                    variant="outline" 
                    size="lg"
                    target="_blank"
                >
                    Falar no WhatsApp
                </Button>
            </div>
            <div class="trust-indicator fade-up">
                <div class="stars-glimmer">
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                </div>

                <div class="client-avatars">
                    <div class="avatar-stack">
                        <!-- Dr. Roberto (Jurídico) -->
                        <img
                            src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=100&h=100&q=80"
                            alt="Dr. Roberto - Especialista em Direito Digital"
                            title="Dr. Roberto | Especialista em Direito Digital"
                            width="36"
                            height="36"
                            loading="eager"
                        />

                        <!-- Nexus (Contabilidade) -->
                        <div
                            class="logo-avatar"
                            title="Nexus Contabilidade"
                            aria-label="Nexus Contabilidade"
                            role="img"
                            style="background: #111; color: #fff; font-size: 8px; font-weight: 900; letter-spacing: 1px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;"
                        >
                            NEXUS
                        </div>

                        <!-- Dra. Helena (Saúde) -->
                        <img
                            src="https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=100&h=100&q=80"
                            alt="Dra. Helena - Clínica de Estética Avançada"
                            title="Dra. Helena | Clínica de Estética Avançada"
                            width="36"
                            height="36"
                            loading="eager"
                        />

                        <!-- Elegance (Advocacia) -->
                        <div
                            class="logo-avatar"
                            title="Elegance Advocacia"
                            aria-label="Elegance Advocacia"
                            role="img"
                            style="background: #000; color: #fff; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4px;"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                width="12"
                                height="12"
                                style="margin-bottom: 1px;"
                                aria-hidden="true"
                                ><path
                                    d="M16 16c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM21 16c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM12 3v13M7 16c0-1.105 1.343-2 3-2s3 .895 3 2-1.343 2-3 2-3-.895-3-2zM17 10H7M12 21v-5"
                                ></path></svg
                            >
                            <span
                                style="font-size: 5px; font-weight: 800; letter-spacing: 0.5px; opacity: 0.8;"
                                >ELEGANCE</span
                            >
                        </div>

                        <!-- Ana Carolina (Tech Founder) -->
                        <img
                            src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&w=100&h=100&q=80"
                            alt="Ana Carolina - Founder Tech Solutions"
                            title="Ana Carolina | Founder Tech Solutions"
                            width="36"
                            height="36"
                            loading="eager"
                        />
                    </div>
                </div>

                <span class="trust-text">
                    Já são <strong class="text-white"
                        >+250 profissionais e empresas</strong
                    > posicionados no digital.<br />
                    <strong>SEJA VOCÊ O PRÓXIMO ! </strong>
                </span>
            </div>
        </div>

        <div class="hero-visual fade-in">
            <div class="projects-carousel">
                <div class="carousel-track">
                    <!-- Slide 1: Psicóloga (Claro) -->
                    <div class="carousel-slide active">
                        <div class="slide-info">
                            <span class="slide-category">Psicólogos</span>
                        </div>
                        <div class="mockup-compo">
                            <div class="desktop-frame">
                                <Image
                                    src={psicologaDesktop}
                                    alt="Site Psicóloga Desktop"
                                    widths={[400, 800, 1200]}
                                    sizes="(max-width: 968px) 100vw, 800px"
                                    loading="eager"
                                    fetchpriority="high"
                                />
                            </div>
                            <div class="mobile-frame mobile-left">
                                <Image
                                    src={psicologaMobile}
                                    alt="Site Psicóloga Mobile"
                                    widths={[200, 400]}
                                    sizes="(max-width: 968px) 30vw, 200px"
                                    loading="eager"
                                    fetchpriority="high"
                                />
                            </div>
                        </div>
                    </div>
                    <!-- Slide 2: Advocacia (Escuro) -->
                    <div class="carousel-slide">
                        <div class="slide-info info-right">
                            <span class="slide-category">Advogados</span>
                        </div>
                        <div class="mockup-compo">
                            <div class="desktop-frame">
                                <Image
                                    src={advocaciaDesktop}
                                    alt="Site Advocacia Desktop"
                                    widths={[400, 800, 1200]}
                                    sizes="(max-width: 968px) 100vw, 800px"
                                    loading="lazy"
                                />
                            </div>
                            <div class="mobile-frame">
                                <Image
                                    src={advocaciaMobile}
                                    alt="Site Advocacia Mobile"
                                    widths={[200, 400]}
                                    sizes="(max-width: 968px) 30vw, 200px"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>
                    <!-- Slide 3: Professor (Claro) -->
                    <div class="carousel-slide">
                        <div class="slide-info">
                            <span class="slide-category">Professores</span>
                        </div>
                        <div class="mockup-compo">
                            <div class="desktop-frame">
                                <Image
                                    src={professorDesktop}
                                    alt="Site Professor Desktop"
                                    widths={[400, 800, 1200]}
                                    sizes="(max-width: 968px) 100vw, 800px"
                                    loading="lazy"
                                />
                            </div>
                            <div class="mobile-frame mobile-left">
                                <Image
                                    src={professorMobile}
                                    alt="Site Professor Mobile"
                                    widths={[200, 400]}
                                    sizes="(max-width: 968px) 30vw, 200px"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>
                    <!-- Slide 4: Nexus (Escuro) -->
                    <div class="carousel-slide">
                        <div class="slide-info info-right">
                            <span class="slide-category">Institucional</span>
                        </div>
                        <div class="mockup-compo">
                            <div class="desktop-frame">
                                <Image
                                    src={nexusDesktop}
                                    alt="Site Nexus Contabilidade Desktop"
                                    widths={[400, 800, 1200]}
                                    sizes="(max-width: 968px) 100vw, 800px"
                                    loading="lazy"
                                />
                            </div>
                            <div class="mobile-frame">
                                <Image
                                    src={nexusMobile}
                                    alt="Site Nexus Contabilidade Mobile"
                                    widths={[200, 400]}
                                    sizes="(max-width: 968px) 30vw, 200px"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="carousel-glow"></div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    // Track autoplay timer so we can clear it on page transitions
    let _heroAutoplayTimer: ReturnType<typeof setInterval> | null = null;

    // Ensure hero text is ALWAYS visible (safety net if GSAP fails or is slow)
    function ensureHeroVisible() {
        const heroEls = document.querySelectorAll(
            ".hero-text .badge, .hero-title-lcp, .hero-text p, .hero-cta, .trust-indicator, .projects-carousel"
        );
        heroEls.forEach((el) => {
            (el as HTMLElement).style.opacity = "1";
        });
    }

    document.addEventListener("astro:before-preparation", () => {
        // Clean up on page transitions to prevent stale tweens
        if (_heroAutoplayTimer) {
            clearInterval(_heroAutoplayTimer);
            _heroAutoplayTimer = null;
        }
        gsap.killTweensOf(
            ".hero-text .badge, .hero-title-lcp, .hero-text p, .hero-cta, .trust-indicator, .projects-carousel"
        );
    });

    document.addEventListener("astro:page-load", () => {
        const isMobile = window.innerWidth <= 968;

        // Kill any leftover tweens from previous page load
        gsap.killTweensOf(
            ".hero-text .badge, .hero-title-lcp, .hero-text p, .hero-cta, .trust-indicator, .projects-carousel"
        );

        // Verify hero elements exist on this page before running
        const heroSection = document.getElementById("hero");
        if (!heroSection) return;

        // Safety timeout: if GSAP doesn't complete in 3s, force visibility
        const safetyTimer = setTimeout(ensureHeroVisible, 3000);

        const tl = gsap.timeline({
            defaults: { ease: "power3.out", duration: 1 },
            onComplete: () => clearTimeout(safetyTimer),
        });

        tl.fromTo(
                ".hero-text .badge",
                { y: 20, opacity: 0 },
                { y: 0, opacity: 1, duration: 0.8 },
            )
            .fromTo(
                ".hero-title-lcp",
                { y: isMobile ? 5 : 30, opacity: isMobile ? 0.9 : 0 },
                { y: 0, opacity: 1, duration: isMobile ? 0.4 : 1 },
                "-=0.6",
            )
            .fromTo(
                ".hero-text p",
                { y: isMobile ? 10 : 30, opacity: 0 },
                { y: 0, opacity: 1, duration: isMobile ? 0.5 : 1 },
                "-=0.8",
            )
            .fromTo(
                ".hero-cta",
                { y: isMobile ? 10 : 30, opacity: 0 },
                { y: 0, opacity: 1, duration: isMobile ? 0.5 : 1 },
                "-=0.8",
            )
            .fromTo(
                ".trust-indicator",
                { y: 20, opacity: 0 },
                { y: 0, opacity: 1 },
                "-=0.8",
            );

        // Carousel Logic
        const slides = document.querySelectorAll(".carousel-slide");
        let currentSlide = 0;
        const totalSlides = slides.length;

        function goToSlide(index: number) {
            if (slides.length === 0 || index === currentSlide) return;

            const prevSlide = slides[currentSlide];
            const nextSlide = slides[index];
            const mobile = window.innerWidth <= 968;

            gsap.set(nextSlide, {
                opacity: 0,
                visibility: "visible",
                zIndex: 5,
                scale: mobile ? 1 : 1.05,
            });

            const tlScroll = gsap.timeline({
                onComplete: () => {
                    prevSlide.classList.remove("active");
                    nextSlide.classList.add("active");
                    gsap.set(prevSlide, { opacity: 0, visibility: "hidden" });
                    currentSlide = index;
                },
            });

            tlScroll.to(prevSlide, { opacity: 0, duration: 0.4, ease: "power1.inOut" });
            tlScroll.to(nextSlide, { opacity: 1, scale: 1, duration: 0.6, ease: "power2.out" }, "-=0.2");
        }

        function advanceSlide() {
            goToSlide((currentSlide + 1) % totalSlides);
        }

        if (_heroAutoplayTimer) clearInterval(_heroAutoplayTimer);
        _heroAutoplayTimer = setInterval(advanceSlide, 5000);

        // Carousel initial reveal
        gsap.fromTo(
            ".projects-carousel",
            { opacity: 0, y: isMobile ? 10 : 20 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.4 },
        );
    });
</script>

<style>
    /* Safety: hero text is always visible by default.
       GSAP will set opacity:0 ONLY when it's ready to animate.
       This prevents permanently invisible text if JS is slow or fails. */
    .hero-text .badge,
    .hero-title-lcp,
    .hero-text p,
    .hero-cta,
    .trust-indicator {
        opacity: 1;
    }

    /* Hero Styles */
    #hero {
        position: relative;
        padding: 160px 0 100px;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    @media (max-width: 968px) {
        #hero {
            padding: 180px 0 60px !important;
            min-height: 85vh; /* Reserve space for LCP/CLS */
        }
    }

    .hero-background {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
    }

    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.5;
        z-index: 1;
    }

    .orb-1 {
        width: 80vw;
        height: 80vw;
        background: radial-gradient(
            circle,
            rgba(138, 28, 38, 0.4) 0%,
            transparent 70%
        );
        top: -30%;
        right: -20%;
        animation: floatOrb 20s infinite alternate ease-in-out;
    }

    @keyframes floatOrb {
        0% { transform: translate(0, 0); }
        100% { transform: translate(-50px, 50px); }
    }

    .orb-2 {
        width: 50vw;
        height: 50vw;
        background: radial-gradient(
            circle,
            rgba(212, 175, 55, 0.15) 0%,
            transparent 60%
        );
        bottom: -10%;
        left: -10%;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.03) 1px,
                transparent 1px
            );
        background-size: 50px 50px;
        opacity: 0.5;
        z-index: 2;
        mask-image: radial-gradient(
            circle at center,
            black 40%,
            transparent 90%
        );
    }

    .hero-container-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: flex-start; /* Alinhado ao topo */
        position: relative;
        z-index: 10;
    }

    .hero-visual {
        margin-top: 5rem; /* Ajustado para alinhar com o h1 (ignorando o badge) */
    }

    .hero-text .badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 24px;
        background: rgba(138, 28, 38, 0.1);
        border: 1px solid rgba(138, 28, 38, 0.3);
        border-radius: 100px;
        color: #fff;
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 1.5rem; /* Adicionado espaço para não encostar nas letras do título */
        box-shadow: 0 0 30px rgba(138, 28, 38, 0.2);
        backdrop-filter: blur(10px);
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        background: var(--color-primary);
        border-radius: 50%;
        position: relative;
        box-shadow: 0 0 10px var(--color-primary);
    }

    .badge-dot::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 1px solid var(--color-primary);
    }

    @keyframes dotRipple {
        0% {
            transform: scale(1);
            opacity: 1;
        }
        100% {
            transform: scale(3);
            opacity: 0;
        }
    }

    @keyframes badgePulse {
        0%,
        100% {
            border-color: rgba(138, 28, 38, 0.3);
            box-shadow: 0 0 30px rgba(138, 28, 38, 0.2);
        }
        50% {
            border-color: rgba(214, 40, 57, 0.6);
            box-shadow: 0 0 45px rgba(214, 40, 57, 0.4);
            transform: translateY(-2px);
        }
    }

    .badges-container {
        display: flex;
        gap: 15px;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }

    .badge.international {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: none;
        animation: none;
        transition: 0.3s;
    }

    .badge.international:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #fff;
        transform: translateY(-2px);
    }

    .flags-only {
        font-size: 1.1rem;
        letter-spacing: 2px;
        opacity: 0.9;
        filter: grayscale(20%);
        transition: 0.3s;
    }

    .badge.international:hover .flags-only {
        filter: grayscale(0%);
        opacity: 1;
    }

    .hero-text h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.1;
        font-weight: 800;
        margin-bottom: 1.5rem;
        letter-spacing: normal; /* Fix spacing */
    }

    .hero-text p {
        font-size: 1.2rem;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
        max-width: 600px;
        line-height: 1.7;
    }

    .hero-cta {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
    }

    .client-btn {
        background: rgba(255, 255, 255, 0.03) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        opacity: 0.8;
    }

    .client-btn:hover {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: rgba(255, 255, 255, 0.3) !important;
        opacity: 1;
    }

    .trust-indicator {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
        margin-top: 1rem;
    }

    .stars-glimmer {
        display: flex;
        gap: 5px;
        margin-bottom: 8px;
    }

    .star {
        color: #fff;
        font-size: 1.4rem;
        filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.4));
    }

    .star:nth-child(2) {
        animation-delay: 0.2s;
    }
    .star:nth-child(3) {
        animation-delay: 0.4s;
    }
    .star:nth-child(4) {
        animation-delay: 0.6s;
    }
    .star:nth-child(5) {
        animation-delay: 0.8s;
    }

    @keyframes starTwinkle {
        0%,
        100% {
            transform: scale(1);
            filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.4));
        }
        50% {
            transform: scale(1.1);
            filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.8));
        }
    }

    .partner-badge {
        display: none;
    }

    .client-avatars {
        display: flex;
        align-items: center;
        margin-top: -8px;
    }

    .avatar-stack {
        display: flex;
        align-items: center;
        padding-left: 0;
    }

    .avatar-stack img,
    .avatar-stack .logo-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid #0a0a0a;
        margin-left: -12px;
        background: #1a1a1a;
        object-fit: cover;
        transition: transform 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

    .avatar-stack img:first-child,
    .avatar-stack .logo-avatar:first-child {
        margin-left: 0;
    }

    .avatar-stack .logo-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        padding: 7px;
    }

    .avatar-stack img:hover,
    .avatar-stack .logo-avatar:hover {
        transform: translateY(-5px) scale(1.1);
        z-index: 10;
        border-color: var(--color-primary);
    }

    .trust-text {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        letter-spacing: 0.5px;
        line-height: 1.4;
    }

    .trust-text strong {
        color: #fff;
        font-weight: 700;
    }

    @media (max-width: 968px) {
        .trust-indicator {
            align-items: center;
            text-align: center;
        }
    }

    /* Projects Carousel */
    .projects-carousel {
        position: relative;
        width: 100%;
        max-width: 1000px; /* Aumentado de 800px para 1000px */
        margin: 0 auto;
        perspective: 1200px;
    }

    .carousel-track {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10; /* Ajustado para visualização mais horizontal e larga */
        background: transparent;
        border-radius: 32px;
        overflow: visible; /* Deixar as imagens flutuarem melhor */
        transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* Reflection Effect refined */
    .projects-carousel::after {
        content: "";
        position: absolute;
        top: 104%;
        left: 5%;
        width: 90%;
        height: 20%;
        background: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 0.05),
            transparent
        );
        transform: scaleY(-1);
