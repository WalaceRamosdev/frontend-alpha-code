---
// src/components/sections/Testimonials.astro
import Card from "../ui/Card.astro";

const testimonials = [
    {
        name: "João Silva",
        role: "CEO na Construtora Nova Era",
        text: "Já tinha tentado fazer site com várias agências. Com a Alpha Code, em 30 dias meu telefone não parava de tocar. O investimento se pagou no primeiro mês.",
        stars: 5
    },
    {
        name: "Maria Santos",
        role: "Diretora na Fit Store",
        text: "Hoje apareço na primeira página do Google para termos competitivos. O tráfego orgânico que recebo me economiza milhares de reais em anúncios mensalmente.",
        stars: 5
    },
    {
        name: "Carlos Oliveira",
        role: "Fundador da Mecânica Premium",
        text: "O diferencial foi o acompanhamento estratégico. Eles não só entregaram o site, me ensinaram como usar ele para vender 3x mais. Mudou meu jogo.",
        stars: 5
    }
];
---

<style>
    .testimonials-grid-elite {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 2.5rem;
        align-items: stretch;
    }
    @media (min-width: 768px) {
        .testimonials-grid-elite {
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
    }

    .testimonial-card-elite {
        background: rgba(12, 12, 12, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px) !important;
        padding: 3rem 2.5rem !important;
        border-radius: 32px !important;
        position: relative;
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .testimonial-card-elite:hover {
        transform: translateY(-10px);
        border-color: rgba(212, 175, 55, 0.3) !important;
        background: rgba(18, 18, 18, 0.6) !important;
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8), 0 0 30px rgba(212, 175, 55, 0.05);
    }

    .quote-mark {
        position: absolute;
        top: 2rem;
        right: 2.5rem;
        font-size: 6rem;
        line-height: 1;
        font-family: serif;
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), transparent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        pointer-events: none;
        user-select: none;
    }

    .star-rating {
        display: flex;
        gap: 4px;
        margin-bottom: 2rem;
    }

    .star-gold {
        color: #d4af37;
        filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.3));
    }

    .testimonial-text-elite {
        color: rgba(255, 255, 255, 0.85);
        font-size: 1.05rem;
        line-height: 1.8;
        font-style: italic;
        margin-bottom: 2.5rem;
        position: relative;
        z-index: 1;
    }

    .author-badge {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .author-avatar {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #1a1a1a, #0a0a0a);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d4af37;
        font-weight: 900;
        font-size: 1.2rem;
    }

    .author-info-elite h4 {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .author-info-elite p {
        color: #d4af37;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }
</style>

<section id="testimonials" class="bg-black py-24 relative overflow-hidden">
    <!-- Ambient Light - Gold -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gold/5 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="container relative z-10">
        <div class="text-center mb-24 text-balance">
            <span class="text-primary text-[11px] font-black uppercase tracking-[5px] mb-4 block">Prova Social de Elite</span>
            <h2 class="text-4xl md:text-6xl font-black text-white mt-4 font-outfit uppercase tracking-tighter">
                Quem Confia, <span class="text-primary">Escala</span>
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg mt-6">
                Resultados concretos de negócios que decidiram abandonar o amadorismo e dominar o mercado digital.
            </p>
        </div>

        <div class="testimonials-grid-elite">
            {testimonials.map((item) => (
                <div class="testimonial-card-elite group">
                    <span class="quote-mark">“</span>
                    
                    <div class="card-top">
                        <div class="star-rating">
                            {[...Array(item.stars)].map(() => (
                                <svg class="star-gold" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                                </svg>
                            ))}
                        </div>
                        <p class="testimonial-text-elite tracking-tight">"{item.text}"</p>
                    </div>

                    <div class="author-badge">
                        <div class="author-avatar">{item.name.charAt(0)}</div>
                        <div class="author-info-elite">
                            <h4 class="font-outfit">{item.name}</h4>
                            <p>{item.role}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
