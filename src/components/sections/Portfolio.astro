---
// src/components/sections/Portfolio.astro
import { projectsData } from "../../data/projects";
import Card from "../ui/Card.astro";
import { Image } from "astro:assets";

// Limit to top 3 strongest projects for high conversion
const displayedProjects = projectsData.slice(0, 3);
---

<style>
    .portfolio-grid-container {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 2rem;
    }
    @media (min-width: 768px) {
        .portfolio-grid-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .portfolio-card {
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        background: rgba(10, 10, 10, 0.6) !important;
        backdrop-filter: blur(20px) !important;
        border-radius: 24px !important;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .portfolio-card:hover {
        border-color: rgba(138, 28, 38, 0.4) !important;
        transform: translateY(-8px) scale(1.01);
        box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(138, 28, 38, 0.15);
    }

    .project-image-wrapper {
        position: relative;
        overflow: hidden;
        aspect-ratio: 16 / 10;
    }

    .project-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(20%) brightness(0.9);
        transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .portfolio-card:hover .project-image {
        filter: grayscale(0%) brightness(1.1);
        transform: scale(1.08);
    }

    .project-content {
        padding: 2.25rem 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
    }

    @media (max-width: 768px) {
        .mobile-carousel {
            display: flex !important;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 40px;
            padding: 0 20px 50px 20px;
            margin: 0 -20px;
            scrollbar-width: none;
        }
        .mobile-carousel::-webkit-scrollbar {
            display: none;
        }
        .portfolio-card {
            flex: 0 0 92%;
            scroll-snap-align: center;
        }
        .project-content {
            padding: 2.5rem 1.75rem;
        }
    }
</style>

<section id="portfolio" class="bg-black py-24 relative overflow-hidden">
    <!-- Decorative Background element -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container">
        <div class="text-center mb-20 text-balance">
            <span class="text-primary text-[11px] font-black uppercase tracking-[4px] mb-4 block opacity-80 decoration-primary underline underline-offset-8">Cases de Sucesso</span>
            <h2 class="text-4xl md:text-6xl font-black text-white mt-4 font-outfit uppercase tracking-tighter">
                Projetos que <span class="text-primary">Dominam</span>
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg mt-6">
                Fomos escolhidos por líderes de mercado para elevar seu posicionamento digital através de design estratégico.
            </p>
        </div>

        <div class="portfolio-grid-container mobile-carousel">
            {displayedProjects.map((project) => (
                <div class="portfolio-card group">
                    <div class="project-image-wrapper">
                        <Image 
                            src={project.image} 
                            alt={project.name}
                            width={600} 
                            height={400}
                            class="project-image"
                        />
                        <!-- Subtle View Project indicator -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
                            <span class="text-white text-xs font-black uppercase tracking-widest flex items-center gap-2">
                                Ver Projeto 
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                            </span>
                        </div>
                    </div>
                    <div class="project-content">
                        <span class="text-primary text-[10px] font-black uppercase tracking-[2px] block mb-2">{project.type}</span>
                        <h3 class="text-white text-2xl font-black tracking-tight group-hover:text-primary transition-colors duration-300">{project.name}</h3>
                    </div>
                </div>
            ))}
        </div>
        
        <div class="text-center mt-20">
            <a href="/portfolio" class="group relative inline-flex items-center gap-4 text-white font-black uppercase tracking-widest text-sm py-4 px-8 border border-white/10 rounded-full hover:border-primary/50 transition-all duration-300 overflow-hidden">
                <span class="relative z-10 font-outfit">Ver portfólio completo</span>
                <svg class="relative z-10 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                <div class="absolute inset-0 bg-primary/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
            </a>
        </div>
    </div>
</section>
