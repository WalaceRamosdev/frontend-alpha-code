---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../ui/Button.astro";
import fs from "fs";
import path from "path";

interface Props {
    cidade?: string;
}

const { cidade } = Astro.props;

// Self-healing asset setup (ensures images are copied to public during compile)
const srcDir = "C:\\Users\\HP\\.gemini\\antigravity\\brain\\5d5fb8e7-a79d-4fd2-ab1d-890d11724195";
const targetDir = path.resolve("./public/assets/projects");

if (!fs.existsSync(targetDir)) {
    fs.mkdirSync(targetDir, { recursive: true });
}

const imagesToCopy = [
    { src: "raw_desktop_solar_ui_1778595073795.png", dest: "site-empresa-energia-solar.webp" },
    { src: "raw_mobile_solar_ui_1778595107874.png", dest: "website-solar-mobile.webp" },
    { src: "landing_page_energia_solar_1778594111629.png", dest: "landing-page-energia-solar.webp" }
];

for (const img of imagesToCopy) {
    const srcPath = path.join(srcDir, img.src);
    const destPath = path.join(targetDir, img.dest);
    
    // Always convert and overwrite if the source file exists (ensures any source updates ripple to public)
    if (fs.existsSync(srcPath)) {
        try {
            const sharp = (await import("sharp")).default;
            await sharp(srcPath).webp({ quality: 90 }).toFile(destPath);
            console.log(`[Asset Setup] Converted and saved ${img.dest} using Sharp`);
        } catch (sharpError) {
            fs.copyFileSync(srcPath, destPath);
            console.log(`[Asset Setup] Copied ${img.dest} (fallback)`);
        }
    }
}

// Localized configurations
const displayCity = cidade ? ` em ${cidade}` : "";
const ufMap: Record<string, string> = {
    "São Paulo": "SP",
    "Curitiba": "PR",
    "Belo Horizonte": "MG",
    "Mato Grosso do Sul": "MS",
    "Pará": "PA"
};
const displayCityMeta = cidade ? ` em ${cidade}${ufMap[cidade] ? ` (${ufMap[cidade]})` : ""}` : "";

// SEO Metadata
const title = `Criação de Sites para Empresas de Energia Solar${displayCityMeta}`;
const description = `Desenvolvemos sites profissionais para empresas de energia solar${displayCity} com foco em SEO local, geração de leads e conversão.`;
const keywords = [
    `site para empresa de energia solar${displayCity}`,
    `criação de site para energia solar${displayCity}`,
    `website para empresa solar${displayCity}`,
    `site para integrador solar${displayCity}`,
    `landing page energia solar${displayCity}`,
    "desenvolvimento de site solar",
    "marketing digital para energia solar"
];

// FAQ Data
const faq = [
    {
        q: `Quanto custa um site para empresa solar${displayCity}?`,
        a: "O investimento varia de acordo com a complexidade do projeto (se inclui simulador de economia, páginas dinâmicas de cidades para SEO, etc.). Oferecemos soluções modulares sob medida com alto retorno sobre o investimento (ROI). Entre em contato para um orçamento detalhado!"
    },
    {
        q: "Em quanto tempo o site fica pronto?",
        a: "O prazo médio de entrega para um site solar premium totalmente otimizado e completo é de 15 a 20 dias úteis, contados a partir da aprovação do briefing."
    },
    {
        q: "O site aparece no Google?",
        a: `Sim! Todos os nossos sites são criados sob a arquitetura de SEO de Elite. Implementamos técnicas de SEO Local e Regional avançadas para que sua empresa seja encontrada nas primeiras posições quando clientes buscarem por energia solar em ${cidade || "sua região"}.`
    },
    {
        q: "Vocês fazem integração com WhatsApp?",
        a: "Com certeza. O WhatsApp é o maior canal de conversão do Brasil. Integramos botões flutuantes inteligentes, CTAs estratégicos direcionados e formulários de pré-qualificação que enviam os dados direto para o seu WhatsApp ou CRM de vendas."
    },
    {
        q: "O site funciona no celular?",
        a: "100% responsivo e com foco mobile-first. Mais de 80% das buscas por energia solar são feitas por celulares. Por isso, garantimos carregamento instantâneo e layout perfeito em qualquer smartphone."
    }
];

const areasAtendidas = [
    { cidade: "São Paulo", slug: "sao-paulo" },
    { cidade: "Curitiba", slug: "curitiba" },
    { cidade: "Belo Horizonte", slug: "belo-horizonte" },
    { cidade: "Mato Grosso do Sul", slug: "mato-grosso-do-sul" },
    { cidade: "Pará", slug: "para" }
];
---

