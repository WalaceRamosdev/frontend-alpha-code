<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", () => {
        const accordionItems = document.querySelectorAll(".faq-accordion-item");
        
        accordionItems.forEach(item => {
            const trigger = item.querySelector(".faq-trigger");
            const content = item.querySelector(".faq-content") as HTMLElement;
            
            trigger?.addEventListener("click", () => {
                const isOpen = item.classList.contains("active");
                
                accordionItems.forEach(otherItem => {
                    if (otherItem !== item && otherItem.classList.contains("active")) {
                        otherItem.classList.remove("active");
                        const otherContent = otherItem.querySelector(".faq-content") as HTMLElement;
                        const otherTrigger = otherItem.querySelector(".faq-trigger");
                        if (otherContent) otherContent.style.maxHeight = "0";
                        otherTrigger?.setAttribute("aria-expanded", "false");
                    }
                });
                
                if (isOpen) {
                    item.classList.remove("active");
                    if (content) content.style.maxHeight = "0";
                    trigger.setAttribute("aria-expanded", "false");
                } else {
                    item.classList.add("active");
                    if (content) content.style.maxHeight = content.scrollHeight + "px";
                    trigger.setAttribute("aria-expanded", "true");
                }
            });
        });

        ScrollTrigger.refresh();

        gsap.to(".hero-img", {
            y: -10,
            duration: 4,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut"
        });

        gsap.to(".desktop-mockup", {
            y: -8,
            duration: 5,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut"
        });

        gsap.to(".mobile-mockup", {
            y: -15,
            duration: 4.5,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: 0.5
        });

        const reveals = document.querySelectorAll(".hero-text-content > *, .hero-visual, .pain-box, .gain-box, .solution-text, .solution-visual, .benefit-card, .step-card, .testimonial-card, .faq-accordion-item");
        
        reveals.forEach(el => {
            gsap.fromTo(el, {
                opacity: 0,
                y: 40
            }, {
                scrollTrigger: {
                    trigger: el,
                    start: "top 85%",
                    toggleActions: "play none none none"
                },
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out"
            });
        });
    });
</script>
