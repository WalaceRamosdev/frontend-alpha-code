---
// src/components/sections/Pricing.astro
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
---

<style>
    .pricing-grid-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        align-items: stretch;
    }

    @media (max-width: 767px) {
        .pricing-grid-container {
            grid-template-columns: 1fr;
            gap: 4rem;
            padding: 0 1rem;
        }

        /* Melhora padding interno dos cards no mobile */
        .pricing-grid-container :global(.price-card),
        .pricing-grid-container > * {
            padding: 2.5rem 1.5rem !important;
            max-width: 100%;
        }

        /* Mantém destaque no card central sem margin extra interferindo no gap */
        .pricing-grid-container > *:nth-child(2) {
            transform: scale(1.05) !important;
            margin: 1.5rem 0;
            z-index: 10;
        }

        /* Fonte adequada no mobile */
        .pricing-grid-container h3 {
            font-size: 1.75rem !important;
        }
        .pricing-grid-container p,
        .pricing-grid-container li span,
        .pricing-grid-container .urgency-text {
            font-size: 0.9rem !important;
        }
    }

    @media (min-width: 768px) {
        .pricing-grid-container {
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }
    }
    @media (min-width: 1024px) {
        .pricing-grid-container {
            gap: 2.5rem;
        }
    }

    .premium-card {
        border-color: rgba(212, 175, 55, 0.4) !important;
        position: relative;
    }
    .premium-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 32px;
        padding: 1px;
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.4), transparent, rgba(212, 175, 55, 0.4));
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask-composite: exclude;
        -webkit-mask-composite: destination-out;
        pointer-events: none;
    }
    .premium-text {
        background: linear-gradient(135deg, #d4af37, #f9e272, #d4af37);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: 2px;
    }
    .btn-premium {
        border-color: #d4af37 !important;
        color: #d4af37 !important;
        background: rgba(212, 175, 55, 0.05);
    }
    .btn-premium:hover {
        background: #d4af37 !important;
        color: #000 !important;
        box-shadow: 0 0 30px rgba(212, 175, 55, 0.3);
    }
    .check-icon-svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        margin-top: 2px;
    }
    .old-price {
        text-decoration: line-through;
        color: rgba(255, 255, 255, 0.3);
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .save-badge {
        background: #10b981;
        color: white;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: inline-block;
        margin-bottom: 0.5rem;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }
    .urgency-text {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 1rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }
</style>

<section id="pricing" class="py-24 bg-black relative overflow-visible">
    <div class="container">
        <div class="text-center mb-20">
            <h2 class="text-4xl md:text-6xl font-black text-white mb-6 font-outfit uppercase tracking-tighter">
                Escolha Sua <span class="text-primary">Estratégia</span>
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg">
                Projetos sob medida para o tamanho da sua ambição e alcance de mercado.
            </p>
        </div>

        <div class="pricing-grid-container">
            <!-- Essencial -->
            <Card variant="price" class="p-10 bg-[#080808] border border-white/5 rounded-[32px] flex flex-col items-center h-full group hover:border-primary/40 transition-all duration-500">
                <div class="w-full text-center mb-8">
                    <h3 class="text-white text-2xl font-black uppercase tracking-tight mb-2">Presença Inicial</h3>
                    <p class="text-primary text-[11px] font-black uppercase tracking-[3px] opacity-80 decoration-primary underline underline-offset-4">Padrão Alpha Bronze</p>
                </div>
                
                <div class="mb-10 flex flex-col items-center justify-center min-h-[140px]">
                    <div class="h-px w-20 bg-white/10 mb-6"></div>
                    <p class="text-white/60 text-xs uppercase tracking-[4px] font-bold text-center leading-relaxed">
                        Estrutura <br/> Essencial
                    </p>
                    <div class="h-px w-20 bg-white/10 mt-6"></div>
                </div>

                <ul class="space-y-6 mb-12 w-full flex-grow border-t border-white/5 pt-8">
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Landing Page de Alta Performance</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Copywriting Persuasivo</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Otimização de Velocidade</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Botão WhatsApp Estratégico</span>
                    </li>
                </ul>

                <Button href="/planos" variant="outline" class="w-full py-4 rounded-2xl border-white/10 text-white font-bold hover:bg-white hover:text-black transition-all">
                    VER DETALHES
                </Button>
            </Card>

            <!-- Profissional -->
            <Card variant="price" class="p-10 bg-gradient-to-b from-[#9b1c28] to-[#7a151f] rounded-[32px] flex flex-col items-center h-full shadow-[0_40px_80px_-15px_rgba(138,28,38,0.6)] relative z-20 md:scale-[1.08] lg:scale-110 border-none transition-all duration-500">
                <div class="absolute -top-5 left-1/2 -translate-x-1/2 bg-white text-[#8a1c26] px-6 py-2 rounded-full text-[11px] font-black uppercase shadow-2xl whitespace-nowrap z-30 tracking-wider">
                    🔥 MAIS PEDIDO
                </div>

                <div class="w-full text-center mb-8">
                    <h3 class="text-white text-2xl font-black uppercase tracking-tight mb-2">Estrutura de Conversão</h3>
                    <p class="text-white/80 text-[11px] font-black uppercase tracking-[3px]">Padrão Alpha Prata</p>
                </div>
                
                <div class="mb-10 flex flex-col items-center justify-center min-h-[140px]">
                    <div class="h-px w-20 bg-white/20 mb-6"></div>
                    <p class="text-white text-xs uppercase tracking-[4px] font-black text-center leading-relaxed">
                        Autoridade <br/> Digital
                    </p>
                    <div class="h-px w-20 bg-white/20 mt-6"></div>
                </div>

                <ul class="space-y-6 mb-12 w-full flex-grow border-t border-white/10 pt-8">
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-white">
                        <svg class="check-icon-svg text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-bold leading-tight">Site Institucional Completo</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-white">
                        <svg class="check-icon-svg text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-bold leading-tight">SEO Local (Google Maps)</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-white">
                        <svg class="check-icon-svg text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-bold leading-tight">Blog de Autoridade</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-white">
                        <svg class="check-icon-svg text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-bold leading-tight">Design Premium Exclusivo</span>
                    </li>
                </ul>

                <Button href="/planos" variant="secondary" class="w-full py-5 rounded-2xl bg-white text-[#8a1c26] font-black shadow-2xl hover:scale-[1.03] transition-all !border-[3px] !border-black/20">
                    VER PLANOS
                </Button>
                <p class="urgency-text text-white/80 mt-6 text-[10px] font-black">
                    🔥 ESCOLHA DE 87% DOS CLIENTES
                </p>
            </Card>

            <!-- Premium -->
            <Card variant="price" class="p-10 bg-[#080808] border border-white/5 rounded-[32px] flex flex-col items-center h-full premium-card hover:border-gold/50 transition-all duration-500">
                <div class="absolute -top-5 right-6 bg-[#d4af37] text-black px-4 py-1.5 rounded-full text-[9px] font-black uppercase shadow-xl tracking-tighter">
                    Alta Performance
                </div>
                
                <div class="w-full text-center mb-8">
                    <h3 class="text-white text-2xl font-black uppercase tracking-tight mb-2">Autoridade de Mercado</h3>
                    <p class="premium-text text-[11px] uppercase tracking-[3px]">Padrão Alpha Ouro</p>
                </div>
                
                <div class="mb-10 flex flex-col items-center justify-center min-h-[140px]">
                    <div class="h-px w-20 bg-gold/30 mb-6"></div>
                    <p class="premium-text text-xs uppercase tracking-[4px] font-black text-center leading-relaxed">
                        Dominância <br/> Total
                    </p>
                    <div class="h-px w-20 bg-gold/30 mt-6"></div>
                </div>

                <ul class="space-y-6 mb-12 w-full flex-grow border-t border-white/5 pt-8">
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Funil de Vendas Automatizado</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">SEO Técnico Avançado</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Integração CRM / Checkout</span>
                    </li>
                    <li class="grid grid-cols-[20px_1fr] gap-4 items-start text-gray-300">
                        <svg class="check-icon-svg text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <span class="text-sm font-medium leading-tight">Mentoria Estratégica (1h)</span>
                    </li>
                </ul>

                <Button href="/planos" variant="outline" class="w-full py-4 rounded-2xl btn-premium font-bold transition-all">
                    CONSULTAR ELITE
                </Button>
            </Card>
        </div>
    </div>
</section>
