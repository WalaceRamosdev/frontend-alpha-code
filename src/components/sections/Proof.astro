---
// src/components/sections/Proof.astro
---
<section class="bg-black py-16 border-y border-white/5 relative overflow-hidden">
    <!-- Subtle glow -->
    <div class="absolute top-0 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
    
    <div class="container">
        <!-- Numbers Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center mb-16">
            <div class="proof-item group">
                <span class="text-5xl md:text-6xl font-black text-primary block mb-3 font-outfit transition-transform group-hover:scale-110 duration-500">+200</span>
                <p class="text-gray-400 uppercase tracking-widest text-[10px] font-black opacity-70">Projetos de Elite Entregues</p>
            </div>
            <div class="proof-item group">
                <span class="text-5xl md:text-6xl font-black text-primary block mb-3 font-outfit transition-transform group-hover:scale-110 duration-500">+150</span>
                <p class="text-gray-400 uppercase tracking-widest text-[10px] font-black opacity-70">Empresas e Profissionais</p>
            </div>
            <div class="proof-item group">
                <span class="text-5xl md:text-6xl font-black text-white block mb-3 font-outfit transition-transform group-hover:scale-110 duration-500">100%</span>
                <p class="text-gray-400 uppercase tracking-widest text-[10px] font-black opacity-70">Índice de Satisfação Real</p>
            </div>
        </div>

        <!-- Trust Logos -->
        <div class="pt-8 border-t border-white/5 flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-40 grayscale transition-all hover:grayscale-0 hover:opacity-100 duration-1000">
             <div class="flex items-center gap-2 text-white font-black text-xs tracking-tighter">
                <span class="p-1 bg-white text-black text-[8px] rounded">G</span> GOOGLE PARTNER
             </div>
             <div class="flex items-center gap-2 text-white font-black text-xs tracking-tighter">
                <span class="text-primary text-lg">▲</span> ASTRO TECH
             </div>
             <div class="flex items-center gap-2 text-white font-black text-xs tracking-tighter">
                <span class="text-green-500 text-lg">★</span> TRUSTPILOT 4.9/5
             </div>
             <div class="flex items-center gap-2 text-white font-black text-xs tracking-tighter uppercase">
                24h Suporte
             </div>
        </div>

        <!-- CRO: Skeleton Testimonials (Prova Social Visual Load) -->
        <div class="mt-16 border-t border-white/5 pt-12">
            <h3 class="text-center text-gray-400 text-xs font-bold uppercase tracking-[0.2em] mb-8">Nossos Clientes Recomendam</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Skeleton 1 -->
                <div class="testimonial-card bg-zinc-900 border border-zinc-800 rounded-xl p-6 relative overflow-hidden h-[180px]">
                    <div class="animate-pulse flex space-x-4 mb-4">
                        <div class="rounded-full bg-zinc-700 h-10 w-10"></div>
                        <div class="flex-1 space-y-2 py-1">
                            <div class="h-3 bg-zinc-700 rounded w-24"></div>
                            <div class="h-2 bg-zinc-700 rounded w-16"></div>
                        </div>
                    </div>
                    <div class="animate-pulse space-y-2">
                        <div class="h-2 bg-zinc-700 rounded w-full"></div>
                        <div class="h-2 bg-zinc-700 rounded w-5/6"></div>
                        <div class="h-2 bg-zinc-700 rounded w-4/6"></div>
                    </div>
                </div>
                <!-- Skeleton 2 -->
                <div class="testimonial-card bg-zinc-900 border border-zinc-800 rounded-xl p-6 relative overflow-hidden h-[180px]">
                    <div class="animate-pulse flex space-x-4 mb-4">
                        <div class="rounded-full bg-zinc-700 h-10 w-10"></div>
                        <div class="flex-1 space-y-2 py-1">
                            <div class="h-3 bg-zinc-700 rounded w-32"></div>
                            <div class="h-2 bg-zinc-700 rounded w-20"></div>
                        </div>
                    </div>
                    <div class="animate-pulse space-y-2">
                        <div class="h-2 bg-zinc-700 rounded w-full"></div>
                        <div class="h-2 bg-zinc-700 rounded w-full"></div>
                        <div class="h-2 bg-zinc-700 rounded w-3/4"></div>
                    </div>
                </div>
                <!-- Skeleton 3 -->
                <div class="testimonial-card bg-zinc-900 border border-zinc-800 rounded-xl p-6 relative overflow-hidden h-[180px]">
                    <div class="animate-pulse flex space-x-4 mb-4">
                        <div class="rounded-full bg-zinc-700 h-10 w-10"></div>
                        <div class="flex-1 space-y-2 py-1">
                            <div class="h-3 bg-zinc-700 rounded w-20"></div>
                            <div class="h-2 bg-zinc-700 rounded w-12"></div>
                        </div>
                    </div>
                    <div class="animate-pulse space-y-2">
                        <div class="h-2 bg-zinc-700 rounded w-5/6"></div>
                        <div class="h-2 bg-zinc-700 rounded w-4/6"></div>
                        <div class="h-2 bg-zinc-700 rounded w-full"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
