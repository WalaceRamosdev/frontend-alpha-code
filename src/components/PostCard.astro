---
interface Props {
    title: string;
    description: string;
    pubDate: Date;
    heroImage?: string;
    slug: string;
    author: string;
}

const { title, description, pubDate, heroImage, slug, author } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
});
---

<a href={`/blog/${slug}`} class="post-card">
    <div class="card-image">
        {
            heroImage ? (
                <img
                    src={heroImage}
                    alt={title}
                    loading="lazy"
                    width="400"
                    height="250"
                />
            ) : (
                <div class="placeholder-image" />
            )
        }
        <div class="card-overlay"></div>
    </div>
    <div class="card-body">
        <header class="card-header">
            <span class="card-date">{formattedDate}</span>
            <h3 class="card-title">{title}</h3>
        </header>
        <p class="card-excerpt">{description}</p>
        <footer class="card-footer">
            <div class="author-pill">
                <div class="author-avatar">{author.charAt(0)}</div>
                <span>{author}</span>
            </div>
            <div class="read-indicator">
                <span>Explorar</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                        points="7 7 17 7 17 17"></polyline></svg
                >
            </div>
        </footer>
    </div>
</a>

<style>
    .post-card {
        display: flex;
        flex-direction: column;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 32px;
        overflow: hidden;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        height: 100%;
        position: relative;
    }

    .post-card:hover {
        transform: translateY(-8px);
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.5);
    }

    .card-image {
        position: relative;
        aspect-ratio: 16/10;
        overflow: hidden;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 60%,
            rgba(5, 5, 5, 0.4)
        );
        opacity: 0.6;
    }

    .post-card:hover .card-image img {
        transform: scale(1.08);
    }

    .card-body {
        padding: 32px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-header {
        margin-bottom: 20px;
    }

    .card-date {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #666;
        margin-bottom: 12px;
    }

    .card-title {
        font-size: 1.625rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        transition: color 0.3s;
    }

    .post-card:hover .card-title {
        color: #fff;
    }

    .card-excerpt {
        font-size: 1rem;
        color: #888;
        line-height: 1.6;
        margin-bottom: 32px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .author-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #666;
    }

    .author-avatar {
        width: 24px;
        height: 24px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        color: #fff;
    }

    .read-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #fff;
        opacity: 0.6;
        transition:
            opacity 0.3s,
            transform 0.3s;
    }

    .post-card:hover .read-indicator {
        opacity: 1;
        transform: translateX(4px);
    }

    .read-indicator svg {
        transition: transform 0.3s;
    }
</style>
