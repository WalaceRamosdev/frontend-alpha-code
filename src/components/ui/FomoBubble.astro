---
// src/components/ui/FomoBubble.astro
---

<div
    id="fomo-bubble"
    class="fixed bottom-6 left-6 z-[100] transform translate-y-24 opacity-0 pointer-events-none transition-all duration-700 ease-out"
>
    <!-- Card wrapper with relative positioning for absolute close button -->
    <div
        class="relative bg-[#0a0a0a]/95 backdrop-blur-xl border border-white/5 p-5 rounded-2xl shadow-[0_15px_40px_rgba(214,40,57,0.15)] flex items-start gap-4 max-w-[340px]"
    >
        <!-- Close Button (absolute positioned) -->
        <button
            id="close-fomo"
            class="absolute top-3 right-3 text-gray-500 hover:text-white transition-colors bg-white/5 hover:bg-white/10 p-1.5 rounded-full cursor-pointer z-10"
            aria-label="Fechar notificação"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <div
            class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0 border border-primary/20 shadow-[0_0_15px_rgba(214,40,57,0.2)] mt-0.5"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
        </div>
        <div class="flex-1 pr-2">
            <p
                class="text-[10px] text-gray-400 font-extrabold uppercase tracking-[0.2em] mb-1.5"
            >
                Novo Orçamento
            </p>
            <p
                class="text-sm text-gray-200 font-medium leading-relaxed drop-shadow-sm"
                id="fomo-text"
            >
                Um <strong>Psicólogo</strong> de São Paulo solicitou um diagnóstico.
            </p>
            <p
                class="text-xs text-primary font-semibold mt-2 flex items-center opacity-90"
                id="fomo-time"
            >
                <span
                    class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse inline-block mr-1.5"
                ></span>
                há 4 minutos
            </p>
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const bubble = document.getElementById("fomo-bubble");
        const text = document.getElementById("fomo-text");
        const time = document.getElementById("fomo-time");
        const closeBtn = document.getElementById("close-fomo");

        let fomoTimeout: ReturnType<typeof setTimeout> | null = null;
        let forceClosed = false; // Add a flag to prevent further popups if the user manually closes it

        const niches = [
            "Psicólogo",
            "Médico",
            "Advogado",
            "Arquiteto",
            "Dentista",
            "Contador",
            "Terapeuta",
            "Empresário",
            "Consultor",
        ];

        const locations = [
            "Nova Iguaçu",
            "Duque de Caxias",
            "Rio de Janeiro",
            "São Paulo",
            "Belford Roxo",
            "Niterói",
            "Curitiba",
            "Belo Horizonte",
        ];

        function showFomo() {
            if (!bubble || !text || !time || forceClosed) return;

            const niche = niches[Math.floor(Math.random() * niches.length)];
            const loc = locations[Math.floor(Math.random() * locations.length)];
            const minutes = Math.floor(Math.random() * 55) + 2;

            text.innerHTML = `Um <strong>${niche}</strong> de ${loc} solicitou um diagnóstico gratuito.`;
            time.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse inline-block mr-1.5"></span>há ${minutes} minutos`;

            bubble.classList.remove(
                "translate-y-24",
                "opacity-0",
                "pointer-events-none",
            );

            if (fomoTimeout) clearTimeout(fomoTimeout);

            fomoTimeout = setTimeout(() => {
                hideFomo(false);
            }, 8000);
        }

        function hideFomo(manualClose = false) {
            if (manualClose) {
                forceClosed = true; // Stop showing popups if manually closed
            }
            bubble?.classList.add(
                "translate-y-24",
                "opacity-0",
                "pointer-events-none",
            );
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", () => hideFomo(true));
        }

        // Initial delay
        setTimeout(() => {
            showFomo();
            // Show again every 45 seconds if not force closed
            setInterval(showFomo, 45000);
        }, 12000);
    });
</script>
