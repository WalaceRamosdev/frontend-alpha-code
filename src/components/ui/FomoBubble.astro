---
// src/components/ui/FomoBubble.astro
---

<div
    id="fomo-bubble"
    class="fixed bottom-6 left-6 z-[100] transform translate-y-24 opacity-0 pointer-events-none transition-all duration-700 ease-out"
>
    <!-- Card wrapper with relative positioning for absolute close button -->
    <div
        class="relative bg-[#0d0d0d]/90 backdrop-blur-md border border-white/10 p-3.5 rounded-xl shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-3.5 max-w-[290px]"
    >
        <!-- Close Button (absolute positioned) -->
        <button
            id="close-fomo"
            class="absolute -top-2 -right-2 text-gray-400 hover:text-white transition-colors bg-[#1a1a1a] border border-white/10 p-1 rounded-full cursor-pointer z-10 shadow-lg"
            aria-label="Fechar notificação"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <div
            class="w-8 h-8 rounded-lg bg-primary/5 flex items-center justify-center shrink-0 border border-primary/10"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 text-primary/80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
        </div>
        <div class="flex-1">
            <p
                class="text-[12px] text-gray-200 font-medium leading-snug"
                id="fomo-text"
            >
                Um <strong>Psicólogo</strong> de São Paulo solicitou um orçamento.
            </p>
            <p
                class="text-[10px] text-primary/70 font-bold mt-1.5 flex items-center"
                id="fomo-time"
            >
                <span
                    class="w-1 h-1 rounded-full bg-primary/60 inline-block mr-1.5"
                ></span>
                há 4 minutos
            </p>
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const bubble = document.getElementById("fomo-bubble");
        const text = document.getElementById("fomo-text");
        const time = document.getElementById("fomo-time");
        const closeBtn = document.getElementById("close-fomo");

        let fomoTimeout: ReturnType<typeof setTimeout> | null = null;
        let forceClosed = false; // Add a flag to prevent further popups if the user manually closes it

        const niches = [
            "Psicólogo",
            "Médico",
            "Advogado",
            "Arquiteto",
            "Dentista",
            "Contador",
            "Terapeuta",
            "Empresário",
            "Consultor",
        ];

        const locations = [
            "Nova Iguaçu",
            "Duque de Caxias",
            "Rio de Janeiro",
            "São Paulo",
            "Belford Roxo",
            "Niterói",
            "Curitiba",
            "Belo Horizonte",
        ];

        function showFomo() {
            if (!bubble || !text || !time || forceClosed) return;

            const niche = niches[Math.floor(Math.random() * niches.length)];
            const loc = locations[Math.floor(Math.random() * locations.length)];
            const minutes = Math.floor(Math.random() * 55) + 2;

            text.innerHTML = `Um <strong>${niche}</strong> de ${loc} solicitou um orçamento.`;
            time.innerHTML = `<span class="w-1 h-1 rounded-full bg-primary/60 inline-block mr-1.5"></span>há ${minutes} minutos`;

            bubble.classList.remove(
                "translate-y-24",
                "opacity-0",
                "pointer-events-none",
            );

            if (fomoTimeout) clearTimeout(fomoTimeout);

            fomoTimeout = setTimeout(() => {
                hideFomo(false);
            }, 8000);
        }

        function hideFomo(manualClose = false) {
            if (manualClose) {
                forceClosed = true; // Stop showing popups if manually closed
            }
            bubble?.classList.add(
                "translate-y-24",
                "opacity-0",
                "pointer-events-none",
            );
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", () => hideFomo(true));
        }

        // Initial delay
        setTimeout(() => {
            showFomo();
            // Show again every 45 seconds if not force closed
            setInterval(showFomo, 45000);
        }, 12000);
    });
</script>
