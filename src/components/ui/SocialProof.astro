    const popup = document.getElementById("social-proof-popup");
    const messageEl = document.getElementById("sp-message");
    const closeBtn = document.getElementById("sp-close");

    if (popup && messageEl && closeBtn) {
        let timer: any;
        let lastIndex = -1;

        const showPopup = () => {
            let randomIndex;
            // Ensure we have messages
            if (messages.length === 0) messages = allMessages;

            do {
                randomIndex = Math.floor(Math.random() * messages.length);
            } while (randomIndex === lastIndex && messages.length > 1);

            lastIndex = randomIndex;
            const randomMsg = messages[randomIndex];

            messageEl.innerHTML = randomMsg;

            popup.classList.remove("hidden");
            setTimeout(() => popup.classList.add("active"), 100);

            // Auto hide after 6 seconds
            timer = setTimeout(hidePopup, 6000);
        };

        const hidePopup = () => {
            popup.classList.remove("active");
            setTimeout(() => popup.classList.add("hidden"), 500);

            // Wait 6-12 seconds before showing again (more frequent for higher urgency)
            const nextTime = 6000 + Math.random() * 6000;
            setTimeout(showPopup, nextTime);
        };

        closeBtn.addEventListener("click", () => {
            clearTimeout(timer);
            hidePopup();
        });

        // Start the first one after 4 seconds
        setTimeout(showPopup, 4000);
    }
</script>
