---
// BackgroundEffects.astro
---

<div class="background-effects">
  <!-- Gradientes animados -->
  <div class="gradient-orb orb-1"></div>
  <div class="gradient-orb orb-2"></div>
  <div class="gradient-orb orb-3"></div>
  
  <!-- Linhas de grid sutis -->
  <div class="grid-overlay"></div>
  
  <!-- Partículas -->
  <div class="particles-bg"></div>
</div>

<style>
  .background-effects {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Não atrapalha cliques */
    z-index: 0;
    overflow: hidden;
    background: #000;
  }

  /* Esferas de gradiente que se movem */
  .gradient-orb {
    position: absolute;
    width: 60vmax;
    height: 60vmax;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: float-background 20s infinite ease-in-out;
  }

  .orb-1 {
    background: radial-gradient(circle at 30% 30%, #8a1c26, #df2a3a);
    top: -20%;
    left: -10%;
    animation-duration: 25s;
  }

  .orb-2 {
    background: radial-gradient(circle at 70% 70%, #4a0000, #8a1c26);
    bottom: -20%;
    right: -10%;
    animation-duration: 30s;
    animation-delay: -5s;
  }

  .orb-3 {
    background: radial-gradient(circle at 50% 50%, #8a1c26, #000);
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40vmax;
    height: 40vmax;
    opacity: 0.1;
    animation-duration: 35s;
    animation-delay: -2s;
  }

  @keyframes float-background {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(5%, 5%) scale(1.1); }
    66% { transform: translate(-5%, -5%) scale(0.9); }
  }

  /* Grid sobreposto */
  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(circle at 50% 50%, black, transparent 80%);
  }

  .particles-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle at 10% 20%, rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    animation: particleDrift-bg 40s linear infinite;
  }

  @keyframes particleDrift-bg {
    0% { background-position: 0 0; }
    100% { background-position: 40px 40px; }
  }
</style>
