---
/**
 * Premium floating WhatsApp widget with glassmorphism
 * Initially circular on desktop, expands on hover
 */
---

<div
    id="premium-wa-widget"
    class="wa-widget-premium"
    role="button"
    aria-label="Falar no WhatsApp"
>
    <!-- Link overlay -->
    <a
        id="wa-widget-link"
        href="https://wa.me/5521999064502"
        target="_blank"
        rel="noopener noreferrer"
        class="wa-overlay"
        aria-label="Iniciar conversa no WhatsApp"></a>

    <div class="wa-content">
        <!-- Icon Wrapper (Always Visible) -->
        <div class="wa-icon-box">
            <div class="wa-pulse"></div>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="wa-svg"
            >
                <path
                    d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.13 1.2 4.74 1.2 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zM12.05 20.21c-1.5 0-2.97-.39-4.27-1.17l-.3-.18-3.15.83.84-3.07-.19-.31c-.82-1.33-1.26-2.88-1.26-4.43a8.12 8.12 0 0 1 13.85-5.74c1.53 1.53 2.37 3.55 2.37 5.71a8.12 8.12 0 0 1-8.12 8.11zm4.45-6.08c-.24-.12-1.44-0.71-1.66-0.79-.22-.08-.38-.12-.54.12-.17.24-.65.8-0.8.96-.14.16-.29.17-.54.06-.24-.12-1.03-.38-1.95-1.21-.73-.65-1.22-1.45-1.36-1.7-.15-.24-.02-.37.1-.49.1-.1.24-.24.36-.37.11-.12.15-.2.23-.33.08-.13.04-.25-.02-.35-.06-.11-0.54-1.3-0.74-1.79-.2-.48-.41-.42-.54-.42l-.47-.01c-.16 0-.42.06-.64.3-.22.24-0.85.83-0.85 2.02s0.87 2.34 0.99 2.51c.11.16 1.7 2.61 4.14 3.65.57.25 1.02.4 1.37.51.58.19 1.11.16 1.52.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.17-.47-.29z"
                ></path>
            </svg>
        </div>

        <!-- Text Area (Revealed on hover) -->
        <div class="wa-text-area">
            <span class="wa-title">Atendimento Alpha</span>
            <span class="wa-subtitle">Iniciar conversa</span>
        </div>

        <!-- Arrow (Revealed on hover) -->
        <div class="wa-arrow">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
            >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </div>
</div>

<script is:inline>
    (function () {
        const initWA = () => {
            const widget = document.getElementById("premium-wa-widget");
            const link = document.getElementById("wa-widget-link");
            if (!widget || !link) return;

            const path = window.location.pathname;
            let text = "Olá, gostaria de um orçamento para um site.";
            if (path.includes("psicologos"))
                text =
                    "Olá, sou psicólogo e quero lotar minha agenda com um site novo.";
            link.href = `https://wa.me/5521999064502?text=${encodeURIComponent(text)}`;

            const runAnims = () => {
                if (typeof gsap === "undefined") return;
                gsap.to(".wa-pulse", {
                    scale: 2.2,
                    opacity: 0,
                    duration: 2,
                    repeat: -1,
                    ease: "power2.out",
                });
                gsap.to(widget, {
                    y: -5,
                    duration: 2,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            };

            if (typeof gsap === "undefined") {
                const s = document.createElement("script");
                s.src =
                    "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js";
                s.onload = runAnims;
                document.head.appendChild(s);
            } else {
                runAnims();
            }
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initWA);
        } else {
            initWA();
        }
    })();
</script>

<style>
    .wa-widget-premium {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 9999999; /* Max priority */

        display: flex;
        align-items: center;

        /* Glassmorphism Default State (Circular) */
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.1); /* Slightly more visible */
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 60px; /* Pill shape when expanded, circle when small */

        padding: 8px; /* Standard padding for the icon */
        cursor: pointer;
        overflow: hidden; /* This keeps text hidden when collapsed */
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    /* DESKTOP HOVER */
    @media (min-width: 769px) {
        .wa-widget-premium:hover {
            width: 260px;
            padding-right: 20px;
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(37, 211, 102, 0.4);
        }
    }

    .wa-overlay {
        position: absolute;
        inset: 0;
        z-index: 10;
    }

    .wa-content {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 240px; /* Ensures text doesn't wrap and stays in place */
    }

    .wa-icon-box {
        position: relative;
        width: 44px;
        height: 44px;
        background: #25d366;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .wa-svg {
        width: 26px;
        height: 26px;
        z-index: 2;
    }

    .wa-pulse {
        position: absolute;
        inset: 0;
        background: rgba(37, 211, 102, 0.6);
        border-radius: 50%;
        z-index: 1;
    }

    .wa-text-area {
        display: flex;
        flex-direction: column;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .wa-widget-premium:hover .wa-text-area {
        opacity: 1;
    }

    .wa-title {
        color: #25d366;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        line-height: 1;
    }

    .wa-subtitle {
        color: white;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .wa-arrow {
        color: rgba(255, 255, 255, 0.3);
        display: flex;
        opacity: 0;
        margin-left: auto;
        transition: opacity 0.3s ease;
    }

    .wa-widget-premium:hover .wa-arrow {
        opacity: 1;
    }

    .wa-arrow svg {
        width: 16px;
        height: 16px;
    }

    /* Mobile: Always circular */
    @media (max-width: 768px) {
        .wa-widget-premium {
            bottom: 20px;
            right: 20px;
            width: 60px;
            height: 60px;
            padding: 8px;
        }
        .wa-text-area,
        .wa-arrow {
            display: none !important;
        }
    }
</style>
