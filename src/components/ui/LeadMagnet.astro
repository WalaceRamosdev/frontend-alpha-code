---
// src/components/ui/LeadMagnet.astro
---

<div
    class="lead-magnet bg-gradient-to-br from-gray-900 to-black p-8 rounded-3xl border border-primary/20 shadow-2xl relative overflow-hidden group"
>
    <div
        class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 rounded-full blur-3xl group-hover:bg-primary/20 transition-colors duration-700"
    >
    </div>

    <div class="relative z-10 text-center">
        <div
            class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 rounded-2xl mb-6 border border-primary/20"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
            </svg>
        </div>

        <h3
            class="text-2xl font-black text-white mb-4 uppercase tracking-tight"
        >
            MATERIAL GRATUITO
        </h3>
        <p class="text-gray-400 mb-8 leading-relaxed">
            Baixe nosso <strong>Checklist de Conversão 2026</strong>: 12
            elementos obrigatórios que todo site de serviços precisa ter para
            vender todos os dias.
        </p>

        <form class="space-y-4" id="magnet-form">
            <input
                type="email"
                placeholder="Seu melhor e-mail"
                required
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-primary transition-colors"
                id="magnet-email"
            />
            <button
                type="submit"
                class="w-full bg-white text-black font-black py-4 rounded-xl hover:bg-primary hover:text-white transition-all duration-300 transform active:scale-95 shadow-xl"
            >
                QUERO RECEBER O LISTA
            </button>
        </form>

        <p
            class="text-[10px] text-gray-600 mt-6 uppercase tracking-widest font-bold"
        >
            Respeitamos sua privacidade. Spam zero.
        </p>
    </div>
</div>

<script>
    document
        .getElementById("magnet-form")
        ?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const email = (
                document.getElementById("magnet-email") as HTMLInputElement
            ).value;
            const btn = (e.target as HTMLFormElement).querySelector("button");

            if (btn) {
                btn.disabled = true;
                btn.innerText = "ENVIANDO...";

                // Simulação de envio / redirecionamento para material
                setTimeout(() => {
                    btn.innerText = "VERIFICAR E-MAIL!";
                    btn.classList.add("bg-green-500", "text-white");
                    alert(
                        "Obrigado! Enviamos o link para seu e-mail. Verifique também sua caixa de spam.",
                    );
                    // Aqui poderia abrir o PDF ou redirecionar
                    window.open(
                        "https://wa.me/5521999064502?text=Solicitei%20o%20checklist%20pelo%20site%20e%20quero%20um%20diagnostico",
                        "_blank",
                    );
                }, 1000);
            }
        });
</script>
