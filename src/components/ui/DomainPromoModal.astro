---
// DomainPromoModal.astro
---

<div id="domain-promo-modal" class="domain-modal-overlay" style="display: none;">
    <div class="domain-modal-content">
        <button
            id="close-domain-promo"
            class="close-button"
            aria-label="Fechar promoção"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="18" y1="6" x2="6" y2="18"></line><line
                    x1="6"
                    y1="6"
                    x2="18"
                    y2="18"></line></svg
            >
        </button>

        <div class="domain-badge">LANÇAMENTO ALPHA</div>

        <div class="domain-icon-wrapper">
            <span class="globe-icon">🌐</span>
        </div>

        <h2 class="domain-title">Seu Domínio <span class="text-gradient">Profissional</span></h2>
        <p class="domain-subtitle">Garanta sua marca na internet hoje.</p>

        <div class="domain-message">
            Não deixe ninguém registrar sua ideia. Registramos e configuramos seu <strong>.com.br</strong> ou <strong>.com</strong> com gestão completa.
        </div>

        <div class="price-tag">
            <span class="old-price">R$ 97</span>
            <div class="current-price">
                <span class="currency">R$</span> 59 <span class="period">/ano</span>
            </div>
        </div>

        <a href="/pedido?plan=dominio" class="domain-cta">
            RESERVAR AGORA
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                    points="12 5 19 12 12 19"></polyline></svg
            >
        </a>

        <p class="domain-footer">Disponível para todos os clientes.</p>
    </div>
</div>

<style>
    .domain-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(8px);
        z-index: 10001; /* Higher than other modals */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        opacity: 0;
    }

    .domain-modal-content {
        background: linear-gradient(135deg, #0a0a0a 0%, #050505 100%);
        border: 1px solid rgba(6, 182, 212, 0.3);
        border-radius: 24px;
        width: 100%;
        max-width: 400px;
        padding: 40px 30px 30px;
        position: relative;
        text-align: center;
        box-shadow:
            0 25px 60px -12px rgba(0, 0, 0, 0.9),
            0 0 30px rgba(6, 182, 212, 0.2);
    }

    .close-button {
        position: absolute;
        top: 15px;
        right: 15px;
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        padding: 5px;
        transition: 0.3s;
    }

    .close-button:hover {
        color: white;
        transform: rotate(90deg);
    }

    .domain-badge {
        background: rgba(6, 182, 212, 0.1);
        color: #06b6d4;
        display: inline-block;
        padding: 6px 16px;
        font-size: 0.7rem;
        font-weight: 800;
        border-radius: 100px;
        margin-bottom: 20px;
        border: 1px solid rgba(6, 182, 212, 0.2);
    }

    .domain-icon-wrapper {
        font-size: 4rem;
        margin-bottom: 20px;
        filter: drop-shadow(0 0 15px rgba(6, 182, 212, 0.4));
    }

    .domain-title {
        font-size: 2rem;
        font-weight: 900;
        color: #fff;
        margin-bottom: 10px;
        line-height: 1.2;
    }

    .text-gradient {
        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .domain-subtitle {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 15px;
    }

    .domain-message {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .price-tag {
        margin-bottom: 30px;
    }

    .old-price {
        text-decoration: line-through;
        color: rgba(239, 68, 68, 0.5);
        font-size: 1rem;
        display: block;
        margin-bottom: -5px;
    }

    .current-price {
        font-size: 3rem;
        font-weight: 900;
        color: #fff;
    }

    .currency {
        font-size: 1.2rem;
        vertical-align: super;
        margin-right: 4px;
    }

    .period {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .domain-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
        color: white;
        text-decoration: none;
        padding: 16px 30px;
        border-radius: 16px;
        font-weight: 800;
        font-size: 1.1rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 20px rgba(6, 182, 212, 0.3);
    }

    .domain-cta:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 15px 30px rgba(6, 182, 212, 0.5);
    }

    .domain-footer {
        margin-top: 20px;
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.3);
    }
</style>

<script>
    import { gsap } from "gsap";

    function initDomainPromoModal() {
        const modal = document.getElementById("domain-promo-modal");
        const closeBtn = document.getElementById("close-domain-promo");

        const isHomePage =
            window.location.pathname === "/" ||
            window.location.pathname === "/index.html";
        
        const hasBeenShown = sessionStorage.getItem("alpha_domain_promo_shown");

        if (!isHomePage || hasBeenShown) return;

        function showModal() {
            if (!modal) return;

            sessionStorage.setItem("alpha_domain_promo_shown", "true");
            modal.style.display = "flex";

            gsap.to(modal, {
                opacity: 1,
                duration: 0.5,
                ease: "power2.out",
            });

            gsap.from(".domain-modal-content", {
                scale: 0.8,
                y: 50,
                opacity: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
                delay: 0.2,
            });
        }

        if (closeBtn && modal) {
            closeBtn.addEventListener("click", () => {
                gsap.to(modal, {
                    opacity: 0,
                    duration: 0.3,
                    onComplete: () => {
                        modal.style.display = "none";
                    },
                });
            });
        }

        // Show after 6 seconds (after the other promo modal if it exists)
        setTimeout(showModal, 6000);
    }

    document.addEventListener("astro:page-load", initDomainPromoModal);
</script>
