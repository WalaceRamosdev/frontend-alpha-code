---
// src/components/ui/FaqAccordion.astro
import type { NicheContent } from "../../data/niches";

interface Props {
    niche: NicheContent;
}

const { niche } = Astro.props;
---

<div class="faq-container w-full max-w-3xl mx-auto space-y-4">
    {
        niche.faq.map((item, index) => (
            <details class="faq-item group bg-[#111] border border-white/5 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary/30">
                <summary class="flex justify-between items-center p-6 cursor-pointer list-none">
                    <h3 class="text-lg font-bold text-white pr-4">
                        {item.question}
                    </h3>
                    <span class="faq-icon text-primary transition-transform duration-300 group-open:rotate-180">
                        <i class="fas fa-chevron-down" />
                    </span>
                </summary>
                <div class="faq-content p-6 pt-0 text-gray-400 leading-relaxed border-t border-white/5 bg-[#0a0a0a]">
                    {item.answer}
                </div>
            </details>
        ))
    }
</div>

<style>
    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    details[open] {
        border-color: var(--color-primary);
        box-shadow: 0 10px 30px -10px rgba(var(--color-primary-rgb), 0.2);
    }

    .faq-icon {
        color: var(--color-primary);
    }
</style>
