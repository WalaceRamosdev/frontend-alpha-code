---
// src/components/seo/NicheMeta.astro
import { niches } from "../../data/niches";

interface Props {
    slug: string;
}

const { slug } = Astro.props;
const niche = niches.find((n) => n.slug === slug);

if (!niche) return null;

const description = niche.metaFormulas.formula2;
const title = `${niche.title} | Alpha Code`;
const ogImage = `https://www.sitesalphacode.com.br/assets/og-image-3d.webp`;
const pageUrl = `https://www.sitesalphacode.com.br/solucoes/${slug}`;
---

<meta property="og:title" content={title} slot="head" />
<meta property="og:description" content={description} slot="head" />
<meta property="og:image" content={ogImage} slot="head" />
<meta property="og:url" content={pageUrl} slot="head" />
<meta property="og:type" content="website" slot="head" />
<meta property="og:site_name" content="Alpha Code" slot="head" />
<meta name="twitter:title" content={title} slot="head" />
<meta name="twitter:description" content={description} slot="head" />
<meta name="twitter:image" content={ogImage} slot="head" />
<meta name="twitter:card" content="summary_large_image" slot="head" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" slot="head" />
<meta name="author" content="Alpha Code" slot="head" />
