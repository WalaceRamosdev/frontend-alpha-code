---
interface Props {
    type?:
        | "Organization"
        | "WebSite"
        | "ProfessionalService"
        | "Article"
        | "Service";
    name?: string;
    description?: string;
    url?: string;
    image?: string;
    sameAs?: string[];
    priceRange?: string;
    providerName?: string;
    faqItems?: { question: string; answer: string }[];
}

const {
    type = "ProfessionalService",
    name = "Alpha Code",
    description = "Criação de sites profissionais para psicólogos, terapeutas, advogados e saúde. Aumente sua autoridade e converta mais pacientes.",
    url = "https://www.sitesalphacode.com.br",
    image = "https://www.sitesalphacode.com.br/assets/logo.svg",
    sameAs = [
        "https://www.instagram.com/alphacodesites/",
        "https://www.linkedin.com/company/alphacode",
    ],
    priceRange = "$$",
    providerName = "Alpha Code",
    faqItems = [],
} = Astro.props;

let schema = {};

if (type === "Service") {
    schema = {
        "@context": "https://schema.org",
        "@type": "Service",
        serviceType: name,
        provider: {
            "@type": "LocalBusiness",
            name: providerName,
            image: image,
            url: url,
            address: {
                "@type": "PostalAddress",
                addressLocality: "Rio de Janeiro",
                addressRegion: "RJ",
                addressCountry: "BR",
            },
        },
        description: description,
        areaServed: "BR",
        hasOfferCatalog: {
            "@type": "OfferCatalog",
            name: "Serviços Digitais",
            itemListElement: [
                {
                    "@type": "Offer",
                    itemOffered: {
                        "@type": "Service",
                        name: name,
                    },
                },
            ],
        },
    };
} else if (type === "ProfessionalService" || type === "Organization") {
    schema = {
        "@context": "https://schema.org",
        "@type":
            type === "Organization" ? "Organization" : "ProfessionalService",
        name: name,
        url: url,
        logo: image,
        image: image,
        description: description,
        address: {
            "@type": "PostalAddress",
            addressLocality: "Rio de Janeiro",
            addressRegion: "RJ",
            addressCountry: "BR",
        },
        areaServed: [
            "Brasília - DF",
            "Rio de Janeiro - RJ",
            "São Paulo - SP",
            "Brasil",
        ],
        telephone: "+5521999064502",
        priceRange: priceRange,
        openingHoursSpecification: [
            {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: [
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday",
                ],
                opens: "09:00",
                closes: "18:00",
            },
        ],
        sameAs: sameAs,
    };
} else if (type === "Article") {
    schema = {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: name,
        description: description,
        image: image,
        author: {
            "@type": "Person",
            name: "Walace Ramos",
        },
        publisher: {
            "@type": "Organization",
            name: "Alpha Code",
            logo: {
                "@type": "ImageObject",
                url: "https://www.sitesalphacode.com.br/assets/logo.svg",
            },
        },
        datePublished: new Date().toISOString(),
    };
} else if (faqItems && faqItems.length > 0) {
    schema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
            },
        })),
    };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
