---

<nav class="blog-header" id="blog-header">
    <div class="container blog-header-container">
        <div class="header-left">
            <a href="/" class="blog-logo">
                <img loading="lazy"
                    src="/assets/logo-header.svg"
                    alt="Alpha Code Logo"
                    width="140"
                    height="22"
                />
            </a>
            <div class="nav-divider"></div>
            <a href="/blog" class="insights-brand">Insights</a>
        </div>

        <div class="blog-nav-actions">
            <a href="/" class="back-link">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
                <span>Site Principal</span>
            </a>
            <a
                href="https://wa.me/5521999064502"
                target="_blank"
                class="premium-cta"
            >
                Consultoria
            </a>
        </div>
    </div>
</nav>

<style>
    .blog-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 72px;
        background: rgba(2, 2, 2, 0.75);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        z-index: 1000;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .blog-header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 40px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .blog-logo img {
        height: 35px;
        width: auto;
        display: block;
        transition: transform 0.3s ease;
    }

    .blog-logo:hover img {
        transform: scale(1.05);
    }

    .nav-divider {
        width: 1px;
        height: 20px;
        background: rgba(255, 255, 255, 0.15);
    }

    .insights-brand {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
    }

    .blog-nav-actions {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .back-link {
        display: flex;
        align-items: center;
        gap: 6px;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .back-link:hover {
        color: #fff;
    }

    .back-link svg {
        transition: transform 0.3s ease;
    }

    .back-link:hover svg {
        transform: translateX(-4px);
    }

    .premium-cta {
        background: #fff;
        color: #000;
        padding: 10px 24px;
        border-radius: 100px;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
    }

    .premium-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(255, 255, 255, 0.2);
        background: #f0f0f0;
    }

    /* Scroll State */
    .blog-header.scrolled {
        height: 60px;
        border-color: rgba(255, 255, 255, 0.15);
        background: rgba(2, 2, 2, 0.9);
    }

    @media (max-width: 768px) {
        .blog-header {
            height: 64px;
        }
        .blog-header-container {
            padding: 0 20px;
        }
        .nav-divider,
        .insights-brand,
        .back-link span {
            display: none;
        }
        .header-left {
            gap: 0;
        }
        .blog-nav-actions {
            gap: 16px;
        }
        .premium-cta {
            padding: 8px 16px;
            font-size: 0.8rem;
        }
    }
</style>

<script>
    const header = document.getElementById("blog-header");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 20) {
            header?.classList.add("scrolled");
        } else {
            header?.classList.remove("scrolled");
        }
    });
</script>
