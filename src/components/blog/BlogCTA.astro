---
interface Props {
    type?: "topo" | "meio" | "fundo";
    customTitle?: string;
    customText?: string;
    customLink?: string;
    customLabel?: string;
}

const {
    type = "fundo",
    customTitle,
    customText,
    customLink,
    customLabel,
} = Astro.props;

const templates = {
    topo: {
        title: "Quer entender melhor como um site profissional pode ajudar psicólogos?",
        text: "Leia nosso guia completo sobre presença digital ética.",
        link: "/blog",
        label: "Ver guia de presença digital",
        variant: "topo",
    },
    meio: {
        title: "Já pensou se o seu site estivesse trazendo pacientes de forma constante?",
        text: "Solicite uma análise gratuita e veja o que pode ser melhorado.",
        link: "https://wa.me/5521999064502?text=Olá, gostaria de uma análise gratuita do meu site/projeto.",
        label: "Solicitar análise gratuita",
        variant: "meio",
    },
    fundo: {
        title: "Pronto para ter um site profissional, rápido e alinhado às normas do CFP?",
        text: "Fale com a Alpha Code e receba uma proposta personalizada.",
        link: "https://wa.me/5521999064502",
        label: "Receber proposta personalizada",
        variant: "fundo",
    },
};

const active = templates[type];
const finalTitle = customTitle || active.title;
const finalText = customText || active.text;
const finalLink = customLink || active.link;
const finalLabel = customLabel || active.label;
---

<section class={`blog-cta-container cta-variant-${type}`}>
    <div class="cta-glass-card">
        <div class="cta-badge">
            {
                type === "topo"
                    ? "Dica Alpha"
                    : type === "meio"
                      ? "Oportunidade"
                      : "Próximo Passo"
            }
        </div>
        <h2 class="cta-title">{finalTitle}</h2>
        <p class="cta-text">{finalText}</p>
        <div class="cta-action-wrapper">
            <a
                href={finalLink}
                class="cta-button"
                target={finalLink.startsWith("http") ? "_blank" : "_self"}
                rel={finalLink.startsWith("http") ? "noopener noreferrer" : ""}
            >
                {finalLabel}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                        points="12 5 19 12 12 19"></polyline></svg
                >
            </a>
        </div>
    </div>
</section>

<style>
    .blog-cta-container {
        margin: 80px 0;
        position: relative;
    }

    .cta-glass-card {
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 32px;
        text-align: center;
        overflow: hidden;
        position: relative;
        transition: all 0.4s ease;
    }

    .cta-variant-fundo .cta-glass-card {
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.03) 0%,
            rgba(214, 40, 57, 0.05) 100%
        );
        border-color: rgba(214, 40, 57, 0.1);
    }

    .cta-badge {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 24px;
    }

    .cta-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        line-height: 1.2;
        color: #fff;
        margin-bottom: 16px;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .cta-text {
        font-size: 1.125rem;
        color: #888;
        margin-bottom: 32px;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        color: #000;
        padding: 16px 32px;
        border-radius: 100px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .cta-variant-fundo .cta-button {
        background: #fff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .cta-button:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 20px 40px rgba(255, 255, 255, 0.1);
    }

    .cta-button svg {
        transition: transform 0.3s;
    }

    .cta-button:hover svg {
        transform: translateX(5px);
    }

    @media (max-width: 768px) {
        .cta-glass-card {
            padding: 40px 24px;
        }
    }
</style>
