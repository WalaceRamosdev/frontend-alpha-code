---
interface Props {
    activePage:
        | "dashboard"
        | "financial"
        | "projects"
        | "maintenance"
        | "store"
        | "users"
        | "contracts"
        | "profile";
    isAdmin?: boolean;
}

const { activePage, isAdmin = false } = Astro.props;
---

<aside class="sidebar">
    <div class="sidebar-logo">
        <img loading="lazy" src="/assets/logo3d.svg" alt="Alpha Code" class="mini-logo" />
    </div>
    <nav class="sidebar-nav">
        <a
            href="/dashboard"
            class={`nav-item ${activePage === "dashboard" ? "active" : ""}`}
            title="Dashboard"
        >
            <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
            <span class="nav-label">Dashboard</span>
        </a>

        {
            isAdmin ? (
                <>
                    <a
                        href="/"
                        class="nav-item back-to-site"
                        title="Voltar ao Site"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-house-user" />
                        </span>
                        <span class="nav-label">Home</span>
                    </a>

                    <a
                        href="/admin/contracts"
                        class={`nav-item ${activePage === "contracts" ? "active" : ""}`}
                        title="Gerar Contratos"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-file-contract" />
                        </span>
                        <span class="nav-label">Contratos</span>
                    </a>

                    <a
                        href="/admin/financial/custom-payment"
                        class={`nav-item ${activePage === "financial" ? "active" : ""}`}
                        title="Links de Pagamento"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-credit-card" />
                        </span>
                        <span class="nav-label">Pagamentos</span>
                    </a>
                </>
            ) : (
                <>
                    <a
                        href="/pedido?plan=manutencao"
                        class={`nav-item ${activePage === "maintenance" ? "active" : ""}`}
                        title="Solicitar Manutenção"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-screwdriver-wrench" />
                        </span>
                        <span class="nav-label">Manutenção</span>
                    </a>

                    <a
                        href="/loja"
                        class={`nav-item ${activePage === "store" ? "active" : ""}`}
                        title="Alpha Store"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-store" />
                        </span>
                        <span class="nav-label">Loja</span>
                    </a>

                    <a
                        href="/"
                        class="nav-item back-to-site"
                        title="Voltar ao Site"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-house-user" />
                        </span>
                        <span class="nav-label">Home</span>
                    </a>

                    <a
                        href="/faturas"
                        class={`nav-item ${activePage === "financial" ? "active" : ""}`}
                        title="Minhas Faturas"
                    >
                        <span class="nav-icon">
                            <i class="fas fa-file-invoice-dollar" />
                        </span>
                        <span class="nav-label">Faturas</span>
                    </a>

                    <a href="/perfil" class="nav-item" title="Meu Perfil">
                        <span class="nav-icon">
                            <i class="fas fa-user-circle" />
                        </span>
                        <span class="nav-label">Perfil</span>
                    </a>
                </>
            )
        }
    </nav>
</aside>

<style>
    .sidebar {
        width: 80px;
        background: #0d0d0d;
        padding: 20px 10px;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: width 0.3s ease;
        min-height: 100vh;
        z-index: 10;
        flex-shrink: 0;
    }

    @media (hover: hover) {
        .sidebar:hover {
            width: 240px;
        }
    }

    .sidebar-logo {
        width: 100%;
        display: flex;
        justify-content: center;
        margin-bottom: 30px;
    }

    .mini-logo {
        width: 40px;
        height: 40px;
        object-fit: contain;
    }

    .sidebar-nav {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        justify-content: center; /* Center icons by default */
        padding: 12px;
        color: #888;
        text-decoration: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        white-space: nowrap;
        overflow: hidden;
    }

    .nav-icon {
        font-size: 1.4rem;
        min-width: 40px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .nav-label {
        opacity: 0;
        max-width: 0;
        margin-left: 0;
        overflow: hidden;
        transition: all 0.3s ease;
        font-weight: 500;
        transform: translateX(-10px);
    }

    @media (hover: hover) {
        .sidebar:hover .nav-label {
            opacity: 1;
            max-width: 150px;
            margin-left: 10px;
            transform: translateX(0);
        }

        .sidebar:hover .nav-item {
            justify-content: flex-start; /* Left align on expand */
        }
    }

    .nav-item.active {
        background: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
        border-left: 3px solid #e74c3c;
    }

    @media (hover: hover) {
        .nav-item:hover {
            background: rgba(231, 76, 60, 0.1);
            color: #e74c3c;
        }
    }

    .back-to-site {
        margin: 10px 0;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    @media (hover: hover) {
        .back-to-site:hover {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(255, 255, 255, 0.2);
        }
    }

    @media (max-width: 768px) {
        .sidebar {
            width: 100% !important;
            height: 75px;
            min-height: auto;
            position: fixed;
            bottom: 0;
            top: auto;
            left: 0;
            flex-direction: row;
            justify-content: space-around;
            align-items: center;
            padding: 0 5px;
            border-right: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }
        .sidebar-logo,
        .nav-label {
            display: none !important;
        }
        .sidebar-nav {
            flex-direction: row;
            justify-content: space-around;
            align-items: center;
            width: 100%;
            height: 100%;
            gap: 0;
            margin: 0;
        }
        .nav-item {
            padding: 0;
            height: 100%;
            border-radius: 0;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border-left: none !important;
            background: transparent !important;
            transition: none !important;
        }
        .nav-item.active {
            color: #e74c3c;
            position: relative;
        }
        .nav-item.active::after {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 3px;
            background: #e74c3c;
            border-radius: 0 0 4px 4px;
            box-shadow: 0 2px 10px rgba(231, 76, 60, 0.5);
        }
        .nav-icon {
            font-size: 1.25rem;
            margin: 0;
        }
        .back-to-site {
            margin: 0;
            background: none;
            border: none;
        }
    }
</style>
