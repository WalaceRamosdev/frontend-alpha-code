---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { createSEOMeta } from "../utils/seo";
import SchemaMarkup from "../components/seo/SchemaMarkup.astro";
import SocialProof from "../components/ui/SocialProof.astro";
import PromoModal from "../components/ui/PromoModal.astro";
import PremiumWhatsapp from "../components/ui/PremiumWhatsapp.astro";
import { ViewTransitions } from "astro:transitions";
import FomoBubble from "../components/ui/FomoBubble.astro";
import "../styles/variables.css";
import "../styles/utilities.css";
import "../styles/global.css";
import "../styles/focus.css";

interface Props {
    title: string;
    description?: string;
    canonicalUrl?: string;
    ogImage?: string;
    keywords?: string[];
    noIndex?: boolean;
    showWhatsApp?: boolean;
    showHeader?: boolean;
    showFooter?: boolean;
    showSocialProof?: boolean;
    schemaType?:
        | "Organization"
        | "WebSite"
        | "ProfessionalService"
        | "Article"
        | "Service"
        | "LocalBusiness";
    schemaName?: string;
    schemaDescription?: string;
    faqItems?: { question: string; answer: string }[];
}

const {
    title,
    description,
    canonicalUrl = Astro.url.href,
    ogImage = "/assets/og-image-3d.jpg",
    keywords = [],
    noIndex = false,
    showWhatsApp = true,
    showHeader = true,
    showFooter = true,
    showSocialProof = false,
    schemaType = "ProfessionalService",
    schemaName,
    schemaDescription,
    faqItems = [],
} = Astro.props;

const serveLocations = [
    "Brasília - DF",
    "Rio de Janeiro - RJ",
    "Moema - SP",
    "Jardins - SP",
    "Brooklin - SP",
    "Bela Vista - SP",
    "Centro - RJ",
    "Itaim Bibi - SP",
    "Leblon - RJ",
    "Tijuca - RJ",
    "Ipanema - RJ",
    "Santo Amaro - SP",
    "Botafogo - RJ",
    "Vila Mariana - SP",
    "Vila Olímpia - SP",
    "Cerqueira César - SP",
    "Copacabana - RJ",
    "Zona Sul de São Paulo",
];

const absoluteOgImage = typeof ogImage === 'string' && ogImage.startsWith('http') 
    ? ogImage 
    : new URL(ogImage || "/assets/og-image-3d.jpg", Astro.site || Astro.url).href;

const seo = createSEOMeta({
    title, // Removing the pipe here since utility already adds it
    description,
    canonicalUrl,
    ogImage: absoluteOgImage,
    keywords: [...keywords, ...serveLocations],
});
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <!-- Google Tag Manager -->
        <script type="text/partytown">
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    "gtm.start": new Date().getTime(),
                    event: "gtm.js",
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-T98FLHVM");
        </script>
        <!-- End Google Tag Manager -->

        <!-- Google tag (gtag.js) -->
        <script
            type="text/partytown"
            src="https://www.googletagmanager.com/gtag/js?id=AW-17948194634"
        ></script>
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "AW-17948194634");
        </script>
        <meta charset="UTF-8" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <meta name="generator" content={Astro.generator} />
        {noIndex && <meta name="robots" content="noindex, nofollow" />}

        <!-- SEO -->
        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <link rel="canonical" href={seo.canonical} />
        <meta name="keywords" content={seo.keywords} />
        <meta name="author" content="Alpha Code" />
        <meta
            name="google-site-verification"
            content="google74f5360f54ab2c1a"
        />

        <!-- Open Graph -->
        <meta property="og:title" content={seo["og:title"]} />
        <meta property="og:description" content={seo["og:description"]} />
        <meta property="og:type" content={seo["og:type"]} />
        <meta property="og:url" content={seo["og:url"]} />
        <meta property="og:image" content={seo["og:image"]} />
        <meta property="og:locale" content={seo["og:locale"]} />

        <!-- Twitter -->
        <meta name="twitter:card" content={seo["twitter:card"]} />
        <meta name="twitter:creator" content={seo["twitter:creator"]} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <!-- Font Awesome -->
        <link
            rel="preload"
            as="style"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            media="print"
            onload="this.media='all'"
        />
        <style is:global>
            /* Optimization: Font-display swap for Font Awesome to avoid "invisible text" during load */
            @font-face {
                font-family: "Font Awesome 6 Free";
                font-display: swap;
            }
            @font-face {
                font-family: "Font Awesome 6 Brands";
                font-display: swap;
            }
        </style>
        <noscript>
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            />
            <link
                href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <meta name="geo.region" content="BR" />
        <meta name="geo.placename" content="Brasil" />
        <meta name="geo.position" content="-23.55052;-46.633309" />
        <meta name="ICBM" content="-23.55052, -46.633309" />
        <meta
            name="DC.coverage"
            content="Brasília, Rio de Janeiro, São Paulo, Brasil"
        />

        <SchemaMarkup
            type={schemaType as any}
            name={schemaName || title}
            description={schemaDescription || description}
            faqItems={faqItems}
        />

        {noIndex && <meta name="robots" content="noindex, nofollow" />}
        {!noIndex && <meta name="robots" content={seo.robots} />}

        <ViewTransitions />
        <slot name="head" />
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-T98FLHVM"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->
        <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
            Pular para conteúdo principal
        </a>

        {showHeader && <Header />}

        <main id="main-content">
            <slot />
        </main>

        {showFooter && <Footer />}

        {showWhatsApp && <PremiumWhatsapp />}

        <!-- Social Proof Popup -->
        {showSocialProof && <SocialProof />}

        <!-- Promotional Modal -->
        <PromoModal />

        <!-- Toast Notification Container -->
        <div id="toast-container" class="toast-container"></div>
        <FomoBubble />
        <slot name="scripts" />

        <script>
            // Capture referral code if present in URL
            const urlParams = new URLSearchParams(window.location.search);
            const ref = urlParams.get("ref");
            if (ref) {
                localStorage.setItem("alpha_ref_code", ref);
                console.log("Referral code captured:", ref);
            }

            import { ScrollTrigger } from "gsap/ScrollTrigger";
            // Globally disable markers
            ScrollTrigger.config({ limitCallbacks: true });
            ScrollTrigger.defaults({ markers: false });

            // Global ShowToast function
            (window as any).showToast = function (
                message: string,
                type: "success" | "error" = "success",
            ) {
                const container = document.getElementById("toast-container");
                if (!container) return;

                const toast = document.createElement("div");
                toast.className = `toast-item ${type}`;
                toast.innerHTML = `
                    <div class="toast-content">
                        ${type === "success" ? "✅" : "❌"}
                        <span>${message}</span>
                    </div>
                `;

                container.appendChild(toast);

                // Auto remove
                setTimeout(() => {
                    toast.classList.add("fade-out");
                    setTimeout(() => toast.remove(), 500);
                }, 3000);
            };
        </script>
    </body>
</html>

<style>
    .skip-link {
        background: var(--color-primary);
        color: white;
        padding: 8px;
        z-index: 9999;
    }
    /* Toast Styles */
    .toast-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: 15px;
        pointer-events: none;
        width: 100%;
        max-width: 420px;
        align-items: center;
    }

    .toast-item {
        background: #0a0a0a;
        border: 2px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        padding: 22px 30px;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        gap: 16px;
        animation: toastPopup 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
        pointer-events: auto;
        text-align: center;
        width: 90%;
    }

    .toast-item.success {
        border: 2px solid #10b981;
        background: #062016;
    }

    .toast-item.error {
        border: 2px solid #ef4444;
        background: #2d0a0a;
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.2);
    }

    .toast-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-size: 1.15rem;
        font-weight: 700;
        width: 100%;
    }

    @keyframes toastPopup {
        from {
            transform: scale(0.7) translateY(30px);
            opacity: 0;
        }
        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .toast-item.fade-out {
        opacity: 0;
        transform: scale(0.9);
        transition: 0.4s;
    }
</style>
