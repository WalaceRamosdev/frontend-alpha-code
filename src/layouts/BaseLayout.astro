---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { createSEOMeta } from "../utils/seo";
import SchemaMarkup from "../components/seo/SchemaMarkup.astro";
import SocialProof from "../components/ui/SocialProof.astro";
import PromoModal from "../components/ui/PromoModal.astro";
import PremiumWhatsapp from "../components/ui/PremiumWhatsapp.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    canonicalUrl?: string;
    ogImage?: string;
    keywords?: string[];
    noIndex?: boolean;
    showWhatsApp?: boolean;
    showHeader?: boolean;
    showFooter?: boolean;
    showSocialProof?: boolean;
}

const {
    title,
    description,
    canonicalUrl = Astro.url.href,
    ogImage = "/assets/logo.svg",
    keywords = [],
    noIndex = false,
    showWhatsApp = true,
    showHeader = true,
    showFooter = true,
    showSocialProof = false,
} = Astro.props;

// Get Pixel ID safely from env or fallback
const PIXEL_ID = (import.meta.env.META_PIXEL_ID ?? "4112004805778911")
    .replace(/["']/g, "")
    .trim();

const serveLocations = [
    "Brasília - DF",
    "Rio de Janeiro - RJ",
    "Moema - SP",
    "Jardins - SP",
    "Brooklin - SP",
    "Bela Vista - SP",
    "Centro - RJ",
    "Itaim Bibi - SP",
    "Leblon - RJ",
    "Tijuca - RJ",
    "Ipanema - RJ",
    "Santo Amaro - SP",
    "Botafogo - RJ",
    "Vila Mariana - SP",
    "Vila Olímpia - SP",
    "Cerqueira César - SP",
    "Copacabana - RJ",
    "Zona Sul de São Paulo",
];

const seo = createSEOMeta({
    title, // Removing the pipe here since utility already adds it
    description,
    canonicalUrl,
    ogImage,
    keywords: [...keywords, ...serveLocations],
});
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Google tag (gtag.js) - Optimized Loading -->
        <script is:inline define:vars={{ PIXEL_ID }}>
            // Optimize GTM loading
            function loadGTM() {
                if (window.gtmLoaded) return;
                window.gtmLoaded = true;

                const script = document.createElement("script");
                script.async = true;
                script.src =
                    "https://www.googletagmanager.com/gtag/js?id=G-Z1TRD8DK7P";
                document.head.appendChild(script);

                window.dataLayer = window.dataLayer || [];
                function gtag() {
                    dataLayer.push(arguments);
                }
                gtag("js", new Date());
                gtag("config", "G-Z1TRD8DK7P", {
                    page_path: window.location.pathname,
                });
            }

            // Meta Pixel Loading
            function loadMetaPixel() {
                if (window.fbLoaded) return;
                window.fbLoaded = true;

                !(function (f, b, e, v, n, t, s) {
                    if (f.fbq) return;
                    n = f.fbq = function () {
                        n.callMethod
                            ? n.callMethod.apply(n, arguments)
                            : n.queue.push(arguments);
                    };
                    if (!f._fbq) f._fbq = n;
                    n.push = n;
                    n.loaded = !0;
                    n.version = "2.0";
                    n.queue = [];
                    t = b.createElement(e);
                    t.async = !0;
                    t.src = v;
                    s = b.getElementsByTagName(e)[0];
                    s.parentNode.insertBefore(t, s);
                })(
                    window,
                    document,
                    "script",
                    "https://connect.facebook.net/en_US/fbevents.js",
                );

                fbq("init", PIXEL_ID);
                fbq("track", "PageView");
            }

            // Safe CAPI Call (Non-blocking)
            const sendCAPI = async (
                eventName = "PageView",
                customData = {},
            ) => {
                try {
                    await fetch("/api/events", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            event_name: eventName,
                            event_source_url: window.location.href,
                            user_data: {
                                client_user_agent: navigator.userAgent,
                            },
                            custom_data: customData,
                        }),
                    });
                } catch (e) {
                    console.warn("CAPI silent fail:", e);
                }
            };

            // Load trackers after 3.5s or on user interaction
            const loadTrackers = () => {
                if (window.trackersLoaded) return;
                window.trackersLoaded = true;

                loadGTM();
                loadMetaPixel();
                sendCAPI("PageView"); // Send server-side event
            };

            const trackerTimer = setTimeout(loadTrackers, 3500);
            ["touchstart", "mousemove", "scroll", "keydown"].forEach(
                (event) => {
                    window.addEventListener(event, loadTrackers, {
                        once: true,
                        passive: true,
                    });
                },
            );
        </script>

        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <meta name="generator" content={Astro.generator} />
        {noIndex && <meta name="robots" content="noindex, nofollow" />}

        <!-- SEO -->
        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <link rel="canonical" href={seo.canonical} />
        <meta name="keywords" content={seo.keywords} />
        <meta name="author" content="Alpha Code" />
        <meta
            name="google-site-verification"
            content="google74f5360f54ab2c1a"
        />
        <meta name="google-adsense-account" content="ca-pub-3382063594917016" />

        <!-- Open Graph -->
        <meta property="og:title" content={seo["og:title"]} />
        <meta property="og:description" content={seo["og:description"]} />
        <meta property="og:type" content={seo["og:type"]} />
        <meta property="og:url" content={seo["og:url"]} />
        <meta property="og:image" content={seo["og:image"]} />
        <meta property="og:locale" content={seo["og:locale"]} />

        <!-- Twitter -->
        <meta name="twitter:card" content={seo["twitter:card"]} />
        <meta name="twitter:creator" content={seo["twitter:creator"]} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <!-- Preload critical fonts -->
        <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800&family=Plus+Jakarta+Sans:wght@400;700&display=swap"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <meta name="geo.region" content="BR" />
        <meta name="geo.placename" content="Brasil" />
        <meta name="geo.position" content="-23.55052;-46.633309" />
        <meta name="ICBM" content="-23.55052, -46.633309" />
        <meta
            name="DC.coverage"
            content="Brasília, Rio de Janeiro, São Paulo, Brasil"
        />

        <SchemaMarkup />

        {noIndex && <meta name="robots" content="noindex, nofollow" />}
        {!noIndex && <meta name="robots" content={seo.robots} />}
    </head>
    <body>
        <noscript>
            <img
                height="1"
                width="1"
                style="display:none"
                src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}
            />
        </noscript>
        <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
            Pular para conteúdo principal
        </a>

        {showHeader && <Header />}

        <main id="main-content">
            <slot />
        </main>

        {showFooter && <Footer />}

        {showWhatsApp && <PremiumWhatsapp />}

        <!-- Social Proof Popup -->
        {showSocialProof && <SocialProof />}

        <!-- Promotional Modal -->
        <PromoModal />

        <!-- Toast Notification Container -->
        <div id="toast-container" class="toast-container"></div>

        <slot name="scripts" />
        <script is:inline>
            // Utility to get cookies
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(";").shift();
            }

            // Expose sendCAPI to window for inline usage if needed, or define locally if scoping allows.
            // Since sendCAPI is defined in the previous module script which might be scoped,
            // we'll redefine a robust sender here that uses the same endpoint.
            const triggerCAPI = async (eventName, eventId) => {
                try {
                    const fbc = getCookie("_fbc");
                    const fbp = getCookie("_fbp");

                    await fetch("/api/events", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            event_name: eventName,
                            event_id: eventId,
                            event_source_url: window.location.href,
                            user_data: {
                                client_user_agent: navigator.userAgent,
                                fbc: fbc,
                                fbp: fbp,
                            },
                        }),
                    });
                    console.log(`CAPI ${eventName} sent (ID: ${eventId})`);
                } catch (e) {
                    console.warn("CAPI fail", e);
                }
            };

            // Generate unique event ID
            const generateEventId = () => {
                return `evt_${Date.now()}_${Math.floor(Math.random() * 1000)}`;
            };

            // GA4 + Meta Pixel + CAPI Conversion Tracking
            document.addEventListener("click", function (e) {
                // WhatsApp Tracking
                const waLink = e.target.closest('a[href*="wa.me"]');
                if (waLink) {
                    const eventID = generateEventId();

                    // 1. Google Analytics
                    if (window.gtag) {
                        gtag("event", "conversion", {
                            send_to: "G-Z1TRD8DK7P",
                            event_category: "Engagement",
                            event_label: "WhatsApp Click",
                            value: 1,
                            transaction_id: eventID, // Syncing ID if possible
                        });
                    }
                    // 2. Meta Pixel (Browser)
                    if (window.fbq) {
                        fbq("track", "Contact", {}, { eventID: eventID }); // Using 'Contact' for WhatsApp with ID
                    }
                    // 3. Meta CAPI (Server)
                    triggerCAPI("Contact", eventID);

                    console.log(
                        "WA Click Tracked (GA4 + Pixel + CAPI) - ID: " +
                            eventID,
                    );
                }
            });

            // Form Submit Tracking
            document.addEventListener("submit", function (e) {
                const eventID = generateEventId();

                // 1. Google Analytics
                if (window.gtag) {
                    gtag("event", "conversion", {
                        send_to: "G-Z1TRD8DK7P",
                        event_category: "Lead",
                        event_label: "Form Submission",
                        value: 1,
                        transaction_id: eventID,
                    });
                }
                // 2. Meta Pixel (Browser)
                if (window.fbq) {
                    fbq("track", "Lead", {}, { eventID: eventID }); // Using 'Lead' for Forms with ID
                }
                // 3. Meta CAPI (Server)
                triggerCAPI("Lead", eventID);

                console.log(
                    "Form Submit Tracked (GA4 + Pixel + CAPI) - ID: " + eventID,
                );
            });
        </script>
        <script>
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            // Globally disable markers
            ScrollTrigger.config({ limitCallbacks: true });
            ScrollTrigger.defaults({ markers: false });

            // Global ShowToast function
            (window as any).showToast = function (
                message: string,
                type: "success" | "error" = "success",
            ) {
                const container = document.getElementById("toast-container");
                if (!container) return;

                const toast = document.createElement("div");
                toast.className = `toast-item ${type}`;
                toast.innerHTML = `
                    <div class="toast-content">
                        ${type === "success" ? "✅" : "❌"}
                        <span>${message}</span>
                    </div>
                `;

                container.appendChild(toast);

                // Auto remove
                setTimeout(() => {
                    toast.classList.add("fade-out");
                    setTimeout(() => toast.remove(), 500);
                }, 3000);
            };
        </script>
    </body>
</html>

<style>
    .skip-link {
        background: var(--color-primary);
        color: white;
        padding: 8px;
        z-index: 9999;
    }
    /* Toast Styles */
    .toast-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: 15px;
        pointer-events: none;
        width: 100%;
        max-width: 420px;
        align-items: center;
    }

    .toast-item {
        background: #0a0a0a;
        border: 2px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        padding: 22px 30px;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        gap: 16px;
        animation: toastPopup 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
        pointer-events: auto;
        text-align: center;
        width: 90%;
    }

    .toast-item.success {
        border: 2px solid #10b981;
        background: #062016;
    }

    .toast-item.error {
        border: 2px solid #ef4444;
        background: #2d0a0a;
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.2);
    }

    .toast-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-size: 1.15rem;
        font-weight: 700;
        width: 100%;
    }

    @keyframes toastPopup {
        from {
            transform: scale(0.7) translateY(30px);
            opacity: 0;
        }
        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .toast-item.fade-out {
        opacity: 0;
        transform: scale(0.9);
        transition: 0.4s;
    }
</style>
