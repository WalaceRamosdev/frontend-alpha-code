---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { createSEOMeta } from "../utils/seo";
import SchemaMarkup from "../components/seo/SchemaMarkup.astro";
import SocialProof from "../components/ui/SocialProof.astro";
import PromoModal from "../components/ui/PromoModal.astro";
import PremiumWhatsapp from "../components/ui/PremiumWhatsapp.astro";
import { ViewTransitions } from "astro:transitions";
import FomoBubble from "../components/ui/FomoBubble.astro";
import "../styles/variables.css";
import "../styles/utilities.css";
import "../styles/global.css";
import "../styles/focus.css";

interface Props {
    title: string;
    description?: string;
    canonicalUrl?: string;
    ogImage?: string;
    keywords?: string[];
    noIndex?: boolean;
    showWhatsApp?: boolean;
    showHeader?: boolean;
    showFooter?: boolean;
    showSocialProof?: boolean;
    showFomoBubble?: boolean;
    /** Imagem LCP crítica da página (opcional — tem fallback) */
    lcpImage?: string;
    schemaType?:
        | "Organization"
        | "WebSite"
        | "ProfessionalService"
        | "Article"
        | "Service"
        | "LocalBusiness";
    schemaName?: string;
    schemaDescription?: string;
    faqItems?: { question: string; answer: string }[];
}

const {
    title,
    description,
    canonicalUrl,
    ogImage = "/assets/og-image-3d.webp",
    keywords = [],
    noIndex = false,
    showWhatsApp = true,
    showHeader = true,
    showFooter = true,
    showSocialProof = false,
    showFomoBubble = false,
    schemaType = "ProfessionalService",
    schemaName,
    schemaDescription,
    faqItems = [],
} = Astro.props;

// Canonical: sempre derivado do pathname, sem query string e sem hash
const finalCanonicalUrl = canonicalUrl
    ? canonicalUrl
    : new URL(Astro.url.pathname, Astro.site || Astro.url).href;

const absoluteOgImage = typeof ogImage === 'string' && ogImage.startsWith('http')
    ? ogImage
    : new URL(ogImage || "/assets/og-image-3d.webp", Astro.site || Astro.url).href;

const seo = createSEOMeta({
    title,
    description,
    canonicalUrl: finalCanonicalUrl,
    ogImage: absoluteOgImage,
    keywords,
});
---

<!doctype html>
<html lang="pt-BR" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <slot name="head" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <!-- LCP Critical Preload: definido por página via prop lcpImage; fallback para hero mobile -->
        <link
            rel="preload"
            as="image"
            href={Astro.props.lcpImage || "/assets/projects/psicologa-mobile.webp"}
            fetchpriority="high"
        />
        <!-- Preconnect Cloudflare CDN (Font Awesome) — economiza ~20ms no LCP -->
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
        <!-- Preconnect Unsplash (avatares do hero) -->
        <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
        <!-- Preconnect GTM/GA4 -->
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.googletag.com" />

        <script is:inline>document.documentElement.classList.add("js-enabled");</script>

        <!-- Google Tag Manager & Analytics (DEFERRED via requestIdleCallback)
             GTM, GA4 e Google Ads são adiados para depois do First Paint
             para não impactar o LCP/Core Web Vitals -->
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag("js", new Date());

            // Pre-carrega config imediatamente (não bloqueia, só enfileira)
            const isAdmin = new URLSearchParams(window.location.search).get("admin") === "true" ||
                          localStorage.getItem("alpha_admin_mode") === "true";
            const trafficType = isAdmin ? "internal" : "external";
            gtag("config", "G-Z1TRD8DK7P", { traffic_type: trafficType, page_path: window.location.pathname });
            gtag("config", "AW-17948194634");

            // Adia o carregamento de GTM/gtag.js para depois do idle
            const initGTM = () => {
                if (window.__gtmLoaded) return;
                window.__gtmLoaded = true;
                (function (w, d, s, l, i) {
                    w[l] = w[l] || [];
                    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
                    var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s),
                        dl = l != "dataLayer" ? "&l=" + l : "";
                    j.async = true;
                    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                    f.parentNode.insertBefore(j, f);
                })(window, document, "script", "dataLayer", "GTM-P839T8F");

                // GA4 lib (gtag.js)
                var s = document.createElement("script");
                s.async = true;
                s.src = "https://www.googletagmanager.com/gtag/js?id=G-Z1TRD8DK7P";
                document.head.appendChild(s);
            };

            // Usa requestIdleCallback se disponível, senão setTimeout 1.5s
            if ("requestIdleCallback" in window) {
                requestIdleCallback(initGTM, { timeout: 2500 });
            } else {
                setTimeout(initGTM, 1500);
            }

            // Reenvia page_view em ViewTransitions (SPA navigation)
            document.addEventListener("astro:page-load", () => {
                if (window.gtag) {
                    const a = new URLSearchParams(window.location.search).get("admin") === "true" ||
                              localStorage.getItem("alpha_admin_mode") === "true";
                    gtag("event", "page_view", {
                        page_path: window.location.pathname,
                        traffic_type: a ? "internal" : "external",
                    });
                }
            });
        </script>
        


        <link rel="icon" type="image/svg+xml" href="/assets/logo3d.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- RSS Feed -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Alpha Insights | Blog da Alpha Code"
            href="/rss.xml"
        />

        <!-- SEO -->
        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <link rel="canonical" href={seo.canonical} />
        <meta name="keywords" content={seo.keywords} />
        <meta name="author" content="Alpha Code" />
        <meta
            name="google-site-verification"
            content="google74f5360f54ab2c1a"
        />
        <link rel="alternate" hreflang="pt-BR" href={seo.canonical} />
        <link rel="alternate" hreflang="x-default" href={seo.canonical} />

        <!-- Open Graph -->
        <meta property="og:title" content={seo["og:title"]} />
        <meta property="og:description" content={seo["og:description"]} />
        <meta property="og:type" content={seo["og:type"]} />
        <meta property="og:url" content={seo["og:url"]} />
        <meta property="og:image" content={seo["og:image"]} />
        <meta property="og:locale" content={seo["og:locale"]} />
        <meta property="og:site_name" content="Alpha Code" />

        <!-- Twitter -->
        <meta name="twitter:card" content={seo["twitter:card"]} />
        <meta name="twitter:creator" content={seo["twitter:creator"]} />
        <meta name="twitter:title" content={seo["twitter:title"]} />
        <meta name="twitter:description" content={seo["twitter:description"]} />
        <meta name="twitter:image" content={seo["twitter:image"]} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <!-- Font Awesome self-hosted via @font-face com font-display:swap -->
        <style is:global>
            /* Substitui o CSS externo do Cloudflare (que tem font-display:block)
               e serve apenas os arquivos woff2 com swap. ~75% menor. */
            @font-face {
                font-family: "Font Awesome 6 Free";
                src: url("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2")
                        format("woff2");
                font-weight: 900;
                font-style: normal;
                font-display: swap;
            }
            @font-face {
                font-family: "Font Awesome 6 Brands";
                src: url("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2")
                        format("woff2");
                font-weight: 400;
                font-style: normal;
                font-display: swap;
            }
            @font-face {
                font-family: "Font Awesome 6 Free";
                src: url("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2")
                        format("woff2");
                font-weight: 400;
                font-style: normal;
                font-display: swap;
            }
            .fa,
            .fas,
            .far,
            .fab {
                -moz-osx-font-smoothing: grayscale;
                -webkit-font-smoothing: antialiased;
                display: inline-block;
                font-style: normal;
                font-variant: normal;
                text-rendering: auto;
                line-height: 1;
            }
            .fa,
            .fas {
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
            }
            .far {
                font-family: "Font Awesome 6 Free";
                font-weight: 400;
            }
            .fab {
                font-family: "Font Awesome 6 Brands";
                font-weight: 400;
            }
            /* Subset inline dos 104 ícones Font Awesome usados no projeto (~4KB).
               Garante que cada classe .fa-XXX tenha o glifo Unicode correto
               sem precisar carregar os 75KB do CSS externo do Cloudflare. */
            .fa-arrow-left:before{content:"\f060"}.fa-arrow-right:before{content:"\f061"}.fa-arrow-trend-down:before{content:"\e097"}.fa-award:before{content:"\f559"}.fa-balance-scale:before{content:"\f24e"}.fa-ban:before{content:"\f05e"}.fa-bolt:before{content:"\f0e7"}.fa-boxes-packing:before{content:"\e4c7"}.fa-briefcase:before{content:"\f0b1"}.fa-building-user:before{content:"\e4da"}.fa-bullhorn:before{content:"\f0a1"}.fa-calendar-times:before{content:"\f273"}.fa-camera:before{content:"\f030"}.fa-chart-line:before{content:"\f201"}.fa-check:before{content:"\f00c"}.fa-check-circle:before{content:"\f058"}.fa-chevron-down:before{content:"\f078"}.fa-chevron-right:before{content:"\f054"}.fa-chevron-up:before{content:"\f077"}.fa-city:before{content:"\f64f"}.fa-clock-rotate-left:before{content:"\f1da"}.fa-comments:before{content:"\f086"}.fa-compress-arrows-alt:before{content:"\f78c"}.fa-copy:before{content:"\f0c5"}.fa-credit-card:before{content:"\f09d"}.fa-crown:before{content:"\f521"}.fa-dollar-sign:before{content:"\24"}.fa-download:before{content:"\f019"}.fa-exclamation-triangle:before{content:"\f071"}.fa-external-link-alt:before{content:"\f35d"}.fa-eye-slash:before{content:"\f070"}.fa-file-contract:before{content:"\f56c"}.fa-file-invoice-dollar:before{content:"\f571"}.fa-file-pdf:before{content:"\f1c1"}.fa-file-signature:before{content:"\f573"}.fa-gauge-high:before{content:"\f625"}.fa-gavel:before{content:"\f0e3"}.fa-gears:before{content:"\f085"}.fa-gem:before{content:"\f3a5"}.fa-gift:before{content:"\f06b"}.fa-globe:before{content:"\f0ac"}.fa-globe-americas:before{content:"\f57d"}.fa-hand-holding-dollar:before{content:"\f4c0"}.fa-hand-holding-usd:before{content:"\f4c0"}.fa-handshake:before{content:"\f2b5"}.fa-handshake-slash:before{content:"\e060"}.fa-headset:before{content:"\f590"}.fa-hospital-user:before{content:"\f80d"}.fa-hotel:before{content:"\f594"}.fa-hourglass-half:before{content:"\f252"}.fa-house-damage:before{content:"\f6f1"}.fa-house-user:before{content:"\e1b0"}.fa-images:before{content:"\f302"}.fa-info-circle:before{content:"\f05a"}.fa-instagram:before{content:"\f16d"}.fa-key:before{content:"\f084"}.fa-laptop-house:before{content:"\e066"}.fa-layer-group:before{content:"\f5fd"}.fa-linkedin:before{content:"\f08c"}.fa-list-check:before{content:"\f0ae"}.fa-location-dot:before{content:"\f3c5"}.fa-lock:before{content:"\f023"}.fa-magic:before{content:"\f0d0"}.fa-map-location-dot:before{content:"\f5a0"}.fa-mobile-alt:before{content:"\f3cd"}.fa-money-bill-trend-up:before{content:"\e529"}.fa-mouse-pointer:before{content:"\f245"}.fa-notes-medical:before{content:"\f481"}.fa-paper-plane:before{content:"\f1d8"}.fa-pen:before{content:"\f304"}.fa-pen-nib:before{content:"\f5ad"}.fa-pen-to-square:before{content:"\f044"}.fa-play:before{content:"\f04b"}.fa-quote-left:before{content:"\f10d"}.fa-rectangle-ad:before{content:"\f641"}.fa-right-from-bracket:before{content:"\f2f5"}.fa-rocket:before{content:"\f135"}.fa-screwdriver-wrench:before{content:"\f7d9"}.fa-search:before{content:"\f002"}.fa-search-dollar:before{content:"\f688"}.fa-server:before{content:"\f233"}.fa-shield-alt:before{content:"\f3ed"}.fa-shield-halved:before{content:"\f3ed"}.fa-shopping-bag:before{content:"\f290"}.fa-star:before{content:"\f005"}.fa-stethoscope:before{content:"\f0f1"}.fa-store:before{content:"\f54e"}.fa-tags:before{content:"\f02c"}.fa-times:before{content:"\f00d"}.fa-tools:before{content:"\f7d9"}.fa-tooth:before{content:"\f5c9"}.fa-trash:before{content:"\f1f8"}.fa-trash-can:before{content:"\f2ed"}.fa-user:before{content:"\f007"}.fa-user-circle:before{content:"\f2bd"}.fa-user-md:before{content:"\f0f0"}.fa-user-plus:before{content:"\f234"}.fa-users:before{content:"\f0c0"}.fa-user-slash:before{content:"\f506"}.fa-users-slash:before{content:"\e073"}.fa-user-tie:before{content:"\f508"}.fa-utensils:before{content:"\f2e7"}.fa-wallet:before{content:"\f555"}.fa-wrench:before{content:"\f0ad"}
        </style>
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <meta name="geo.region" content="BR" />
        <meta name="geo.placename" content="Brasil" />
        <meta name="geo.position" content="-23.55052;-46.633309" />
        <meta name="ICBM" content="-23.55052, -46.633309" />
        <meta
            name="DC.coverage"
            content="Brasília, Rio de Janeiro, São Paulo, Brasil"
        />

        <SchemaMarkup
            type={schemaType as any}
            name={schemaName || title}
            description={schemaDescription || description}
            faqItems={faqItems}
        />

        <!-- Slot para schemas adicionais injetados pela página (ex: planos) -->
        <slot name="schema" />

        {noIndex && <meta name="robots" content="noindex, nofollow" />}
        {!noIndex && <meta name="robots" content={seo.robots} />}

        <!-- ViewTransitions com transition:animate=none para evitar reflows.
             Mantém SPA navigation (essencial para o admin/dashboard que depende
             de astro:page-load para inicializar scripts) sem as animações
             custosas que causavam layout thrashing. -->
        <ViewTransitions />
        <script is:inline>
            // 1) Polyfill: dispara astro:page-load em navegação nativa (back/forward)
            //    e em bfcache para que componentes que dependem do evento
            //    continuem funcionando em qualquer cenário.
            (function () {
                const firePageLoad = () => {
                    if (window.__astroPageLoadFired) return;
                    window.__astroPageLoadFired = true;
                    document.dispatchEvent(new Event("astro:page-load"));
                };
                // Carrega na primeira visita
                if (document.readyState === "complete" || document.readyState === "interactive") {
                    setTimeout(firePageLoad, 0);
                } else {
                    document.addEventListener("DOMContentLoaded", firePageLoad, { once: true });
                }
                // Em back/forward e bfcache
                window.addEventListener("pageshow", (e) => {
                    if (e.persisted) {
                        window.__astroPageLoadFired = false;
                        setTimeout(firePageLoad, 0);
                    }
                });
            })();

            // 2) Prefetch on hover/touch — só carrega a página quando o usuário
            //    demonstra intenção (substitui o download especulativo padrão).
            (function () {
                if (window.__prefetchConfigured) return;
                window.__prefetchConfigured = true;
                const prefetch = (url) => {
                    if (!url) return;
                    try {
                        const u = new URL(url, location.href);
                        if (u.origin !== location.origin) return;
                        if (u.pathname === location.pathname) return;
                        const link = document.createElement("link");
                        link.rel = "prefetch";
                        link.href = u.pathname;
                        link.as = "document";
                        document.head.appendChild(link);
                    } catch (_) {}
                };
                document.addEventListener(
                    "mouseover",
                    (e) => {
                        const a = e.target.closest && e.target.closest("a[href]");
                        if (a && a.href) prefetch(a.getAttribute("href"));
                    },
                    { passive: true },
                );
                document.addEventListener(
                    "touchstart",
                    (e) => {
                        const a = e.target.closest && e.target.closest("a[href]");
                        if (a && a.href) prefetch(a.getAttribute("href"));
                    },
                    { passive: true },
                );
            })();
        </script>
    </head>
    <body transition:animate="none">
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-P839T8F"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->
        <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
            Pular para conteúdo principal
        </a>

        {showHeader && <Header />}

        <main id="main-content">
            <slot />
        </main>

        {showFooter && <Footer />}

        {showWhatsApp && <PremiumWhatsapp />}

        <!-- Social Proof Popup -->
        {showSocialProof && <SocialProof />}

        <!-- Promotional Modals -->
        <PromoModal />

        <!-- Toast Notification Container -->
        <div id="toast-container" class="toast-container"></div>
        {showFomoBubble && <FomoBubble />}
        <slot name="scripts" />

        <script>
            // Capture referral code if present in URL
            const urlParams = new URLSearchParams(window.location.search);
            const ref = urlParams.get("ref");
            if (ref) {
                localStorage.setItem("alpha_ref_code", ref);
            }

            // GSAP é importado de forma lazy (code-split) pelos componentes que usam.
            // Aqui só fazemos um refresh global se GSAP já estiver carregado.
            document.addEventListener("astro:page-load", () => {
                if (window.gsap && window.ScrollTrigger) {
                    window.ScrollTrigger.refresh();
                }
            });

            // Cleanup on view transition
            document.addEventListener("astro:before-preparation", () => {
                if (window.ScrollTrigger) {
                    window.ScrollTrigger.getAll().forEach((t: { kill: () => void }) => t.kill());
                }
            });

            // Global ShowToast function
            (window as any).showToast = function (
                message: string,
                type: "success" | "error" = "success",
            ) {
                const container = document.getElementById("toast-container");
                if (!container) return;

                const toast = document.createElement("div");
                toast.className = `toast-item ${type}`;
                toast.innerHTML = `
                    <div class="toast-content">
                        ${type === "success" ? "✅" : "❌"}
                        <span>${message}</span>
                    </div>
                `;

                container.appendChild(toast);

                setTimeout(() => {
                    toast.classList.add("fade-out");
                    setTimeout(() => toast.remove(), 500);
                }, 3000);
            };
        </script>

        <!-- GSAP lazy loader (code-split, só carrega quando o usuário rolar a página) -->
        <script>
            (function () {
                if (window.__gsapLoaded) return;
                const loadGsap = () => {
                    if (window.__gsapLoading) return;
                    window.__gsapLoading = true;
                    // Import dinâmico: o Vite adiciona modulepreload no <head>,
                    // mas usamos requestIdleCallback para que o fetch só aconteça
                    // APÓS o LCP, evitando disputa no caminho crítico.
                    const start = () =>
                        Promise.all([
                            import("gsap"),
                            import("gsap/ScrollTrigger"),
                        ]).then(([gsapMod, stMod]) => {
                            const gsap =
                                gsapMod.default || gsapMod.gsap;
                            const ScrollTrigger =
                                stMod.ScrollTrigger || stMod.default;
                            gsap.registerPlugin(ScrollTrigger);
                            ScrollTrigger.config({ limitCallbacks: true });
                            ScrollTrigger.defaults({ markers: false });
                            window.gsap = gsap;
                            window.ScrollTrigger = ScrollTrigger;
                            window.__gsapLoaded = true;
                            window.dispatchEvent(
                                new CustomEvent("gsap:ready", { detail: { gsap, ScrollTrigger } }),
                            );
                        });
                    if ("requestIdleCallback" in window) {
                        requestIdleCallback(start, { timeout: 1500 });
                    } else {
                        setTimeout(start, 1500);
                    }
                };
                // Carrega GSAP só quando o usuário rolar, tocar ou após 6s (fallback)
                const trigger = () => {
                    loadGsap();
                    window.removeEventListener("scroll", trigger);
                    window.removeEventListener("pointerdown", trigger);
                    window.removeEventListener("keydown", trigger);
                };
                window.addEventListener("scroll", trigger, { passive: true, once: true });
                window.addEventListener("pointerdown", trigger, { passive: true, once: true });
                window.addEventListener("keydown", trigger, { passive: true, once: true });
                setTimeout(() => {
                    if (!window.__gsapLoaded && !window.__gsapLoading) loadGsap();
                }, 6000);
            })();
        </script>
    </body>
</html>

<style>
    .skip-link {
        background: var(--color-primary);
        color: white;
        padding: 8px;
        z-index: 9999;
    }
    /* Toast Styles */
    .toast-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: 15px;
        pointer-events: none;
        width: 100%;
        max-width: 420px;
        align-items: center;
    }

    .toast-item {
        background: #0a0a0a;
        border: 2px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        padding: 22px 30px;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        gap: 16px;
        animation: toastPopup 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
        pointer-events: auto;
        text-align: center;
        width: 90%;
    }

    .toast-item.success {
        border: 2px solid #10b981;
        background: #062016;
    }

    .toast-item.error {
        border: 2px solid #ef4444;
        background: #2d0a0a;
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.2);
    }

    .toast-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-size: 1.15rem;
        font-weight: 700;
        width: 100%;
    }

    @keyframes toastPopup {
        from {
            transform: scale(0.7) translateY(30px);
            opacity: 0;
        }
        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .toast-item.fade-out {
        opacity: 0;
        transform: scale(0.9);
        transition: 0.4s;
    }
</style>
