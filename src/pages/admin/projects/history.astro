---
import Layout from "../../../layouts/BaseLayout.astro";
import { getSession } from "../../../lib/auth";
import { prisma } from "../../../lib/prisma";
import AdminSidebar from "../../../components/admin/AdminSidebar.astro";
import StatusModal from "../../../components/ui/StatusModal.astro";

let session = null;
try {
    session = await getSession(Astro.request);
} catch (e) {
    console.error("Auth Error:", e);
}

if (!session || session.user?.role !== "ADMIN") {
    return Astro.redirect("/login");
}

const projects = await prisma.project.findMany({
    orderBy: { createdAt: "desc" },
});

const formatDate = (date: Date | null | undefined) => {
    if (!date) return "-";
    return new Date(date).toLocaleDateString("pt-BR");
};
---

<Layout
    title="Histórico de Projetos | Alpha Code"
    showWhatsApp={false}
    showHeader={false}
    showFooter={false}
>
    <div class="admin-container">
        <AdminSidebar activePage="projects" />

        <div class="dashboard-wrapper">
            <div class="container dashboard-container">
                <div class="header-actions mb-4">
                    <a href="/dashboard" class="back-link">← Voltar ao Painel</a
                    >
                </div>

                <div class="projects-header">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center;"
                    >
                        <div>
                            <h1>Histórico de Projetos Criados</h1>
                            <p>
                                Gerencie todos os projetos entregues pela
                                agência.
                            </p>
                        </div>
                        <button
                            id="open-add-project-modal"
                            class="btn-admin-primary"
                            >+ Adicionar Projeto</button
                        >
                    </div>
                </div>

                <section class="main-card mt-8">
                    <div class="projects-table-wrapper">
                        <table class="projects-table">
                            <thead>
                                <tr>
                                    <th>Nome do Projeto</th>
                                    <th>Cliente</th>
                                    <th>Plano</th>
                                    <th>Selo (Red Badge)</th>
                                    <th>Filtro</th>
                                    <th>Data Início</th>
                                    <th>Data Entrega</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {
                                    projects.length > 0 ? (
                                        projects.map((project) => (
                                            <tr>
                                                <td class="font-bold">
                                                    {project.name}
                                                </td>
                                                <td>
                                                    {project.clientName || "-"}
                                                </td>
                                                <td>
                                                    <span class="plan-badge">
                                                        {project.plan || "N/A"}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="type-badge">
                                                        {project.type}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="category-badge">
                                                        {project.category}
                                                    </span>
                                                </td>
                                                <td>
                                                    {formatDate(
                                                        project.startDate ||
                                                            project.createdAt,
                                                    )}
                                                </td>
                                                <td>
                                                    {formatDate(
                                                        project.deliveryDate ||
                                                            project.updatedAt,
                                                    )}
                                                </td>
                                                <td>
                                                    <span
                                                        class={`badge-status ${project.status === "Entregue" ? "success" : "pending"}`}
                                                    >
                                                        {project.status}
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <a
                                                            href={
                                                                project.projectUrl
                                                            }
                                                            target="_blank"
                                                            class="link-btn"
                                                            title="Ver Site"
                                                        >
                                                            👁️
                                                        </a>
                                                        <button
                                                            class="edit-btn"
                                                            title="Editar Projeto"
                                                            data-project={JSON.stringify(
                                                                project,
                                                            )}
                                                        >
                                                            ✏️
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        ))
                                    ) : (
                                        <tr>
                                            <td
                                                colspan="9"
                                                class="text-center p-4 text-muted"
                                            >
                                                Nenhum projeto cadastrado.
                                            </td>
                                        </tr>
                                    )
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
        <!-- Add Project Modal -->
        <div id="add-project-modal" class="modal-backdrop hidden">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Novo Projeto Manual</h2>
                    <button id="close-add-project-modal" class="close-btn"
                        >&times;</button
                    >
                </div>
                <form id="add-project-form">
                    <input type="hidden" name="id" id="project-id" />
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Nome do Projeto *</label>
                            <input
                                type="text"
                                name="name"
                                required
                                placeholder="Ex: Site Advocacia Silva"
                            />
                        </div>
                        <div class="form-group">
                            <label>Nome do Cliente</label>
                            <input
                                type="text"
                                name="clientName"
                                placeholder="Ex: Dr. Silva"
                            />
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Plano *</label>
                            <div class="custom-select">
                                <select name="plan" required>
                                    <option value="BRONZE"
                                        >Bronze (Página Simples)</option
                                    >
                                    <option value="PRATA"
                                        >Prata (Página Completa)</option
                                    >
                                    <option value="OURO"
                                        >Ouro (Página Premium)</option
                                    >
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Selo do Card (Red Badge) *</label>
                            <input
                                type="text"
                                name="type"
                                required
                                placeholder="Ex: PÁGINA COMPLETA (PRATA) ou SAÚDE"
                            />
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Filtro de Portfólio *</label>
                            <div class="custom-select">
                                <select name="category" required>
                                    <option value="juridico">Jurídico</option>
                                    <option value="saude">Saúde</option>
                                    <option value="educacao">Educação</option>
                                    <option value="gastronomia"
                                        >Gastronomia</option
                                    >
                                    <option value="institucional"
                                        >Institucional</option
                                    >
                                    <option value="outros">Outros</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Link do Projeto *</label>
                            <input
                                type="url"
                                name="projectUrl"
                                required
                                placeholder="https://exemplo.com"
                            />
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Data Início</label>
                            <input type="date" name="startDate" required />
                        </div>
                        <div class="form-group">
                            <label>Data Entrega</label>
                            <input type="date" name="deliveryDate" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Status *</label>
                        <div class="custom-select">
                            <select name="status" required>
                                <option value="Em Andamento"
                                    >Em Andamento</option
                                >
                                <option value="Entregue">Entregue</option>
                                <option value="Cancelado">Cancelado</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-actions">
                        <button
                            type="button"
                            id="cancel-add-project-modal"
                            class="btn-secondary">Cancelar</button
                        >
                        <button type="submit" class="btn-submit"
                            >Adicionar Projeto</button
                        >
                    </div>
                </form>
            </div>
        </div>
    </div>
</Layout>

<StatusModal
    id="project-status-modal"
    title="Processando"
    message="Aguarde..."
    type="loading"
/>

<script>
    const modal = document.getElementById("add-project-modal");
    const openBtn = document.getElementById("open-add-project-modal");
    const closeBtn = document.getElementById("close-add-project-modal");
    const cancelBtn = document.getElementById("cancel-add-project-modal");
    const form = document.getElementById(
        "add-project-form",
    ) as HTMLFormElement | null;

    function openModal() {
        if (modal) {
            modal.classList.remove("hidden");
        }
    }

    function closeModal() {
        if (modal) modal.classList.add("hidden");
    }

    // Edit logic
    const editBtns = document.querySelectorAll(".edit-btn");
    editBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const project = JSON.parse(
                btn.getAttribute("data-project") || "{}",
            );
            if (form && modal) {
                // Fill form
                (
                    form.querySelector('input[name="id"]') as HTMLInputElement
                ).value = project.id;
                (
                    form.querySelector('input[name="name"]') as HTMLInputElement
                ).value = project.name;
                (
                    form.querySelector(
                        'input[name="clientName"]',
                    ) as HTMLInputElement
                ).value = project.clientName || "";
                (
                    form.querySelector(
                        'select[name="plan"]',
                    ) as HTMLSelectElement
                ).value = project.plan || "BRONZE";
                (
                    form.querySelector('input[name="type"]') as HTMLInputElement
                ).value = project.type;
                (
                    form.querySelector(
                        'select[name="category"]',
                    ) as HTMLSelectElement
                ).value = project.category;
                (
                    form.querySelector(
                        'select[name="status"]',
                    ) as HTMLSelectElement
                ).value = project.status;
                (
                    form.querySelector(
                        'input[name="projectUrl"]',
                    ) as HTMLInputElement
                ).value = project.projectUrl;

                if (project.startDate) {
                    try {
                        const date = new Date(project.startDate);
                        if (!isNaN(date.getTime())) {
                            (
                                form.querySelector(
                                    'input[name="startDate"]',
                                ) as HTMLInputElement
                            ).value = date.toISOString().split("T")[0];
                        }
                    } catch (e) {
                        console.error("Erro ao converter data de início:", e);
                    }
                }
                if (project.deliveryDate) {
                    try {
                        const date = new Date(project.deliveryDate);
                        if (!isNaN(date.getTime())) {
                            (
                                form.querySelector(
                                    'input[name="deliveryDate"]',
                                ) as HTMLInputElement
                            ).value = date.toISOString().split("T")[0];
                        }
                    } catch (e) {
                        console.error("Erro ao converter data de entrega:", e);
                    }
                }

                const modalTitle = modal.querySelector("h2");
                if (modalTitle) modalTitle.innerText = "Editar Projeto";

                const submitBtn = form.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                if (submitBtn) submitBtn.innerText = "Salvar Alterações";

                openModal();
            }
        });
    });

    if (openBtn) {
        openBtn.addEventListener("click", () => {
            if (form && modal) {
                form.reset();
                (
                    form.querySelector('input[name="id"]') as HTMLInputElement
                ).value = "";

                const modalTitle = modal.querySelector("h2");
                if (modalTitle) modalTitle.innerText = "Novo Projeto Manual";

                const submitBtn = form.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                if (submitBtn) submitBtn.innerText = "Adicionar Projeto";

                // Set default date to today for startDate
                const dateInput = form.querySelector(
                    'input[name="startDate"]',
                ) as HTMLInputElement;
                if (dateInput) dateInput.valueAsDate = new Date();
            }
            openModal();
        });
    }
    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (cancelBtn) cancelBtn.addEventListener("click", closeModal);

    // Close on click outside
    if (modal) {
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeModal();
        });
    }

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const isEdit = !!(
                form.querySelector("#project-id") as HTMLInputElement
            ).value;
            const btn = form.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement | null;
            const originalText = btn
                ? btn.innerText
                : isEdit
                  ? "Salvar Alterações"
                  : "Adicionar Projeto";

            if (btn) {
                btn.innerText = "Salvando...";
                btn.disabled = true;
            }

            // Show loading modal
            (window as any).showModal(
                "Salvando",
                "Adicionando projeto ao portfólio...",
                "loading",
            );

            const formData = new FormData(form);
            const data = Object.fromEntries(formData);

            try {
                const endpoint = isEdit
                    ? "/api/admin/portfolio/update"
                    : "/api/admin/portfolio/add";
                const response = await fetch(endpoint, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });

                if (response.ok) {
                    (window as any).showModal(
                        "Sucesso",
                        isEdit
                            ? "Projeto atualizado com sucesso!"
                            : "Projeto adicionado com sucesso!",
                        "success",
                    );
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    const err = await response.json();
                    (window as any).showModal(
                        "Erro",
                        "Falha ao salvar: " +
                            (err.error || err.message || "Erro desconhecido"),
                        "error",
                    );
                    if (btn) {
                        btn.innerText = originalText;
                        btn.disabled = false;
                    }
                    setTimeout(() => (window as any).hideModal(), 5000);
                }
            } catch (e) {
                console.error(e);
                (window as any).showModal(
                    "Erro",
                    "Erro de conexão ao salvar projeto.",
                    "error",
                );
                setTimeout(() => (window as any).hideModal(), 3000);
            } finally {
                if (btn) {
                    btn.innerText = originalText;
                    btn.disabled = false;
                }
            }
        });
    }
</script>

<style>
    /* Reuse dashboard styles for consistency */
    .admin-container {
        display: flex;
        min-height: 100vh;
        background: #0a0a0a;
        color: white;
    }

    .dashboard-wrapper {
        flex: 1;
        padding-top: 40px;
        min-height: 100vh;
        background-color: #0a0a0a;
        color: #fff;
        padding-bottom: 4rem;
    }

    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .back-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
    }
    .back-link:hover {
        color: #fff;
    }

    .projects-header {
        margin-bottom: 2rem;
    }
    .projects-header p {
        color: var(--color-text-muted);
    }

    .main-card {
        background: rgba(20, 20, 20, 0.6);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 2rem;
        backdrop-filter: blur(10px);
    }

    .projects-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .projects-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        min-width: 800px;
    }

    .projects-table th {
        text-align: left;
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-text-heading);
    }

    .projects-table td {
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        vertical-align: middle;
    }

    .type-badge,
    .category-badge,
    .plan-badge {
        display: inline-block;
        padding: 4px 12px;
        background: rgba(52, 152, 219, 0.1);
        color: #3498db;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .category-badge {
        background: rgba(149, 165, 166, 0.1);
        color: #95a5a6;
    }

    .plan-badge {
        background: rgba(241, 196, 15, 0.1);
        color: #f1c40f;
    }

    .type-badge {
        background: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
    }

    .badge-status.success {
        color: #34d399;
        background: rgba(52, 211, 153, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .badge-status.pending {
        color: #fbbf24;
        background: rgba(251, 191, 36, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .link-btn {
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .link-btn:hover {
        text-decoration: underline;
    }

    .mb-4 {
        margin-bottom: 1rem;
    }
    .mt-8 {
        margin-top: 2rem;
    }
    .font-bold {
        font-weight: 700;
    }
    .text-center {
        text-align: center;
    }
    .text-muted {
        color: var(--color-text-muted);
    }
    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }

    @media (max-width: 768px) {
        .admin-container {
            flex-direction: column;
        }
        .dashboard-wrapper {
            padding-top: 20px;
            margin-bottom: 80px;
            max-width: 100%;
        }
        .dashboard-container {
            padding: 0 1rem;
        }
        .projects-header div {
            flex-direction: column !important;
            align-items: stretch !important;
            text-align: center;
            gap: 1.5rem;
        }
        .projects-header h1 {
            font-size: 1.8rem;
        }
        .btn-admin-primary {
            width: 100%;
            padding: 15px;
        }
        .main-card {
            padding: 1.2rem;
            margin-top: 1.5rem;
        }
        .projects-table th,
        .projects-table td {
            padding: 10px;
        }
    }

    .edit-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        padding: 6px;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .edit-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--color-primary);
    }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 1;
        transition: opacity 0.3s ease;
    }

    .modal-backdrop.hidden {
        display: none;
        opacity: 0;
        pointer-events: none;
    }

    .modal-content {
        background: #1a1a1a;
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        width: 90%;
        max-width: 600px;
        padding: 2rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.2) rgba(255, 255, 255, 0.05);
    }

    .modal-content::-webkit-scrollbar {
        width: 6px;
    }
    .modal-content::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
    }
    .modal-content::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
    }
    .modal-content::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--glass-border);
        padding-bottom: 1rem;
    }

    .close-btn {
        background: none;
        border: none;
        color: var(--color-text-muted);
        font-size: 2rem;
        cursor: pointer;
        line-height: 1;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @media (max-width: 600px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 0.8rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--glass-border);
        border-radius: 8px;
        color: #fff;
        outline: none;
    }

    .form-group select option {
        background-color: #1a1a1a;
    }

    .btn-admin-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 24px;
        background: linear-gradient(135deg, #ae1d2a 0%, #8a1c26 100%);
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(138, 28, 38, 0.3);
        white-space: nowrap;
    }

    .btn-admin-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(138, 28, 38, 0.5);
        filter: brightness(1.1);
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-text-muted);
        padding: 10px 24px;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 30px;
        background: linear-gradient(135deg, #ae1d2a 0%, #8a1c26 100%);
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(138, 28, 38, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(138, 28, 38, 0.5);
