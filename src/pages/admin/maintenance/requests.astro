---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { prisma } from "../../../lib/prisma";
import AdminSidebar from "../../../components/admin/AdminSidebar.astro";
import { getSession } from "../../../lib/auth";

let session = null;
try {
    session = await getSession(Astro.request);
} catch (e) {
    console.error("Auth Error:", e);
}

if (!session || session.user?.role !== "ADMIN") {
    return Astro.redirect("/login");
}

const requests = await (prisma as any).maintenanceRequest.findMany({
    orderBy: { createdAt: "desc" },
});

const stats = {
    total: requests.length,
    pending: requests.filter((r: any) => r.paymentStatus === "PENDENTE").length,
    paid: requests.filter((r: any) => r.paymentStatus === "PAGO").length,
    totalEarnings: requests
        .filter((r: any) => r.paymentStatus === "PAGO")
        .reduce((acc: number, curr: any) => acc + curr.amount, 0),
};

const title = "Pedidos de Manutenção e SEO - Admin";
---

<BaseLayout
    title={title}
    showHeader={false}
    showFooter={false}
    showWhatsApp={false}
>
    <div class="admin-container">
        <AdminSidebar activePage="maintenance" isAdmin={true} />

        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <h1>Gestão de Solicitações</h1>
                    <p>Controle de Manutenções e Serviços</p>
                </div>
                <button id="open-request-modal" class="btn-admin-primary">
                    Novo Pedido Manual
                </button>
            </header>

            <div class="stats-grid">
                <div class="stat-card total">
                    <span class="stat-icon"
                        ><i class="fas fa-list-check"></i></span
                    >
                    <div class="stat-info">
                        <span class="stat-label">Total de Pedidos</span>
                        <span class="stat-value">{stats.total}</span>
                    </div>
                </div>
                <div class="stat-card pending">
                    <span class="stat-icon"
                        ><i class="fas fa-clock-rotate-left"></i></span
                    >
                    <div class="stat-info">
                        <span class="stat-label">Aguardando Pagamento</span>
                        <span class="stat-value">{stats.pending}</span>
                    </div>
                </div>
                <div class="stat-card success">
                    <span class="stat-icon"
                        ><i class="fas fa-hand-holding-dollar"></i></span
                    >
                    <div class="stat-info">
                        <span class="stat-label">Total Recebido</span>
                        <span class="stat-value"
                            >R$ {
                                stats.totalEarnings.toLocaleString("pt-BR", {
                                    minimumFractionDigits: 2,
                                })
                            }</span
                        >
                    </div>
                </div>
            </div>

            <section class="main-card mt-8">
                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Serviço</th>
                                <th>Valor</th>
                                <th>Pagamento</th>
                                <th>Status Serviço</th>
                                <th>Início / Fim</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                requests.length > 0 ? (
                                    requests.map((request: any) => (
                                        <tr>
                                            <td class="font-bold">
                                                {request.clientName}
                                            </td>
                                            <td>
                                                <span
                                                    class={`badge-service ${request.serviceType}`}
                                                >
                                                    {request.serviceType ===
                                                    "SEO_TURBINADO" ? (
                                                        <>
                                                            <i class="fas fa-rocket mr-1" />{" "}
                                                            SEO Turbinado
                                                        </>
                                                    ) : (
                                                        <>
                                                            <i class="fas fa-wrench mr-1" />{" "}
                                                            Manutenção
                                                        </>
                                                    )}
                                                </span>
                                            </td>
                                            <td>
                                                R${" "}
                                                {request.amount.toLocaleString(
                                                    "pt-BR",
                                                    {
                                                        minimumFractionDigits: 2,
                                                    },
                                                )}
                                            </td>
                                            <td>
                                                <span
                                                    class={`badge-payment ${request.paymentStatus}`}
                                                >
                                                    {request.paymentStatus}
                                                </span>
                                            </td>
                                            <td>
                                                <span
                                                    class={`badge-status ${request.status}`}
                                                >
                                                    {request.status}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="date-info">
                                                    {request.startDate
                                                        ? new Date(
                                                              request.startDate,
                                                          ).toLocaleDateString(
                                                              "pt-BR",
                                                          )
                                                        : "-"}
                                                    {request.endDate && <br />}
                                                    {request.endDate
                                                        ? `Até: ${new Date(request.endDate).toLocaleDateString("pt-BR")}`
                                                        : ""}
                                                </div>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    {request.paymentStatus ===
                                                        "PENDENTE" && (
                                                        <button
                                                            class="pay-btn"
                                                            data-id={request.id}
                                                            title="Confirmar Pagamento"
                                                        >
                                                            <i class="fas fa-dollar-sign mr-1" />{" "}
                                                            Pagar
                                                        </button>
                                                    )}

                                                    {request.status !==
                                                        "CONCLUIDO" && (
                                                        <button
                                                            class="status-btn"
                                                            data-id={request.id}
                                                            title="Marcar como Concluído"
                                                        >
                                                            <i class="fas fa-check-circle mr-1" />{" "}
                                                            Entregar
                                                        </button>
                                                    )}

                                                    <button
                                                        class="delete-btn"
                                                        data-id={request.id}
                                                        title="Excluir Pedido"
                                                    >
                                                        <i class="fas fa-trash-can" />
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    ))
                                ) : (
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state-container">
                                                <div class="empty-icon">📂</div>
                                                <p>
                                                    Nenhuma solicitação
                                                    encontrada
                                                </p>
                                                <span class="empty-sub">
                                                    Crie um novo pedido manual
                                                    para começar
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                )
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <!-- Modal Novo Pedido -->
    <div id="request-modal" class="modal-backdrop hidden">
        <div class="modal-content">
            <h2>Nova Solicitação Manual</h2>
            <form id="request-form">
                <div class="form-group">
                    <label>Nome do Cliente *</label>
                    <input type="text" name="clientName" required />
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Tipo de Serviço *</label>
                        <select
                            name="serviceType"
                            id="service-type-select"
                            required
                        >
                            <option value="MANUTENCAO"
                                >🔧 Manutenção Corretiva/Evolutiva</option
                            >
                            <option value="SEO_TURBINADO"
                                >🚀 SEO Turbinado (3 Meses)</option
                            >
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Valor (R$) *</label>
                        <input
                            type="number"
                            step="0.01"
                            name="amount"
                            required
                        />
                    </div>
                </div>
                <div class="form-group" id="description-group">
                    <label>Descrição do Problema/Pedido</label>
                    <textarea name="description" rows="3"></textarea>
                </div>
                <div class="form-grid" id="date-group">
                    <div class="form-group">
                        <label>Data de Início</label>
                        <input type="date" name="startDate" />
                    </div>
                    <div
                        class="form-group"
                        id="end-date-container"
                        style="display:none;"
                    >
                        <label>Data de Término</label>
                        <input type="date" name="endDate" readonly />
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="cancel-btn" id="close-modal"
                        >Cancelar</button
                    >
                    <button type="submit" class="primary-btn"
                        >Criar Pedido</button
                    >
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de Confirmação Customizado -->
    <div id="confirm-modal" class="modal-backdrop hidden">
        <div class="modal-content confirm-modal-content">
            <div class="confirm-icon-wrap">
                <span class="confirm-icon" id="confirm-icon-emoji">⚠️</span>
            </div>
            <h2 id="confirm-title">Confirmar Ação</h2>
            <p id="confirm-message">Deseja realmente prosseguir?</p>
            <div class="confirm-divider"></div>
            <div class="modal-actions full-width">
                <button type="button" class="cancel-btn" id="confirm-cancel"
                    >Cancelar</button
                >
                <button type="button" class="confirm-btn-action" id="confirm-ok"
                    >Confirmar</button
                >
            </div>
        </div>
    </div>

    <script>
        const modal = document.getElementById("request-modal");
        const openBtn = document.getElementById("open-request-modal");
        const closeBtn = document.getElementById("close-modal");
        const form = document.getElementById("request-form") as HTMLFormElement;
        const typeSelect = document.getElementById(
            "service-type-select",
        ) as HTMLSelectElement;
        const endDateContainer = document.getElementById("end-date-container");
        const startDateInput = document.querySelector(
            'input[name="startDate"]',
        ) as HTMLInputElement;
        const endDateInput = document.querySelector(
            'input[name="endDate"]',
        ) as HTMLInputElement;

        // Custom Confirm Logic
        const confirmModal = document.getElementById("confirm-modal");
        const confirmTitle = document.getElementById("confirm-title");
        const confirmMessage = document.getElementById("confirm-message");
        const confirmOk = document.getElementById("confirm-ok");
        const confirmCancel = document.getElementById("confirm-cancel");
        let confirmCallback: (() => void) | null = null;

        function showConfirm(
            title: string,
            message: string,
            onConfirm: () => void,
        ) {
            if (!confirmTitle || !confirmMessage || !confirmModal) return;
            confirmTitle.innerText = title;
            confirmMessage.innerText = message;
            confirmCallback = onConfirm;
            confirmModal.classList.remove("hidden");
        }

        confirmCancel?.addEventListener("click", () => {
            confirmModal?.classList.add("hidden");
            confirmCallback = null;
        });

        confirmOk?.addEventListener("click", () => {
            if (confirmCallback) confirmCallback();
            confirmModal?.classList.add("hidden");
        });

        // Lógica de datas para SEO (3 meses)
        typeSelect.addEventListener("change", () => {
            if (typeSelect.value === "SEO_TURBINADO") {
                endDateContainer!.style.display = "block";
                updateEndDate();
            } else {
                endDateContainer!.style.display = "none";
            }
        });

        startDateInput.addEventListener("change", updateEndDate);

        function updateEndDate() {
            if (typeSelect.value === "SEO_TURBINADO" && startDateInput.value) {
                const start = new Date(startDateInput.value + "T00:00:00");
                const end = new Date(
                    start.getTime() + 90 * 24 * 60 * 60 * 1000,
                );
                endDateInput.value = end.toISOString().split("T")[0];
            }
        }

        openBtn?.addEventListener("click", () => {
            modal?.classList.remove("hidden");
            // Set today as default start date
            if (!startDateInput.value) {
                startDateInput.value = new Date().toISOString().split("T")[0];
                updateEndDate();
            }
        });
        closeBtn?.addEventListener("click", () =>
            modal?.classList.add("hidden"),
        );

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);

            try {
                const res = await fetch("/api/admin/maintenance/add", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert("Erro ao criar pedido");
                }
            } catch (e) {
                console.error(e);
            }
        });

        // Lógica de Pagamento (Integração Financeira)
        document.querySelectorAll(".pay-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const id = btn.getAttribute("data-id");
                showConfirm(
                    "💰 Confirmar Pagamento",
                    "Deseja confirmar o recebimento deste pagamento? O valor será somado automaticamente aos ganhos financeiros do dashboard.",
                    async () => {
                        try {
                            const res = await fetch(
                                "/api/admin/maintenance/pay",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify({ id }),
                                },
                            );
                            if (res.ok) {
                                window.location.reload();
                            } else {
                                const err = await res.json();
                                alert(
                                    "Erro ao processar pagamento: " +
                                        (err.error || "Erro interno"),
                                );
                            }
                        } catch (e) {
                            alert("Erro de conexão ao processar pagamento.");
                        }
                    },
                );
            });
        });

        // Lógica de Status (Entregar)
        document.querySelectorAll(".status-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const id = btn.getAttribute("data-id");
                showConfirm(
                    "✅ Finalizar Serviço",
                    "Deseja marcar este pedido como entregue/concluído?",
                    async () => {
                        try {
                            const res = await fetch(
                                "/api/admin/maintenance/status",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify({
                                        id,
                                        status: "CONCLUIDO",
                                    }),
                                },
                            );
                            if (res.ok) {
                                window.location.reload();
                            } else {
                                const err = await res.json();
                                alert(
                                    "Erro ao concluir pedido: " +
                                        (err.error || "Erro interno"),
                                );
                            }
                        } catch (e) {
                            alert("Erro de conexão ao concluir pedido.");
                        }
                    },
                );
            });
        });

        // Lógica de Exclusão
        document.querySelectorAll(".delete-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const id = btn.getAttribute("data-id");
                console.log("Botão de excluir clicado para ID:", id);
                showConfirm(
                    "⚠️ Excluir Solicitação",
                    "Tem certeza que deseja excluir esta solicitação? Esta ação não pode ser desfeita.",
                    async () => {
                        try {
                            const res = await fetch(
                                "/api/admin/maintenance/delete",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify({ id }),
                                },
                            );

                            if (res.ok) {
                                window.location.reload();
                            } else {
                                const err = await res.json();
                                alert(
                                    "Erro ao excluir: " +
                                        (err.error || "Erro desconhecido"),
                                );
                            }
                        } catch (error) {
                            console.error("Erro na exclusão:", error);
                            alert("Erro de conexão ao tentar excluir.");
                        }
                    },
                );
            });
        });
    </script>

    <style>
        .admin-container {
            display: flex;
        }
        .admin-main {
            flex: 1;
            padding: 40px;
            max-width: calc(100% - 80px);
        }

        /* Standard Admin Button Styles */
        .btn-admin-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 24px;
            background: linear-gradient(135deg, #ae1d2a 0%, #8a1c26 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(138, 28, 38, 0.3);
            white-space: nowrap;
        }

        .btn-admin-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(138, 28, 38, 0.5);
            filter: brightness(1.1);
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .admin-header h1 {
            font-size: 2rem;
            margin-bottom: 5px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #161616;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #222;
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .stat-icon {
            font-size: 1.5rem;
            opacity: 0.8;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
        }
        .stat-card.total .stat-icon {
            color: #3498db;
            background: rgba(52, 152, 219, 0.1);
        }
        .stat-card.pending .stat-icon {
            color: #f1c40f;
            background: rgba(241, 196, 15, 0.1);
        }
        .stat-card.success .stat-icon {
            color: #2ecc71;
            background: rgba(46, 204, 113, 0.1);
        }

        .stat-info {
            display: flex;
            flex-direction: column;
        }
        .stat-label {
            display: block;
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 5px;
        }
        .stat-value {
            font-size: 1.6rem;
            font-weight: bold;
        }
        .mr-1 {
            margin-right: 8px;
        }
        .stat-card.total {
            border-left: 4px solid #3498db;
        }
        .stat-card.pending {
            border-left: 4px solid #f1c40f;
        }
        .stat-card.success {
            border-left: 4px solid #2ecc71;
        }

        .main-card {
            background: #161616;
            border-radius: 12px;
            border: 1px solid #222;
            overflow: hidden;
        }
        .table-wrapper {
            overflow-x: auto;
        }
        @media (max-width: 768px) {
            .admin-container {
                flex-direction: column;
            }
            .admin-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
                margin-bottom: 25px;
            }
            .admin-header h1 {
                font-size: 1.75rem;
            }
            .admin-main {
                padding: 15px;
                max-width: 100%;
                margin-left: 0 !important;
                margin-bottom: 80px; /* Room for bottom nav */
            }
            .stats-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }
            .admin-main {
                padding: 15px;
                max-width: 100%;
                margin-left: 0 !important;
                margin-bottom: 80px; /* Room for bottom nav */
            }
            .btn-admin-primary {
                width: 100%;
                padding: 15px;
            }
            .table-wrapper {
                margin: 0 -15px;
                width: calc(100% + 30px);
                border-radius: 0;
            }
            .admin-table {
                min-width: 900px; /* Increased min-width for readability */
            }
            .admin-table th,
            .admin-table td {
                padding: 12px 10px;
                font-size: 0.8rem; /* Slightly smaller text on mobile */
            }
            .table-wrapper::after {
                content: "← Deslize para ver mais →";
                display: block;
                text-align: center;
                color: #666;
                font-size: 0.7rem;
                padding: 10px;
                background: #111;
                border-top: 1px solid #222;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }
        .admin-table th {
            background: #1a1a1a;
            padding: 15px;
            color: #888;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 2px solid #222;
        }

        /* Empty State */
        .empty-state-container {
            padding: 60px 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            color: #666;
        }
        .empty-icon {
            font-size: 3rem;
            margin-bottom: 10px;
            opacity: 0.5;
        }
        .empty-sub {
            font-size: 0.85rem;
            opacity: 0.7;
        }
        .admin-table td {
            padding: 15px;
            border-bottom: 1px solid #222;
            font-size: 0.95rem;
        }

        .badge-service {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: bold;
        }
        .badge-service.SEO_TURBINADO {
            background: rgba(52, 152, 219, 0.2);
            color: #3498db;
        }
        .badge-service.MANUTENCAO {
            background: rgba(155, 89, 182, 0.2);
            color: #9b59b6;
        }

        .badge-payment {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
        }
        .badge-payment.PENDENTE {
            background: rgba(241, 196, 15, 0.15);
            color: #f1c40f;
        }
        .badge-payment.PAGO {
            background: rgba(46, 204, 113, 0.15);
            color: #2ecc71;
        }

        .badge-status {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.7rem;
        }
        .badge-status.PENDENTE {
            color: #888;
        }
        .badge-status.CONCLUIDO {
            color: #2ecc71;
        }

        .primary-btn {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
        .pay-btn {
            background: #2ecc71;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .delete-btn {
            background: rgba(231, 76, 60, 0.1);
            color: #e74c3c;
            border: 1px solid rgba(231, 76, 60, 0.2);
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: all 0.2s;
        }
        .status-btn {
            background: rgba(46, 204, 113, 0.1);
            color: #2ecc71;
            border: 1px solid rgba(46, 204, 113, 0.2);
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .status-btn:hover {
            background: #2ecc71;
            color: white;
        }
        .delete-btn:hover {
            background: #e74c3c;
            color: white;
            transform: scale(1.1);
        }
        .cancel-btn {
            background: #333;
            color: white;
            border: none;
            padding: 12px 24px;
