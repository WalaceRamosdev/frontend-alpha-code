---
import Layout from "../../layouts/BaseLayout.astro";
import AdminSidebar from "../../components/admin/AdminSidebar.astro";
import { getSession } from "../../lib/auth";
import { prisma } from "../../lib/prisma";
import StatusModal from "../../components/ui/StatusModal.astro";

let session = null;
try {
    session = await getSession(Astro.request);
} catch (e) {
    console.error("Admin Auth Error:", e);
}

if (!session || session.user?.role !== "ADMIN") {
    return Astro.redirect("/login");
}

const isAdmin = session.user?.role === "ADMIN";

const allUsers = await prisma.user.findMany({
    orderBy: { createdAt: "desc" },
    where: { role: "USER" },
});

const totalUsers = allUsers.length;

const formatPhone = (phone: string | null | undefined) => {
    if (!phone) return "";
    const cleaned = phone.replace(/\D/g, "");
    const match = cleaned.match(/^(\d{2})(\d{5})(\d{4})$/);
    if (match) return `(${match[1]}) ${match[2]}-${match[3]}`;
    return phone;
};

const planColors: Record<string, string> = {
    BRONZE: "#cd7f32",
    PRATA: "#aaa",
    OURO: "#f5c211",
    FREE: "#555",
    PARCEIRO: "#10b981", // Emerald/Green for partners
};

export const prerender = false;
---

<Layout
    title="Gestão de Clientes | Alpha Code"
    showWhatsApp={false}
    showHeader={false}
    showFooter={false}
>
    <div class="dashboard-container">
        <AdminSidebar activePage="users" isAdmin={isAdmin} />

        <main class="main-content">
            <!-- Header -->
            <header class="dashboard-header">
                <div class="user-welcome">
                    <h1>Gestão de Clientes</h1>
                    <div class="client-count-badge">
                        <i class="fas fa-users"></i>
                        <span
                            >{totalUsers} cliente{
                                totalUsers !== 1 ? "s" : ""
                            }</span
                        >
                    </div>
                </div>
                <div class="header-actions">
                    <button class="add-btn" id="toggle-create-form">
                        <i class="fas fa-user-plus"></i>
                        Novo Cliente
                    </button>
                </div>
            </header>

            <!-- Create User Inline Panel (collapsed by default) -->
            <div class="create-panel" id="create-panel">
                <div class="panel-inner">
                    <div class="panel-title">
                        <i class="fas fa-user-plus"></i>
                        <span>Cadastrar Novo Cliente</span>
                        <button class="close-panel-btn" id="close-create-panel"
                            ><i class="fas fa-times"></i></button
                        >
                    </div>
                    <form id="create-user-form" class="create-form">
                        <div class="create-grid">
                            <div class="field">
                                <label>Nome Completo</label>
                                <input
                                    type="text"
                                    name="name"
                                    id="name"
                                    placeholder="Ex: João Silva"
                                    required
                                />
                            </div>
                            <div class="field">
                                <label>E-mail ou WhatsApp</label>
                                <input
                                    type="text"
                                    name="email"
                                    id="email"
                                    placeholder="email@... ou (21) 99999-9999"
                                    required
                                />
                            </div>
                            <div class="field">
                                <label>Senha Inicial</label>
                                <input
                                    type="text"
                                    name="password"
                                    value="alpha123"
                                    required
                                />
                            </div>
                            <div class="field">
                                <label>Plano</label>
                                <select name="plan">
                                    <option value="FREE">Free</option>
                                    <option value="BRONZE">Bronze</option>
                                    <option value="PRATA">Prata</option>
                                    <option value="OURO">Ouro</option>
                                    <option value="PARCEIRO">Parceiro</option>
                                </select>
                            </div>
                            <div class="field full">
                                <label>URL do Site (opcional)</label>
                                <input
                                    type="url"
                                    name="siteUrl"
                                    placeholder="https://cliente.vercel.app"
                                />
                            </div>
                            <div class="field full">
                                <label>Data de Cadastro (Opcional)</label>
                                <input type="date" name="createdAt" />
                            </div>
                        </div>
                        <button
                            type="submit"
                            class="btn-create"
                            id="submit-btn"
                        >
                            <i class="fas fa-check"></i> Cadastrar Cliente
                        </button>
                    </form>
                </div>
            </div>

            <!-- Users Table -->
            <div class="table-card">
                {
                    allUsers.length === 0 ? (
                        <div class="empty-state">
                            <i class="fas fa-users" />
                            <p>Nenhum cliente cadastrado ainda.</p>
                            <button class="add-btn" id="toggle-create-form-2">
                                Cadastrar primeiro cliente
                            </button>
                        </div>
                    ) : (
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Contato</th>
                                    <th>Plano</th>
                                    <th>Site</th>
                                    <th>Desde</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {allUsers.map((u) => (
                                    <tr>
                                        <td class="td-name">
                                            <div class="avatar-initials">
                                                <img
                                                    src="/assets/logo3d.svg"
                                                    alt="Alpha Code"
                                                    style="width: 22px; height: 22px; object-fit: contain;"
                                                />
                                            </div>
                                            <span class="name-text">
                                                {u.name}
                                            </span>
                                        </td>
                                        <td
                                            class="td-contact"
                                            data-label="Contato"
                                        >
                                            {formatPhone(u.phone) ||
                                                u.email ||
                                                "—"}
                                        </td>
                                        <td data-label="Plano">
                                            <span
                                                class="plan-badge"
                                                style={`color:${planColors[u.plan] || "#aaa"}; border-color:${planColors[u.plan] || "#aaa"}44`}
                                            >
                                                {u.plan}
                                            </span>
                                        </td>
                                        <td class="td-site" data-label="Site">
                                            {u.siteUrl ? (
                                                <a
                                                    href={u.siteUrl}
                                                    target="_blank"
                                                    rel="noopener"
                                                    class="site-link"
                                                >
                                                    <i class="fas fa-external-link-alt" />
                                                    {
                                                        u.siteUrl
                                                            .replace(
                                                                /https?:\/\//,
                                                                "",
                                                            )
                                                            .split("/")[0]
                                                    }
                                                </a>
                                            ) : (
                                                <span class="muted">—</span>
                                            )}
                                        </td>
                                        <td
                                            class="td-date muted"
                                            data-label="Desde"
                                        >
                                            {new Date(
                                                u.createdAt,
                                            ).toLocaleDateString("pt-BR")}
                                        </td>
                                        <td class="td-actions">
                                            <button
                                                class="action-btn edit-btn"
                                                title="Editar cliente"
                                                data-user={JSON.stringify(u)}
                                                onclick="openEditModal(this)"
                                            >
                                                <i class="fas fa-pen" />
                                            </button>
                                            <button
                                                class="action-btn reset-btn"
                                                title="Resetar senha"
                                                data-id={u.id}
                                                data-name={u.name}
                                                onclick="openResetModal(this)"
                                            >
                                                <i class="fas fa-key" />
                                            </button>
                                            <button
                                                class="action-btn delete-btn"
                                                title="Excluir cliente"
                                                data-id={u.id}
                                                data-name={u.name}
                                                onclick="openDeleteModal(this)"
                                            >
                                                <i class="fas fa-trash" />
                                            </button>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    )
                }
            </div>
        </main>
    </div>

    <!-- EDIT MODAL -->
    <div id="edit-modal" class="modal-backdrop hidden">
        <div class="modal-box">
            <div class="modal-hdr">
                <h2><i class="fas fa-pen"></i> Editar Cliente</h2>
                <button class="modal-close" onclick="closeModal('edit-modal')"
                    ><i class="fas fa-times"></i></button
                >
            </div>
            <form id="edit-user-form" class="modal-form">
                <input type="hidden" id="edit-id" name="id" />
                <div class="field">
                    <label>Nome</label>
                    <input type="text" id="edit-name" name="name" required />
                </div>
                <div class="field">
                    <label>E-mail ou WhatsApp</label>
                    <input type="text" id="edit-email" name="email" required />
                </div>
                <div class="field">
                    <label>Plano</label>
                    <select id="edit-plan" name="plan">
                        <option value="FREE">Free</option>
                        <option value="BRONZE">Bronze</option>
                        <option value="PRATA">Prata</option>
                        <option value="OURO">Ouro</option>
                        <option value="PARCEIRO">Parceiro</option>
                    </select>
                </div>
                <div class="field">
                    <label>URL do Site</label>
                    <input
                        type="text"
                        id="edit-siteUrl"
                        name="siteUrl"
                        placeholder="https://..."
                    />
                </div>
                <div class="field">
                    <label>Data de Cadastro</label>
                    <input type="date" id="edit-createdAt" name="createdAt" />
                </div>
                <button type="submit" class="btn-modal-submit">
                    <i class="fas fa-check"></i> Salvar Alterações
                </button>
            </form>
        </div>
    </div>

    <!-- RESET PASSWORD MODAL -->
    <div id="reset-modal" class="modal-backdrop hidden">
        <div class="modal-box">
            <div class="modal-hdr">
                <h2><i class="fas fa-key"></i> Resetar Senha</h2>
                <button class="modal-close" onclick="closeModal('reset-modal')"
                    ><i class="fas fa-times"></i></button
                >
            </div>
            <p class="modal-desc">
                Nova senha para <strong id="reset-user-name">Usuário</strong>
            </p>
            <form id="reset-password-form" class="modal-form">
                <input type="hidden" id="reset-id" name="userId" />
                <div class="field">
                    <label>Nova Senha</label>
                    <input
                        type="text"
                        name="newPassword"
                        placeholder="Mínimo 6 caracteres"
                        required
                    />
                </div>
                <button type="submit" class="btn-modal-submit">
                    <i class="fas fa-lock"></i> Alterar Senha
                </button>
            </form>
        </div>
    </div>

    <!-- DELETE MODAL -->
    <div id="delete-modal" class="modal-backdrop hidden">
        <div class="modal-box modal-box--sm">
            <div class="modal-hdr">
                <h2><i class="fas fa-trash"></i> Excluir Cliente</h2>
                <button class="modal-close" onclick="closeModal('delete-modal')"
                    ><i class="fas fa-times"></i></button
                >
            </div>
            <p class="modal-desc">
                Tem certeza que deseja excluir <strong id="delete-user-name"
                    >Usuário</strong
                >?
            </p>
            <p class="warning-text">
                <i class="fas fa-exclamation-triangle"></i> Esta ação não pode ser
                desfeita.
            </p>
            <div class="modal-actions">
                <button class="btn-cancel" onclick="closeModal('delete-modal')"
                    >Cancelar</button
                >
                <button id="confirm-delete-btn" class="btn-delete"
                    ><i class="fas fa-trash"></i> Confirmar</button
                >
            </div>
        </div>
    </div>

    <StatusModal
        id="admin-status-modal"
        title="Processando..."
        message="Aguarde um momento"
        type="loading"
    />
</Layout>

<script is:inline>
    // Toggle create panel
    const toggleBtns = ["toggle-create-form", "toggle-create-form-2"];
    toggleBtns.forEach((id) => {
        const btn = document.getElementById(id);
        if (btn)
            btn.addEventListener("click", () => {
                document
                    .getElementById("create-panel")
                    .classList.toggle("open");
            });
    });
    document
        .getElementById("close-create-panel")
        ?.addEventListener("click", () => {
            document.getElementById("create-panel").classList.remove("open");
        });

    // Modal helpers
    window.openEditModal = (btn) => {
        const user = JSON.parse(btn.getAttribute("data-user"));
        document.getElementById("edit-id").value = user.id;
        document.getElementById("edit-name").value = user.name;
        document.getElementById("edit-email").value = user.email;
        document.getElementById("edit-plan").value = user.plan;
        document.getElementById("edit-siteUrl").value = user.siteUrl || "";

        if (user.createdAt) {
            const date = new Date(user.createdAt);
            document.getElementById("edit-createdAt").value = date
                .toISOString()
                .split("T")[0];
        } else {
            document.getElementById("edit-createdAt").value = "";
        }

        document.getElementById("edit-modal").classList.remove("hidden");
    };
    window.openResetModal = (btn) => {
        document.getElementById("reset-id").value = btn.dataset.id;
        document.getElementById("reset-user-name").innerText = btn.dataset.name;
        document.getElementById("reset-modal").classList.remove("hidden");
    };
    let deleteUserId = null;
    window.openDeleteModal = (btn) => {
        deleteUserId = btn.dataset.id;
        document.getElementById("delete-user-name").innerText =
            btn.dataset.name;
        document.getElementById("delete-modal").classList.remove("hidden");
    };
    window.closeModal = (id) =>
        document.getElementById(id).classList.add("hidden");
    window.onclick = (e) => {
        if (e.target.classList.contains("modal-backdrop"))
            e.target.classList.add("hidden");
    };

    // Shared helper
    async function handleAction(url, formEl, onSuccess) {
        const data = Object.fromEntries(new FormData(formEl));
        window.showModal?.("Processando...", "Aguarde", "loading");
        try {
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
            });
            const result = await res.json();
            if (res.ok) {
                window.showModal?.("Sucesso!", result.message, "success");
                formEl.reset();
                if (onSuccess) setTimeout(onSuccess, 1500);
                else setTimeout(() => window.hideModal?.(), 2000);
            } else {
                window.showModal?.(
                    "Erro",
                    result.message || "Algo deu errado",
                    "error",
                );
                setTimeout(() => window.hideModal?.(), 3000);
            }
        } catch {
            window.showModal?.("Erro", "Falha de conexão", "error");
            setTimeout(() => window.hideModal?.(), 3000);
        }
    }

    document
        .getElementById("create-user-form")
        ?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = document.getElementById("submit-btn");
            if (btn)
                btn.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Cadastrando...';
            await handleAction("/api/admin/create-user", e.target, () =>
                window.location.reload(),
            );
            if (btn)
                btn.innerHTML =
                    '<i class="fas fa-check"></i> Cadastrar Cliente';
        });

    document
        .getElementById("edit-user-form")
        ?.addEventListener("submit", async (e) => {
            e.preventDefault();
            window.closeModal("edit-modal");
            await handleAction("/api/admin/update-user", e.target, () =>
                window.location.reload(),
            );
        });

    document
        .getElementById("reset-password-form")
        ?.addEventListener("submit", async (e) => {
            e.preventDefault();
            window.closeModal("reset-modal");
            await handleAction("/api/admin/reset-password", e.target, () =>
                window.location.reload(),
            );
        });

    document
        .getElementById("confirm-delete-btn")
        ?.addEventListener("click", async () => {
            window.closeModal("delete-modal");
            window.showModal?.("Excluindo...", "Removendo cliente", "loading");
            try {
                const res = await fetch("/api/admin/delete-user", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ userId: deleteUserId }),
                });
                if (res.ok) {
                    window.showModal?.(
                        "Removido!",
                        "Cliente excluído com sucesso.",
                        "success",
                    );
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    const d = await res.json();
                    window.showModal?.(
                        "Erro",
                        d.message || "Falha ao excluir",
                        "error",
                    );
                    setTimeout(() => window.hideModal?.(), 3000);
                }
            } catch {
                window.showModal?.("Erro", "Erro de conexão", "error");
                setTimeout(() => window.hideModal?.(), 3000);
            }
        });

    // Phone mask
    ["email", "edit-email"].forEach((id) => {
        const el = document.getElementById(id);
        if (el)
            el.addEventListener("input", (e) => {
                if (/^\d/.test(e.target.value)) {
                    let v = e.target.value.replace(/\D/g, "").slice(0, 11);
                    if (v.length > 7)
                        e.target.value = `(${v.slice(0, 2)}) ${v.slice(2, 7)}-${v.slice(7)}`;
                    else if (v.length > 2)
                        e.target.value = `(${v.slice(0, 2)}) ${v.slice(2)}`;
                    else e.target.value = v;
                }
            });
    });
</script>

<style>
    :root {
        --color-primary: #8a1c26;
        --glass-border: rgba(255, 255, 255, 0.06);
    }

    .dashboard-container {
        display: flex;
        min-height: 100vh;
        background: #050505;
        color: #fff;
    }

    .main-content {
        flex: 1;
        padding: 3rem;
        overflow-x: hidden;
    }

    /* Header */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .user-welcome h1 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 800;
        background: linear-gradient(135deg, #fff 0%, #888 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.25rem;
    }

    .user-welcome p {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.95rem;
    }

    .add-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--color-primary);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 4px 15px rgba(138, 28, 38, 0.3);
    }

    .add-btn:hover {
        background: #a52030;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 12px 25px rgba(138, 28, 38, 0.5);
    }

    .add-btn i {
        font-size: 1.1rem;
        transition: transform 0.4s;
    }

    .add-btn:hover i {
        transform: rotate(90deg);
    }

    /* Create Panel */
    .create-panel {
        max-height: 0;
        overflow: hidden;
        transition:
            max-height 0.4s ease,
            opacity 0.3s;
        opacity: 0;
        margin-bottom: 0;
    }

    .create-panel.open {
        max-height: 600px;
        opacity: 1;
        margin-bottom: 2rem;
    }

    .panel-inner {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 2rem;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 1.05rem;
        color: #fff;
        margin-bottom: 1.5rem;
    }

    .panel-title i {
        color: var(--color-primary);
    }

    .close-panel-btn {
        margin-left: auto;
        background: rgba(255, 255, 255, 0.06);
        border: none;
        color: #888;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

    .close-panel-btn:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.12);
    }

    .create-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .field.full {
        grid-column: 1 / -1;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field label {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .field input,
    .field select {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #fff;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        outline: none;
        transition: 0.2s;
        width: 100%;
        appearance: none;
    }

    .field input:focus,
    .field select:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 2px rgba(138, 28, 38, 0.2);
    }

    .field select option {
        background: #1a1a1a;
    }

    .btn-create {
        background: #fff;
        color: var(--color-primary);
        border: none;
        padding: 0.85rem 2rem;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.95rem;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-create:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
    }

    /* Table */
    .table-card {
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        overflow: hidden;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

    .users-table thead {
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid var(--glass-border);
    }

    .users-table th {
        padding: 14px 18px;
        text-align: left;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(255, 255, 255, 0.35);
        font-weight: 700;
    }

    .users-table td {
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.75);
        vertical-align: middle;
    }

    .users-table tbody tr:last-child td {
        border-bottom: none;
    }

    .users-table tbody tr:hover td {
        background: rgba(255, 255, 255, 0.025);
    }

    .td-name {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-initials {
        width: 36px;
        height: 36px;
        min-width: 36px;
        background: rgba(138, 28, 38, 0.25);
        color: var(--color-primary);
        border: 1px solid rgba(138, 28, 38, 0.3);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.95rem;
    }

    .name-text {
        color: #fff;
        font-weight: 600;
    }

    .plan-badge {
        border: 1px solid;
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .site-link {
