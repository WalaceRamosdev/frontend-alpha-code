---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const title = "Sistemas Personalizados | Alpha Code";
const description = "Soluções robustas e exclusivas para o seu negócio.";

export const prerender = false;
---

<BaseLayout title={title} description={description} showWhatsApp={true}>
    <!-- OPEN ACCESS DURING PRE-LAUNCH (Removed Restriction) -->

    <div class="sistemas-page">
        <!-- 1️⃣ HERO PRINCIPAL -->
        <section class="hero-sistemas">
            <div class="container text-center">
                <span class="badge-institutional fade-up"
                    >Desenvolvimento Consultivo</span
                >
                <h1 class="fade-up delay-1">
                    Tenha seu próprio sistema e <span class="text-gradient"
                        >pare de depender</span
                    > de plataformas.
                </h1>
                <p class="hero-subheadline fade-up delay-2">
                    Foco em controle total, escalabilidade ilimitada e autonomia
                    operacional para o seu negócio.
                </p>
                <div class="hero-actions fade-up delay-3">
                    <Button href="#diagnostico" variant="primary" size="lg"
                        >Solicitar Análise do Projeto</Button
                    >
                    <Button
                        href="https://wa.me/5521999064502"
                        variant="outline"
                        size="lg">Falar com Especialista</Button
                    >
                </div>
            </div>
            <div class="ambient-glow"></div>
        </section>

        <!-- 2️⃣ SEÇÃO DE DOR (Enxuta e Direta) -->
        <section class="problema-section">
            <div class="container">
                <div class="section-grid">
                    <div class="section-header">
                        <h2>
                            Seu negócio está crescendo, mas sua estrutura <span
                                class="text-gradient">acompanha?</span
                            >
                        </h2>
                        <p>
                            O sucesso traz complexidade. Se você sente que está
                            perdendo o controle, é hora de agir antes que o
                            gargalo pare sua operação.
                        </p>
                    </div>
                    <div class="pains-grid">
                        <div class="pain-card">
                            <span class="pain-icon"
                                ><i class="fa-solid fa-hand-holding-dollar"
                                ></i></span
                            >
                            <h3>Taxas Abusivas</h3>
                            <p>
                                Pare de entregar sua margem para plataformas de
                                terceiros.
                            </p>
                        </div>
                        <div class="pain-card">
                            <span class="pain-icon"
                                ><i class="fa-solid fa-arrow-trend-down"
                                ></i></span
                            >
                            <h3>Perda de Pedidos</h3>
                            <p>
                                Processos manuais e lentos fazem você perder
                                vendas valiosas.
                            </p>
                        </div>
                        <div class="pain-card">
                            <span class="pain-icon"
                                ><i class="fa-solid fa-gears"></i></span
                            >
                            <h3>Processos Manuais</h3>
                            <p>
                                Dependência de terceiros e tarefas que deveriam
                                ser automáticas.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3️⃣ TRANSIÇÃO PARA DIAGNÓSTICO -->
        <section class="transicao-diag fade-up">
            <div class="container text-center">
                <h2>
                    Descubra o nível <span class="text-gradient">ideal</span> da sua
                    estrutura digital
                </h2>
                <p class="tension-text-light">
                    Antes de falar em investimento, precisamos entender a
                    maturidade e os requisitos reais da sua operação
                    corporativa.
                </p>
                <div class="mt-4">
                    <Button
                        href="#diagnostico"
                        variant="primary"
                        size="lg"
                        class="btn-glow">INICIAR DIAGNÓSTICO ESTRATÉGICO</Button
                    >
                </div>
            </div>
        </section>

        <!-- 4️⃣ CALCULADORA MULTI-STEP -->
        <section id="diagnostico" class="diagnostico-section">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="badge-institutional"
                        >Ferramenta de Qualificação</span
                    >
                    <h2>
                        Diagnóstico de <span class="text-gradient"
                            >Complexidade Tecnológica</span
                        >
                    </h2>
                    <p class="section-subtitle">
                        Responda o mapeamento abaixo para classificarmos seu
                        projeto e estimarmos o cenário ideal.
                    </p>
                </div>

                <div class="diagnostico-wrapper">
                    <div class="diag-card glass-premium">
                        <!-- Progress Bar -->
                        <div class="diag-progress">
                            <div
                                class="progress-bar-inner"
                                id="progress-bar"
                                style="width: 20%;"
                            >
                            </div>
                            <span class="step-counter"
                                >Etapa <span id="current-step-num">1</span> de 5</span
                            >
                        </div>

                        <form id="diagnostico-form" class="diag-form">
                            <!-- STEP 1: Tipo de Negócio -->
                            <div class="diag-step active" data-step="1">
                                <h3>Qual o segmento do seu negócio?</h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="RESTAURANTE"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-utensils"
                                                ></i></span
                                            >
                                            <span>Restaurante / Lanchonete</span
                                            >
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="ESCRITORIO"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-building-user"
                                                ></i></span
                                            >
                                            <span>Escritório / Serviços</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="CLINICA"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-notes-medical"
                                                ></i></span
                                            >
                                            <span>Clínica / Saúde</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="OUTRO"
                                            id="radio-outro"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-briefcase"
                                                ></i></span
                                            >
                                            <span>Outro Negócio</span>
                                        </div>
                                    </label>
                                </div>
                                <input
                                    type="hidden"
                                    name="negocio_custom"
                                    id="negocio_custom_hidden"
                                />
                            </div>

                            <!-- STEP 2: Estrutura Atual -->
                            <div class="diag-step" data-step="2">
                                <h3>Como você gerencia sua operação hoje?</h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="MANUAL"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-pen-to-square"
                                                ></i></span
                                            >
                                            <span>Operação Manual</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="PLANILHAS"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-chart-line"
                                                ></i></span
                                            >
                                            <span>Uso de Planilhas</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="TERCEIRIZADO"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-globe"
                                                ></i></span
                                            >
                                            <span>Sistema Terceirizado</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="PROPRIO"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-rocket"
                                                ></i></span
                                            >
                                            <span
                                                >Já possui sistema próprio</span
                                            >
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 3: Funcionalidades -->
                            <div class="diag-step" data-step="3">
                                <h3>Quais funcionalidades são essenciais?</h3>
                                <div class="checkbox-grid">
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="pedidos"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Pedidos Online</span
                                            >
                                            <p class="check-desc">
                                                Sistema completo para delivery e
                                                pedidos em mesa.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="agendamento"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Agendamento</span
                                            >
                                            <p class="check-desc">
                                                Gestão inteligente de horários e
                                                profissionais.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="usuarios"
                                            data-weight="2"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Múltiplos Usuários</span
                                            >
                                            <p class="check-desc">
                                                Controle de permissões para toda
                                                sua equipe.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="financeiro"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Controle Financeiro</span
                                            >
                                            <p class="check-desc">
                                                Fluxo de caixa, DRE e gestão de
                                                pagamentos.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="relatorios"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Relatórios Avançados</span
                                            >
                                            <p class="check-desc">
                                                Dashboards métricos para
                                                decisões baseadas em dados.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="pagamento"
                                            data-weight="4"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Integração de Pagamento</span
                                            >
                                            <p class="check-desc">
                                                Receba via PIX, Cartão e Boleto
                                                direto no sistema.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="estoque"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Controle de Estoque</span
                                            >
                                            <p class="check-desc">
                                                Gestão de inventário e alertas
                                                de reposição.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="prontuario"
                                            data-weight="4"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Prontuário Digital</span
                                            >
                                            <p class="check-desc">
                                                Histórico completo e seguro de
                                                pacientes ou clientes.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="admin"
                                            data-weight="2"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >Painel Administrativo</span
                                            >
                                            <p class="check-desc">
                                                Visão 360º de toda a operação.
                                            </p>
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="pwa"
                                            data-weight="4"
                                        />
                                        <div class="cb-content">
                                            <span class="check-label"
                                                >App ou PWA</span
                                            >
                                            <p class="check-desc">
                                                Interface instalável para
                                                dispositivos móveis.
                                            </p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 4: Escala -->
                            <div class="diag-step" data-step="4">
                                <h3>Qual a escala atual do seu negócio?</h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="1"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-location-dot"
                                                ></i></span
                                            >
                                            <span>1 Unidade</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="5"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-map-location-dot"
                                                ></i></span
                                            >
                                            <span>2 a 5 Unidades</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="10"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-city"
                                                ></i></span
                                            >
                                            <span>Multi-filial / Franquia</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="DIGITAL"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-globe"
                                                ></i></span
                                            >
                                            <span
                                                >Digital / Escala Nacional</span
                                            >
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 5: Orçamento -->
                            <div class="diag-step" data-step="5">
                                <h3>
                                    Qual o orçamento estimado para o projeto?
                                </h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="5k"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-credit-card"
                                                ></i></span
                                            >
                                            <span>Até R$ 5.000</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="10k"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i
                                                    class="fa-solid fa-money-bill-trend-up"
                                                ></i></span
                                            >
                                            <span>R$ 5.000 a R$ 10.000</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="20k"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-gem"
                                                ></i></span
                                            >
                                            <span>R$ 10.000 a R$ 20.000</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="UP"
                                        />
                                        <div class="option-content">
                                            <span class="icon"
                                                ><i class="fa-solid fa-crown"
                                                ></i></span
                                            >
                                            <span>Acima de R$ 20.000</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Navigation Buttons -->
                            <div class="diag-nav">
                                <button
                                    type="button"
                                    id="prev-btn"
                                    class="btn-diag-nav hidden">Anterior</button
                                >
                                <button
                                    type="button"
                                    id="next-btn"
                                    class="btn-diag-nav primary"
                                    >Continuar</button
                                >
                                <button
                                    type="button"
                                    id="finish-btn"
                                    class="btn-diag-nav primary hidden"
                                    >Ver Resultado</button
                                >
                            </div>
                        </form>

                        <!-- RESULT SCREEN (Initially Hidden) -->
                        <div id="diag-result" class="diag-result hidden-result">
                            <div class="result-header">
                                <span class="badge-success"
                                    >Diagnóstico Concluído</span
                                >
                                <h2>
                                    Nível do Projeto: <span
                                        id="res-nivel"
                                        class="text-gradient">---</span
                                    >
                                </h2>
                            </div>

                            <div class="result-stats">
                                <div class="stat-box">
                                    <span class="label">Complexidade</span>
                                    <span class="value" id="res-complex"
                                        >---</span
                                    >
                                </div>
                                <div class="stat-box">
                                    <span class="label"
                                        >Investimento Estimado</span
                                    >
                                    <span class="value" id="res-invest"
                                        >---</span
                                    >
                                </div>
                                <div class="stat-box">
                                    <span class="label">Prazo Estimado</span>
                                    <span class="value" id="res-prazo">---</span
                                    >
                                </div>
                            </div>

                            <div class="result-plan">
                                <h3>Estrutura Recomendada</h3>
                                <p id="res-desc">
                                    Carregando análise técnica...
                                </p>
                            </div>

                            <div class="lead-capture">
                                <p>
                                    Preencha o formulário abaixo para receber
                                    seu diagnóstico completo em PDF e falar com
                                    um especialista.
                                </p>
                                <div id="lead-form-trigger">
                                    <Button
                                        variant="primary"
                                        size="lg"
                                        id="open-lead-btn"
                                        >Receber Relatório Completo</Button
                                    >
                                </div>

                                <form
                                    id="lead-capture-form"
                                    class="lead-form hidden"
                                >
                                    <div class="l-group">
                                        <input
                                            type="text"
                                            id="l-name"
                                            placeholder="Seu Nome Completo"
                                            required
                                        />
                                    </div>
                                    <div class="l-group">
                                        <input
                                            type="tel"
                                            id="l-whatsapp"
                                            placeholder="Seu WhatsApp (com DDD)"
                                            required
                                        />
                                    </div>
                                    <div class="l-group">
                                        <input
                                            type="email"
                                            id="l-email"
                                            placeholder="Seu Melhor E-mail"
                                            required
                                        />
                                    </div>
                                    <button
                                        type="submit"
                                        class="btn-submit-lead"
                                        >BAIXAR RELATÓRIO PDF DETALHADO</button
                                    >
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5️⃣ SISTEMA SOB MEDIDA (Reforço após o diagnóstico) -->
        <section class="entregamos-section">
            <div class="container">
                <div class="text-center mb-5">
                    <h2>
                        Sistema <span class="text-gradient">sob medida</span> para
                        sua operação.
                    </h2>
                    <p class="section-subtitle">
                        Tecnologia desenhada para resolver as dores reais do seu
                        negócio e escalar seu lucro.
                    </p>
                </div>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Gestão Centralizada</h3>
                                <p>
                                    Tudo o que acontece na sua empresa em um
                                    único painel de controle estratégico.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Automação Inteligente</h3>
                                <p>
                                    Elimine falhas humanas com fluxos
                                    automáticos de pedidos e agendamentos.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Painel Administrativo</h3>
                                <p>
                                    Gestão simplificada e interface intuitiva
                                    para sua equipe operar com velocidade.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Relatórios de Inteligência</h3>
                                <p>
                                    Visão clara do seu negócio para tomar
                                    decisões baseadas em lucros reais.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Escalabilidade Corporativa</h3>
                                <p>
                                    Infraestrutura preparada para suportar o
                                    crescimento sem limites técnicos.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6️⃣ SEGMENTOS ATENDIDOS -->
        <section class="publico-section">
            <div class="container">
                <div class="text-center mb-5">
                    <h2>
                        Especialização em <span class="text-gradient"
                            >Nichos de Alta Peformance</span
                        >
                    </h2>
                </div>
                <div class="publico-grid">
                    <div class="publico-card">
                        <div class="p-icon">
                            <i class="fa-solid fa-utensils"></i>
                        </div>
                        <h3>Restaurantes e Lanchonetes</h3>
                        <p>
                            Delivery próprio sem taxas de terceiros,
                            sincronização de mesas e estoque em tempo real.
                        </p>
                    </div>
                    <div class="publico-card">
                        <div class="p-icon">
