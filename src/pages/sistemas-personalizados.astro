<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector(
            "#diagnostico-form",
        ) as HTMLFormElement | null;
        if (!form) return;

        const steps = document.querySelectorAll(".diag-step");
        const progressBar = document.querySelector(
            "#progress-bar",
        ) as HTMLElement | null;
        const currentStepNum = document.querySelector(
            "#current-step-num",
        ) as HTMLElement | null;
        const prevBtn = document.querySelector(
            "#prev-btn",
        ) as HTMLButtonElement | null;
        const nextBtn = document.querySelector(
            "#next-btn",
        ) as HTMLButtonElement | null;
        const finishBtn = document.querySelector(
            "#finish-btn",
        ) as HTMLButtonElement | null;
        const resultScreen = document.querySelector(
            "#diag-result",
        ) as HTMLElement | null;

        let currentStep = 1;

        const updateStep = () => {
            steps.forEach((s) => s.classList.remove("active"));
            const activeStep = document.querySelector(
                `.diag-step[data-step="${currentStep}"]`,
            );
            if (activeStep) activeStep.classList.add("active");

            // Progress Bar
            if (progressBar) {
                const progress = (currentStep / steps.length) * 100;
                progressBar.style.width = `${progress}%`;
            }
            if (currentStepNum) {
                currentStepNum.innerText = currentStep.toString();
            }

            // Nav Buttons
            if (prevBtn) {
                if (currentStep === 1) prevBtn.classList.add("hidden");
                else prevBtn.classList.remove("hidden");
            }

            if (nextBtn && finishBtn) {
                if (currentStep === steps.length) {
                    nextBtn.classList.add("hidden");
                    finishBtn.classList.remove("hidden");
                } else {
                    nextBtn.classList.remove("hidden");
                    finishBtn.classList.add("hidden");
                }
            }

            checkValidity();
        };

        const checkValidity = () => {
            const activeStep = document.querySelector(
                `.diag-step[data-step="${currentStep}"]`,
            );
            if (!activeStep) return;

            let isValid = false;

            const radios = activeStep.querySelectorAll(
                'input[type="radio"]',
            ) as NodeListOf<HTMLInputElement>;
            const checkboxes = activeStep.querySelectorAll(
                'input[type="checkbox"]',
            ) as NodeListOf<HTMLInputElement>;

            if (radios.length > 0) {
                const checkedRadio = activeStep.querySelector(
                    'input[type="radio"]:checked',
                ) as HTMLInputElement;
                if (checkedRadio) {
                    isValid = true;
                    // Special case for OUTRO
                    if (checkedRadio.value === "OUTRO") {
                        const hiddenVal = (
                            document.getElementById(
                                "negocio_custom_hidden",
                            ) as HTMLInputElement
                        )?.value;
                        if (!hiddenVal) isValid = false;
                    }
                }
            } else if (checkboxes.length > 0) {
                const checkedCheckboxes = activeStep.querySelectorAll(
                    'input[type="checkbox"]:checked',
                );
                isValid = checkedCheckboxes.length > 0;
            }

            if (nextBtn) nextBtn.disabled = !isValid;
            if (finishBtn) finishBtn.disabled = !isValid;
        };

        // Listen for changes
        form.addEventListener("change", checkValidity);
        form.addEventListener("input", checkValidity);

        // Initialize first step
        updateStep();

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                if (currentStep < steps.length) {
                    currentStep++;
                    updateStep();
                    const targetTop =
                        form.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({
                        top: targetTop,
                        behavior: "smooth",
                    });
                }
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                if (currentStep > 1) {
                    currentStep--;
                    updateStep();
                }
            });
        }

        // Handle Custom Business Logic (Modal)
        const modalOutro = document.getElementById("modal-outro");
        const modalInput = document.getElementById(
            "modal-negocio-input",
        ) as HTMLInputElement | null;
        const btnSaveModal = document.getElementById("btn-save-modal");
        const btnCancelModal = document.getElementById("btn-cancel-modal");
        const hiddenInput = document.getElementById(
            "negocio_custom_hidden",
        ) as HTMLInputElement | null;
        const radioOutro = document.getElementById(
            "radio-outro",
        ) as HTMLInputElement | null;

        const openModal = () => {
            modalOutro?.classList.remove("hidden");
            setTimeout(() => modalInput?.focus(), 100);
        };

        const closeModal = () => modalOutro?.classList.add("hidden");

        radioOutro?.addEventListener("click", (e) => {
            openModal();
        });

        btnSaveModal?.addEventListener("click", () => {
            if (modalInput && hiddenInput) {
                hiddenInput.value = modalInput.value;
                if (modalInput.value) {
                    closeModal();
                    checkValidity();
                } else {
                    alert("Por favor, informe o seu tipo de negócio.");
                }
            }
        });

        btnCancelModal?.addEventListener("click", () => {
            if (radioOutro) radioOutro.checked = false;
            if (hiddenInput) hiddenInput.value = "";
            closeModal();
            checkValidity();
        });

        if (finishBtn) {
            finishBtn.addEventListener("click", () => {
                calculateResult();
                form.classList.add("hidden");
                if (resultScreen) {
                    resultScreen.classList.remove("hidden-result");
                    const targetTop =
                        resultScreen.getBoundingClientRect().top +
                        window.scrollY -
                        100;
                    window.scrollTo({
                        top: targetTop,
                        behavior: "smooth",
                    });
                }
            });
        }

        // 🧮 CALCULATION LOGIC
        const calculateResult = () => {
            const formData = new FormData(form);

            // 1. Calculate Score
            let score = 0;

            // Weights from current structure
            const estrutura = formData.get("estrutura") as string | null;
            if (estrutura === "PLANILHAS") score += 3;
            if (estrutura === "TERCEIRIZADO") score += 6;
            if (estrutura === "PROPRIO") score += 9;

            // Multiple Checkbox Weights
            const funcoes = form.querySelectorAll(
                'input[name="funcao"]:checked',
            ) as NodeListOf<HTMLInputElement>;
            funcoes.forEach((cb) => {
                score += parseInt(cb.getAttribute("data-weight") || "0");
            });

            const escala = parseInt((formData.get("escala") as string) || "1");
            score += escala;

            // 2. Classify
            let nivel = "Essencial";
            let complexidade = "Baixa";
            let investimento = "R$ 4.900 a R$ 7.000";
            let prazo = "20 a 35 dias";
            let desc = "";

            if (score > 40) {
                nivel = "Enterprise";
                complexidade = "Alta";
                investimento = "Acima de R$ 20.000";
                prazo = "90+ dias";
                desc =
                    "Seu projeto exige uma infraestrutura de alta escalabilidade, com APIs robustas, inteligência de dados e processos multinível. Recomendamos um sistema com arquitetura de microsserviços e segurança bancária.";
            } else if (score > 25) {
                nivel = "Avançado";
                complexidade = "Alta";
                investimento = "R$ 12.000 a R$ 20.000";
                prazo = "45 a 75 dias";
                desc =
                    "Você precisa de um sistema completo para dominar o nicho. Integrações complexas de pagamento, controle total de estoque e múltiplos níveis de acesso. Foco em automação total da operação.";
            } else if (score > 12) {
                nivel = "Intermediário";
                complexidade = "Média";
                investimento = "R$ 7.000 a R$ 12.000";
                prazo = "30 a 50 dias";
                desc =
                    "Seu negócio já está em fase de expansão. Recomendamos um sistema centralizado com foco em relatórios estratégicos e automação de pedidos/agendamentos para reduzir gargalos.";
            } else {
                nivel = "Essencial";
                complexidade = "Baixa";
                investimento = "R$ 4.900 a R$ 7.000";
                prazo = "20 a 35 dias";
                desc =
                    "Indicado para validar processos digitais. Um sistema ágil focado nas dores principais (como pedidos ou agendamentos) para tirar a operação do papel ou planilhas.";
            }

            // Update UI
            const resNivel = document.querySelector(
                "#res-nivel",
            ) as HTMLElement | null;
            const resComplex = document.querySelector(
                "#res-complex",
            ) as HTMLElement | null;
            const resInvest = document.querySelector(
                "#res-invest",
            ) as HTMLElement | null;
            const resPrazo = document.querySelector(
                "#res-prazo",
            ) as HTMLElement | null;
            const resDesc = document.querySelector(
                "#res-desc",
            ) as HTMLElement | null;

            if (resNivel) resNivel.innerText = nivel;
            if (resComplex) resComplex.innerText = complexidade;
            if (resInvest) resInvest.innerText = investimento;
            if (resPrazo) resPrazo.innerText = prazo;
            if (resDesc) resDesc.innerText = desc;
        };

        // 📩 LEAD CAPTURE
        const openLeadBtn = document.querySelector(
            "#open-lead-btn",
        ) as HTMLButtonElement | null;
        const leadForm = document.querySelector(
            "#lead-capture-form",
        ) as HTMLFormElement | null;
        const triggerDiv = document.querySelector(
            "#lead-form-trigger",
        ) as HTMLElement | null;

        if (openLeadBtn && triggerDiv && leadForm) {
            openLeadBtn.addEventListener("click", () => {
                triggerDiv.classList.add("hidden");
                leadForm.classList.remove("hidden");
            });

            leadForm.addEventListener("submit", async (e) => {
                e.preventDefault();

                const btnSubmit = leadForm.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement | null;
                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerText = "GERANDO DIAGNÓSTICO...";
                }

                const nameInput = document.querySelector(
                    "#l-name",
                ) as HTMLInputElement | null;
                const whatsappInput = document.querySelector(
                    "#l-whatsapp",
                ) as HTMLInputElement | null;
                const emailInput = document.querySelector(
                    "#l-email",
                ) as HTMLInputElement | null;
                const nivelRes =
                    (document.querySelector("#res-nivel") as HTMLElement | null)
                        ?.innerText || "";

                if (!nameInput || !whatsappInput || !emailInput) return;

                const name = nameInput.value;
                const whatsapp = whatsappInput.value;
                const email = emailInput.value;

                // Collect referral info
                const referredBy = localStorage.getItem("alpha_ref_code");

                // Collect diagnostic data
                const diagFormData = new FormData(form);
                const diagnosticData: any = {};
                diagFormData.forEach((value, key) => {
                    if (diagnosticData[key]) {
                        if (!Array.isArray(diagnosticData[key])) {
                            diagnosticData[key] = [diagnosticData[key]];
                        }
                        diagnosticData[key].push(value);
                    } else {
                        diagnosticData[key] = value;
                    }
                });

                try {
                    const response = await fetch(
                        "/api/generate-diagnosis-pdf",
                        {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                contact: { name, whatsapp, email },
                                diagnosis: diagnosticData,
                                referredBy: referredBy || null,
                                results: {
                                    level: nivelRes,
                                    complexity:
                                        (
                                            document.querySelector(
                                                "#res-complex",
                                            ) as HTMLElement | null
                                        )?.innerText || "",
                                    investment:
                                        (
                                            document.querySelector(
                                                "#res-invest",
                                            ) as HTMLElement | null
                                        )?.innerText || "",
                                    timeline:
                                        (
                                            document.querySelector(
                                                "#res-prazo",
                                            ) as HTMLElement | null
                                        )?.innerText || "",
                                },
                            }),
                        },
                    );

                    const result = await response.json();

                    if (result.success) {
                        // Automatic Download
                        const downloadLink = document.createElement("a");
                        downloadLink.href = result.pdfUrl;
                        downloadLink.download = "Diagnostico_AlphaCode.pdf";
                        document.body.appendChild(downloadLink);
                        downloadLink.click();
                        document.body.removeChild(downloadLink);

                        // Success UI
                        leadForm.innerHTML = `
                            <div class="success-message premium-card-success">
                                <div class="success-icon-wrap">
                                    <div class="success-icon-circle">
                                        <span class="check-icon"><i class="fa-solid fa-check"></i></span>
                                    </div>
                                </div>
                                <h4>Diagnóstico Concluído!</h4>
                                <p class="success-subtitle">O download do seu relatório PDF detalhado iniciou automaticamente.</p>
                                
                                <div class="next-step-box-premium">
                                    <h5 class="next-step-title">PRÓXIMO PASSO ESTRATÉGICO</h5>
                                    <p>Relatório em mãos? Agora valide seu diagnóstico e tire dúvidas técnicas com um de nossos especialistas:</p>
                                    <button id="final-analysis-btn" class="btn-whatsapp-premium">
                                        SOLICITAR ANÁLISE NO WHATSAPP
                                    </button>
                                </div>
                                <p class="download-fallback">Caso o download não tenha iniciado, <a href="${result.pdfUrl}" download class="text-gradient">clique aqui para baixar</a>.</p>
                            </div>
                        `;

                        const fBtn =
                            document.getElementById("final-analysis-btn");
                        if (fBtn) {
                            fBtn.addEventListener("click", () => {
                                const msg = `Olá! Acabei de baixar meu Diagnóstico Estratégico (Nível: ${nivelRes}) e gostaria de agendar uma análise técnica gratuita.`;
                                window.open(
                                    `https://wa.me/5521999064502?text=${encodeURIComponent(msg)}`,
                                    "_blank",
                                );
                            });
                        }
                    } else {
                        throw new Error(result.error || "Erro ao gerar PDF");
                    }
                } catch (error: any) {
                    console.error("PDF Error:", error);
                    alert(
                        "Erro: " +
                            (error.message || "Falha técnica inesperada") +
                            ". Seus dados de contato foram salvos e nossa equipe entrará em contato via WhatsApp para enviar seu diagnóstico manualmente.",
                    );
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerText = "SOLICITAR ANÁLISE AGORA";
                    }
                }
            });
        }
    });
</script>

