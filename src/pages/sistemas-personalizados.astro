---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const title = "Sistemas Personalizados | Alpha Code";
const description = "Soluções robustas e exclusivas para o seu negócio.";

export const prerender = false;
---

<BaseLayout title={title} description={description} showWhatsApp={true}>
    <!-- OPEN ACCESS DURING PRE-LAUNCH (Removed Restriction) -->

    <div class="sistemas-page">
        <!-- 1️⃣ HERO PRINCIPAL -->
        <section class="hero-sistemas">
            <div class="container text-center">
                <span class="badge-institutional fade-up"
                    >Desenvolvimento Consultivo</span
                >
                <h1 class="fade-up delay-1">
                    Tenha seu próprio sistema e <span class="text-gradient"
                        >pare de depender</span
                    > de plataformas.
                </h1>
                <p class="hero-subheadline fade-up delay-2">
                    Foco em controle total, escalabilidade ilimitada e autonomia
                    operacional para o seu negócio.
                </p>
                <div class="hero-actions fade-up delay-3">
                    <Button href="#diagnostico" variant="primary" size="lg"
                        >Solicitar Análise do Projeto</Button
                    >
                    <Button
                        href="https://wa.me/5521999064502"
                        variant="outline"
                        size="lg">Falar com Especialista</Button
                    >
                </div>
            </div>
            <div class="ambient-glow"></div>
        </section>

        <!-- 2️⃣ SEÇÃO DE DOR (Enxuta e Direta) -->
        <section class="problema-section">
            <div class="container">
                <div class="section-grid">
                    <div class="section-header">
                        <h2>
                            Seu negócio está crescendo, mas sua estrutura <span
                                class="text-gradient">acompanha?</span
                            >
                        </h2>
                        <p>
                            O sucesso traz complexidade. Se você sente que está
                            perdendo o controle, é hora de agir antes que o
                            gargalo pare sua operação.
                        </p>
                    </div>
                    <div class="pains-grid">
                        <div class="pain-card">
                            <span class="pain-icon">💸</span>
                            <h3>Taxas Abusivas</h3>
                            <p>
                                Pare de entregar sua margem para plataformas de
                                terceiros.
                            </p>
                        </div>
                        <div class="pain-card">
                            <span class="pain-icon">📉</span>
                            <h3>Perda de Pedidos</h3>
                            <p>
                                Processos manuais e lentos fazem você perder
                                vendas valiosas.
                            </p>
                        </div>
                        <div class="pain-card">
                            <span class="pain-icon">⚙️</span>
                            <h3>Processos Manuais</h3>
                            <p>
                                Dependência de terceiros e tarefas que deveriam
                                ser automáticas.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3️⃣ TRANSIÇÃO PARA DIAGNÓSTICO -->
        <section class="transicao-diag fade-up">
            <div class="container text-center">
                <h2>
                    Descubra o nível <span class="text-gradient">ideal</span> da sua
                    estrutura digital
                </h2>
                <p class="tension-text-light">
                    Antes de falar em investimento, precisamos entender a
                    maturidade e os requisitos reais da sua operação
                    corporativa.
                </p>
                <div class="mt-4">
                    <Button
                        href="#diagnostico"
                        variant="primary"
                        size="lg"
                        class="btn-glow">INICIAR DIAGNÓSTICO ESTRATÉGICO</Button
                    >
                </div>
            </div>
        </section>

        <!-- 4️⃣ CALCULADORA MULTI-STEP -->
        <section id="diagnostico" class="diagnostico-section">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="badge-institutional"
                        >Ferramenta de Qualificação</span
                    >
                    <h2>
                        Diagnóstico de <span class="text-gradient"
                            >Complexidade Tecnológica</span
                        >
                    </h2>
                    <p class="section-subtitle">
                        Responda o mapeamento abaixo para classificarmos seu
                        projeto e estimarmos o cenário ideal.
                    </p>
                </div>

                <div class="diagnostico-wrapper">
                    <div class="diag-card glass-premium">
                        <!-- Progress Bar -->
                        <div class="diag-progress">
                            <div
                                class="progress-bar-inner"
                                id="progress-bar"
                                style="width: 20%;"
                            >
                            </div>
                            <span class="step-counter"
                                >Etapa <span id="current-step-num">1</span> de 5</span
                            >
                        </div>

                        <form id="diagnostico-form" class="diag-form">
                            <!-- STEP 1: Tipo de Negócio -->
                            <div class="diag-step active" data-step="1">
                                <h3>Qual o segmento do seu negócio?</h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="RESTAURANTE"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon">🍔</span>
                                            <span>Restaurante / Lanchonete</span
                                            >
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="CLINICA"
                                        />
                                        <div class="option-content">
                                            <span class="icon">🏥</span>
                                            <span>Clínica / Saúde</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="negocio"
                                            value="OUTRO"
                                        />
                                        <div class="option-content">
                                            <span class="icon">🏢</span>
                                            <span>Outro Negócio</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 2: Estrutura Atual -->
                            <div class="diag-step" data-step="2">
                                <h3>Como você gerencia sua operação hoje?</h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="MANUAL"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon">📝</span>
                                            <span>Operação Manual</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="PLANILHAS"
                                        />
                                        <div class="option-content">
                                            <span class="icon">📊</span>
                                            <span>Uso de Planilhas</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="TERCEIRIZADO"
                                        />
                                        <div class="option-content">
                                            <span class="icon">🌐</span>
                                            <span>Sistema Terceirizado</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="estrutura"
                                            value="PROPRIO"
                                        />
                                        <div class="option-content">
                                            <span class="icon">🚀</span>
                                            <span
                                                >Já possui sistema próprio</span
                                            >
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 3: Funcionalidades -->
                            <div class="diag-step" data-step="3">
                                <h3>Quais funcionalidades são essenciais?</h3>
                                <div class="checkbox-grid">
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="pedidos"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            Pedidos Online
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="agendamento"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            Agendamento
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="usuarios"
                                            data-weight="2"
                                        />
                                        <div class="cb-content">
                                            Múltiplos Usuários
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="financeiro"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            Controle Financeiro
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="relatorios"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            Relatórios Avançados
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="pagamento"
                                            data-weight="4"
                                        />
                                        <div class="cb-content">
                                            Integração de Pagamento
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="estoque"
                                            data-weight="3"
                                        />
                                        <div class="cb-content">
                                            Controle de Estoque
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="prontuario"
                                            data-weight="4"
                                        />
                                        <div class="cb-content">
                                            Prontuário Digital
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="admin"
                                            data-weight="2"
                                        />
                                        <div class="cb-content">
                                            Painel Administrativo
                                        </div>
                                    </label>
                                    <label class="checkbox-card">
                                        <input
                                            type="checkbox"
                                            name="funcao"
                                            value="pwa"
                                            data-weight="4"
                                        />
                                        <div class="cb-content">App ou PWA</div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 4: Escala -->
                            <div class="diag-step" data-step="4">
                                <h3>Qual a escala atual do seu negócio?</h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="1"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon">📍</span>
                                            <span>1 Unidade</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="5"
                                        />
                                        <div class="option-content">
                                            <span class="icon">🌍</span>
                                            <span>2 a 5 Unidades</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="escala"
                                            value="10"
                                        />
                                        <div class="option-content">
                                            <span class="icon">🏢</span>
                                            <span>Multi-filial / Franquia</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- STEP 5: Orçamento -->
                            <div class="diag-step" data-step="5">
                                <h3>
                                    Qual o orçamento estimado para o projeto?
                                </h3>
                                <div class="options-grid">
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="5k"
                                            required
                                        />
                                        <div class="option-content">
                                            <span class="icon">💳</span>
                                            <span>Até R$ 5.000</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="10k"
                                        />
                                        <div class="option-content">
                                            <span class="icon">💰</span>
                                            <span>R$ 5.000 a R$ 10.000</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="20k"
                                        />
                                        <div class="option-content">
                                            <span class="icon">💎</span>
                                            <span>R$ 10.000 a R$ 20.000</span>
                                        </div>
                                    </label>
                                    <label class="option-card">
                                        <input
                                            type="radio"
                                            name="orcamento"
                                            value="UP"
                                        />
                                        <div class="option-content">
                                            <span class="icon">📈</span>
                                            <span>Acima de R$ 20.000</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Navigation Buttons -->
                            <div class="diag-nav">
                                <button
                                    type="button"
                                    id="prev-btn"
                                    class="btn-diag-nav hidden">Anterior</button
                                >
                                <button
                                    type="button"
                                    id="next-btn"
                                    class="btn-diag-nav primary"
                                    >Continuar</button
                                >
                                <button
                                    type="button"
                                    id="finish-btn"
                                    class="btn-diag-nav primary hidden"
                                    >Ver Resultado</button
                                >
                            </div>
                        </form>

                        <!-- RESULT SCREEN (Initially Hidden) -->
                        <div id="diag-result" class="diag-result hidden-result">
                            <div class="result-header">
                                <span class="badge-success"
                                    >Diagnóstico Concluído</span
                                >
                                <h2>
                                    Nível do Projeto: <span
                                        id="res-nivel"
                                        class="text-gradient">---</span
                                    >
                                </h2>
                            </div>

                            <div class="result-stats">
                                <div class="stat-box">
                                    <span class="label">Complexidade</span>
                                    <span class="value" id="res-complex"
                                        >---</span
                                    >
                                </div>
                                <div class="stat-box">
                                    <span class="label"
                                        >Investimento Estimado</span
                                    >
                                    <span class="value" id="res-invest"
                                        >---</span
                                    >
                                </div>
                                <div class="stat-box">
                                    <span class="label">Prazo Estimado</span>
                                    <span class="value" id="res-prazo">---</span
                                    >
                                </div>
                            </div>

                            <div class="result-plan">
                                <h3>Estrutura Recomendada</h3>
                                <p id="res-desc">
                                    Carregando análise técnica...
                                </p>
                            </div>

                            <div class="lead-capture">
                                <p>
                                    Preencha o formulário abaixo para receber
                                    seu diagnóstico completo em PDF e falar com
                                    um especialista.
                                </p>
                                <div id="lead-form-trigger">
                                    <Button
                                        variant="primary"
                                        size="lg"
                                        id="open-lead-btn"
                                        >Receber Relatório Completo</Button
                                    >
                                </div>

                                <form
                                    id="lead-capture-form"
                                    class="lead-form hidden"
                                >
                                    <div class="l-group">
                                        <input
                                            type="text"
                                            id="l-name"
                                            placeholder="Seu Nome Completo"
                                            required
                                        />
                                    </div>
                                    <div class="l-group">
                                        <input
                                            type="tel"
                                            id="l-whatsapp"
                                            placeholder="Seu WhatsApp (com DDD)"
                                            required
                                        />
                                    </div>
                                    <div class="l-group">
                                        <input
                                            type="email"
                                            id="l-email"
                                            placeholder="Seu Melhor E-mail"
                                            required
                                        />
                                    </div>
                                    <button
                                        type="submit"
                                        class="btn-submit-lead"
                                        >SOLICITAR ANÁLISE AGORA</button
                                    >
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5️⃣ SISTEMA SOB MEDIDA (Reforço após o diagnóstico) -->
        <section class="entregamos-section">
            <div class="container">
                <div class="text-center mb-5">
                    <h2>
                        Sistema <span class="text-gradient">sob medida</span> para
                        sua operação.
                    </h2>
                    <p class="section-subtitle">
                        Tecnologia desenhada para resolver as dores reais do seu
                        negócio e escalar seu lucro.
                    </p>
                </div>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Gestão Centralizada</h3>
                                <p>
                                    Tudo o que acontece na sua empresa em um
                                    único painel de controle estratégico.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Automação Inteligente</h3>
                                <p>
                                    Elimine falhas humanas com fluxos
                                    automáticos de pedidos e agendamentos.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Painel Administrativo</h3>
                                <p>
                                    Gestão simplificada e interface intuitiva
                                    para sua equipe operar com velocidade.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Relatórios de Inteligência</h3>
                                <p>
                                    Visão clara do seu negócio para tomar
                                    decisões baseadas em lucros reais.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-box">
                            <span class="check">✔️</span>
                            <div class="benefit-content">
                                <h3>Escalabilidade Corporativa</h3>
                                <p>
                                    Infraestrutura preparada para suportar o
                                    crescimento sem limites técnicos.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6️⃣ SEGMENTOS ATENDIDOS -->
        <section class="publico-section">
            <div class="container">
                <div class="text-center mb-5">
                    <h2>
                        Especialização em <span class="text-gradient"
                            >Nichos de Alta Peformance</span
                        >
                    </h2>
                </div>
                <div class="publico-grid">
                    <div class="publico-card">
                        <div class="p-icon">🍔</div>
                        <h3>Restaurantes e Lanchonetes</h3>
                        <p>
                            Delivery próprio sem taxas de terceiros,
                            sincronização de mesas e estoque em tempo real.
                        </p>
                    </div>
                    <div class="publico-card">
                        <div class="p-icon">🏥</div>
                        <h3>Clínicas e Saúde</h3>
                        <p>
                            Agendamentos automatizados, prontuários seguros e
                            gestão de fluxo de pacientes otimizada.
                        </p>
                    </div>
                    <div class="publico-card">
                        <div class="p-icon">🏢</div>
                        <h3>Negócios em Crescimento</h3>
                        <p>
                            Sistemas de ERP sob medida para indústrias e
                            serviços que precisam de organização e controle.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 7️⃣ PROVA DE ESTRUTURA / DIFERENCIAIS -->
        <section class="diferenciais-section">
            <div class="container text-center">
                <h2>
                    Engenharia de Software de <span class="text-gradient"
                        >Elite</span
                    >
                </h2>
                <div class="diferenciais-grid mt-5">
                    <div class="dif-item">
                        <h4>Arquitetura Escalável</h4>
                        <p>
                            Sistemas prontos para suportar milhares de acessos
                            simultâneos.
                        </p>
                    </div>
                    <div class="dif-item">
                        <h4>Segurança de Dados</h4>
                        <p>
                            Criptografia de ponta a ponta e backups redundantes.
                        </p>
                    </div>
                    <div class="dif-item">
                        <h4>Alta Performance</h4>
                        <p>
                            Código otimizado para execução instantânea em
                            qualquer dispositivo.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 8️⃣ INVESTIMENTO (Prioridade Rebaixada) -->
        <section class="investimento-section">
            <div class="container text-center">
                <div class="investimento-card">
                    <h2>Investimento Estratégico</h2>
                    <div class="price-range">
                        <span>Projetos a partir de</span>
                        <div class="value">R$ 4.900</div>
                    </div>
                    <p class="price-disclaimer">
                        O investimento final depende da complexidade técnica
                        identificada no diagnóstico estratégico.
                    </p>
                    <div class="exclusive-note">
                        <span class="icon">💎</span>
                        <p>
                            Cada sistema é desenvolvido de forma exclusiva para
                            a necessidade específica do seu negócio.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 9️⃣ CTA FINAL FORTE -->
        <section class="cta-final-section">
            <div class="container text-center">
                <h2>
                    Pronto para estruturar seu negócio como uma <span
                        class="text-gradient">empresa de verdade?</span
                    >
                </h2>
                <div class="hero-actions mt-5">
                    <Button href="#diagnostico" variant="primary" size="lg"
                        >Agendar Diagnóstico Estratégico</Button
                    >
                    <Button
                        href="https://wa.me/5521999064502"
                        variant="outline"
                        size="lg">Falar com Especialista</Button
                    >
                </div>
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector(
            "#diagnostico-form",
        ) as HTMLFormElement | null;
        if (!form) return;

        const steps = document.querySelectorAll(".diag-step");
        const progressBar = document.querySelector(
            "#progress-bar",
        ) as HTMLElement | null;
        const currentStepNum = document.querySelector(
            "#current-step-num",
        ) as HTMLElement | null;
        const prevBtn = document.querySelector(
            "#prev-btn",
        ) as HTMLButtonElement | null;
        const nextBtn = document.querySelector(
            "#next-btn",
        ) as HTMLButtonElement | null;
        const finishBtn = document.querySelector(
            "#finish-btn",
        ) as HTMLButtonElement | null;
        const resultScreen = document.querySelector(
            "#diag-result",
        ) as HTMLElement | null;

        let currentStep = 1;

        const updateStep = () => {
            steps.forEach((s) => s.classList.remove("active"));
            const activeStep = document.querySelector(
                `.diag-step[data-step="${currentStep}"]`,
            );
            if (activeStep) activeStep.classList.add("active");

            // Progress Bar
            if (progressBar) {
                const progress = (currentStep / steps.length) * 100;
                progressBar.style.width = `${progress}%`;
            }
            if (currentStepNum) {
                currentStepNum.innerText = currentStep.toString();
            }

            // Nav Buttons
            if (prevBtn) {
                if (currentStep === 1) prevBtn.classList.add("hidden");
                else prevBtn.classList.remove("hidden");
            }

            if (nextBtn && finishBtn) {
                if (currentStep === steps.length) {
                    nextBtn.classList.add("hidden");
                    finishBtn.classList.remove("hidden");
                } else {
                    nextBtn.classList.remove("hidden");
                    finishBtn.classList.add("hidden");
                }
            }
        };

        // Initialize first step
        updateStep();

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                if (currentStep < steps.length) {
                    currentStep++;
                    updateStep();
                    const targetTop =
                        form.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({
                        top: targetTop,
                        behavior: "smooth",
                    });
                }
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                if (currentStep > 1) {
                    currentStep--;
                    updateStep();
                }
            });
        }

        if (finishBtn) {
            finishBtn.addEventListener("click", () => {
                calculateResult();
                form.classList.add("hidden");
                if (resultScreen) {
                    resultScreen.classList.remove("hidden-result");
                    const targetTop =
                        resultScreen.getBoundingClientRect().top +
                        window.scrollY -
                        100;
                    window.scrollTo({
                        top: targetTop,
                        behavior: "smooth",
                    });
                }
            });
        }

        // 🧮 CALCULATION LOGIC
        const calculateResult = () => {
            const formData = new FormData(form);

            // 1. Calculate Score
            let score = 0;

            // Weights from current structure
            const estrutura = formData.get("estrutura") as string | null;
            if (estrutura === "PLANILHAS") score += 3;
            if (estrutura === "TERCEIRIZADO") score += 6;
            if (estrutura === "PROPRIO") score += 9;

            // Multiple Checkbox Weights
            const funcoes = form.querySelectorAll(
                'input[name="funcao"]:checked',
            ) as NodeListOf<HTMLInputElement>;
            funcoes.forEach((cb) => {
                score += parseInt(cb.getAttribute("data-weight") || "0");
            });

            const escala = parseInt((formData.get("escala") as string) || "1");
            score += escala;

            // 2. Classify
            let nivel = "Essencial";
            let complexidade = "Baixa";
            let investimento = "R$ 4.900 a R$ 7.000";
            let prazo = "20 a 35 dias";
            let desc = "";

            if (score > 40) {
                nivel = "Enterprise";
                complexidade = "Alta";
                investimento = "Acima de R$ 20.000";
                prazo = "90+ dias";
                desc =
                    "Seu projeto exige uma infraestrutura de alta escalabilidade, com APIs robustas, inteligência de dados e processos multinível. Recomendamos um sistema com arquitetura de microsserviços e segurança bancária.";
            } else if (score > 25) {
                nivel = "Avançado";
                complexidade = "Alta";
                investimento = "R$ 12.000 a R$ 20.000";
                prazo = "45 a 75 dias";
                desc =
                    "Você precisa de um sistema completo para dominar o nicho. Integrações complexas de pagamento, controle total de estoque e múltiplos níveis de acesso. Foco em automação total da operação.";
            } else if (score > 12) {
                nivel = "Intermediário";
                complexidade = "Média";
                investimento = "R$ 7.000 a R$ 12.000";
                prazo = "30 a 50 dias";
                desc =
                    "Seu negócio já está em fase de expansão. Recomendamos um sistema centralizado com foco em relatórios estratégicos e automação de pedidos/agendamentos para reduzir gargalos.";
            } else {
                nivel = "Essencial";
                complexidade = "Baixa";
                investimento = "R$ 4.900 a R$ 7.000";
                prazo = "20 a 35 dias";
                desc =
                    "Indicado para validar processos digitais. Um sistema ágil focado nas dores principais (como pedidos ou agendamentos) para tirar a operação do papel ou planilhas.";
            }

            // Update UI
            const resNivel = document.querySelector(
                "#res-nivel",
            ) as HTMLElement | null;
            const resComplex = document.querySelector(
                "#res-complex",
            ) as HTMLElement | null;
            const resInvest = document.querySelector(
                "#res-invest",
            ) as HTMLElement | null;
            const resPrazo = document.querySelector(
                "#res-prazo",
            ) as HTMLElement | null;
            const resDesc = document.querySelector(
                "#res-desc",
            ) as HTMLElement | null;

            if (resNivel) resNivel.innerText = nivel;
            if (resComplex) resComplex.innerText = complexidade;
            if (resInvest) resInvest.innerText = investimento;
            if (resPrazo) resPrazo.innerText = prazo;
            if (resDesc) resDesc.innerText = desc;
        };

        // 📩 LEAD CAPTURE
        const openLeadBtn = document.querySelector(
            "#open-lead-btn",
        ) as HTMLButtonElement | null;
        const leadForm = document.querySelector(
            "#lead-capture-form",
        ) as HTMLFormElement | null;
        const triggerDiv = document.querySelector(
            "#lead-form-trigger",
        ) as HTMLElement | null;

        if (openLeadBtn && triggerDiv && leadForm) {
            openLeadBtn.addEventListener("click", () => {
                triggerDiv.classList.add("hidden");
                leadForm.classList.remove("hidden");
            });

            leadForm.addEventListener("submit", async (e) => {
                e.preventDefault();

                const btnSubmit = leadForm.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement | null;
                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerText = "GERANDO DIAGNÓSTICO...";
                }

                const nameInput = document.querySelector(
                    "#l-name",
                ) as HTMLInputElement | null;
                const whatsappInput = document.querySelector(
                    "#l-whatsapp",
                ) as HTMLInputElement | null;
                const emailInput = document.querySelector(
                    "#l-email",
                ) as HTMLInputElement | null;
                const nivelRes =
                    (document.querySelector("#res-nivel") as HTMLElement | null)
                        ?.innerText || "";

                if (!nameInput || !whatsappInput || !emailInput) return;

                const name = nameInput.value;
                const whatsapp = whatsappInput.value;
                const email = emailInput.value;

                // Collect diagnostic data
                const diagFormData = new FormData(form);
                const diagnosticData: any = {};
                diagFormData.forEach((value, key) => {
                    if (diagnosticData[key]) {
                        if (!Array.isArray(diagnosticData[key])) {
                            diagnosticData[key] = [diagnosticData[key]];
                        }
                        diagnosticData[key].push(value);
                    } else {
                        diagnosticData[key] = value;
                    }
                });

                try {
                    const response = await fetch(
                        "/api/generate-diagnosis-pdf",
                        {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                contact: { name, whatsapp, email },
                                diagnosis: diagnosticData,
                                results: {
                                    level: nivelRes,
                                    complexity:
                                        (
                                            document.querySelector(
                                                "#res-complex",
                                            ) as HTMLElement | null
                                        )?.innerText || "",
                                    investment:
                                        (
                                            document.querySelector(
                                                "#res-invest",
                                            ) as HTMLElement | null
                                        )?.innerText || "",
                                    timeline:
                                        (
                                            document.querySelector(
                                                "#res-prazo",
                                            ) as HTMLElement | null
                                        )?.innerText || "",
                                },
                            }),
                        },
                    );

                    const result = await response.json();

                    if (result.success) {
                        // Success UI
                        leadForm.innerHTML = `
                            <div class="success-message" style="background: rgba(37, 211, 102, 0.1); padding: 20px; border-radius: 12px; border: 1px solid #25d366; margin-top: 20px;">
                                <h4 style="color: #25d366; margin-bottom: 10px;">Diagnóstico Gerado com Sucesso!</h4>
                                <p style="font-size: 0.9rem; margin-bottom: 20px;">O relatório profissional completo já está disponível para você.</p>
                                <a href="${result.pdfUrl}" download="Diagnostico_AlphaCode.pdf" class="btn-submit-lead" style="display: block; text-align: center; text-decoration: none;">BAIXAR PDF</a>
                                <p style="font-size: 0.75rem; color: rgba(255,255,255,0.5); margin-top: 15px;">Um especialista Alpha Code entrará em contato em breve para detalhar os resultados.</p>
                            </div>
                        `;

                        // Send to WhatsApp as fallback
                        const msg = `Olá! Acabei de realizar o Diagnóstico Estratégico no site e gerei meu PDF.\n\n*Resumo:*\nNome: ${name}\nNível: ${nivelRes}\nE-mail: ${email}`;
                        const encoded = encodeURIComponent(msg);
                        window.open(
                            `https://wa.me/5521999064502?text=${encoded}`,
                            "_blank",
                        );
                    } else {
                        throw new Error(result.error || "Erro ao gerar PDF");
                    }
                } catch (error) {
                    console.error("PDF Error:", error);
                    alert(
                        "Ocorreu um erro ao processar seu PDF. Mas não se preocupe, seus dados foram recebidos e entraremos em contato via WhatsApp.",
                    );
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerText = "SOLICITAR ANÁLISE AGORA";
                    }
                }
            });
        }
    });
</script>

