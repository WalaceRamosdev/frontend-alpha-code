    <!-- MODAL PARA OUTRO NEGÓCIO -->
    <div id="modal-outro" class="modal-overlay hidden">
        <div class="modal-content glass-premium">
            <h3>Qual o ramo do seu negócio?</h3>
            <p>Especifique para que possamos detalhar no seu PDF.</p>
            <input
                type="text"
                id="modal-negocio-input"
                placeholder="Ex: Consultoria, Advocacia..."
                class="custom-input-premium"
            />
            <div class="modal-actions">
                <button
                    type="button"
                    id="btn-cancel-modal"
                    class="btn-modal-secondary">Cancelar</button
                >
