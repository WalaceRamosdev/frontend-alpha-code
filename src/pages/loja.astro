---
import Layout from "../layouts/BaseLayout.astro";
import AdminSidebar from "../components/admin/AdminSidebar.astro";
import { getSession } from "../lib/auth";
import { prisma } from "../lib/prisma";

const session = await getSession(Astro.request);
if (!session) return Astro.redirect("/login");

const isAdmin = session.user?.role === "ADMIN";

export const prerender = false;
---

<Layout
    title="Alpha Store | Turbine seu Site"
    showWhatsApp={false}
    showHeader={false}
    showFooter={false}
>
    <div class="dashboard-container">
        <AdminSidebar activePage="store" isAdmin={isAdmin} />

        <main class="main-content">
            <header class="dashboard-header">
                <div class="user-welcome">
                    <h1>Loja Alpha Code</h1>
                    <p>
                        Potencialize seu projeto com nossos serviços
                        especializados.
                    </p>
                </div>
                <div class="header-actions">
                    <a href="/dashboard" class="back-btn">
                        <i class="fas fa-arrow-left"></i> Voltar ao Dashboard
                    </a>
                </div>
            </header>

            <div class="content-body">
                <section class="main-card store-section-full">
                    <div class="card-header">
                        <h2>Explorar Serviços</h2>
                        <span class="badge-active">CONECTADO</span>
                    </div>

                    <div class="store-grid">
                        <!-- Blog Item -->
                        <div class="store-item featured">
                            <div class="store-icon blog">
                                <i class="fas fa-file-signature"></i>
                            </div>
                            <div class="store-info">
                                <strong>Artigos para Blog</strong>
                                <p>
                                    Criação de 8 artigos mensais (2x por semana)
                                    otimizados para SEO. Ideal para gerar
                                    autoridade e tráfego orgânico constante.
                                </p>
                                <div class="item-footer">
                                    <span class="price"
                                        >A partir de R$ 247/mês</span
                                    >
                                    <a
                                        href="/pedido?plan=artigos"
                                        class="store-btn-main">Saber Mais</a
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Redesign Item -->
                        <div class="store-item">
                            <div class="store-icon design">
                                <i class="fas fa-pen-nib"></i>
                            </div>
                            <div class="store-info">
                                <strong>Redesign Premium</strong>
                                <p>
                                    Uma nova cara para o seu site. Interface
                                    moderna, rápida e focada 100% em conversão
                                    de visitantes em clientes.
                                </p>
                                <div class="item-footer">
                                    <span class="price">Sob Consulta</span>
                                    <a
                                        href="/pedido?plan=redesign"
                                        class="store-btn-main">Solicitar Orç.</a
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Speed Item -->
                        <div class="store-item">
                            <div class="store-icon speed">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div class="store-info">
                                <strong>Turbo Speed</strong>
                                <p>
                                    Otimização técnica profunda para
                                    carregamento instantâneo. Melhore sua nota
                                    no Google PageSpeed significativamente.
                                </p>
                                <div class="item-footer">
                                    <span class="price"
                                        >R$ 199 (Taxa única)</span
                                    >
                                    <a
                                        href="/pedido?plan=speed"
                                        class="store-btn-main">Contratar</a
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Ads Item -->
                        <div class="store-item">
                            <div class="store-icon ads">
                                <i class="fas fa-rectangle-ad"></i>
                            </div>
                            <div class="store-info">
                                <strong>Alpha Ads</strong>
                                <p>
                                    Gestão de anúncios no Google e Meta. Atraia
                                    o público certo no momento exato da decisão
                                    de compra.
                                </p>
                                <div class="item-footer">
                                    <span class="price">Gestão mensal fixa</span
                                    >
                                    <a
                                        href="/pedido?plan=ads"
                                        class="store-btn-main">Configurar</a
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>
</Layout>

<style>
    .dashboard-container {
        display: flex;
        min-height: 100vh;
        background: radial-gradient(circle at top right, #0a0a0a, #000);
        color: #fff;
    }

    .main-content {
        flex: 1;
        padding: 3rem;
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4rem;
    }

    .user-welcome h1 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
        font-weight: 800;
        letter-spacing: -1px;
        background: linear-gradient(
            135deg,
            #fff 0%,
            rgba(255, 255, 255, 0.4) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .user-welcome p {
        color: var(--color-text-muted);
        font-size: 1.15rem;
    }

    .back-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 12px 24px;
        border-radius: 14px;
        color: #fff;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(10px);
    }

    .back-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateX(-5px);
    }

    .main-card {
        background: rgba(10, 10, 10, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 32px;
        padding: 3rem;
        backdrop-filter: blur(40px);
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3.5rem;
    }

    .card-header h2 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
    }

    .badge-active {
        background: rgba(16, 185, 129, 0.08);
        color: #10b981;
        padding: 6px 16px;
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .store-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
    }

    .store-item {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 28px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        position: relative;
        overflow: hidden;
    }

    .store-item::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.1),
            transparent
        );
    }

    .store-item:hover {
        transform: translateY(-12px);
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(138, 28, 38, 0.4);
        box-shadow:
            0 30px 60px rgba(0, 0, 0, 0.6),
            inset 0 0 20px rgba(255, 255, 255, 0.02);
    }

    .store-item.featured {
        background: linear-gradient(
            145deg,
            rgba(15, 15, 15, 0.4) 0%,
            rgba(138, 28, 38, 0.03) 100%
        );
        border-color: rgba(138, 28, 38, 0.2);
    }

    .store-item.featured::after {
        content: "OFERTA ATIVA";
        position: absolute;
        top: 20px;
        right: -30px;
        background: #8a1c26;
        color: white;
        font-size: 0.65rem;
        font-weight: 900;
        padding: 5px 40px;
        transform: rotate(45deg);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .store-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        transition: transform 0.3s;
    }

    .store-item:hover .store-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .store-icon.blog {
        background: linear-gradient(
            135deg,
            rgba(168, 85, 247, 0.2) 0%,
            rgba(168, 85, 247, 0) 100%
        );
        color: #a855f7;
        border: 1px solid rgba(168, 85, 247, 0.3);
    }
    .store-icon.design {
        background: linear-gradient(
            135deg,
            rgba(59, 130, 246, 0.2) 0%,
            rgba(59, 130, 246, 0) 100%
        );
        color: #3b82f6;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .store-icon.speed {
        background: linear-gradient(
            135deg,
            rgba(245, 158, 11, 0.2) 0%,
            rgba(245, 158, 11, 0) 100%
        );
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .store-icon.ads {
        background: linear-gradient(
            135deg,
            rgba(16, 185, 129, 0.2) 0%,
            rgba(16, 185, 129, 0) 100%
        );
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .store-info strong {
        display: block;
        font-size: 1.4rem;
        margin-bottom: 0.5rem;
        color: #fff;
        letter-spacing: -0.5px;
    }

    .store-info p {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.5);
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .item-footer {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .price {
        font-size: 0.75rem;
        font-weight: 900;
        color: #fff;
        background: rgba(138, 28, 38, 0.1);
        display: inline-block;
        width: fit-content;
        padding: 4px 12px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: 1px solid rgba(138, 28, 38, 0.3);
    }

    .store-btn-main {
        display: block;
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        padding: 16px;
        border-radius: 16px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
        text-decoration: none;
        backdrop-filter: blur(5px);
    }

    .store-btn-main:hover {
        background: #8a1c26;
        border-color: #8a1c26;
        box-shadow: 0 10px 25px rgba(138, 28, 38, 0.4);
        transform: translateY(-2px);
    }

    @media (max-width: 900px) {
        .main-content {
            padding: 1.5rem;
        }
        .dashboard-header {
            flex-direction: column;
            gap: 2rem;
        }
        .user-welcome h1 {
            font-size: 2.2rem;
        }
        .store-grid {
            grid-template-columns: 1fr;
        }
        .main-card {
            padding: 1.5rem;
        }
    }
</style>
