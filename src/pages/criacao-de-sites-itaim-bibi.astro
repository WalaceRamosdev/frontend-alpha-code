---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const faqs = [
    {
        question: "Quanto custa criar um site profissional no Itaim Bibi?",
        answer: "O valor dependerá da complexidade do projeto. No Itaim Bibi, atendemos empresas que buscam o mais alto padrão visual e técnico para se destacar em um mercado extremamente competitivo e qualificado.",
    },
    {
        question: "Qual o prazo de entrega?",
        answer: "Projetos de alta performance são entregues entre 15 a 30 dias úteis, incluindo design exclusivo, copywriting estratégico e otimização para SEO.",
    },
    {
        question: "Meu site aparecerá no Google para buscas locais no Itaim Bibi?",
        answer: "Sim, implementamos SEO Local avançado para garantir que sua empresa seja encontrada por quem busca 'perto de mim' ou especificamente na região do Itaim e arredores.",
    },
];

const painPoints = [
    {
        icon: "🏢",
        title: "Concorrência de Alto Nível",
        desc: "No Itaim Bibi, você compete com as melhores empresas do país. Seu site precisa transparecer essa mesma excelência.",
    },
    {
        icon: "⚡",
        title: "Exigência de Velocidade",
        desc: "Seu público não espera. Sites lentos passam uma imagem de amadorismo e perdem leads em segundos.",
    },
    {
        icon: "💎",
        title: "Necessidade de Branding Premium",
        desc: "Um site comum não atrai o cliente de alto ticket da região. Você precisa de um design que venda valor, não preço.",
    },
];

const targetAudiences = [
    { title: "Escritórios de Advocacia", benefit: "Posicionamento imponente e prospecção ética de grandes contas." },
    { title: "Clínicas Médicas de Luxo", benefit: "Atraia pacientes que buscam exclusividade e atendimento humanizado." },
    { title: "Empresas de Tecnologia & SaaS", benefit: "Interfaces modernas que refletem inovação e agilidade." },
    { title: "Arquitetos e Design de Interiores", benefit: "Exiba seu portfólio com a moldura digital que ele merece." },
];
---

<BaseLayout
    title="Criação de Sites no Itaim Bibi | Agência de Elite Alpha Code"
    description="Criação de sites profissionais no Itaim Bibi, São Paulo. Sites de alta performance (Astro.js) com foco em conversão, SEO de elite e design premium."
    showHeader={true}
    showFooter={true}
>
    <!-- GSAP Scripts -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            const tl = gsap.timeline();
            tl.from(".hero-badge", { y: -10, opacity: 0, duration: 1, ease: "power3.out" })
                .from(".hero-title", { y: 30, opacity: 0, duration: 1, ease: "power3.out" }, "-=0.6")
                .from(".hero-sub", { y: 20, opacity: 0, duration: 0.8, ease: "power3.out" }, "-=0.4")
                .from(".hero-cta", { scale: 0.95, opacity: 0, duration: 0.6, ease: "back.out(1.7)", delay: 0.2 }, "-=0.1");

            gsap.utils.toArray(".anim-fade-up").forEach((elem: any) => {
                gsap.from(elem, {
                    scrollTrigger: { trigger: elem, start: "top 85%", toggleActions: "play none none reverse" },
                    y: 40, opacity: 0, duration: 0.8, ease: "power3.out"
                });
            });
        });
    </script>

    <div class="seo-landing-page">
        <section class="hero-lp">
            <div class="container">
                <div class="hero-content">
                    <span class="hero-badge badge">Criação de Sites no Itaim Bibi</span>
                    <h1 class="hero-title">
                        Sua Empresa no Coração Financeiro com <br /><span class="highlight">Presença Digital de Elite</span>
                    </h1>
                    <p class="hero-sub subheadline">
                        No Itaim Bibi, o padrão de exigência é outro. Criamos sites que refletem a sofisticação e a agilidade que o mercado de São Paulo exige.
                    </p>
                    <div class="hero-cta cta-wrapper">
                        <Button
                            href="https://wa.me/5521999064502?text=Olá! Gostaria de um orçamento para criação de um site premium para minha empresa no Itaim Bibi."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="pulse-anim main-cta-btn"
                        >
                            FALAR COM UM ESPECIALISTA
                        </Button>
                    </div>
                </div>
            </div>
            <div class="hero-bg-glow"></div>
        </section>

        <section class="intro-section anim-fade-up">
            <div class="container text-content">
                <h2>O Mercado do Itaim Bibi Não Aceita Amadorismo</h2>
                <p>
                    O Itaim Bibi é o epicentro do dinamismo empresarial em São Paulo. Estar localizado aqui ou atender este público significa lidar com um nível de sofisticação e velocidade acima da média. Quando um potencial parceiro ou cliente busca por sua solução, o seu site é o primeiro filtro de qualidade.
                </p>
                <p>
                    Sites lentos, com design datado ou que não funcionam perfeitamente no mobile são descartados em segundos. Na Alpha Code, utilizamos a tecnologia <strong>Astro.js</strong> para entregar sites que carregam instantaneamente, garantindo a melhor pontuação no Google e a melhor experiência para o seu usuário corporativo.
                </p>
            </div>
        </section>

        <section class="problem-section anim-fade-up">
            <div class="container">
                <div class="section-header">
                    <h2>Desafios de quem atua no Itaim Bibi</h2>
                </div>
                <div class="problems-grid">
                    {painPoints.map((pain) => (
                        <div class="problem-card">
                            <div class="icon-box">{pain.icon}</div>
                            <h3>{pain.title}</h3>
                            <p>{pain.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="audience-section anim-fade-up">
            <div class="container">
                <h2 style="text-align: center; margin-bottom: 40px; color: white;">Especialistas em Nichos de Alta Performance</h2>
                <div class="audiences-grid">
                    {targetAudiences.map((audience) => (
                        <div class="audience-card">
                            <h3>{audience.title}</h3>
                            <p>{audience.benefit}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="faq-section anim-fade-up">
            <div class="container text-content">
                <h2 style="text-align:center; margin-bottom: 40px;">Perguntas Frequentes</h2>
                <div class="faq-list">
                    {faqs.map((f) => (
                        <div class="faq-item">
                            <h3>{f.question}</h3>
                            <p>{f.answer}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="final-cta-section anim-fade-up">
            <div class="container">
                <div class="final-cta-content text-center">
                    <h2>Pronto para dominar o digital em SP?</h2>
                    <p>Agende uma conversa estratégica e descubra como podemos elevar sua marca.</p>
                    <div class="actions" style="margin-top: 32px;">
                        <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-effect pulse-anim">FALAR COM UM ESPECIALISTA AGORA</Button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .seo-landing-page { color: #e0e0e0; font-family: "Plus Jakarta Sans", sans-serif; background-color: #050505; }
    .container { max-width: 1000px; margin: 0 auto; padding: 0 24px; }
    .highlight { color: var(--color-primary); font-weight: 800; }
    section { padding: 80px 0; }
    .hero-lp { padding: 120px 0 60px; text-align: center; background: radial-gradient(circle at center top, #1a0505 0%, #000000 60%); }
    .badge { background: rgba(255, 255, 255, 0.08); color: var(--color-primary); padding: 8px 18px; border-radius: 100px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-bottom: 24px; }
    .hero-title { font-family: "Outfit", sans-serif; font-size: 3.2rem; line-height: 1.2; font-weight: 800; color: white; margin-bottom: 24px; }
    .hero-sub { font-size: 1.25rem; color: #a0a0a0; max-width: 780px; margin-bottom: 40px; line-height: 1.6; }
    .text-content p { color: #ccc; font-size: 1.1rem; line-height: 1.8; margin-bottom: 24px; }
    .text-content h2 { font-size: 2.2rem; color: #fff; margin-bottom: 24px; font-weight: 700; text-align: center; }
    .problems-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .problem-card { background: #111; padding: 30px 20px; border-radius: 16px; border: 1px solid #222; text-align: center; }
    .icon-box { font-size: 2.5rem; margin-bottom: 15px; }
    .problem-card h3 { color: white; font-size: 1.2rem; margin-bottom: 12px; }
    .audiences-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .audience-card { background: #111; padding: 25px; border-radius: 12px; border-left: 3px solid var(--color-primary); }
    .audience-card h3 { color: #fff; margin-bottom: 10px; }
    .faq-list { display: flex; flex-direction: column; gap: 20px; }
    .faq-item { background: #111; padding: 25px; border-radius: 12px; }
    .faq-item h3 { color: #fff; margin-bottom: 10px; }
    .final-cta-section { padding: 120px 0; text-align: center; background: radial-gradient(circle at center bottom, #1a0505 0%, #000 70%); }
    @media (max-width: 768px) {
        .problems-grid { grid-template-columns: 1fr; }
        .hero-title { font-size: 2.4rem; }
    }
</style>
---
