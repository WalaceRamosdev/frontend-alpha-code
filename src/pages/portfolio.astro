---
// src/pages/portfolio.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioGrid from "../components/react/PortfolioGrid.tsx";
import SocialProofGrid from "../components/sections/SocialProofGrid.astro";
import CTAButton from "../components/ui/CTAButton.astro";

const title = "Portfólio de Sites | Alpha Code";
const description =
    "Confira nossa galeria de sites profissionais para psicólogos, médicos, advogados e empresas. Mais de 1.400 projetos entregues com foco em conversão.";
---

<BaseLayout title={title} description={description}>
    <!-- Hero Section -->
    <section class="section-hero-portfolio">
        <div class="container text-center relative z-10">
            <span class="badge-accent">Excelência Digital</span>
            <h1 class="hero-title">
                Nossos Cases de <br />
                <span class="text-primary">Sucesso</span>
            </h1>
            <p class="hero-subtitle">
                Transformamos a presença digital de mais de 1.400 profissionais
                e empresas em máquinas de gerar novos clientes.
            </p>
        </div>

        <!-- Abstract shape backgrounds -->
        <div
            class="absolute top-0 right-0 w-96 h-96 bg-primary/10 rounded-full blur-[120px] -mr-48 -mt-24"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-96 h-96 bg-primary/5 rounded-full blur-[100px] -ml-48 -mb-24"
        >
        </div>
    </section>

    <!-- Interactive Portfolio Grid -->
    <section class="portfolio-grid-section">
        <div class="container">
            <PortfolioGrid client:load />
        </div>
    </section>

    <!-- Social Proof Stats -->
    <SocialProofGrid />

    <!-- Why our sites work -->
    <section class="section-why-us">
        <div class="container container-why-us">
            <div class="why-us-grid">
                <div class="why-us-text">
                    <h2 class="section-title">
                        Por que nossos sites <span class="text-primary"
                            >convertem tanto?</span
                        >
                    </h2>
                    <ul class="why-us-list">
                        <li class="why-us-item">
                            <div class="why-us-icon-wrapper">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div class="why-us-item-content">
                                <h4>Performance Extrema</h4>
                                <p>
                                    Usamos Astro.js para carregar
                                    instantaneamente. Velocidade é a métrica #1
                                    de conversão.
                                </p>
                            </div>
                        </li>
                        <li class="why-us-item">
                            <div class="why-us-icon-wrapper">
                                <i class="fas fa-search"></i>
                            </div>
                            <div class="why-us-item-content">
                                <h4>SEO Estratégico</h4>
                                <p>
                                    Nascido para o Google. Estrutura técnica
                                    impecável para você aparecer no topo.
                                </p>
                            </div>
                        </li>
                        <li class="why-us-item">
                            <div class="why-us-icon-wrapper">
                                <i class="fas fa-mouse-pointer"></i>
                            </div>
                            <div class="why-us-item-content">
                                <h4>UX Focus</h4>
                                <p>
                                    Design pensado na jornada do seu cliente.
                                    Facilitamos o contato em cada clique.
                                </p>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="why-us-stats">
                    <div class="stats-glass-card">
                        <div class="stats-content">
                            <div class="stats-value">+247%</div>
                            <p class="stats-label">Aumento médio</p>
                            <p class="stats-sublabel">
                                em solicitações de orçamento
                            </p>
                        </div>
                        <div class="stats-glow"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="section-final-cta">
        <div class="container text-center">
            <h2 class="cta-title">
                Pronto para ter um site digno desse portfólio?
            </h2>
            <p class="cta-subtitle">
                Não deixe para amanhã o posicionamento que você precisa hoje.
                Orçamento rápido, sem enrolação.
            </p>
            <CTAButton
                text="QUERO MEU ORÇAMENTO EM 24H"
                href="https://wa.me/5521999064502?text=Vi%20o%20portfolio%20e%20quero%20um%20site%20para%20mim%20tamb%C3%A9m"
                variant="primary"
                size="lg"
            />
        </div>
    </section>
</BaseLayout>

<style>
    .section-hero-portfolio {
        padding: 8rem 0;
        background: linear-gradient(to bottom, #000, #050505);
        position: relative;
        overflow: hidden;
    }

    .badge-accent {
        color: var(--color-primary);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.75rem;
        margin-bottom: 1rem;
        display: block;
    }

    .hero-title {
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        font-weight: 900;
        color: white;
        margin-bottom: 2rem;
        font-family: "Outfit", sans-serif;
        line-height: 1.1;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-secondary);
        max-width: 700px;
        margin: 0 auto 3rem;
        line-height: 1.6;
    }

    .portfolio-grid-section {
        padding: 5rem 0;
        background-color: #050505;
    }

    /* Why Us Section */
    .section-why-us {
        padding: 6rem 0;
        background-color: #080808;
    }

    .why-us-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 4rem;
        align-items: center;
    }

    @media (max-width: 991px) {
        .why-us-grid {
            grid-template-columns: 1fr;
        }
    }

    .section-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 900;
        color: white;
        margin-bottom: 3rem;
        font-family: "Outfit", sans-serif;
        line-height: 1.2;
    }

    .why-us-list {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .why-us-item {
        display: flex;
        gap: 1.5rem;
    }

    .why-us-icon-wrapper {
        width: 3.5rem;
        height: 3.5rem;
        background: rgba(138, 28, 38, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .why-us-item-content h4 {
        color: white;
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }

    .why-us-item-content p {
        color: var(--color-text-secondary);
        font-size: 1rem;
        line-height: 1.6;
    }

    .why-us-stats {
        position: relative;
    }

    .stats-glass-card {
        aspect-ratio: 1;
        background: linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.05),
            transparent
        );
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
    }

    .stats-content {
        text-align: center;
        z-index: 1;
    }

    .stats-value {
        font-size: 5rem;
        font-weight: 900;
        color: white;
        line-height: 1;
        margin-bottom: 0.5rem;
        font-family: "Outfit", sans-serif;
    }

    .stats-label {
        color: var(--color-primary);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.875rem;
    }

    .stats-sublabel {
        color: var(--color-text-muted);
        font-size: 0.75rem;
        margin-top: 0.5rem;
    }

    .stats-glow {
        position: absolute;
        width: 150%;
        height: 150%;
        background: radial-gradient(
            circle,
            rgba(138, 28, 38, 0.15) 0%,
            transparent 60%
        );
        top: -25%;
        left: -25%;
        pointer-events: none;
    }

    /* Final CTA Section */
    .section-final-cta {
        padding: 8rem 0;
        background-color: #000;
    }

    .cta-title {
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 900;
        color: white;
        margin-bottom: 2rem;
        font-family: "Outfit", sans-serif;
        line-height: 1.1;
    }

    .cta-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-secondary);
        max-width: 600px;
        margin: 0 auto 3.5rem;
        line-height: 1.6;
    }

    .font-outfit {
        font-family: "Outfit", sans-serif;
    }
    .bg-alt {
        background: #080808;
    }
</style>
