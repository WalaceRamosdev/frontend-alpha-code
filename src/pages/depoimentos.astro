---
// src/pages/depoimentos.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialProofGrid from "../components/sections/SocialProofGrid.astro";
import CTAButton from "../components/ui/CTAButton.astro";

const testimonials = [
    {
        name: "Dr. Fernando Lopes",
        role: "Psicanalista",
        location: "São Paulo, SP",
        image: "",
        content:
            "Meu tráfego orgânico subiu 320% em 4 meses. Antes eu tinha 2 agendamentos por semana pelo site, hoje são 12. A Alpha Code entendeu exatamente o que meu consultório precisava.",
        stars: 5,
        verified: true,
    },
    {
        name: "Dra. Priscila Almeida",
        role: "Psicóloga Clínica - CRP 06/123456",
        location: "Rio de Janeiro, RJ",
        image: "",
        content:
            "Em 30 dias depois do site no ar, recebo 5 contatos por dia pelo WhatsApp. Meus pacientes dizem que o site passa segurança antes mesmo da primeira sessão. O investimento se pagou em menos de 2 meses.",
        stars: 4.9,
        verified: true,
    },
    {
        name: "Dr. Ricardo Medeiros",
        role: "Advogado - OAB/PR 123.456",
        location: "Curitiba, PR",
        image: "",
        content:
            "A equipe cuidou de tudo nas normas da OAB, desde o rodapé até as páginas de especialidades. Em 3 meses, minha carteira de clientes de direito trabalhista cresceu 40%. Nunca tinha visto resultado assim com marketing digital.",
        stars: 5,
        verified: true,
    },
    {
        name: "Dr. André Figueiredo",
        role: "Ortodontista - CRO/SP 12345",
        location: "Campinas, SP",
        image: "",
        content:
            "O site ficou rápido demais — meus pacientes carregam em menos de 1 segundo no celular. As consultas de implantes dentários aumentaram de 8 para 23 por mês. A taxa de conversão do formulário ficou em 18%.",
        stars: 5,
        verified: true,
    },
    {
        name: "Dra. Mariana Costa",
        role: "Dermatologista - CRM/SP 123456",
        location: "São Paulo, SP",
        image: "",
        content:
            "Como dermatologista, minha presença online é tudo. Em 60 dias minha agenda de procedimentos estéticos lotou. Agora atendo 35% mais pacientes por mês e precisei contratar uma secretária só para agendar.",
        stars: 4.8,
        verified: true,
    },
    {
        name: "Carlos Eduardo Prado",
        role: "Contador",
        location: "Porto Alegre, RS",
        image: "",
        content:
            "Em 5 meses passei de 20 para 47 clientes ativos. O diferencial foi a landing page de abertura de empresa que a Alpha Code criou — ela converte sozinha, sem precisar de vendedor. O custo por aquisição caiu pela metade.",
        stars: 5,
        verified: true,
    },
    {
        name: "Marcos Vinícius Reis",
        role: "Arquiteto",
        location: "Belo Horizonte, MG",
        image: "",
        content:
            "O portfólio online ficou absurdamente bom. Um projeto residencial que postei trouxe 3 leads qualificados na primeira semana. Antes eu perdia tempo com clientes que não tinham orçamento, agora os contatos já vêm com budget definido.",
        stars: 4.9,
        verified: true,
    },
    {
        name: "Lucas Tavares",
        role: "Personal Trainer",
        location: "Brasília, DF",
        image: "",
        content:
            "Em 45 dias minha agenda de treinos personalizados passou de 6 para 19 alunos fixos. O site transmite autoridade demais — quando mando o link, o cliente já entende que é profissional sério. O WhatsApp Business integrado foi um diferencial enorme.",
        stars: 5,
        verified: true,
    },
    {
        name: "Roberto Nascimento",
        role: "Empresário — Restaurante",
        location: "Florianópolis, SC",
        image: "",
        content:
            "O site do restaurante ficou lindo e funcional. Em 2 meses o delivery dobrou de faturamento e o reservatório de eventos passou a lotar toda semana. O investimento no site se pagou em 45 dias, não exagero.",
        stars: 4.8,
        verified: true,
    },
    {
        name: "Dra. Vanessa Tavares",
        role: "Clínica de Estética",
        location: "Salvador, BA",
        image: "",
        content:
            "Gerencio uma clínica com 8 profissionais e o site unificou tudo. Agora cada especialista tem sua página e o agendamento online reduziu 70% das ligações para a recepção. Em 3 meses o faturamento da clínica cresceu 55% — resultado que nunca tive com Instagram sozinha.",
        stars: 5,
        verified: true,
    },
];
---

<BaseLayout
    title="Depoimentos e Casos de Sucesso"
    description="Veja o que nossos clientes dizem sobre os sites e estratégias digitais da Alpha Code. Mais de 1.400 projetos entregues com sucesso."
>
    <!-- Hero Section -->
    <section class="pt-44 pb-20 bg-gradient-to-b from-black to-[#050505]">
        <div class="container mx-auto px-4 text-center">
            <span
                class="text-primary font-bold tracking-widest uppercase text-sm mb-4 block"
                >Prova Real</span
            >
            <h1
                class="text-4xl md:text-6xl font-black text-white mb-6 font-outfit"
            >
                O que nossos clientes <span class="text-primary"
                    >estão dizendo</span
                >
            </h1>
            <p class="text-xl text-gray-400 max-w-2xl mx-auto mb-10">
                Não somos apenas uma fábrica de sites. Somos parceiros no
                crescimento do seu negócio digital.
            </p>
            <div class="flex justify-center gap-4">
                <div
                    class="flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-2 rounded-full"
                >
                    <span class="text-yellow-500">★★★★★</span>
                    <span class="text-white font-bold">4.9/5</span>
                    <span class="text-gray-500 text-sm">no Google Reviews</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Grid -->
    <SocialProofGrid />

    <!-- Testimonials Grid -->
    <section class="py-20 bg-[#050505]">
        <div class="container mx-auto px-4">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    testimonials.map((t) => (
                        <div class="testimonial-card bg-[#111] p-8 rounded-3xl border border-white/5 hover:border-primary/20 transition-all duration-300">
                            <div class="flex gap-1 mb-6 text-yellow-500">
                                {[...Array(t.stars)].map(() => (
                                    <i class="fas fa-star" />
                                ))}
                            </div>
                            <p class="text-lg text-gray-300 italic mb-8 leading-relaxed">
                                "{t.content}"
                            </p>
                            <div class="flex items-center gap-4">
                                <img loading="lazy"
                                    src={t.image}
                                    alt={t.name}
                                    class="w-14 h-14 rounded-full border-2 border-primary/20"
                                />
                                <div>
                                    <h4 class="text-white font-bold">
                                        {t.name}
                                    </h4>
                                    <p class="text-sm text-gray-500">
                                        {t.role}
                                    </p>
                                    <div class="flex items-center gap-1 mt-1">
                                        <span class="text-[10px] text-primary uppercase font-bold tracking-tighter">
                                            Cliente Verificado
                                        </span>
                                        <i class="fas fa-check-circle text-primary text-[10px]" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Video Testimonials Placeholder -->
    <section class="py-20 bg-alt">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold text-white mb-12 font-outfit">
                Depoimentos em Vídeo
            </h2>
            <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                <div
                    class="video-placeholder aspect-video bg-black/40 rounded-3xl border-2 border-white/5 flex items-center justify-center group cursor-pointer hover:border-primary/40 transition-all overflow-hidden relative"
                >
                    <div
                        class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center text-primary group-hover:scale-110 transition-transform"
                    >
                        <i class="fas fa-play text-3xl"></i>
                    </div>
                    <div class="absolute bottom-6 left-6 text-left">
                        <p class="text-white font-bold">Dra. Juliana Mendes</p>
                        <p class="text-xs text-gray-400">Psicóloga Clínica</p>
                    </div>
                </div>
                <div
                    class="video-placeholder aspect-video bg-black/40 rounded-3xl border-2 border-white/5 flex items-center justify-center group cursor-pointer hover:border-primary/40 transition-all overflow-hidden relative"
                >
                    <div
                        class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center text-primary group-hover:scale-110 transition-transform"
                    >
                        <i class="fas fa-play text-3xl"></i>
                    </div>
                    <div class="absolute bottom-6 left-6 text-left">
                        <p class="text-white font-bold">Dr. Roberto Campos</p>
                        <p class="text-xs text-gray-400">Psicanalista</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl font-bold text-white mb-6 font-outfit">
                Seja o próximo caso de sucesso
            </h2>
            <p class="text-xl text-gray-400 mb-10 max-w-xl mx-auto">
                Sua autoridade digital começa com um clique. Vamos transformar
                seu negócio hoje?
            </p>
            <CTAButton
                text="QUERO MEU ORÇAMENTO EM 24H"
                href="https://wa.me/5521999064502?text=Vi%20os%20depoimentos%20e%20quero%20um%20site%20para%20mim%20tamb%C3%A9m"
                variant="primary"
                size="lg"
            />
        </div>
    </section>
</BaseLayout>

<style>
    .font-outfit {
        font-family: "Outfit", sans-serif;
    }
    .bg-alt {
        background: #080808;
    }
</style>
