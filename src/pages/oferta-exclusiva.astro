---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import mercadoPagoLogo from "../assets/mercadoPago.svg";

const title = "OFERTA EXCLUSIVA | Platinum Site Profissional | Alpha Code";
const description = "💎 Acesso Antecipado: Garanta sua estrutura Alpha Plano Prata por um valor simbólico de lançamento. O padrão luxo agora acessível.";
const keywords = ["site premium", "alpha code", "oferta exclusiva", "criação de sites luxo", "plano prata"];

const beneficos = [
    { icon: "✨", title: "Design Impecável", desc: "Estética refinada que comunica sucesso imediato." },
    { icon: "🚀", title: "Performance Elite", desc: "Velocidade que supera 99% da concorrência no Google." },
    { icon: "🔐", title: "Segurança Total", desc: "Criptografia bancária e proteção de dados constante." },
    { icon: "📱", title: "Ultra Responsivo", desc: "Experiência perfeita em qualquer tamanho de tela." }
];
---

<BaseLayout 
    title={title} 
    description={description}
    showWhatsApp={true}
    showHeader={false}
>
    <!-- ✨ INTERFACE DE LUXO (OFERTA EXCLUSIVA) -->
    <main class="page-wrapper bg-black text-white selection:bg-[#8a1c26] selection:text-white overflow-hidden">
        
        <!-- ⏱️ BARRA DE URGÊNCIA CINEMÁTICA -->
        <div class="urgent-top-bar h-12 bg-gradient-to-r from-[#8a1c26] via-[#d42839] to-[#8a1c26] flex items-center justify-center p-2 relative z-[200] border-b border-white/10 shadow-[0_4px_30px_rgba(138,28,38,0.3)]">
            <div class="container flex justify-between items-center px-4">
                 <div class="hidden md:flex items-center gap-2 opacity-80">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    <span class="text-[9px] font-black uppercase tracking-[5px]">Vagas extremamente limitadas</span>
                </div>
                
                <div id="countdown" class="text-sm md:text-base font-black tracking-[4px] font-outfit uppercase">
                    Oferta encerra em: <span id="timer-display" class="tabular-nums">00:00:00:00</span>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-[9px] font-black uppercase tracking-[5px] text-white/50">Alpha <span class="text-white">v3.0</span></span>
                </div>
            </div>
        </div>

        <!-- 🎭 HERO: A GRANDE ENTRADA -->
        <section class="min-h-screen flex items-center justify-center relative py-20 px-4">
            <!-- Background Visuals -->
            <div class="absolute inset-0 z-0 overflow-hidden">
                <div class="mesh-gradient opacity-40"></div>
                <div class="grid-lines"></div>
                <div class="light-beam-1"></div>
                <div class="light-beam-2"></div>
            </div>

            <div class="container relative z-10">
                <div class="flex flex-col items-center text-center gap-12">
                    <div class="badge-reveal inline-flex items-center gap-3 bg-white/5 border border-white/10 px-8 py-3 rounded-full backdrop-blur-3xl animate-fade-in opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
                        <span class="text-[#BF953F] font-black text-[10px] uppercase tracking-[6px]">Acesso Platinum Ativado</span>
                    </div>

                    <h1 class="hero-title text-6xl md:text-8xl lg:text-[11rem] font-black leading-[0.8] tracking-[-0.05em] uppercase font-outfit reveal-text">
                        A SUA <br/>
                        <span class="text-glow-red">EVOLUÇÃO</span> <br/>
                        <span class="text-white drop-shadow-[0_10px_30px_rgba(255,255,255,0.3)]">DIGITAL</span>
                    </h1>

                    <!-- Novo Mockup Imponente abaixo de DIGITAL -->
                    <div class="mt-8 relative animate-fade-in" style="animation-delay: 0.2s;">
                        <img src="/assets/imagens-de-paginas/anaBottesi.svg" alt="Preview App Premium" class="w-full max-w-lg rounded-3xl shadow-[0_50px_100px_rgba(0,0,0,0.8)] border border-white/10" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                    </div>

                    <p class="max-w-2xl text-gray-400 text-lg md:text-2xl leading-relaxed font-outfit animate-fade-in opacity-0" style="animation-delay: 0.8s; animation-fill-mode: forwards;">
                        O <span class="text-white font-bold">Plano Prata</span> da Alpha Code é o atalho para quem não aceita ser apenas "mais um". Design de luxo, performance de elite e conversão natural.
                    </p>

                    <div class="flex flex-col md:flex-row gap-6 w-full max-w-xl animate-fade-in opacity-0" style="animation-delay: 1s; animation-fill-mode: forwards;">
                        <a href="/pedido?plan=completa&coupon=ALPHA147" class="btn-platinum flex-1 py-6 text-xl font-black rounded-full uppercase tracking-widest text-center shadow-[0_20px_50px_rgba(138,28,38,0.4)]">
                            Garantir Site Alpha ⚡
                        </a>
                    </div>

                    <div class="flex gap-16 mt-8 animate-fade-in opacity-0" style="animation-delay: 1.2s; animation-fill-mode: forwards;">
                        <div class="text-left">
                            <span class="block text-4xl font-black text-white">100%</span>
                            <span class="text-[9px] uppercase tracking-widest text-white/40">Garantia Alpha</span>
                        </div>
                        <div class="text-left">
                            <span class="block text-4xl font-black text-white">07</span>
                            <span class="text-[9px] uppercase tracking-widest text-white/40">Dias de Entrega</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="scroll-indicator absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
                <div class="w-px h-16 bg-gradient-to-b from-transparent via-white/50 to-transparent"></div>
            </div>
        </section>

        <!-- 📦 O PRODUTO (REVELAÇÃO 3D) -->
        <section class="py-32 relative bg-[#050505]">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-24 items-center">
                    <div class="reveal-content p-8 lg:p-20 bg-white/[0.01] border border-white/5 rounded-[60px] backdrop-blur-3xl relative overflow-hidden">
                        <div class="absolute top-0 left-0 w-20 h-20 border-t-2 border-l-2 border-[#8a1c26]/50 rounded-tl-[60px]"></div>
                        <div class="absolute bottom-0 right-0 w-20 h-20 border-b-2 border-r-2 border-[#8a1c26]/50 rounded-br-[60px]"></div>

                        <h2 class="text-4xl md:text-6xl font-black text-white mb-10 uppercase italic leading-none tracking-tighter">O QUE VOCÊ ESTÁ <br/> <span class="text-[#8a1c26]">ADQUIRINDO:</span></h2>
                        
                        <div class="space-y-8">
                            {beneficos.map((b, idx) => (
                                <div class="benefit-item flex gap-6 items-start group" style={`animation-delay: ${idx * 0.2}s`}>
                                    <div class="w-14 h-14 rounded-2xl bg-white/5 flex items-center justify-center text-3xl group-hover:bg-[#8a1c26]/20 transition-all duration-500 border border-white/10">
                                        {b.icon}
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="text-white font-bold text-xl mb-1 uppercase italic tracking-tighter">{b.title}</h4>
                                        <p class="text-gray-500 text-sm">{b.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- 🎥 CARD DE PREÇO MAGNÉTICO -->
                    <div class="price-side relative">
                        <div class="magnetic-card-v3">
                            <div class="card-glass-body p-12 md:p-20 text-center relative overflow-hidden">
                                <div class="absolute top-0 left-1/2 -translate-x-1/2 bg-[#8a1c26] text-white text-[9px] font-black px-12 py-2 rounded-b-full uppercase tracking-[6px] shadow-2xl z-20">Condição Imbatível</div>
                                
                                <div class="relative z-10">
                                    <span class="text-white/20 uppercase tracking-[8px] text-[10px] font-black block mb-10">Premium Access Pass</span>
                                    
                                    <div class="flex flex-col items-center mb-16">
                                        <span class="text-gray-600 line-through text-4xl font-bold mb-4 opacity-50 font-outfit italic">De R$ 697,00</span>
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-white text-4xl font-bold italic mr-2">R$</span>
                                            <span class="text-9xl md:text-[11rem] font-black text-white leading-[0.8] tracking-tighter font-outfit title-glow">147</span>
                                        </div>
                                        <span class="text-[#8a1c26] font-black text-sm tracking-[8px] mt-8 uppercase italic animate-pulse">Apenas 03 Vagas Restantes</span>
                                    </div>

                                    <a href="/pedido?plan=completa&coupon=ALPHA147" class="btn-hero-v3 w-full py-8 text-2xl font-black rounded-[30px] uppercase tracking-tighter transition-all duration-500 hover:scale-[1.02] flex items-center justify-center gap-4 group">
                                        RESERVAR MINHA ESTRUTURA <span class="group-hover:translate-x-2 transition-transform">➡️</span>
                                    </a>

                                    <div class="mt-12 flex flex-col items-center gap-6 opacity-40 hover:opacity-100 transition-opacity">
                                        <span class="text-[10px] font-black uppercase tracking-[5px]">Check-out Instantâneo</span>
                                        <div class="bg-white p-3 rounded-2xl grayscale hover:grayscale-0 transition-all duration-700">
                                            <img src={mercadoPagoLogo.src} alt="Mercado Pago" class="h-8 object-contain" />
                                        </div>
                                    </div>
                                </div>
                                <div class="inner-glow"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ⚖️ PROVA LÓGICA (LUXO) -->
        <section class="py-32 bg-black border-y border-white/5 overflow-hidden">
            <div class="container text-center mb-24">
                <h2 class="text-5xl md:text-8xl font-black text-white uppercase italic leading-none tracking-tighter mb-8">COMPARATIVO <br/> <span class="text-[#8a1c26]">DE VALOR</span></h2>
                <p class="text-gray-500 text-xl font-medium max-w-2xl mx-auto">A diferença entre um gasto momentâneo e um investimento perpétuo em sua autoridade.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto px-4">
                <div class="logic-card-lux p-12 bg-white/[0.02] border border-white/5 rounded-[48px] hover:border-white/10 transition-all group">
                    <span class="text-5xl block mb-8 grayscale group-hover:grayscale-0 transition-all duration-500">🍕</span>
                    <h5 class="text-white/40 group-hover:text-white font-black text-2xl mb-4 italic uppercase transition-all">Jantar Casual</h5>
                    <p class="text-gray-600 group-hover:text-gray-400 text-sm leading-relaxed transition-all">Gasto que desaparece em 24h. R$ 150,00 que não deixam rastro em seu futuro profissional.</p>
                </div>
                <div class="logic-card-lux p-12 bg-gradient-to-br from-[#8a1c26]/20 to-black border-2 border-[#8a1c26]/50 rounded-[48px] relative scale-110 shadow-[0_30px_100px_rgba(138,28,38,0.2)]">
                    <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-white text-black text-[9px] font-black px-6 py-1.5 rounded-full uppercase tracking-[4px]">Investimento Inteligente</div>
                    <span class="text-5xl block mb-8">💎</span>
                    <h5 class="text-white font-black text-2xl mb-4 italic uppercase font-outfit">Site Alpha Prata</h5>
                    <p class="text-white/70 text-sm leading-relaxed">Sua vitrine de luxo aberta 24h/dia, gerando autoridade clínica e jurídica com design que impõe respeito.</p>
                </div>
                <div class="logic-card-lux p-12 bg-white/[0.02] border border-white/5 rounded-[48px] hover:border-white/10 transition-all group">
                    <span class="text-5xl block mb-8 grayscale group-hover:grayscale-0 transition-all duration-500">🎬</span>
                    <h5 class="text-white/40 group-hover:text-white font-black text-2xl mb-4 italic uppercase transition-all">Assinaturas</h5>
                    <p class="text-gray-600 group-hover:text-gray-400 text-sm leading-relaxed transition-all">Custos passivos recorrentes que drenam seu capital sem oferecer nenhuma visibilidade ou lucro.</p>
                </div>
            </div>
        </section>

        <!-- 🤝 GARANTIA DE HONRA (ALPHA) -->
        <section class="py-32 relative bg-[#050505] overflow-hidden">
            <div class="container relative z-10">
                <div class="p-16 md:p-32 rounded-[80px] bg-white/[0.01] border border-white/5 relative backdrop-blur-3xl overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-tr from-[#8a1c26]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
                    
                    <div class="text-center max-w-4xl mx-auto relative z-10">
                        <img src="/assets/seloGarantia.svg" alt="Garantia Alpha" class="w-40 h-40 mx-auto mb-16 filter brightness-0 invert opacity-20 group-hover:opacity-80 transition-all duration-1000" />
                        <h2 class="text-5xl md:text-8xl font-black text-white mb-10 uppercase leading-tight tracking-tighter italic">O MEU COMPROMISSO <br/> É <span class="text-[#8a1c26]">ABSOLUTO.</span></h2>
                        <p class="text-gray-400 text-2xl md:text-3xl leading-relaxed italic mb-20 font-light">
                            "Se o seu novo site não transmitir o luxo e a autoridade que sua marca merece, o investimento volta para o seu bolso na hora. Eu coloco minha palavra no negócio."
                        </p>
                        
                        <div class="flex flex-col md:flex-row items-center justify-center gap-10 border-t border-white/5 pt-16">
                            <div class="w-32 h-32 rounded-3xl border-2 border-white/10 overflow-hidden rotate-3 shadow-2xl transition-transform group-hover:rotate-0 duration-700">
                                <img src="/assets/team/walace.webp" alt="Walace Ramos" class="w-full h-full object-cover" />
                            </div>
                            <div class="text-left">
                                <span class="text-white font-black block text-3xl tracking-tighter uppercase italic mb-1">Walace Ramos</span>
                                <span class="text-[#BF953F] text-xs font-bold uppercase tracking-[6px]">Fundador & CEO Alpha Code Agency</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Background Orbs p/ Garantia -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[100vw] h-[100vw] bg-[#8a1c26]/5 blur-[200px] rounded-full pointer-events-none"></div>
        </section>

        <!-- 🛑 GRAND FINALE CTA -->
        <section class="py-40 bg-black relative text-center">
            <div class="container relative z-10">
                <div class="max-w-5xl mx-auto">
                    <h2 class="text-7xl md:text-[12rem] font-black text-white leading-[0.75] tracking-[-0.05em] uppercase italic mb-20 reveal-text">
                        A HORA <br/> DO <span class="text-glow-red">ALPHA</span> <br/> É AGORA.
                    </h2>
                    
                    <a href="/pedido?plan=completa&coupon=ALPHA147" class="btn-platinum-final inline-flex px-24 py-10 text-4xl font-black rounded-full uppercase tracking-tighter shadow-gold-extreme transition-all duration-700 hover:tracking-[5px]">
                        DOMINAR O MERCADO ➡️
                    </a>

                    <div class="mt-20 flex flex-wrap justify-center gap-12 text-white/20 font-black text-[10px] tracking-[6px] uppercase items-center">
                         <span class="hover:text-white transition-colors cursor-default">• COMPRA 100% BLINDADA •</span>
                         <span class="hover:text-white transition-colors cursor-default">• PAGAMENTO EM 12X •</span>
                         <span class="hover:text-white transition-colors cursor-default">• SATISFAÇÃO 10/10 •</span>
                    </div>
                </div>
            </div>
            
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-[#8a1c26] to-transparent opacity-30"></div>
        </section>

    </main>

    <!-- 📟 CORE INTERACTION ENGINE -->
    <script is:inline>
        function updateCountdown() {
            const targetDate = new Date("March 31, 2026 23:59:59").getTime();
            
            const timer = setInterval(() => {
                const now = new Date().getTime();
                const distance = targetDate - now;
                
                if (distance < 0) {
                    clearInterval(timer);
                    document.getElementById("timer-display").innerHTML = "OFERTA ENCERRADA";
                    return;
                }
                
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                
                const timerEl = document.getElementById("timer-display");
                if (timerEl) {
                    timerEl.innerText = 
                        `${String(days).padStart(2, '0')}D:${String(hours).padStart(2, '0')}H:${String(minutes).padStart(2, '0')}M:${String(seconds).padStart(2, '0')}S`;
                }
            }, 1000);
        }

        // Animation Triggers
        const observeElements = () => {
             const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('reveal-active');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.reveal-text, .reveal-up').forEach(el => observer.observe(el));
        }

        // Init
        document.addEventListener('DOMContentLoaded', () => {
            updateCountdown();
            observeElements();
        });
    </script>
</BaseLayout>

<style>
    /* 🎨 DESIGN SYSTEM ALPHA PLATINUM v4.0 */
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;500;700;900&display=swap');

    :root {
        --color-alpha: #8a1c26;
        --color-alpha-bright: #ff3344;
        --color-gold: #BF953F;
        --font-main: 'Outfit', sans-serif;
    }

    body { font-family: var(--font-main); }

    /* 🔥 EFEITOS CINEMÁTICOS */
    .mesh-gradient {
        position: absolute;
        inset: 0;
        background: 
            radial-gradient(at 10% 10%, rgba(138, 28, 38, 0.2) 0, transparent 50%),
            radial-gradient(at 90% 90%, rgba(191, 149, 63, 0.1) 0, transparent 50%),
            radial-gradient(at 50% 50%, rgba(138, 28, 38, 0.05) 0, transparent 80%);
        filter: blur(80px);
    }

    .grid-lines {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 100px 100px;
        mask-image: radial-gradient(circle at center, black, transparent 90%);
    }

    .text-glow-red {
        color: white;
        text-shadow: 0 0 50px rgba(138, 28, 38, 0.8), 0 0 100px rgba(138, 28, 38, 0.4);
    }

    .title-glow {
        text-shadow: 0 40px 100px rgba(138, 28, 38, 0.5);
    }

    .text-stroke {
        color: white;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
    }

    /* 💎 BOTÕES DE ALTA PERFORMANCE */
    .btn-platinum {
        background: white;
        color: black;
        box-shadow: 0 0 0px transparent;
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
        border: 4px solid transparent;
    }
    .btn-platinum:hover {
        background: var(--color-alpha);
        color: white;
        transform: scale(1.05);
        box-shadow: 0 30px 60px rgba(138, 28, 38, 0.5);
    }

    .btn-hero-v3 {
        background: linear-gradient(135deg, white 0%, #eee 100%);
        color: black;
        box-shadow: 0 20px 60px rgba(255, 255, 255, 0.1);
    }
    .btn-hero-v3:hover {
        background: var(--color-alpha);
        color: white;
        transform: translateY(-5px);
    }

    .btn-platinum-final {
        background: var(--color-alpha);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.1);
        transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1);
    }
    .btn-platinum-final:hover {
        background: white;
        color: black;
        transform: scale(1.1);
        box-shadow: 0 0 100px rgba(255, 255, 255, 0.3);
    }

    /* 🖼️ CARD DE PREÇO MAGNÉTICO (v3.0) */
    .magnetic-card-v3 {
        perspective: 2500px;
        transform: rotateY(-15deg);
        transition: 1s cubic-bezier(0.19, 1, 0.22, 1);
    }
    .magnetic-card-v3:hover {
        transform: rotateY(0deg) translateY(-30px) scale(1.05);
    }

    .card-glass-body {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 60px;
        box-shadow: 0 40px 100px rgba(0,0,0,0.5);
    }
    .inner-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 100% 0%, rgba(138, 28, 38, 0.1) 0%, transparent 50%);
        pointer-events: none;
    }

    /* 🔭 REVEAL ANIMATIONS */
    .reveal-text {
        opacity: 0;
        transform: translateY(40px);
        transition: all 1.2s cubic-bezier(0.19, 1, 0.22, 1);
    }
    .reveal-active {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }

    .animate-fade-in {
        animation: fade-in 1.2s cubic-bezier(0.19, 1, 0.22, 1) forwards;
        opacity: 0;
    }

    @keyframes fade-in {
        from { opacity: 0; transform: translateY(20px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .animate-bounce-slow {
        animation: bounce-slow 4s infinite ease-in-out;
    }

    @keyframes bounce-slow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
    }

    .light-beam-1 {
        position: absolute;
        top: -20%; left: -10%;
        width: 100%; height: 100%;
        background: radial-gradient(circle, rgba(138, 28, 38, 0.1) 0%, transparent 60%);
        transform: rotate(-12deg);
        pointer-events: none;
    }

    .shadow-gold-extreme {
        box-shadow: 0 30px 100px rgba(138, 28, 38, 0.3), 0 0 30px rgba(191, 149, 63, 0.2);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .magnetic-card-v3 { transform: none !important; }
        .hero-title { font-size: 5rem; }
    }
</style>
