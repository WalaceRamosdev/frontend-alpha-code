---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrderForm from "../components/react/OrderForm.jsx";
import { getSession } from "../lib/auth";

const session = await getSession(Astro.request);

if (!session) {
    return Astro.redirect("/login?callbackUrl=/pedido");
}

const title = "Finalizar Pedido | Alpha Code";
export const prerender = false;
const planParam = Astro.url.searchParams.get("plan");
const isMaintenance = planParam === "manutencao";
const headline = isMaintenance
    ? "Solicitação de Melhoria"
    : "Vamos iniciar seu projeto";
const subheadline = isMaintenance
    ? "Descreva sua ideia para evoluirmos seu projeto."
    : "Preencha os dados abaixo para oficializar seu pedido.";
---

<BaseLayout
    title={title}
    noIndex={true}
    showWhatsApp={false}
    showSocialProof={true}
>
    <section class="order-page">
        <div class="order-header container">
            <h1>{headline}</h1>
            <p>{subheadline}</p>
        </div>

        <OrderForm client:load user={session.user} />
    </section>
</BaseLayout>

<style>
    .order-page {
        padding: 80px 0;
    }
    .order-header {
        text-align: center;
        margin-bottom: 60px;
    }
    h1 {
        font-size: clamp(2.5rem, 8vw, 3.5rem);
        font-weight: 800;
        margin-bottom: 1rem;
    }
    p {
        color: var(--color-text-light);
        font-size: 1.1rem;
    }
</style>
