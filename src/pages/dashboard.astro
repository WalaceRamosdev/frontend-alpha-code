            /* Chart Specific Styles */
            .chart-section {
                overflow: visible;
            }
            .chart-wrapper-inner {
                width: 100%;
                height: 400px;
                margin-top: 1rem;
                position: relative; /* Garantir posicionamento para o pseudo-elemento */
                overflow: hidden;
                border-radius: 12px;
            }

            /* Logo de fundo com opacidade baixa */
            .chart-wrapper-inner::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 550px;
                height: 550px;
                background-image: url("/assets/logo3d.svg");
                background-repeat: no-repeat;
                background-position: center;
                background-size: contain;
                opacity: 0.2; /* Opacidade bem baixa como solicitado */
                pointer-events: none;
                z-index: 0;
            }

            canvas#financialChart {
                position: relative;
                z-index: 1; /* Garantir que o gráfico fique por cima da logo */
            }

            .chart-period {
                font-size: 0.8rem;
                color: var(--color-text-muted);
                background: rgba(255, 255, 255, 0.05);
                padding: 4px 12px;
                border-radius: 20px;
                border: 1px solid rgba(255, 255, 255, 0.1);
            }

            /* Legend Styles */
            .chart-legend {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 1.5rem;
                margin-top: 1.5rem;
                padding-top: 1rem;
                border-top: 1px solid rgba(255, 255, 255, 0.05);
            }

            .legend-item {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.85rem;
                color: var(--color-text-muted);
            }

            .legend-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
            }

            .legend-dot.yellow {
                background-color: #facc15;
            }
            .legend-dot.red {
                background-color: #ae1d2a;
            }
            .legend-dot.green {
                background-color: #34d399;
            }
            .legend-dot.dashed {
                background-color: transparent;
                border: 1.5px dashed #ae1d2a;
                border-radius: 2px;
                width: 14px;
                height: 8px;
            }

            /* Height Alignment on Desktop */
            @media (min-width: 901px) {
                .chart-section {
                    height: 100%;
                }
                .sidebar-actions {
                    height: 100%;
                }
                .action-card {
                    height: 100%;
                    display: flex;
                    flex-direction: column;
                }
                .quick-links {
                    display: flex;
                    flex-direction: column;
                    justify-content: space-evenly;
                    flex: 1;
                    gap: 1rem;
                    padding-bottom: 1rem;
                }
                .quick-link {
                    flex: 0 0 auto;
                    min-height: 100px;
                    justify-content: center;
                }
            }

            /* Partner Portal Specific */
            .partner-portal-section {
                border: 1px solid rgba(139, 92, 246, 0.2) !important; /* Slightly purple to distinguish */
                background: linear-gradient(
                    135deg,
                    rgba(20, 20, 20, 0.4) 0%,
                    rgba(139, 92, 246, 0.05) 100%
                ) !important;
            }
            .badge-partner {
                background: rgba(16, 185, 129, 0.1);
                color: #10b981;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 600;
                border: 1px solid rgba(16, 185, 129, 0.2);
            }
            .referral-box {
                background: rgba(255, 255, 255, 0.03);
                padding: 1.5rem;
                border-radius: 16px;
                margin-bottom: 2rem;
                border: 1px solid rgba(255, 255, 255, 0.05);
            }
            .referral-info h3 {
                font-size: 1.1rem;
                margin-bottom: 0.5rem;
                color: white;
            }
            .referral-info p {
                font-size: 0.9rem;
                color: var(--color-text-muted);
                margin-bottom: 1rem;
            }
            .partner-link {
                background: rgba(0, 0, 0, 0.2) !important;
                margin: 1rem 0;
            }
            .code-display {
                font-size: 0.9rem;
                color: var(--color-text-muted);
            }
            .code-display strong {
                color: #a78bfa;
                letter-spacing: 1px;
            }
            .indications-list-wrapper h3 {
                font-size: 1rem;
                margin-bottom: 1rem;
                opacity: 0.8;
                color: white;
            }
            .indications-table {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }
            .indications-header {
                display: grid;
                grid-template-columns: 2fr 1fr 1fr;
                padding: 0.75rem 1rem;
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--color-text-muted);
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            .indication-row {
                display: grid;
                grid-template-columns: 2fr 1fr 1fr;
                padding: 1rem;
                background: rgba(255, 255, 255, 0.02);
                border-radius: 12px;
                font-size: 0.9rem;
                align-items: center;
                transition: background 0.3s ease;
            }
            .indication-row:hover {
                background: rgba(255, 255, 255, 0.05);
            }
            .ind-status {
                color: #34d399;
                font-size: 0.8rem;
                font-weight: 600;
            }
            .empty-indications {
                text-align: center;
                padding: 3rem;
                color: var(--color-text-muted);
                background: rgba(255, 255, 255, 0.01);
                border-radius: 16px;
                border: 1px dashed rgba(255, 255, 255, 0.1);
            }
            .empty-indications i {
                font-size: 2rem;
                margin-bottom: 1rem;
                opacity: 0.3;
            }

            .header-main-title h2 {
                font-size: 1.5rem;
                margin-bottom: 0.25rem;
                color: white;
            }
            .header-main-title p {
                font-size: 0.9rem;
                color: var(--color-text-muted);
            }
            .points-badge {
                background: rgba(255, 215, 0, 0.1);
                color: #ffd700;
                padding: 6px 12px;
                border-radius: 50px;
                font-size: 0.85rem;
                font-weight: 700;
                border: 1px solid rgba(255, 215, 0, 0.2);
            }

            /* Gamification Box */
            .partner-gamification-box {
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 20px;
                padding: 1.5rem;
                margin-bottom: 2rem;
            }
            .tier-progress-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1rem;
            }
            .tier-text p {
                font-size: 0.95rem;
                color: rgba(255, 255, 255, 0.8);
            }
            .progress-percentage {
                font-weight: 800;
                color: white;
                font-size: 1.1rem;
            }
            .custom-progress-bar {
                height: 12px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 10px;
                overflow: hidden;
                position: relative;
                margin-bottom: 1rem;
            }
            .progress-fill {
                height: 100%;
                background: linear-gradient(90deg, #8a1c26, #ff4d4d);
                border-radius: 10px;
                transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
                position: relative;
            }
            .progress-glow {
                position: absolute;
                top: 0;
                right: 0;
                width: 20px;
                height: 100%;
                background: white;
                filter: blur(5px);
                opacity: 0.3;
            }
            .tier-milestones {
                display: flex;
                justify-content: space-between;
                padding: 0 5px;
            }
            .milestone {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 5px;
                opacity: 0.3;
                transition: 0.3s;
            }
            .milestone.active {
                opacity: 1;
            }
            .m-dot {
                width: 8px;
                height: 8px;
                background: white;
                border-radius: 50%;
            }
            .milestone.active .m-dot {
                background: #ff4d4d;
                box-shadow: 0 0 10px #ff4d4d;
            }
            .m-label {
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            /* Resources Section */
            .resources-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 1.5rem;
                margin-top: 1.5rem;
            }
            .resource-card {
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 16px;
                padding: 1.5rem;
                display: flex;
                gap: 1rem;
                transition: transform 0.3s ease, background 0.3s ease;
            }
            .resource-card:hover {
                transform: translateY(-5px);
                background: rgba(255, 255, 255, 0.04);
                border-color: rgba(255, 255, 255, 0.1);
            }
            .res-icon {
                width: 45px;
                height: 45px;
                background: rgba(138, 28, 38, 0.1);
                color: #ff4d4d;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
                flex-shrink: 0;
            }
            .res-content {
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }
            .res-content h4 {
                font-size: 1rem;
                margin-bottom: 0.5rem;
                color: white;
            }
            .res-content p {
                font-size: 0.85rem;
                color: var(--color-text-muted);
                margin-bottom: 1rem;
                line-height: 1.4;
            }
            .res-actions {
                display: flex;
                gap: 0.75rem;
                margin-top: auto;
            }
            .res-btn {
                padding: 6px 12px;
                border-radius: 8px;
                font-size: 0.75rem;
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
                border: none;
                display: flex;
                align-items: center;
                gap: 5px;
                transition: 0.2s;
            }
            .res-btn.download { background: #10b98122; color: #10b981; }
            .res-btn.copy-content-btn { background: #3b82f622; color: #3b82f6; }
            .res-btn.external { background: #6366f122; color: #6366f1; }
            .res-btn:hover { filter: brightness(1.2); }

            /* Status Pills */
            .ind-status-pill {
                padding: 4px 10px;
                border-radius: 50px;
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .status-new { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
            .status-contacted { background: rgba(167, 139, 250, 0.1); color: #a78bfa; }
            .status-negotiating { background: rgba(251, 191, 36, 0.1); color: #fbbf24; }
            .status-closed { background: rgba(16, 185, 129, 0.1); color: #10b981; }

            .stat-icon.partner {
                background: rgba(139, 92, 246, 0.1);
                color: #a78bfa;
            }
        </style>
    </div>
</Layout>

<!-- Chart.js Libraries -->
<script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
<script is:inline>
    document.addEventListener("astro:page-load", () => {
        const ctx = document.getElementById("financialChart");
        if (!ctx) return;

        if (window.financialChartInstance) {
            window.financialChartInstance.destroy();
        }

        const labels = JSON.parse(ctx.getAttribute("data-labels") || "[]");
        const revenue = JSON.parse(ctx.getAttribute("data-revenue") || "[]");
        const expenses = JSON.parse(ctx.getAttribute("data-expenses") || "[]");
        const profit = JSON.parse(ctx.getAttribute("data-profit") || "[]");

        window.financialChartInstance = new Chart(ctx, {
            type: "line",
            data: {
                labels: labels,
                datasets: [
                    {
                        label: "Receita Bruta (Mês)",
                        data: revenue,
                        borderColor: "#facc15",
                        backgroundColor: (context) => {
                            const chart = context.chart;
                            const { ctx, chartArea } = chart;
                            if (!chartArea) return null;
                            const gradient = ctx.createLinearGradient(
                                0,
                                chartArea.bottom,
                                0,
                                chartArea.top,
                            );
                            gradient.addColorStop(0, "rgba(250, 204, 21, 0)");
                            gradient.addColorStop(
                                1,
                                "rgba(250, 204, 21, 0.15)",
                            );
                            return gradient;
                        },
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: "#facc15",
                        pointBorderColor: "rgba(250, 204, 21, 0.5)",
                        pointBorderWidth: 8,
                        pointHoverRadius: 7,
                        shadowBlur: 15,
                        shadowColor: "rgba(250, 204, 21, 0.5)",
                    },
                    {
                        label: "Custos Mensais",
                        data: expenses,
                        borderColor: "#ae1d2a",
                        backgroundColor: "transparent",
                        borderWidth: 2,
                        tension: 0.4,
                        fill: false,
                        pointRadius: 3,
                        pointBackgroundColor: "#ae1d2a",
                        borderDash: [5, 5],
                    },
                    {
                        label: "Lucro Líquido (Mês)",
                        data: profit,
                        borderColor: "#34d399",
                        backgroundColor: (context) => {
                            const chart = context.chart;
                            const { ctx, chartArea } = chart;
                            if (!chartArea) return null;
                            const gradient = ctx.createLinearGradient(
                                0,
                                chartArea.bottom,
                                0,
                                chartArea.top,
                            );
                            gradient.addColorStop(0, "rgba(52, 211, 153, 0)");
                            gradient.addColorStop(1, "rgba(52, 211, 153, 0.2)");
                            return gradient;
                        },
                        borderWidth: 4,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 6,
                        pointBackgroundColor: "#1a1a1a",
                        pointBorderColor: "#34d399",
                        pointBorderWidth: 2,
                        pointHoverRadius: 8,
                        pointHoverBackgroundColor: "#34d399",
                        shadowBlur: 20,
                        shadowColor: "rgba(52, 211, 153, 0.6)",
                    },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: "index",
                    intersect: false,
                },
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        backgroundColor: "rgba(20, 20, 20, 0.95)",
                        titleColor: "#fff",
                        bodyColor: "#eee",
                        borderColor: "rgba(255, 255, 255, 0.1)",
                        borderWidth: 1,
                        padding: 12,
                        boxPadding: 8,
                        usePointStyle: true,
                        callbacks: {
                            label: function (context) {
                                let label = context.dataset.label || "";
                                if (label) {
                                    label += ": ";
                                }
                                if (context.parsed.y !== null) {
                                    label += new Intl.NumberFormat("pt-BR", {
                                        style: "currency",
                                        currency: "BRL",
                                    }).format(context.parsed.y);
                                }
                                return label;
                            },
                        },
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: "rgba(255, 255, 255, 0.03)",
                            drawBorder: false,
                        },
                        ticks: {
                            color: "rgba(255, 255, 255, 0.4)",
                            font: { size: 11 },
                            callback: function (value) {
                                return "R$ " + value;
                            },
                        },
                    },
                    x: {
                        grid: {
                            display: false,
                        },
                        ticks: {
                            color: "rgba(255, 255, 255, 0.4)",
                            font: { size: 11 },
                        },
                    },
                },
            },
        });

        // ResizeObserver para lidar com a expansão da sidebar
        const resizeObserver = new ResizeObserver(() => {
            if (window.financialChartInstance) {
                window.financialChartInstance.resize();
            }
        });
        const wrapper = ctx.closest(".chart-wrapper-inner");
        if (wrapper) {
            resizeObserver.observe(wrapper);
        }

    });

    // Copy content for Partner Resources
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll('.copy-content-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                let content = btn.getAttribute('data-content');
                
                // Tratamento especial em caso de quebras de linha para manter a formatação correta
                content = content.replace(/\\n/g, '\n');

                try {
                    if (navigator.clipboard) {
                        await navigator.clipboard.writeText(content);
                    } else {
                        // Fallback para navegadores antigos ou sem https
                        const textArea = document.createElement("textarea");
                        textArea.value = content;
                        document.body.appendChild(textArea);
                        textArea.select();
                        document.execCommand("Copy");
                        textArea.remove();
                    }
                    
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i> Copiado!';
                    btn.style.background = '#10b98144';
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.style.background = '';
                    }, 2000);
                } catch (err) {
                    console.error('Falha ao copiar:', err);
                }
            });
        });
    });
</script>
