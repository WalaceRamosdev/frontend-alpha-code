            .benefits-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 1.5rem;
                margin-top: 1rem;
            }

            .benefit-item {
                display: flex;
                align-items: center;
                gap: 1.2rem;
                padding: 1.5rem;
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--glass-border);
                border-radius: 12px;
