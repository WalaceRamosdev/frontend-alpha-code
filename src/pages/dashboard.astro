            <StatusModal
                id="dashboard-status-modal"
                title="Salvando..."
                message="Vinculando seu site ao dashboard"
                type="loading"
            />

            <script>
                // Modal Logic - New Project
                const modal = document.getElementById("project-modal");
                const openBtns = [
                    document.getElementById("new-project-btn"),
                    document.getElementById("new-project-cta"),
                ];
                const closeBtn = document.getElementById("close-modal");
                const cancelBtn = document.getElementById("cancel-modal");

                // Modal Logic - Portfolio (Admin)
                const portfolioModal =
                    document.getElementById("portfolio-modal");
                const openPortfolioBtns = [
                    document.getElementById("add-portfolio-btn"),
                    document.getElementById("add-portfolio-cta"),
                ];
                const closePortfolioBtn = document.getElementById(
                    "close-portfolio-modal",
                );
                const cancelPortfolioBtn = document.getElementById(
                    "cancel-portfolio-modal",
                );

                // Modal Logic - Link Site
                const siteModal = document.getElementById("site-modal");
                const openSiteBtn = document.getElementById("add-site-link");
                const closeSiteBtn =
                    document.getElementById("close-site-modal");
                const cancelSiteBtn =
                    document.getElementById("cancel-site-modal");
                const siteForm = document.getElementById("site-url-form");

                // Portfolio Save Logic
                const portfolioForm = document.getElementById("portfolio-form");
                if (portfolioForm) {
                    portfolioForm.addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const btn = portfolioForm.querySelector(
                            "button[type='submit']",
                        ) as HTMLButtonElement | null;
                        const originalText = btn ? btn.innerText : "Adicionar";
                        if (btn) btn.innerText = "Adicionando...";

                        const formData = new FormData(
                            portfolioForm as HTMLFormElement,
                        );
                        const data = Object.fromEntries(formData);

                        try {
                            const response = await fetch(
                                "/api/admin/portfolio/add",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify(data),
                                },
                            );

                            if (response.ok) {
                                (window as any).showModal(
                                    "Sucesso",
                                    "Projeto adicionado ao portfólio!",
                                    "success",
                                );
                                setTimeout(
                                    () => window.location.reload(),
                                    2000,
                                );
                            } else {
                                const err = await response.json();
                                (window as any).showModal(
                                    "Erro",
                                    err.message || "Falha ao adicionar",
                                    "error",
                                );
                                setTimeout(
                                    () => (window as any).hideModal(),
                                    3000,
                                );
                            }
                        } catch (e) {
                            console.error(e);
                            (window as any).showModal(
                                "Erro",
                                "Falha na conexão",
                                "error",
                            );
                            setTimeout(() => (window as any).hideModal(), 3000);
                        } finally {
                            if (btn) btn.innerText = originalText;
                        }
                    });
                }

                function openModal(m: HTMLElement | null) {
                    m?.classList.remove("hidden");
                    document.body.style.overflow = "hidden";
                }

                function closeModal(m: HTMLElement | null) {
                    m?.classList.add("hidden");
                    document.body.style.overflow = "";
                }

                openBtns.forEach((btn) =>
                    btn?.addEventListener("click", () => openModal(modal)),
                );
                closeBtn?.addEventListener("click", () => closeModal(modal));
                cancelBtn?.addEventListener("click", () => closeModal(modal));

                openPortfolioBtns.forEach((btn) =>
                    btn?.addEventListener("click", () =>
                        openModal(portfolioModal),
                    ),
                );
                closePortfolioBtn?.addEventListener("click", () =>
                    closeModal(portfolioModal),
                );
                cancelPortfolioBtn?.addEventListener("click", () =>
                    closeModal(portfolioModal),
                );

                openSiteBtn?.addEventListener("click", () =>
                    openModal(siteModal),
                );
                closeSiteBtn?.addEventListener("click", () =>
                    closeModal(siteModal),
                );
                cancelSiteBtn?.addEventListener("click", () =>
                    closeModal(siteModal),
                );

                // Site URL Save Logic
                if (siteForm) {
                    siteForm.addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const saveBtn = document.getElementById(
                            "save-site-btn",
                        ) as HTMLButtonElement;
                        const urlInput = document.getElementById(
                            "site-url-input",
                        ) as HTMLInputElement;

                        if (saveBtn) saveBtn.innerText = "Salvando...";

                        try {
                            const response = await fetch("/api/user/update", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    siteUrl: urlInput.value,
                                }),
                            });

                            if (response.ok) {
                                (window as any).showModal(
                                    "Link Vinculado!",
                                    "Seu site foi vinculado com sucesso ao seu dashboard.",
                                    "success",
                                );
                                setTimeout(
                                    () => window.location.reload(),
                                    2000,
                                );
                            } else {
                                const errorData = await response.json();
                                (window as any).showModal(
                                    "Erro ao Vincular",
                                    errorData.message +
                                        (errorData.error
                                            ? ": " + errorData.error
                                            : ""),
                                    "error",
                                );
                                setTimeout(
                                    () => (window as any).hideModal(),
                                    5000,
                                );
                            }
                        } catch (error) {
                            console.error("Site URL update error:", error);
                        } finally {
                            if (saveBtn) saveBtn.innerText = "Salvar Link";
                        }
                    });
                }

                // Financial Modal Logic
                const financialModal =
                    document.getElementById("financial-modal");
                const openFinancialBtn = document.getElementById(
                    "open-financial-modal",
                );
                const closeFinancialBtn = document.getElementById(
                    "close-financial-modal",
                );
                const cancelFinancialBtn = document.getElementById(
                    "cancel-financial-modal",
                );
                const financialForm = document.getElementById("financial-form");

                if (openFinancialBtn) {
                    openFinancialBtn.addEventListener("click", () =>
                        openModal(financialModal),
                    );
                    // Add cursor pointer style dynamically
                    openFinancialBtn.style.cursor = "pointer";
                }
                if (closeFinancialBtn)
                    closeFinancialBtn.addEventListener("click", () =>
                        closeModal(financialModal),
                    );
                if (cancelFinancialBtn)
                    cancelFinancialBtn.addEventListener("click", () =>
                        closeModal(financialModal),
                    );

                if (financialForm) {
                    // Auto-calculate logic
                    const planSelect = document.getElementById(
                        "financial-plan",
                    ) as HTMLSelectElement;
                    const extraServiceSelect = document.getElementById(
                        "financial-service-extra",
                    ) as HTMLSelectElement;
                    const hostingCostInput = document.getElementById(
                        "financial-hosting-cost",
                    ) as HTMLInputElement;
                    const amountInput = financialForm.querySelector(
                        "input[name='amount']",
                    ) as HTMLInputElement;

                    const prices: Record<string, number> = {
                        "Plano Bronze": 295,
                        "Plano Prata": 449,
                        "Plano Ouro": 710,
                        Manutenção: 150,
                        Consultoria: 500,
                        "Landing Page Avulsa": 295,
                        "E-commerce": 2500,
                        "SEO Turbinado": 300,
                        Outros: 0,
                        Nenhum: 0,
                        "": 0,
                    };

                    const calculateTotal = () => {
                        if (!amountInput) return;
                        const planPrice = prices[planSelect.value] || 0;
                        const extraPrice =
                            prices[extraServiceSelect.value] || 0;
                        const hosting = hostingCostInput.value
                            ? parseFloat(hostingCostInput.value)
                            : 0;

                        const total = planPrice + extraPrice - hosting;
                        amountInput.value = total.toFixed(2);
                    };

                    if (planSelect && extraServiceSelect && hostingCostInput) {
                        planSelect.addEventListener("change", calculateTotal);
                        extraServiceSelect.addEventListener(
                            "change",
                            calculateTotal,
                        );
                        hostingCostInput.addEventListener(
                            "input",
                            calculateTotal,
                        );
                        // Initial calculation
                        calculateTotal();
                    }

                    financialForm.addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const btn = financialForm.querySelector(
                            "button[type='submit']",
                        ) as HTMLButtonElement | null;
                        const originalText = btn ? btn.innerText : "Registrar";
                        if (btn) btn.innerText = "Salvando...";

                        const formData = new FormData(
                            financialForm as HTMLFormElement,
                        );

                        // Combine service names
                        const plan = formData.get("service") as string;
                        const extra = formData.get("extraService") as string;
                        let combinedService = plan;
                        if (extra) {
                            combinedService += " + " + extra;
                        }

                        const data = {
                            service: combinedService,
                            amount: formData.get("amount"),
                            hostingCost: formData.get("hostingCost"),
                            description: formData.get("description"),
                        };

                        try {
                            const response = await fetch(
                                "/api/admin/financial/add",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify(data),
                                },
                            );

                            if (response.ok) {
                                (window as any).showModal(
                                    "Sucesso",
                                    "Lançamento registrado!",
                                    "success",
                                );
                                setTimeout(() => {
                                    window.location.reload();
                                }, 1000);
                            } else {
                                const err = await response.json();
                                (window as any).showModal(
                                    "Erro",
                                    err.message || "Falha ao registrar",
                                    "error",
                                );
                            }
                        } catch (e) {
                            (window as any).showModal(
                                "Erro",
                                "Falha na conexão",
                                "error",
                            );
                        } finally {
                            if (btn) btn.innerText = originalText;
                        }
                    });
                }

                // Copy URL Logic
                const copyBtns = document.querySelectorAll(".copy-url-btn");
                copyBtns.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const url = btn.getAttribute("data-url");
                        if (url) {
                            navigator.clipboard.writeText(url);
                            const originalHTML = btn.innerHTML;
                            btn.innerHTML =
                                '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                            setTimeout(() => {
                                btn.innerHTML = originalHTML;
                            }, 2000);
                        }
                    });
                });

                // Close on click outside
                window.addEventListener("click", (e) => {
                    if (e.target === modal) closeModal(modal);
                    if (e.target === siteModal) closeModal(siteModal);
                    if (e.target === portfolioModal) closeModal(portfolioModal);
                });

                // Logout Logic
                const logoutBtn = document.getElementById("logout-btn");
                if (logoutBtn) {
                    logoutBtn.addEventListener("click", async () => {
                        const originalText = logoutBtn.innerHTML;
                        logoutBtn.innerText = "Saindo...";
                        try {
                            const csrfRes = await fetch("/api/auth/csrf");
                            const { csrfToken } = await csrfRes.json();

                            await fetch("/api/auth/signout", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    csrfToken,
                                    callbackUrl: "/",
                                }),
                            });

                            window.location.href = "/";
                        } catch (e) {
                            console.error("Logout failed", e);
                            window.location.href = "/";
                        }
                    });
                }
            </script>

