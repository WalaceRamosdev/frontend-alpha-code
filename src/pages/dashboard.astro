---
import Layout from "../layouts/BaseLayout.astro";
import { getSession } from "../lib/auth";
import { prisma } from "../lib/prisma";
import AdminSidebar from "../components/admin/AdminSidebar.astro";
import StatusModal from "../components/ui/StatusModal.astro";
import ChartParticles from "../components/ui/ChartParticles.jsx";
import { partnerTiers, marketingResources } from "../data/partnerData";
// import authConfig from "../auth.config";
// import { SignOut } from "auth-astro/components";

let session = null;
try {
    session = await getSession(Astro.request);
} catch (e) {
    console.error("Dashboard Auth Error:", e);
}

if (!session) {
    return Astro.redirect("/login");
}
const isAdmin = session.user?.role === "ADMIN";
const isPartner =
    session.user?.userType === "PARTNER" || session.user?.role === "PARTNER";
const userEmail = session.user?.email;

const totalUsers = isAdmin
    ? await prisma.user.count({ where: { role: "USER" } })
    : 0;

const totalIndications =
    isPartner && !isAdmin
        ? await prisma.lead.count({
              where: { referredBy: session.user.referralCode },
          })
        : 0;

const indications =
    isPartner && !isAdmin
        ? await prisma.lead.findMany({
              where: { referredBy: session.user.referralCode },
              orderBy: { createdAt: "desc" },
              take: 5,
          })
        : [];

const projectCount = isAdmin
    ? await prisma.project.count()
    : await prisma.project.count({ where: { clientEmail: userEmail } });

const maintenanceCount = isAdmin
    ? await (prisma as any).maintenanceRequest.count({
          where: { status: "PENDENTE" },
      })
    : await (prisma as any).maintenanceRequest.count({
          where: { email: userEmail, NOT: { status: "CONCLUIDO" } },
      });

const userProjects = !isAdmin
    ? await prisma.project.findMany({
          where: { clientEmail: userEmail },
          orderBy: { createdAt: "desc" },
      })
    : [];

const userRequests = !isAdmin
    ? await (prisma as any).maintenanceRequest.findMany({
          where: { email: userEmail },
          orderBy: { createdAt: "desc" },
          take: 5,
      })
    : [];

const financialRecords = isAdmin
    ? await prisma.financialRecord.findMany({
          orderBy: { date: "asc" },
      })
    : [];

// Processar dados para o gráfico de forma estrita mensal (não cumulativa)
const monthlyData = new Map();
financialRecords.forEach((record) => {
    const d = new Date(record.date);
    // Usar UTC para evitar que o fuso horário mude o mês (ex: 01/02 às 00h virar 31/01 no fuso local)
    const year = d.getUTCFullYear();
    const month = d.getUTCMonth(); // 0-indexed
    const key = `${year}-${String(month + 1).padStart(2, "0")}`;

    // Label formatada para o gráfico
    const label = new Intl.DateTimeFormat("pt-BR", {
        month: "short",
        year: "2-digit",
        timeZone: "UTC",
    }).format(d);

    if (!monthlyData.has(key)) {
        monthlyData.set(key, {
            label,
            revenue: 0,
            expenses: 0,
            profit: 0,
        });
    }

    const stats = monthlyData.get(key);
    stats.revenue += record.amount;
    stats.expenses += record.hostingCost || 0;
    stats.profit += record.amount - (record.hostingCost || 0);
});

// Ordenar cronologicamente
const sortedKeys = Array.from(monthlyData.keys()).sort();
const chartLabels = sortedKeys.map((k) => monthlyData.get(k).label);
const revenueData = sortedKeys.map((k) => monthlyData.get(k).revenue);
const expenseData = sortedKeys.map((k) => monthlyData.get(k).expenses);
const profitData = sortedKeys.map((k) => monthlyData.get(k).profit);

const totalRevenue = financialRecords.reduce(
    (acc, record) => acc + record.amount,
    0,
);
const totalProfit = financialRecords.reduce(
    (acc, record) => acc + (record.amount - (record.hostingCost || 0)),
    0,
);
const hasActivePlan = ["BRONZE", "PRATA", "OURO"].includes(session.user?.plan);

const formattedProfit = new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
}).format(totalProfit);

// Partner Gamification Logic
const currentUser = isPartner
    ? await prisma.user.findUnique({ where: { id: session.user.id } })
    : null;
const partnerTier =
    partnerTiers.find(
        (t) => t.id === (currentUser?.partnerTier?.toLowerCase() || "bronze"),
    ) || partnerTiers[0];
const nextTier = partnerTiers[partnerTiers.indexOf(partnerTier) + 1] || null;
const indicationsToNextTier = nextTier
    ? Math.max(0, nextTier.reqN - totalIndications)
    : 0;
const partnerProgress = nextTier
    ? Math.min(100, (totalIndications / nextTier.reqN) * 100)
    : 100;

export const prerender = false;
---

<Layout
    title="Dashboard | Alpha Code"
    showWhatsApp={false}
    showHeader={false}
    showFooter={false}
>
    <div class="admin-container">
        <AdminSidebar activePage="dashboard" isAdmin={isAdmin} />

        <div class="dashboard-wrapper">
            <!-- Background Ambient Glow -->
            <div class="ambient-glow"></div>

            <div class="container dashboard-container">
                <!-- Header Section -->
                <header class="dashboard-header">
                    <div class="user-profile-header">
                        <div class="header-avatar">
                            {
                                isAdmin ? (
                                    <img
                                        src="/assets/logo3d.svg"
                                        alt="Alpha Code Admin"
                                        id="header-avatar-img"
                                    />
                                ) : session.user?.image ? (
                                    <img
                                        src={session.user.image}
                                        alt="Profile"
                                        id="header-avatar-img"
                                        onerror="this.onerror=null;this.src='/assets/logo3d.svg';this.style.objectFit='contain';this.style.padding='4px';"
                                    />
                                ) : (
                                    <img
                                        src="/assets/logo3d.svg"
                                        alt="Alpha Code"
                                        style="width: 32px; height: 32px; object-fit: contain;"
                                    />
                                )
                            }
                        </div>
                        <div class="welcome-text">
                            <span class="greeting">Bem-vindo de volta,</span>
                            <h1 class="user-name">
                                {session.user?.name || "Cliente Alpha"}
                            </h1>
                        </div>
                    </div>
                    <div class="header-actions">
                        <button id="logout-btn" class="logout-btn">
                            <i class="fas fa-right-from-bracket"></i>
                            <span>Sair</span>
                        </button>
                    </div>
                </header>

                <!-- Stats Grid -->
                <div class={`stats-grid`}>
                    {
                        isAdmin ? (
                            /* ADMIN STATS */
                            <>
                                <div class="stat-card">
                                    <div class="card-top">
                                        <div class="stat-icon project">
                                            <i class="fas fa-briefcase" />
                                        </div>
                                        <div class="stat-info">
                                            <span class="stat-value">
                                                {projectCount}
                                            </span>
                                            <span class="stat-label">
                                                Projetos Entregues
                                            </span>
                                        </div>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin/projects/history"
                                            class="history-link-card"
                                        >
                                            📂 Gerenciar Projetos
                                        </a>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="card-top">
                                        <div class="stat-icon invoice">
                                            <i class="fas fa-wallet" />
                                        </div>
                                        <div class="stat-info">
                                            <span class="stat-value">
                                                {formattedProfit}
                                            </span>
                                            <span class="stat-label">
                                                Lucro Líquido Real
                                            </span>
                                        </div>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin/financial/history"
                                            class="history-link-card"
                                        >
                                            📄 Histórico
                                        </a>
                                        <button
                                            id="open-financial-modal"
                                            class="launch-btn"
                                        >
                                            + Lançar Ganhos
                                        </button>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="card-top">
                                        <div
                                            class={`stat-icon support ${maintenanceCount > 0 ? "has-notification" : ""}`}
                                        >
                                            <i class="fas fa-tools" />
                                            {maintenanceCount > 0 && (
                                                <span class="notification-badge-dot" />
                                            )}
                                        </div>
                                        <div class="stat-info">
                                            <span class="stat-value">
                                                {maintenanceCount}
                                            </span>
                                            <span class="stat-label">
                                                Solicitações
                                            </span>
                                        </div>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin/maintenance/requests"
                                            class="history-link-card"
                                        >
                                            🔧 Gerenciar
                                        </a>
                                    </div>
                                </div>
                                {/* Clients Management Card */}
                                <div class="stat-card">
                                    <div class="card-top">
                                        <div class="stat-icon users">
                                            <i class="fas fa-users" />
                                        </div>
                                        <div class="stat-info">
                                            <span class="stat-value">
                                                {totalUsers}
                                            </span>
                                            <span class="stat-label">
                                                Clientes Cadastrados
                                            </span>
                                        </div>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin"
                                            class="history-link-card"
                                        >
                                            👥 Gerenciar Clientes
                                        </a>
                                    </div>
                                </div>
                                {/* No VIP Card for Admin */}
                            </>
                        ) : (
                            <>
                                {!isPartner && (
                                    <>
                                        <div class="stat-card">
                                    <div class="stat-icon project">
                                        <i class="fas fa-rocket" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {projectCount}
                                        </span>
                                        <span class="stat-label">
                                            Projetos Ativos
                                        </span>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon support">
                                        <i class="fas fa-screwdriver-wrench" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {maintenanceCount}
                                        </span>
                                        <span class="stat-label">
                                            Manutenções Ativas
                                        </span>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon plan">
                                        <i class="fas fa-award" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {session.user?.plan || "FREE"}
                                        </span>
                                        <div style="display: flex; flex-direction: column;">
                                            <span class="stat-label">
                                                Seu Plano Alpha
                                            </span>
                                            {(!session.user?.plan ||
                                                session.user?.plan ===
                                                    "FREE") && (
                                                <a
                                                    href="/planos"
                                                    class="upgrade-link"
                                                >
                                                    Adquirir Plano{" "}
                                                    <i
                                                        class="fas fa-arrow-right"
                                                        style="font-size: 0.7rem;"
                                                    />
                                                </a>
                                            )}
                                            {(session.user?.plan === "BRONZE" || session.user?.plan === "PRATA") && (
                                                <a
                                                    href="/upgrade"
                                                    class="upgrade-link highlight"
                                                >
                                                    Upgrade de Plano{" "}
                                                    <i
                                                        class="fas fa-crown"
                                                        style="font-size: 0.7rem;"
                                                    />
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                </div>
                                <div class="stat-card store-card-btn">
                                    <div class="stat-icon store">
                                        <i class="fas fa-shopping-bag" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">LOJA</span>
                                        <span class="stat-label">
                                            Turbine seu Site
                                        </span>
                                    </div>
                                    <a href="/loja" class="launch-btn">
                                        Explorar{" "}
                                        <i class="fas fa-chevron-right" />
                                    </a>
                                </div>
                                </>
                            )}
                            {isPartner && (
                                    <div class="stat-card partner-stats-card">
                                        <div class="stat-icon partner">
                                            <i class="fas fa-handshake" />
                                        </div>
                                        <div class="stat-info">
                                            <span class="stat-value">
                                                {totalIndications}
                                            </span>
                                            <span class="stat-label">
                                                Suas Indicações
                                            </span>
                                        </div>
                                    </div>
                                )}
                            </>
                        )
                    }
                </div>

                <!-- Main Content Area -->
                <div class="content-grid">
                    <!-- My Site URL Section - CLIENT ONLY -->
                    {
                        !isAdmin && !isPartner && hasActivePlan && (
                            <section class="main-card site-url-section">
                                <div class="card-header">
                                    <h2>Link de Acesso Direto</h2>
                                    {session.user?.siteUrl && (
                                        <a
                                            href={session.user.siteUrl}
                                            target="_blank"
                                            class="visit-btn"
                                        >
                                            Visitar Site{" "}
                                            <i
                                                class="fas fa-external-link-alt ml-1"
                                                style="font-size: 0.8rem;"
                                            />
                                        </a>
                                    )}
                                </div>

                                {session.user?.siteUrl ? (
                                    <div class="site-display-box">
                                        <span class="url-label">
                                            Link do seu projeto:
                                        </span>
                                        <div class="url-capsule">
                                            <code>{session.user.siteUrl}</code>
                                            <button
                                                class="copy-url-btn"
                                                data-url={session.user.siteUrl}
                                            >
                                                <i class="fas fa-copy" />
                                            </button>
                                        </div>
                                    </div>
                                ) : (
                                    <div class="site-empty-box">
                                        <div
                                            class="add-site-trigger"
                                            id="add-site-link"
                                        >
                                            <span class="plus-icon">+</span>
                                            <div>
                                                <strong>
                                                    Adicionar Link do Site
                                                </strong>
                                                <p>
                                                    Vincule seu projeto Alpha
                                                    Code para acesso rápido.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </section>
                        )
                    }

                    <!-- Upgrade Banner - CLIENT WITHOUT PLAN -->
                    {
                        !isAdmin && !isPartner && !hasActivePlan && (
                            <section class="main-card upgrade-banner-section">
                                <div class="upgrade-container">
                                    <div class="upgrade-info">
                                        <span class="badge-promo">
                                            OPORTUNIDADE ALPHA
                                        </span>
                                        <h2>Seu site merece o Próximo Nível</h2>
                                        <p>
                                            Você está acessando o dashboard em
                                            modo limitado. Ao adquirir um Plano
                                            Alpha, você desbloqueia:
                                        </p>
                                        <ul class="upgrade-benefits">
                                            <li>
                                                <i class="fas fa-check-circle" />{" "}
                                                Suporte Prioritário (Até 12h)
                                            </li>
                                            <li>
                                                <i class="fas fa-check-circle" />{" "}
                                                Manutenção Técnica Mensal
                                            </li>
                                            <li>
                                                <i class="fas fa-check-circle" />{" "}
                                                Hospedagem de Alta Performance
                                            </li>
                                            <li>
                                                <i class="fas fa-check-circle" />{" "}
                                                20% OFF em novos projetos
                                            </li>
                                        </ul>
                                        <a
                                            href="/planos"
                                            class="btn-upgrade-main"
                                        >
                                            Escolher meu Plano{" "}
                                            <i class="fas fa-arrow-right" />
                                        </a>
                                    </div>
                                    <div class="upgrade-visual">
                                        <div class="floating-icons">
                                            <i class="fas fa-shield-halved" />
                                            <i class="fas fa-gauge-high" />
                                            <i class="fas fa-headset" />
                                        </div>
                                    </div>
                                </div>
                            </section>
                        )
                    }

                    {
                        isPartner && (
                            <>
                                <section class="main-card partner-portal-section">
                                    <div class="card-header">
                                        <div class="header-main-title">
                                            <h2>Portal do Parceiro</h2>
                                            <span class="badge-partner" style={`background: ${partnerTier.color}22; color: ${partnerTier.color}; border-color: ${partnerTier.color}44`}>
                                                {partnerTier.badge} Parceiro {partnerTier.name}
                                            </span>
                                        </div>
                                        <div class="points-badge">
                                            <i class="fas fa-star" /> {currentUser?.partnerPoints || 0} pts
                                        </div>
                                    </div>

                                    <!-- Progress Bar Gamification -->
                                    <div class="partner-gamification-box">
                                        <div class="tier-progress-header">
                                            <div class="tier-text">
                                                {nextTier ? (
                                                    <p>Você está a <strong>{indicationsToNextTier}</strong> indicações do nível <strong>{nextTier.name}</strong></p>
                                                ) : (
                                                    <p>Você atingiu o nível máximo! 🚀</p>
                                                )}
                                            </div>
                                            <span class="progress-percentage">{Math.round(partnerProgress)}%</span>
                                        </div>
                                        <div class="custom-progress-bar">
                                            <div class="progress-fill" style={`width: ${partnerProgress}%`}>
                                                <div class="progress-glow"></div>
                                            </div>
                                        </div>
                                        <div class="tier-milestones">
                                            {partnerTiers.map(tier => (
                                                <div class={`milestone ${totalIndications >= tier.reqN ? 'active' : ''}`}>
                                                    <span class="m-dot"></span>
                                                    <span class="m-label">{tier.name}</span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>

                                    <div class="referral-box">
                                        <div class="referral-info">
                                            <h3>Seu Link de Indicação</h3>
                                            <p>
                                                Compartilhe este link para que
                                                possamos rastrear suas indicações
                                                automaticamente.
                                            </p>
                                        </div>
                                        <div class="url-capsule partner-link">
                                            <code id="partner-referral-url">
                                                https://www.sitesalphacode.com.br?ref=
                                                {session.user.referralCode}
                                            </code>
                                            <button
                                                class="copy-url-btn"
                                                data-url={`https://www.sitesalphacode.com.br?ref=${session.user.referralCode}`}
                                            >
                                                <i class="fas fa-copy" />
                                            </button>
                                        </div>
                                    </div>

                                    <div class="indications-list-wrapper">
                                        <div class="list-header">
                                            <h3>Monitor de Indicações</h3>
                                            <a href="javascript:void(0)" class="view-all">Ver todos</a>
                                        </div>
                                        {indications.length > 0 ? (
                                            <div class="indications-table">
                                                <div class="indications-header">
                                                    <span>Nome</span>
                                                    <span>Data</span>
                                                    <span>Status</span>
                                                </div>
                                                {indications.map((ind: any) => (
                                                    <div class="indication-row">
                                                        <span class="ind-name">
                                                            {ind.name}
                                                        </span>
                                                        <span class="ind-date">
                                                            {new Date(
                                                                ind.createdAt,
                                                            ).toLocaleDateString(
                                                                "pt-BR",
                                                            )}
                                                        </span>
                                                        <span class={`ind-status-pill status-${ind.status?.toLowerCase() || 'new'}`}>
                                                            {ind.status === 'CLOSED' ? 'Fechado ✅' : 
                                                             ind.status === 'NEGOTIATING' ? 'Em Negociação 💬' : 
                                                             ind.status === 'CONTACTED' ? 'Contatado 📞' : 'Recebido 📥'}
                                                        </span>
                                                    </div>
                                                ))}
                                            </div>
                                        ) : (
                                            <div class="empty-indications">
                                                <i class="fas fa-user-plus" />
                                                <p>
                                                    Nenhuma indicação recebida
                                                    ainda.
                                                </p>
                                            </div>
                                        )}
                                    </div>
                                </section>

                                <!-- Kit do Parceiro (Resources) -->
                                <section class="main-card resources-section">
                                    <div class="card-header">
                                        <div class="header-main-title">
                                            <h2>Kit de Marketing Alpha</h2>
                                            <p>Baixe criativos e use scripts validados para converter mais.</p>
                                        </div>
                                    </div>
                                    <div class="resources-grid">
                                        {marketingResources.map(res => (
                                            <div class="resource-card">
                                                <div class="res-icon">
                                                    <i class={res.icon}></i>
                                                </div>
                                                <div class="res-content">
                                                    <h4>{res.title}</h4>
                                                    <p>{res.description}</p>
                                                    <div class="res-actions">
                                                        {res.downloadUrl && (
                                                            <a href={res.downloadUrl} class="res-btn download" download>
                                                                <i class="fas fa-download"></i> Baixar
                                                            </a>
                                                        )}
                                                        {res.copyText && (
                                                            <button type="button" class="res-btn copy-content-btn" data-content={res.copyText}>
                                                                <i class="fas fa-copy"></i> Copiar
                                                            </button>
                                                        )}
                                                        {res.externalUrl && (
                                                            <a href={res.externalUrl} target="_blank" rel="noopener noreferrer" class="res-btn external">
                                                                <i class="fas fa-external-link-alt"></i> Abrir
                                                            </a>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </section>
                            </>
                        )
                    }

                    <!-- Exclusive Benefits Section - CLIENT ONLY -->
                    {
                        !isAdmin && !isPartner && (
                            <>
                                {userRequests.length > 0 && (
                                    <section class="main-card maintenance-section">
                                        <div class="card-header">
                                            <h2>Status de Manutenção</h2>
                                            <span class="badge-count">
                                                {userRequests.length}{" "}
                                                solicitações
                                            </span>
                                        </div>
                                        <div class="request-list">
                                            {userRequests.map((req: any) => (
                                                <div class="request-item">
                                                    <div class="req-type">
                                                        <span
                                                            class={`type-dot ${req.serviceType}`}
                                                        />
                                                        <strong>
                                                            {req.serviceType ===
                                                            "SEO_TURBINADO"
                                                                ? "SEO Turbinado"
                                                                : "Manutenção"}
                                                        </strong>
                                                    </div>
                                                    <div class="req-status">
                                                        <span
                                                            class={`status-pill ${req.status}`}
                                                        >
                                                            {req.status ===
                                                            "PENDENTE"
                                                                ? "Aguardando"
                                                                : req.status ===
                                                                    "EM_EXECUCAO"
                                                                  ? "Em Andamento"
                                                                  : "Concluído"}
                                                        </span>
                                                    </div>
                                                    <div class="req-payment">
                                                        <span
                                                            class={`payment-pill ${req.paymentStatus}`}
                                                        >
                                                            {req.paymentStatus ===
                                                            "PAGO"
                                                                ? "Pago"
                                                                : "Pendente"}
                                                        </span>
                                                    </div>
                                                    <div class="req-date">
                                                        {new Date(
                                                            req.createdAt,
                                                        ).toLocaleDateString(
                                                            "pt-BR",
                                                        )}
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </section>
                                )}

                                <section class="main-card benefits-section">
                                    <div class="card-header">
                                        <h2>Benefícios da sua Conta</h2>
                                        <div
                                            class={`plan-badge ${session.user?.plan?.toLowerCase() || "free"}`}
                                        >
                                            Plano {session.user?.plan || "FREE"}
                                        </div>
                                    </div>

                                    <div class="benefits-grid">
