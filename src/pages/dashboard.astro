                        <div class="form-group">
                            <label>Valor Líquido (R$)</label>
                            <input
                                type="number"
                                name="amount"
                                step="0.01"
                                required
                                placeholder="0,00"
                                readonly
                                style="background: rgba(0,0,0,0.3); color: var(--color-primary); font-weight: bold;"
                            />
                            <small
                                style="color:var(--color-text-muted); font-size: 0.75rem;"
                                >Calculado automaticamente: (Plano + Serviço) -
                                Hospedagem</small
