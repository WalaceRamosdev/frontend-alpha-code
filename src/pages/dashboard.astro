                    color: var(--color-text-heading);
                    margin: 0 0 1.5rem 0;
                    font-weight: 600;
                }

                .action-link {
                    color: var(--color-primary);
                    background: none;
                    border: none;
                    cursor: pointer;
                    font-size: 0.9rem;
                    font-weight: 500;
                }

                .empty-state {
                    text-align: center;
                    padding: 3rem 1rem;
                    border: 2px dashed var(--glass-border);
                    border-radius: 12px;
                }

                .empty-icon {
                    color: var(--color-text-muted);
                    margin-bottom: 1rem;
                    opacity: 0.5;
                }

                .empty-state h3 {
                    color: var(--color-text-heading);
                    margin-bottom: 0.5rem;
                }

                .empty-state p {
                    color: var(--color-text-muted);
                    font-size: 0.9rem;
                    margin-bottom: 1.5rem;
                    max-width: 300px;
                    margin-left: auto;
                    margin-right: auto;
                }

                .btn-primary-small {
                    background: var(--color-primary);
                    color: #fff;
                    border: none;
                    padding: 0.6rem 1.5rem;
                    border-radius: 50px;
                    cursor: pointer;
                    font-weight: 600;
                    transition: 0.3s;
                    font-size: 0.9rem;
                }

                .btn-primary-small:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 15px rgba(138, 28, 38, 0.4);
                }

                /* Benefits Section */
                .benefits-section {
                    grid-column: 1 / -1;
                    margin-top: -1rem;
                }

                .upgrade-link {
                    font-size: 0.75rem;
                    color: var(--color-primary);
                    text-decoration: none;
                    font-weight: 700;
                    margin-top: 4px;
                }
                .upgrade-link:hover {
                    text-decoration: underline;
                }

                .plan-badge {
                    font-size: 0.7rem;
                    font-weight: 800;
                    padding: 4px 12px;
                    border-radius: 50px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                }
                .plan-badge.bronze {
                    background: rgba(205, 127, 50, 0.1);
                    color: #cd7f32;
                    border: 1px solid rgba(205, 127, 50, 0.2);
                }
                .plan-badge.prata {
                    background: rgba(192, 192, 192, 0.1);
                    color: #c0c0c0;
                    border: 1px solid rgba(192, 192, 192, 0.2);
                }
                .plan-badge.ouro {
                    background: rgba(212, 175, 55, 0.1);
                    color: #d4af37;
                    border: 1px solid rgba(212, 175, 55, 0.3);
                }

                .benefits-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                    gap: 1.5rem;
                    margin-top: 1rem;
                }

                .benefit-item {
                    display: flex;
                    align-items: center;
                    gap: 1.2rem;
                    padding: 1.2rem;
                    background: rgba(255, 255, 255, 0.02);
                    border: 1px solid var(--glass-border);
                    border-radius: 12px;
                    transition: all 0.3s ease;
                    cursor: pointer;
                }

                .benefit-item.locked {
                    opacity: 0.5;
                    filter: grayscale(1);
                    border-style: dashed;
                    cursor: not-allowed;
                }

                .benefit-item.active:hover,
                .benefit-item.vip-highlight:hover {
                    background: rgba(255, 255, 255, 0.05);
                    transform: translateY(-3px);
                    border-color: rgba(255, 255, 255, 0.1);
                    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
                }

                .benefit-item.vip-highlight {
                    border-color: rgba(212, 175, 55, 0.3);
                    background: linear-gradient(
                        135deg,
                        rgba(212, 175, 55, 0.05) 0%,
                        transparent 100%
                    );
                }

                .benefit-icon {
                    font-size: 1.5rem;
                    width: 48px;
                    height: 48px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: rgba(255, 255, 255, 0.03);
                    border-radius: 10px;
                }

                .benefit-info strong {
                    display: block;
                    color: #fff;
                    font-size: 0.95rem;
                    margin-bottom: 2px;
                }
                .benefit-info span {
                    font-size: 0.8rem;
                    color: var(--color-text-muted);
                }

                .sidebar-actions {
                    display: flex;
                    flex-direction: column;
                    gap: 2rem;
                }

                .quick-links {
                    display: flex;
                    flex-direction: column;
                    gap: 1.5rem; /* Distância entre os itens */
                }

                .quick-link {
                    display: flex;
                    align-items: center;
                    gap: 1.5rem;
                    padding: 1.5rem; /* Largura/Tamanho maior */
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.03);
                    border: 1px solid var(--glass-border);
                    text-decoration: none;
                    color: var(--color-text-muted);
                    transition: all 0.3s ease;
                }

                .quick-link:hover {
                    background: rgba(255, 255, 255, 0.05);
                    border-color: var(--glass-border);
                    color: var(--color-text-heading);
                    transform: translateX(5px);
                }

                .quick-link .icon {
                    font-size: 1rem;
                    width: 42px;
                    height: 42px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: rgba(255, 255, 255, 0.05);
                    border-radius: 10px;
                    flex-shrink: 0;
                }

                .quick-link .icon.users {
                    background: rgba(168, 85, 247, 0.15);
                    color: #a855f7;
                }
                .quick-link .icon.history {
                    background: rgba(245, 158, 11, 0.15);
                    color: #f59e0b;
                }
                .quick-link .icon.profile {
                    background: rgba(168, 85, 247, 0.15);
                    color: #a855f7;
                }
                .quick-link .icon.maintenance {
                    background: rgba(239, 68, 68, 0.15);
                    color: #ef4444;
                }
                .quick-link .icon.invoices {
                    background: rgba(16, 185, 129, 0.15);
                    color: #10b981;
                }

                .quick-link div {
                    display: flex;
                    flex-direction: column;
                }

                .quick-link strong {
                    color: var(--color-text-heading);
                    font-size: 0.95rem;
                }

                .quick-link span {
                    font-size: 0.8rem;
                }

                /* Modal Styles */
                .modal-backdrop {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.7);
                    backdrop-filter: blur(5px);
                    z-index: 1000;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    opacity: 1;
                    transition: opacity 0.3s ease;
                }

                .modal-backdrop.hidden {
                    display: none;
                    opacity: 0;
                    pointer-events: none;
                }

                .modal-content {
                    background: #1a1a1a;
                    border: 1px solid var(--glass-border);
                    border-radius: 16px;
                    width: 90%;
                    max-width: 500px;
                    padding: 2rem;
                    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
                    transform: translateY(0);
                    transition: transform 0.3s ease;
                    max-height: 90vh;
                    overflow-y: auto;
                    overflow-x: hidden; /* Prevent horizontal scroll */
                }

                /* Custom Scrollbar */
                .modal-content::-webkit-scrollbar {
                    width: 8px;
                }
                .modal-content::-webkit-scrollbar-track {
                    background: rgba(255, 255, 255, 0.02);
                    border-radius: 4px;
                }
                .modal-content::-webkit-scrollbar-thumb {
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 4px;
                }
                .modal-content::-webkit-scrollbar-thumb:hover {
                    background: rgba(255, 255, 255, 0.2);
                }

                .modal-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 2rem;
                    border-bottom: 1px solid var(--glass-border);
                    padding-bottom: 1rem;
                }

                .modal-header h2 {
                    font-size: 1.5rem;
                    color: var(--color-text-heading);
                    margin: 0;
                }

                .close-btn {
                    background: none;
                    border: none;
                    color: var(--color-text-muted);
                    font-size: 2rem;
                    cursor: pointer;
                    line-height: 1;
                }

                .close-btn:hover {
                    color: #fff;
                }

                .form-group {
                    margin-bottom: 1.5rem;
                }

                .form-group label {
                    display: block;
                    margin-bottom: 0.5rem;
                    color: var(--color-text-muted);
                    font-size: 0.9rem;
                }

                .form-group input,
                .custom-select select,
                .form-group textarea {
                    width: 100%;
                    padding: 1rem;
                    background: rgba(255, 255, 255, 0.05);
                    border: 1px solid var(--glass-border);
                    border-radius: 8px;
                    color: #fff;
                    font-family: inherit;
                    appearance: none;
                    outline: none;
                    transition: all 0.3s ease;
                }

                .custom-select {
                    position: relative;
                    width: 100%;
                }

                .select-arrow {
                    position: absolute;
                    right: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    pointer-events: none;
                    color: var(--color-text-muted);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .form-group select option {
                    background-color: #1a1a1a;
                    color: #fff;
                }

                .form-group input:focus,
                .custom-select select:focus,
                .form-group textarea:focus {
                    border-color: var(--color-primary);
                    background: rgba(255, 255, 255, 0.08);
                    box-shadow: 0 0 0 2px rgba(138, 28, 38, 0.2);
                }

                .modal-actions {
                    display: flex;
                    justify-content: flex-end;
                    gap: 1rem;
                    margin-top: 2rem;
                }

                .btn-secondary {
                    background: transparent;
                    border: 1px solid var(--glass-border);
                    color: var(--color-text-muted);
                    padding: 0.6rem 1.5rem;
                    border-radius: 50px;
                    cursor: pointer;
                    transition: 0.3s;
                }

                .btn-secondary:hover {
                    border-color: #fff;
                    color: #fff;
                }

                .btn-submit {
                    background: var(--color-primary);
                    color: #fff;
                    border: none;
                    padding: 0.6rem 2rem;
                    border-radius: 50px;
                    cursor: pointer;
                    font-weight: 600;
                    transition: 0.3s;
                }

                .btn-submit:hover {
                    box-shadow: 0 4px 15px rgba(138, 28, 38, 0.4);
                    transform: translateY(-2px);
                }

                /* Financial Table Styles */
                .financial-table-wrapper {
                    width: 100%;
                    overflow-x: auto;
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.02);
                    border: 1px solid var(--glass-border);
                }

                .financial-table {
                    width: 100%;
