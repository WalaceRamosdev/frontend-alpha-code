---
import Layout from "../layouts/BaseLayout.astro";
import { getSession } from "../lib/auth";
import { prisma } from "../lib/prisma";
import AdminSidebar from "../components/admin/AdminSidebar.astro";
import StatusModal from "../components/ui/StatusModal.astro";
// import authConfig from "../auth.config";
// import { SignOut } from "auth-astro/components";

let session = null;
try {
    session = await getSession(Astro.request);
} catch (e) {
    console.error("Dashboard Auth Error:", e);
}

if (!session) {
    return Astro.redirect("/login");
}
const isAdmin = session.user?.role === "ADMIN";
const projectCount = isAdmin ? await prisma.project.count() : 0;
const maintenanceCount = isAdmin
    ? await (prisma as any).maintenanceRequest.count()
    : 0;
const financialRecords = isAdmin ? await prisma.financialRecord.findMany() : [];
const totalRevenue = financialRecords.reduce(
    (acc, record) => acc + record.amount,
    0,
);
const formattedRevenue = new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
}).format(totalRevenue);

export const prerender = false;
---

<Layout
    title="Dashboard | Alpha Code"
    showWhatsApp={false}
    showHeader={false}
    showFooter={false}
>
    <div class="admin-container">
        <AdminSidebar activePage="dashboard" />

        <div class="dashboard-wrapper">
            <!-- Background Ambient Glow -->
            <div class="ambient-glow"></div>

            <div class="container dashboard-container">
                <!-- Header Section -->
                <header class="dashboard-header">
                    <div class="user-profile-header">
                        <div class="header-avatar">
                            {
                                session.user?.image ? (
                                    <img
                                        src={session.user.image}
                                        alt="Profile"
                                        id="header-avatar-img"
                                    />
                                ) : (
                                    <div class="avatar-letter">
                                        {session.user?.name?.charAt(0) || "U"}
                                    </div>
                                )
                            }
                        </div>
                        <div class="welcome-text">
                            <span class="greeting">Bem-vindo de volta,</span>
                            <h1 class="user-name">
                                {session.user?.name || "Cliente Alpha"}
                            </h1>
                        </div>
                    </div>
                    <div class="header-actions">
                        <button id="logout-btn" class="logout-btn">
                            <i class="fas fa-right-from-bracket"></i>
                            <span>Sair</span>
                        </button>
                    </div>
                </header>

                <!-- Stats Grid -->
                <div class={`stats-grid`}>
                    {
                        isAdmin ? (
                            /* ADMIN STATS */
                            <>
                                <div class="stat-card">
                                    <div class="stat-icon project">
                                        <i class="fas fa-briefcase" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {projectCount}
                                        </span>{" "}
                                        <span class="stat-label">
                                            Projetos Entregues
                                        </span>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin/projects/history"
                                            class="history-link-card"
                                        >
                                            📂 Gerenciar
                                        </a>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon invoice">
                                        <i class="fas fa-wallet" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {formattedRevenue}
                                        </span>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin/financial/history"
                                            class="history-link-card"
                                        >
                                            📄 Histórico
                                        </a>
                                        <button
                                            id="open-financial-modal"
                                            class="launch-btn"
                                        >
                                            + Lançar Ganhos
                                        </button>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon support">
                                        <i class="fas fa-tools" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {maintenanceCount}
                                        </span>
                                        <span class="stat-label">
                                            Solicitações
                                        </span>
                                    </div>
                                    <div class="financial-actions">
                                        <a
                                            href="/admin/maintenance/requests"
                                            class="history-link-card"
                                        >
                                            🔧 Gerenciar
                                        </a>
                                    </div>
                                </div>
                                {/* No VIP Card for Admin */}
                            </>
                        ) : (
                            /* CLIENT STATS */
                            <>
                                <div class="stat-card">
                                    <div class="stat-icon project">
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <>
                                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                                            </>
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">0</span>
                                        <span class="stat-label">
                                            Projetos Ativos
                                        </span>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon invoice">
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <>
                                                <rect
                                                    x="2"
                                                    y="5"
                                                    width="20"
                                                    height="14"
                                                    rx="2"
                                                />
                                                <line
                                                    x1="2"
                                                    y1="10"
                                                    x2="22"
                                                    y2="10"
                                                />
                                            </>
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">R$ 0,00</span>
                                        <span class="stat-label">
                                            Faturas em Aberto
                                        </span>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon support">
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">0</span>
                                        <span class="stat-label">
                                            Tickets Abertos
                                        </span>
                                    </div>
                                </div>
                                <div class="stat-card plan-badge-card">
                                    <div class="stat-icon plan">
                                        <i class="fas fa-award" />
                                    </div>
                                    <div class="stat-info">
                                        <span class="stat-value">
                                            {session.user?.plan || "BRONZE"}
                                        </span>
                                        <a href="/upgrade" class="upgrade-link">
                                            Gerenciar Plano
                                        </a>
                                    </div>
                                </div>
                            </>
                        )
                    }
                </div>

                <!-- Main Content Area -->
                <div class="content-grid">
                    <!-- My Site URL Section - CLIENT ONLY -->
                    {
                        !isAdmin && (
                            <section class="main-card site-url-section">
                                <div class="card-header">
                                    <h2>Meu Projeto Alpha</h2>
                                    {session.user?.siteUrl && (
                                        <a
                                            href={session.user.siteUrl}
                                            target="_blank"
                                            class="visit-btn"
                                        >
                                            Visitar Site{" "}
                                            <i
                                                class="fas fa-external-link-alt ml-1"
                                                style="font-size: 0.8rem;"
                                            />
                                        </a>
                                    )}
                                </div>

                                {session.user?.siteUrl ? (
                                    <div class="site-display-box">
                                        <span class="url-label">
                                            Link do seu projeto:
                                        </span>
                                        <div class="url-capsule">
                                            <code>{session.user.siteUrl}</code>
                                            <button
                                                class="copy-url-btn"
                                                data-url={session.user.siteUrl}
                                            >
                                                <i class="fas fa-copy" />
                                            </button>
                                        </div>
                                    </div>
                                ) : (
                                    <div class="site-empty-box">
                                        <div
                                            class="add-site-trigger"
                                            id="add-site-link"
                                        >
                                            <span class="plus-icon">+</span>
                                            <div>
                                                <strong>
                                                    Adicionar Link do Site
                                                </strong>
                                                <p>
                                                    Vincule seu projeto Alpha
                                                    Code para acesso rápido.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </section>
                        )
                    }

                    <!-- Exclusive Benefits Section - CLIENT ONLY -->
                    {
                        !isAdmin && (
                            <section class="main-card benefits-section">
                                <div class="card-header">
                                    <h2>Benefícios da sua Conta</h2>
                                    <a
                                        href="/upgrade"
                                        class={`plan-badge ${session.user?.plan?.toLowerCase() || "bronze"}`}
                                    >
                                        Plano{" "}
                                        {session.user?.plan === "BRONZE" ||
                                        !session.user?.plan
                                            ? "Bronze"
                                            : session.user?.plan === "PRATA"
                                              ? "Prata"
                                              : "Ouro"}
                                    </a>
                                </div>

                                <div class="benefits-grid">
                                    {(!session.user?.plan ||
                                        session.user?.plan === "BRONZE") && (
                                        <div class="benefit-item locked">
                                            <div class="benefit-icon">🔒</div>
                                            <div class="benefit-info">
                                                <strong>
                                                    Suporte Prioritário
                                                </strong>
                                                <span>
                                                    Exclusivo para planos Prata
                                                    e Ouro
                                                </span>
                                            </div>
                                        </div>
                                    )}

                                    {session.user?.plan === "PRATA" && (
                                        <>
                                            <div class="benefit-item active">
                                                <div class="benefit-icon">
                                                    🛡️
                                                </div>
                                                <div class="benefit-info">
                                                    <strong>
                                                        Suporte Ouro
                                                    </strong>
                                                    <span>
                                                        Atendimento em até 12h
                                                        úteis.
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="benefit-item active">
                                                <div class="benefit-icon">
                                                    🏷️
                                                </div>
                                                <div class="benefit-info">
                                                    <strong>
                                                        Desconto Exclusivo
                                                    </strong>
                                                    <span>
                                                        20% OFF em qualquer novo
                                                        projeto.
                                                    </span>
                                                </div>
                                            </div>
                                        </>
                                    )}

                                    {session.user?.plan === "OURO" && (
                                        <>
                                            <div class="benefit-item active vip-highlight">
                                                <div class="benefit-icon">
                                                    👑
                                                </div>
                                                <div class="benefit-info">
                                                    <strong>
                                                        Consultoria VIP
                                                    </strong>
                                                    <span>
                                                        Acesso direto ao
                                                        arquiteto de software.
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="benefit-item active">
                                                <div class="benefit-icon">
                                                    🛠️
                                                </div>
                                                <div class="benefit-info">
                                                    <strong>
                                                        Manutenção Inclusa
                                                    </strong>
                                                    <span>
                                                        1 ajuste técnico mensal
                                                        gratuito.
                                                    </span>
                                                </div>
                                            </div>
                                        </>
                                    )}

                                    <div class="benefit-item active">
                                        <div class="benefit-icon">🚀</div>
                                        <div class="benefit-info">
                                            <strong>Hospedagem Alpha</strong>
                                            <span>
                                                Ambiente otimizado para alta
                                                performance.
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        )
                    }

                    <!-- Projects Section -->
                    <section
                        class="main-card projects-section"
                        id="portfolio-section"
                    >
                        <div class="card-header">
                            <h2>
                                {
                                    isAdmin
                                        ? "Portfólio / Projetos Finalizados"
                                        : "Meus Projetos"
                                }
                            </h2>
                            {
                                isAdmin ? (
                                    <button
                                        id="add-portfolio-btn"
                                        class="action-link"
                                    >
                                        Adicionar ao Portfólio +
                                    </button>
                                ) : (
                                    <button
                                        id="new-project-btn"
                                        class="action-link"
                                    >
                                        Novo Projeto +
                                    </button>
                                )
                            }
                        </div>
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i
                                    class="fas fa-layer-group"
                                    style="font-size: 3rem;"></i>
                            </div>
                            <h3>
                                {
                                    isAdmin
                                        ? "Gerencie os projetos entregues"
                                        : "Nenhum projeto em andamento"
                                }
                            </h3>
                            <p>
                                {
                                    isAdmin
                                        ? "Adicione projetos concluídos para exibir no portfólio."
                                        : "Inicie um novo projeto conosco para transformar suas ideias em realidade digital."
                                }
                            </p>
                            {
                                isAdmin ? (
                                    <button
                                        id="add-portfolio-cta"
                                        class="btn-primary-small"
                                    >
                                        Adicionar Novo
                                    </button>
                                ) : (
                                    <button
                                        id="new-project-cta"
                                        class="btn-primary-small"
                                    >
                                        Solicitar Orçamento
                                    </button>
                                )
                            }
                        </div>
                    </section>

                    <!-- Sidebar / Quick Actions -->
                    <aside class="sidebar-actions">
                        <div class="main-card action-card">
                            <h3>Ações Rápidas</h3>
                            <div class="quick-links">
                                {
                                    isAdmin ? (
                                        /* ADMIN ACTIONS */
                                        <>
                                            <a href="/admin" class="quick-link">
                                                <span class="icon users">
                                                    <i class="fas fa-users-gear" />
                                                </span>
                                                <div>
                                                    <strong>
                                                        Editar perfil de cliente
                                                    </strong>
                                                    <span>
                                                        Gestão de usuários
                                                    </span>
                                                </div>
                                            </a>
                                            <a
                                                href="/admin/projects/history"
                                                class="quick-link"
                                            >
                                                <span class="icon history">
                                                    <i class="fas fa-scroll" />
                                                </span>
                                                <div>
                                                    <strong>
                                                        Histórico de Projetos
                                                    </strong>
                                                    <span>
                                                        Ver detalhes completos
                                                    </span>
                                                </div>
                                            </a>
                                            <a
                                                href="/perfil"
                                                class="quick-link"
                                            >
                                                <span class="icon profile">
                                                    <i class="fas fa-user-circle" />
                                                </span>
                                                <div>
                                                    <strong>Perfil</strong>
                                                    <span>Editar dados</span>
                                                </div>
                                            </a>
                                        </>
                                    ) : (
                                        /* CLIENT ACTIONS */
                                        <>
                                            <a
                                                href="/pedido?plan=manutencao"
                                                class="quick-link"
                                            >
                                                <span class="icon maintenance">
                                                    <i class="fas fa-screwdriver-wrench" />
                                                </span>
                                                <div>
                                                    <strong>Manutenção</strong>
                                                    <span>
                                                        Solicitar ajuste ou
                                                        reparo
                                                    </span>
                                                </div>
                                            </a>
                                            <a
                                                href="/faturas"
                                                class="quick-link"
                                            >
                                                <span class="icon invoices">
                                                    <i class="fas fa-file-invoice-dollar" />
                                                </span>
                                                <div>
                                                    <strong>
                                                        Minhas Faturas
                                                    </strong>
                                                    <span>Ver histórico</span>
                                                </div>
                                            </a>
                                            <a
                                                href="/perfil"
                                                class="quick-link"
                                            >
                                                <span class="icon profile">
                                                    <i class="fas fa-user-circle" />
                                                </span>
                                                <div>
                                                    <strong>Perfil</strong>
                                                    <span>Editar dados</span>
                                                </div>
                                            </a>
                                        </>
                                    )
                                }
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </div>

        <!-- Modal Novo Projeto -->
        <div id="project-modal" class="modal-backdrop hidden">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Iniciar Novo Projeto</h2>
                    <button id="close-modal" class="close-btn">&times;</button>
                </div>
                <form class="project-form">
                    <div class="form-group">
                        <label>Nome do Projeto</label>
                        <input
                            type="text"
                            placeholder="Ex: E-commerce de Roupas"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label>Tipo de Serviço</label>
                        <div class="custom-select">
                            <select>
                                <option>Web Site Institucional</option>
                                <option>E-commerce / Loja Virtual</option>
                                <option>Sistema Web Personalizado</option>
                                <option>Landing Page</option>
                            </select>
                            <div class="select-arrow">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><polyline points="6 9 12 15 18 9"
                                    ></polyline></svg
                                >
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Descrição Breve</label>
                        <textarea
                            rows="4"
                            placeholder="Descreva suas ideias e objetivos..."
                        ></textarea>
                    </div>
                    <div class="modal-actions">
                        <button
                            type="button"
                            id="cancel-modal"
                            class="btn-secondary">Cancelar</button
                        >
                        <button type="submit" class="btn-submit"
                            >Enviar Solicitação</button
                        >
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Vincular Site -->
        <div id="site-modal" class="modal-backdrop hidden">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Vincular Projeto Alpha</h2>
                    <button id="close-site-modal" class="close-btn"
                        >&times;</button
                    >
                </div>
                <form class="project-form" id="site-url-form">
                    <div class="form-group">
                        <label>URL do seu site adquirido</label>
                        <input
                            type="text"
                            id="site-url-input"
                            placeholder="www.seuprojeto.com.br"
                            required
                            value={session.user?.siteUrl || ""}
                        />
                        <small
                            style="color: var(--color-text-muted); font-size: 0.75rem; display: block; margin-top: 0.5rem;"
                        >
                            Insira a URL completa para aparecer no seu
                            dashboard.
                        </small>
                    </div>
                    <div class="modal-actions">
                        <button
                            type="button"
                            id="cancel-site-modal"
                            class="btn-secondary">Cancelar</button
                        >
                        <button
                            type="submit"
                            class="btn-submit"
                            id="save-site-btn">Salvar Link</button
                        >
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Adicionar Portfólio (ADMIN) -->
        <div id="portfolio-modal" class="modal-backdrop hidden">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Adicionar ao Portfólio</h2>
                    <button id="close-portfolio-modal" class="close-btn"
                        >&times;</button
                    >
                </div>
                <form class="project-form" id="portfolio-form">
                    <div class="form-group">
                        <label>Nome do Projeto</label>
                        <input
                            type="text"
                            name="name"
                            required
                            placeholder="Ex: Alpha Code Site"
                        />
                    </div>
                    <div class="form-group">
                        <label>Tipo de Projeto</label>
                        <div class="custom-select">
                            <select name="type">
                                <option>Site Institucional</option>
                                <option>Landing Page</option>
                                <option>E-commerce / Loja Virtual</option>
                                <option>Sistema Web Personalizado</option>
                                <option>Site para Advogados</option>
                                <option>Site para Saúde / Clínicas</option>
                                <option>Site para Arquitetura</option>
                                <option>Site para Restaurantes</option>
                                <option>Site para Contabilidade</option>
                                <option>Site Educacional</option>
                                <option>Site para Estética</option>
                                <option>Portfólio Online</option>
                                <option>Blog / Portal</option>
                            </select>
                            <div class="select-arrow">
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    ><polyline points="6 9 12 15 18 9"
                                    ></polyline></svg
                                >
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Categoria</label>
                        <div class="custom-select">
                            <select name="category">
                                <option value="juridico">Jurídico</option>
                                <option value="saude">Saúde</option>
                                <option value="educacao">Educação</option>
                                <option value="gastronomia">Gastronomia</option>
                                <option value="institucional"
                                    >Institucional</option
                                >
                                <option value="outros">Outros</option>
                            </select>
                            <div class="select-arrow">
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    ><polyline points="6 9 12 15 18 9"
                                    ></polyline></svg
                                >
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>URL da Imagem (Capa)</label>
                        <input
                            type="text"
                            name="imageUrl"
                            required
                            placeholder="https://..."
                        />
                    </div>
                    <div class="form-group">
                        <label>Link do Projeto (Online)</label>
                        <input
                            type="text"
                            name="projectUrl"
                            required
                            placeholder="https://..."
                        />
                    </div>
                    <div class="modal-actions">
                        <button
                            type="button"
                            id="cancel-portfolio-modal"
                            class="btn-secondary">Cancelar</button
                        >
                        <button type="submit" class="btn-submit"
                            >Adicionar</button
                        >
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Financeiro (ADMIN) -->
        <div id="financial-modal" class="modal-backdrop hidden">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Lançamento Financeiro</h2>
                    <button id="close-financial-modal" class="close-btn"
                        >&times;</button
                    >
                </div>
                <div class="modal-body">
                    <form class="project-form" id="financial-form">
                        <div class="form-group">
                            <label>Plano</label>
                            <div class="custom-select">
                                <select name="service" id="financial-plan">
                                    <option value="Plano Bronze"
                                        >Plano Bronze</option
                                    >
                                    <option value="Plano Prata"
                                        >Plano Prata</option
                                    >
