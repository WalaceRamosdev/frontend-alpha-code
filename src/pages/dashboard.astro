            }

            .benefit-icon {
                font-size: 1.5rem;
                width: 48px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.03);
                border-radius: 10px;
            }

            /* Upgrade Banner Styles */
            .upgrade-banner-section {
                grid-column: 1 / -1;
                background: linear-gradient(
                    135deg,
                    rgba(138, 28, 38, 0.1) 0%,
                    rgba(138, 28, 38, 0.02) 100%
                );
                border: 1px solid rgba(138, 28, 38, 0.2);
                padding: 0;
                overflow: hidden;
                position: relative;
            }

            .upgrade-container {
                display: grid;
                grid-template-columns: 1.5fr 1fr;
                min-height: 350px;
            }

            @media (max-width: 768px) {
                .upgrade-container {
                    grid-template-columns: 1fr;
                }
                .upgrade-visual {
                    display: none;
                }
            }

            .upgrade-info {
                padding: 3rem;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 1.5rem;
            }

            .badge-promo {
                background: rgba(138, 28, 38, 0.15);
                color: var(--color-primary);
                font-size: 0.75rem;
                font-weight: 800;
                padding: 5px 12px;
                border-radius: 50px;
                align-self: flex-start;
                letter-spacing: 1px;
                border: 1px solid rgba(138, 28, 38, 0.3);
            }

            .upgrade-info h2 {
                font-size: 2.2rem;
                color: #fff;
                margin: 0;
                line-height: 1.2;
            }

            .upgrade-info p {
                color: var(--color-text-muted);
                font-size: 1.05rem;
                max-width: 500px;
                line-height: 1.6;
            }

            .upgrade-benefits {
                list-style: none;
                padding: 0;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 1rem;
            }

            .upgrade-benefits li {
                display: flex;
                align-items: center;
                gap: 10px;
                color: #e0e0e0;
                font-size: 0.9rem;
            }

            .upgrade-benefits li i {
                color: var(--color-primary);
            }

            .btn-upgrade-main {
                background: var(--color-primary);
                color: white;
                text-decoration: none;
                padding: 1rem 2rem;
                border-radius: 12px;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                align-self: flex-start;
                transition: all 0.3s ease;
                margin-top: 1rem;
                box-shadow: 0 10px 20px rgba(138, 28, 38, 0.3);
            }

            .btn-upgrade-main:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(138, 28, 38, 0.5);
                background: #a31525;
            }

            .upgrade-visual {
                background: rgba(255, 255, 255, 0.02);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

            .floating-icons {
                font-size: 3rem;
                color: var(--color-primary);
                display: flex;
                gap: 2rem;
                opacity: 0.4;
            }

            .floating-icons i:nth-child(1) {
                animation: float 6s infinite ease-in-out;
            }
            .floating-icons i:nth-child(2) {
                animation: float 6s infinite ease-in-out 1.5s;
            }
            .floating-icons i:nth-child(3) {
                animation: float 6s infinite ease-in-out 3s;
            }

            @keyframes float {
                0%,
                100% {
                    transform: translateY(0);
                }
                50% {
                    transform: translateY(-20px);
                }
            }

            /* Alpha Store Styles */
            .store-section {
                grid-column: 1 / -1;
                margin-top: 2rem;
                border: 1px solid rgba(138, 28, 38, 0.2);
                background: linear-gradient(
                    145deg,
                    rgba(20, 20, 20, 0.6),
                    rgba(138, 28, 38, 0.02)
                );
            }

            .badge-new {
                background: var(--color-primary);
                color: white;
                font-size: 0.65rem;
                font-weight: 800;
                padding: 3px 8px;
                border-radius: 4px;
                letter-spacing: 1px;
            }

            .store-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 1.5rem;
                margin-top: 1rem;
            }

            .store-item {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid var(--glass-border);
                border-radius: 16px;
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 1rem;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .store-item:hover {
                background: rgba(255, 255, 255, 0.05);
                transform: translateY(-5px);
                border-color: rgba(138, 28, 38, 0.4);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            }

            .store-icon {
                width: 50px;
                height: 50px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
                margin-bottom: 0.5rem;
