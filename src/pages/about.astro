---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/sections/About.astro";
import Process from "../components/sections/Process.astro";
import FAQ from "../components/sections/FAQ.astro";

const title = "Sobre a Alpha Code | Especialistas em Autoridade Digital";
const description =
    "Conheça a Alpha Code, a agência líder em criação de sites de alta performance para profissionais liberais e empresas. Nossa missão é transformar sua presença digital em uma máquina de vendas.";

const keywords = [
    "sobre alpha code",
    "agência de criação de sites",
    "especialistas em seo",
    "autoridade digital",
    "desenvolvimento web premium",
    "estratégia digital",
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <main class="about-page">
        <!-- Hero Section for About -->
        <header class="about-hero">
            <div class="container">
                <span class="badge fade-up">Nossa História</span>
                <h1 class="fade-up">
                    Construindo a <span class="text-gradient">Autoridade</span> de
                    quem move o mercado.
                </h1>
                <p class="lead fade-up delay-1">
                    Na Alpha Code, não entregamos apenas código e design.
                    Entregamos o posicionamento que seu negócio merece para
                    dominar a primeira página do Google.
                </p>
            </div>
        </header>

        <AboutSection />

        <section class="container mission-vision">
            <div class="mission-vision-grid">
                <div class="mv-card fade-up">
                    <div class="mv-icon-box">
                        <span class="mv-icon">🎯</span>
                    </div>
                    <div class="mv-content">
                        <h2>Nossa Missão</h2>
                        <p>
                            Democratizar o acesso a sites de padrão
                            internacional para profissionais que buscam
                            excelência. Criamos pontes entre o seu conhecimento
                            técnico e o seu cliente ideal através de uma
                            estrutura digital impecável.
                        </p>
                    </div>
                </div>
                <div class="mv-card fade-up delay-1">
                    <div class="mv-icon-box">
                        <span class="mv-icon">🚀</span>
                    </div>
                    <div class="mv-content">
                        <h2>Nossa Visão</h2>
                        <p>
                            Ser a maior referência em autoridade digital para o
                            setor de serviços no Brasil, reconhecida pela união
                            inseparável entre design premium e resultados
                            matemáticos de SEO.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <Process />

        <section class="authority-section fade-up">
            <div class="container">
                <div class="authority-content glass-panel">
                    <h2 class="text-gradient">
                        Por que confiar na Alpha Code?
                    </h2>
                    <div class="authority-grid">
                        <div class="auth-box">
                            <span class="auth-number">+530</span>
                            <span class="auth-label">Projetos Ativos</span>
                            <div class="auth-bar"></div>
                        </div>
                        <div class="auth-box highlight">
                            <span class="auth-number">98%</span>
                            <span class="auth-label">Taxa de Retenção</span>
                            <div class="auth-bar"></div>
                        </div>
                        <div class="auth-box">
                            <span class="auth-number">24/7</span>
                            <span class="auth-label">Suporte Dedicado</span>
                            <div class="auth-bar"></div>
                        </div>
                    </div>
                    <div class="deep-text-premium">
                        <p>
                            Nossa equipe é formada por especialistas em cada
                            pilar do sucesso digital: designers focados em UX,
                            desenvolvedores especialistas em performance e
                            estrategistas de SEO que entendem a psicologia de
                            vendas do seu nicho.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="container author-bio fade-up">
            <div class="bio-card-wrapper">
                <div class="glass-panel bio-card p-5">
                    <div class="author-image-container mb-4">
                        <img
                            src="https://github.com/WalaceRamosdev.png"
                            alt="Walace Ramos - Fundador Alpha Code"
                            class="founder-img"
                        />
                    </div>
                    <div class="author-info text-center">
                        <span class="text-primary font-bold"
                            >Fundador & Estrategista</span
                        >
                        <h2 class="mt-2">Walace Ramos</h2>
                        <div class="bio-text mt-4">
                            <p>
                                Com mais de 10 anos de experiência no mercado de
                                tecnologia, Walace fundou a Alpha Code com um
                                propósito claro: elevar o padrão digital de
                                profissionais que são referência offline, mas
                                ainda invisíveis no Google.
                            </p>
                            <p class="quote">
                                "SEO não é sobre enganar robôs, é sobre ser a
                                melhor resposta para o seu cliente."
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <FAQ />
    </main>
</BaseLayout>

<style>
    .about-page {
        padding-top: 80px;
    }

    .about-hero {
        padding: 100px 0 60px;
        text-align: center;
        background: radial-gradient(
            circle at center,
            rgba(138, 28, 38, 0.05) 0%,
            transparent 70%
        );
    }

    .about-hero h1 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        margin: 1.5rem 0;
        line-height: 1.1;
    }

    .about-hero .lead {
        font-size: 1.25rem;
        color: var(--color-text-secondary);
        max-width: 800px;
        margin: 0 auto;
    }

    .mission-vision {
        padding: 120px 0;
    }

    .mission-vision-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .mv-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 40px;
        padding: 60px;
        display: flex;
        flex-direction: column;
        gap: 30px;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

    .mv-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(
            circle at top right,
            rgba(138, 28, 38, 0.1),
            transparent 70%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .mv-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(138, 28, 38, 0.3);
    }

    .mv-card:hover::before {
        opacity: 1;
    }

    .mv-icon-box {
        width: 80px;
        height: 80px;
        background: rgba(138, 28, 38, 0.1);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(138, 28, 38, 0.2);
    }

    .mv-icon {
        font-size: 2.5rem;
    }

    .mv-content h2 {
        font-size: 2.4rem;
        margin-bottom: 20px;
        color: white;
    }

    .mv-content p {
        font-size: 1.15rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.7);
    }

    .authority-section {
        padding: 100px 0;
    }

    .authority-content {
        padding: 100px 60px;
        border-radius: 60px;
        text-align: center;
    }

    .authority-content h2 {
        font-size: 3.5rem;
        margin-bottom: 5rem;
    }

    .authority-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-bottom: 5rem;
    }

    .auth-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        padding: 40px;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.01);
        position: relative;
    }

    .auth-box.highlight {
        background: rgba(138, 28, 38, 0.03);
        border: 1px solid rgba(138, 28, 38, 0.1);
    }

    .auth-number {
        font-size: 5rem;
        font-weight: 800;
        color: var(--color-primary);
        line-height: 1;
        text-shadow: 0 0 30px rgba(138, 28, 38, 0.3);
    }

    .auth-label {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 4px;
        font-weight: 700;
    }

    .auth-bar {
        width: 40px;
        height: 4px;
        background: var(--color-primary);
        border-radius: 2px;
        margin-top: 10px;
        opacity: 0.5;
    }

    .deep-text-premium {
        max-width: 900px;
        margin: 0 auto;
        font-size: 1.3rem;
        line-height: 1.9;
        color: rgba(255, 255, 255, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 4rem;
    }

    .author-bio {
        padding: 140px 0;
    }

    .bio-card-wrapper {
        max-width: 1100px;
        margin: 0 auto;
    }

    .bio-card {
        padding: 100px 80px !important;
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 80px;
        align-items: center;
        text-align: left;
    }

    .founder-img {
        width: 100%;
        height: 450px;
        border-radius: 40px;
        object-fit: cover;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8);
    }

    .author-info h2 {
        font-size: 3.5rem;
        margin-bottom: 20px;
    }

    .bio-text p {
        font-size: 1.25rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 2rem;
    }

    .bio-text .quote {
        font-style: italic;
        color: white;
        font-weight: 700;
        font-size: 1.6rem;
        line-height: 1.4;
        border-left: 4px solid var(--color-primary);
        padding-left: 30px;
        margin-top: 3rem;
    }

    @media (max-width: 992px) {
        .mission-vision-grid {
            grid-template-columns: 1fr;
        }
        .authority-grid {
            grid-template-columns: 1fr;
        }
        .bio-card {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 60px 30px !important;
        }
        .founder-img {
            height: 350px;
            max-width: 300px;
            margin: 0 auto;
        }
        .quote {
            text-align: left;
        }
    }

    @media (max-width: 768px) {
        .authority-content h2 {
            font-size: 2.22rem;
        }
        .auth-number {
            font-size: 3.5rem;
        }
        .mv-card {
            padding: 40px;
        }
        .mv-content h2 {
            font-size: 1.8rem;
        }
    }
</style>
