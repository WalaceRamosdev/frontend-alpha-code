---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { niches } from "../../data/niches";

// Organizando por categorias reais para o dropdown
const categories = [
    { id: 'saude', label: 'Saúde', icon: '🩺' },
    { id: 'juridico', label: 'Jurídico', icon: '⚖️' },
    { id: 'negocios', label: 'Negócios', icon: '📊' },
    { id: 'tecnico', label: 'Técnico', icon: '⚡' }
];

// Mapeamento de quais slugs pertencem a quais categorias
const nicheCategoryMap: Record<string, string> = {
    'psicologos': 'saude',
    'medicos': 'saude',
    'dentistas': 'saude',
    'advogados': 'juridico',
    'contadores': 'negocios',
    'arquitetos': 'negocios',
    'energia-solar': 'tecnico',
    'manutencao': 'tecnico'
};

const seo = {
    title: "Soluções por Nicho | Alpha Code",
    description: "Explore nossas soluções especializadas para cada setor. Sites de alta conversão para médicos, advogados, arquitetos e muito mais.",
};
---

<BaseLayout title={seo.title} description={seo.description}>
    <main class="solutions-hub">
        <!-- Hero Section -->
        <section class="hub-hero">
            <div class="container">
                <div class="hero-badge">CATÁLOGO DE PERFORMANCE</div>
                <h1>Soluções Sob Medida para <br/> <span class="text-gradient" id="word-rotator">Seu Negócio</span></h1>
                <p class="hero-subtitle">
                    Escolha seu nicho e veja como transformamos sua presença digital em uma máquina de vendas com tecnologia de ponta.
                </p>
            </div>
        </section>

        <!-- Main Hub Interface -->
        <section class="hub-interface">
            <div class="container">
                <div class="hub-layout">
                    
                    <!-- Left Column: Cards & Filtering -->
                    <div class="hub-content">
                        <!-- Filters -->
                        <div class="filter-wrapper sticky-filter">
                            <div class="filter-bar">
                                <button class="filter-btn active" data-category="all">
                                    <span class="dot"></span> Todos
                                </button>
                                {categories.map(cat => (
                                    <button class="filter-btn" data-category={cat.id}>
                                        <span class="icon">{cat.icon}</span> {cat.label}
                                    </button>
                                ))}
                            </div>
                        </div>

                        <!-- Categorized Sections -->
                        <div class="categorized-hub" id="categorized-hub">
                            {categories.map(cat => (
                                <section class="category-section" data-section={cat.id}>
                                    <div class="category-header" role="button" tabindex="0" aria-expanded="false" aria-controls={`content-${cat.id}`}>
                                        <span class="category-icon" aria-hidden="true">{cat.icon}</span>
                                        <h2 class="category-title">{cat.label}</h2>
                                        <span class="category-arrow" aria-hidden="true">▼</span>
                                    </div>
                                    
                                    <div class="category-content" id={`content-${cat.id}`} role="region">
                                        <div class="niche-grid">
                                            {niches.filter(n => nicheCategoryMap[n.slug] === cat.id).map(niche => (
                                                <div 
                                                    class="niche-card" 
                                                    data-slug={niche.slug}
                                                    role="button"
                                                    tabindex="0"
                                                    aria-label={`Ver detalhes de ${niche.name}`}
                                                >
                                                    <div class="card-bg"></div>
                                                    <div class="card-content">
                                                        <h3>{niche.title}</h3>
                                                        <p>{(niche.heroDesc || "").substring(0, 80)}...</p>
                                                        <div class="card-footer desktop-only">
                                                            <span class="cta-text">Ver detalhes ➔</span>
                                                        </div>
                                                    </div>
                                                    <!-- Botão de ação rápida exclusivo mobile -->
                                                    <div class="cta-icon-mobile mobile-only" aria-hidden="true">
                                                        <span>→</span>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </section>
                            ))}

                            <!-- Custom/Special Section -->
                            <section class="category-section active-section">
                                <div class="category-header">
                                    <span class="category-icon">✦</span>
                                    <h2 class="category-title">Projetos Customizados</h2>
                                    <span class="category-arrow">▼</span>
                                </div>
                                <div class="category-content">
                                    <div class="niche-grid">
                                        <a href="https://wa.me/5521999064502" target="_blank" class="niche-card custom-request">
                                            <div class="card-content">
                                                <h3>Outros Nichos</h3>
                                                <p>Não encontrou seu setor? Desenvolvemos estratégias sob medida para qualquer negócio.</p>
                                                <span class="cta-text desktop-only">Consultar Especialista ➔</span>
                                            </div>
                                            <div class="cta-icon-mobile mobile-only">→</div>
                                        </a>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>

                    <div class="hub-sidebar">
                        <div class="sticky-panel-container">
                            <!-- Floating Card Hint -->
                            <div class="preview-mini-panel">
                                <div class="icon-pulse">✨</div>
                                <h3>Selecione um Nicho</h3>
                                <p>Clique em um dos cards ao lado para ver os detalhes da solução e cases de sucesso.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Fixed Details Modal -->
        <div id="niche-modal" class="niche-modal hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="modal-backdrop"></div>
            <div class="modal-container">
                <button id="close-modal" class="close-btn" aria-label="Fechar Modal">
                    <span class="cross-line"></span>
                    <span class="cross-line"></span>
                </button>
                <div class="modal-body">
                    <div class="modal-visual">
                        <div class="browser-mockup">
                            <div class="browser-header">
                                <div class="dots"><span></span><span></span><span></span></div>
                                <div class="address-bar">alphacode.com.br/view</div>
                            </div>
                            <div class="browser-body">
                                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=800" id="modal-img" alt="Site Preview" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-info">
                        <h2 id="modal-title">Nicho Selecionado</h2>
                        <div class="metric-grid">
                            <div class="metric-item">
                                <span class="metric-val" id="modal-conversion">+400%</span>
                                <span class="metric-lab">Conversão</span>
                            </div>
                            <div class="metric-item">
                                <span class="metric-val">100</span>
                                <span class="metric-lab">PageSpeed</span>
                            </div>
                            <div class="metric-item">
                                <span class="metric-val">&lt; 1s</span>
                                <span class="metric-lab">Carregamento</span>
                            </div>
                        </div>

                        <div class="benefit-list">
                            <h4>Recursos Inclusos:</h4>
                            <ul id="modal-benefits">
                                <!-- Populated by JS -->
                            </ul>
                        </div>

                        <a href="#" id="modal-link" class="btn btn-primary btn-block">
                            QUERO MAIS RESULTADOS ➔
                        </a>
                    </div>
                </div>
            </div>
        </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Dados para o preview (Injetados via script por ser interativo)
    const nichesData = {
        'psicologos': {
            title: 'Psicólogos & Terapeutas',
            benefits: ['Agenda Online Sync', 'Blog de Autoridade', 'Ficha Técnica Profissional', 'Botão Emergencial'],
            link: '/solucoes/psicologos',
            img: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&q=80&w=500'
        },
        'medicos': {
            title: 'Médicos & Clínicas',
            benefits: ['Agendamento Inteligente', 'SEO Local de Alta Demanda', 'Painel de Convênios', 'Galerias de Estrutura'],
            link: '/solucoes/medicos',
            img: 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=500'
        },
        'dentistas': {
            title: 'Dentistas & Odonto',
            benefits: ['Vitrine de Sorrisos', 'Tabela de Procedimentos', 'Suporte WhatsApp 24h', 'Sistema de Reviews'],
            link: '/solucoes/dentistas',
            img: 'https://images.unsplash.com/photo-1598256989800-fe5f95da9787?auto=format&fit=crop&q=80&w=500'
        },
        'advogados': {
            title: 'Advogados & Jurídico',
            benefits: ['Landing Pages Educativas', 'Captação Compliance OAB', 'Área de Atuação Dinâmica', 'Blog jurídico'],
            link: '/solucoes/advogados',
            img: 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&q=80&w=500'
        },
        'arquitetos': {
            title: 'Arquitetos & Interiores',
            benefits: ['Portfólio Imersivo', 'Galeria High-Res', 'Gestão de Projetos', 'Formulário de Briefing'],
            link: '/solucoes/arquitetos',
            img: 'https://images.unsplash.com/photo-1503387762-592dee58c460?auto=format&fit=crop&q=80&w=500'
        },
        'contadores': {
            title: 'Contadores & BPO',
            benefits: ['Central de Downloads', 'Simuladores de Impostos', 'Calendário Fiscal', 'Atendimento Humanizado'],
            link: '/solucoes/contadores',
            img: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&q=80&w=500'
        },
        'energia-solar': {
            title: 'Empresas de Energia Solar',
            benefits: ['Simulador de Economia', 'Mapa de Instalações', 'Área de Grandes Clientes', 'Formulário Solar Lead'],
            link: '/solucoes/energia-solar',
            img: 'https://images.unsplash.com/photo-1509391366360-fe5bb58583bb?auto=format&fit=crop&q=80&w=500'
        },
        'manutencao': {
            title: 'Manutenção Predial',
            benefits: ['Catálogo de Serviços', 'Solicitação de Orçamento', 'Área de Cobertura', 'Equipe & Segurança'],
            link: '/manutencao',
            img: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&q=80&w=500'
        }
    };

    const initHub = () => {
        const cards = document.querySelectorAll('.niche-card:not(.custom-request)');
        const modal = document.getElementById('niche-modal');
        const closeModal = document.getElementById('close-modal');
        const backdrop = document.querySelector('.modal-backdrop');
        
        const mTitle = document.getElementById('modal-title');
        const mBenefits = document.getElementById('modal-benefits');
        const mLink = document.getElementById('modal-link') as HTMLAnchorElement;
        const mImg = document.getElementById('modal-img') as HTMLImageElement;
        
        const filterBtns = document.querySelectorAll('.filter-btn');
        const sections = document.querySelectorAll('.category-section');
        const categoryHeaders = document.querySelectorAll('.category-header');

        const openModal = (slug: string) => {
            const data = nichesData[slug as keyof typeof nichesData];
            if (!data || !modal) return;

            if (mTitle) mTitle.innerText = data.title;
            if (mLink) mLink.href = data.link;
            if (mImg && data.img) mImg.src = data.img;
            if (mBenefits) {
                mBenefits.innerHTML = data.benefits.map(b => `<li><span class="check">✓</span> ${b}</li>`).join('');
            }

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Lock Scroll
            
            gsap.fromTo(".modal-container", 
                { opacity: 0, scale: 0.9, y: 20 },
                { opacity: 1, scale: 1, y: 0, duration: 0.4, ease: "power3.out" }
            );
        };

        const closeAll = () => {
            if (!modal) return;
            gsap.to(".modal-container", {
                opacity: 0, scale: 0.9, y: 20, duration: 0.3, onComplete: () => {
                    modal.classList.add('hidden');
                    document.body.style.overflow = ''; // Unlock Scroll
                }
            });
        };

        if (closeModal) closeModal.addEventListener('click', closeAll);
        if (backdrop) backdrop.addEventListener('click', closeAll);

        // Keyboard Support
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeAll();
        });

        // Accessibility Listeners
        const interactables = document.querySelectorAll('.niche-card, .category-header');
        interactables.forEach(el => {
            el.addEventListener('keydown', (e: any) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    e.click();
                }
            });
        });

        // Rotator Hero
        const words = ["Seu Negócio", "Sua Clínica", "Seu Escritório", "Sua Empresa"];
        let wordIdx = 0;
        const wordEl = document.getElementById('word-rotator');
        
        setInterval(() => {
            if(!wordEl) return;
            gsap.to(wordEl, { opacity: 0, y: -20, duration: 0.3, onComplete: () => {
                wordIdx = (wordIdx + 1) % words.length;
                wordEl.innerText = words[wordIdx];
                gsap.fromTo(wordEl, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.3 });
            }});
        }, 3500);

        // Accordion Toggle Logic
        categoryHeaders.forEach(header => {
            header.addEventListener('click', () => {
                const parent = header.parentElement;
                const wasActive = parent?.classList.contains('active-section');
                
                // Opcional: Fechar outros ao abrir um
                // sections.forEach(s => s.classList.remove('active-section'));
                
                if (wasActive) {
                    parent?.classList.remove('active-section');
                } else {
                    parent?.classList.add('active-section');
                }
            });
        });

        // Click Card Logic (Trigger Modal)
        cards.forEach(card => {
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                const slug = card.getAttribute('data-slug');
                if (slug) openModal(slug);
            });
        });

        // Filtering Logic (Open target category)
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const cat = btn.getAttribute('data-category');
                
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                if (cat === 'all') {
                    sections.forEach(sec => {
                        (sec as HTMLElement).style.display = 'block';
                        gsap.to(sec, { opacity: 1, duration: 0.3 });
                    });
                } else {
                    sections.forEach(sec => {
                        const secCat = sec.getAttribute('data-section');
                        if (secCat === cat) {
                            (sec as HTMLElement).style.display = 'block';
                            sec.classList.add('active-section'); // Auto-abrir ao filtrar
                            gsap.to(sec, { opacity: 1, duration: 0.3 });
                            sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        } else if (secCat) {
                            (sec as HTMLElement).style.display = 'none';
                            sec.classList.remove('active-section');
                        }
                    });
                }
            });
        });
        // Select First Niche by default (after a small delay to ensure DOM is ready)
        setTimeout(() => {
            const firstCard = document.querySelector('.niche-card') as HTMLElement;
            if (firstCard) {
                const parentSection = firstCard.closest('.category-section');
                parentSection?.classList.add('active-section');
            }
        }, 100);

    };

    document.addEventListener('astro:page-load', initHub);
</script>

<style>
    .solutions-hub {
        background: #050505;
        color: white;
        padding-top: 100px;
        min-height: 100vh;
    }

    .container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    @media (max-width: 768px) {
        .container {
            padding: 0 1rem;
            max-width: 100%;
            overflow-x: hidden;
        }
    }

    /* Hero */
    .hub-hero {
        padding: 80px 0 40px;
        text-align: center;
        position: relative;
    }

    .hub-hero::before {
        content: '';
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        height: 300px;
        background: radial-gradient(circle, rgba(138, 28, 38, 0.15) 0%, transparent 70%);
        pointer-events: none;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 1.5rem;
        backdrop-filter: blur(10px);
    }

    .hub-hero h1 {
        font-size: clamp(2.2rem, 5vw, 4rem);
        font-weight: 900;
        line-height: 1;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: #777;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .hub-hero {
            padding: 60px 0 30px;
        }
        .hub-hero h1 {
            font-size: 2.1rem;
            padding: 0 5px;
        }
        .hero-subtitle {
            font-size: 0.9rem;
            opacity: 0.8;
        }
    }

    /* Layout */
    .hub-layout {
        display: grid;
        grid-template-columns: 1fr 450px;
        gap: 3rem;
        margin-top: 4rem;
        padding-bottom: 100px;
    }

    @media (max-width: 1024px) {
        .hub-layout {
            grid-template-columns: 1fr;
        }
        .hub-sidebar {
            display: none; /* Escondido em mobile por enquanto ou movido pra baixo */
        }
    }

    /* Filters */
    .sticky-filter {
        position: sticky;
        top: 80px;
        z-index: 100;
        padding: 15px 0;
        margin-bottom: 2.5rem;
    }

    .filter-bar {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 6px;
        border-radius: 100px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        width: fit-content;
        margin: 0 auto;
        scrollbar-width: none;
    }

    .filter-bar::-webkit-scrollbar { display: none; }

    .filter-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.5);
        padding: 10px 20px;
        border-radius: 50px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

    .filter-btn:hover {
        color: white;
        background: rgba(255, 255, 255, 0.05);
    }

    .filter-btn.active {
        background: white;
        color: black;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    }

    .filter-btn .dot {
        width: 5px;
        height: 5px;
        background: currentColor;
        border-radius: 50%;
    }

    @media (max-width: 768px) {
        .filter-bar {
            width: 100%;
            border-radius: 16px;
        }
        .filter-btn {
            padding: 8px 16px;
            font-size: 0.8rem;
        }
    }

    /* Category Sections */
    .category-section {
        margin-bottom: 1.25rem;
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 28px;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .category-section.active-section {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
        margin-bottom: 2.5rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    .category-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.75rem 2.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-header:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .category-icon {
        font-size: 1.15rem;
        background: rgba(255, 255, 255, 0.03);
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: inset 0 0 10px rgba(255, 255, 255, 0.02);
    }

    .category-title {
        font-size: 0.95rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.4);
        transition: all 0.3s ease;
    }

    .active-section .category-title {
        color: #fff;
    }

    .category-arrow {
        margin-left: auto;
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.2);
        transition: all 0.4s ease;
    }

    .active-section .category-arrow {
        transform: rotate(180deg);
        color: var(--color-primary);
    }

    @media (max-width: 768px) {
        .category-header {
            padding: 1.25rem 1.5rem;
            gap: 1rem;
        }
        .category-icon {
            width: 38px;
            height: 38px;
            font-size: 1rem;
        }
        .category-title {
            font-size: 0.8rem;
        }
    }

    .category-content {
        max-height: 0;
        opacity: 0;
        visibility: hidden;
        overflow: hidden;
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        padding: 0 2rem;
    }

    .active-section .category-content {
        max-height: 3000px;
        opacity: 1;
        visibility: visible;
        padding-bottom: 2rem;
    }

    /* Modern Grid para Mobile */
    .niche-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        padding-top: 1rem;
    }

    @media (max-width: 768px) {
        .niche-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 0;
            width: 100% !important; /* Força largura total */
            max-width: 100% !important;
        }

        /* Elimina o visual de accordion no mobile */
        .category-section {
            background: transparent !important;
            border: none !important;
            border-radius: 0 !important;
            margin-bottom: 0 !important;
            overflow: visible !important;
            width: 100% !important;
        }
        
        .category-header {
            display: none !important; 
        }

        .category-content {
            max-height: none !important;
            opacity: 1 !important;
            visibility: visible !important;
            padding: 0 !important;
            overflow: visible !important;
            width: 100% !important;
        }
    }

    .niche-card {
        background: linear-gradient(135deg, rgba(20, 20, 20, 0.6) 0%, rgba(10, 10, 10, 0.8) 100%);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 28px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        text-align: left;
        transition: all 0.4s cubic-bezier(0.2, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
