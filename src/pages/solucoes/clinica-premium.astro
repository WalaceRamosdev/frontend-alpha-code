---
import Layout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import { getSession } from "../../lib/auth";

export const prerender = false;
const session = await getSession(Astro.request);
const isLoggedIn = !!session;
---

<Layout
    title="Criação de Sites para Clínicas Odontológicas no RJ | SEO para Dentistas"
    description="Especialistas em criação de sites para clínicas odontológicas no RJ. Marketing para dentistas com foco em SEO local, agendamento 24h e alta conversão de pacientes."
>
    <div class="solution-page">
        <div class="ambient-glow"></div>

        <section class="hero-section container">
            <div class="hero-content">
                <span class="badge fade-up">AUTORIDADE PARA ESPECIALISTAS</span>
                <h1 class="fade-up delay-1">
                    Sua Clínica no RJ com <br /><span class="text-gradient"
                        >Presença de Elite</span
                    >
                </h1>
                <p class="hero-desc fade-up delay-2">
                    A primeira impressão do seu paciente é digital.
                    Dominamos o marketing para dentistas e médicos para criar o ecossistema ideal de captação, focando em sofisticação, SEO local e agendamento imediato.
                </p>
                <div class="cta-group fade-up delay-3">
                    <Button
                        href="https://wa.me/5521999064502?text=Olá! Quero ver a demonstração do sistema premium para clínicas."
                        target="_blank"
                        variant="primary"
                        size="lg"
                    >
                        CONSULTAR PROJETO
                    </Button>
                    {isLoggedIn ? (
                        <span class="price-tag">
                            De <span style="text-decoration: line-through;">R$ 2.997</span> por apenas <strong>R$ 1.997</strong>
                        </span>
                    ) : (
                        <span class="price-tag">
                            Valores sob consulta para membros
                        </span>
                    )}
                </div>
            </div>
            <div class="hero-image fade-in">
                <img loading="lazy"
                    src="/assets/clinica_system_tech_mockup.png"
                    alt="Mockup Tecnológico do Sistema Clínica"
                    class="main-mockup"
                    width="600"
                    height="400"
                />
            </div>
        </section>

        <section class="pain-section bg-darker">
            <div class="container">
                <div class="section-header text-center">
                    <h2>
                        Sua Agenda em <span class="text-primary"
                            >Fluxo Constante</span
                        >
                    </h2>
                    <p>
                        Não perca pacientes por falta de resposta imediata ou
                        por uma imagem que não transmite confiança.
                    </p>
                </div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">📅</div>
                        <h3>Agendamento 24h</h3>
                        <p>
                            Seu paciente agenda o horário desejado mesmo quando
                            sua clínica está fechada.
                        </p>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">💎</div>
                        <h3>Branding de Luxo</h3>
                        <p>
                            Posicione-se como autoridade máxima e justifique o
                            valor da sua consulta particular.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="specialties-section container">
            <div class="section-header text-center">
                <span class="badge">ESPECIALIDADES DE ALTO VALOR</span>
                <h2>Estratégias de <span class="text-primary">SEO Odontológico no RJ</span></h2>
                <p>Otimizamos seu posicionamento orgânico para os termos mais buscados no Rio de Janeiro e região.</p>
            </div>
            <div class="specialties-grid">
                <div class="spec-card">
                    <div class="spec-icon">🦷</div>
                    <h3>Implantes & Protocolo</h3>
                    <p>Páginas otimizadas para converter quem busca por reabilitação oral e estética funcional.</p>
                </div>
                <div class="spec-card">
                    <div class="spec-icon">✨</div>
                    <h3>Estética Avançada</h3>
                    <p>Lentes de contato dental e clareamento com foco em desejo visual e autoridade.</p>
                </div>
                <div class="spec-card">
                    <div class="spec-icon">🔄</div>
                    <h3>Ortodontia (Invisalign)</h3>
                    <p>Páginas de alta conversão para tratamentos tecnológicos e modernos.</p>
                </div>
                <div class="spec-card">
                    <div class="spec-icon">🚨</div>
                    <h3>Atendimento 24h</h3>
                    <p>Foco em SEO de emergência para captar pacientes no momento da maior necessidade.</p>
                </div>
            </div>
        </section>

        <section class="treatments-list bg-darker">
            <div class="container">
                <div class="section-header text-center">
                    <span class="badge">SOLUÇÕES COMPLETAS</span>
                    <h2>Tudo o que seu <span class="text-primary">Paciente Procura</span></h2>
                    <p>Otimizamos seu site para os termos de busca mais rentáveis do mercado odontológico.</p>
                </div>
                <div class="keywords-cloud">
                    <span>Implantes Dentários</span>
                    <span>Lentes de Contato</span>
                    <span>Invisalign</span>
                    <span>Prótese Protocolo</span>
                    <span>Clareamento a Laser</span>
                    <span>Harmonização Facial</span>
                    <span>Odontopediatria</span>
                    <span>Endodontia (Canal)</span>
                    <span>Periodontia</span>
                    <span>Cirurgia Oral</span>
                </div>
            </div>
        </section>

        <section class="faq-section container">
            <div class="section-header text-center">
                <span class="badge">DÚVIDAS FREQUENTES</span>
                <h2>Marketing e <span class="text-primary">Resultados</span></h2>
            </div>
            <div class="faq-grid">
                <div class="faq-item">
                    <h3>Como o SEO para dentistas funciona?</h3>
                    <p>Otimizamos seu site para aparecer quando pacientes buscam por procedimentos como "implantes", "clareamento" ou "dentista perto de mim" no Google.</p>
                </div>
                <div class="faq-item">
                    <h3>Por que minha clínica precisa de um site premium?</h3>
                    <p>O design de luxo transmite autoridade imediata, permitindo que você justifique valores de consulta particular mais altos e atraia um público qualificado.</p>
                </div>
                <div class="faq-item">
                    <h3>O sistema de agendamento é integrado?</h3>
                    <p>Sim, facilitamos a jornada do paciente para que ele agende a consulta diretamente pelo site ou WhatsApp em segundos.</p>
                </div>
            </div>
        </section>

        <section class="final-cta container text-center">
            <div class="cta-box">
                <h2>
                    Domine o <span class="text-primary"
                        >Marketing Odontológico</span
                    >
                </h2>
                <p>
                    Tecnologia de ponta para converter visitantes em pacientes fidelizados.
                </p>
                <Button
                    href="https://wa.me/5521999064502?text=Olá! Quero dominar o SEO da minha clínica com o sistema Alpha Code."
                    target="_blank"
                    variant="primary"
                    size="lg"
                >
                    ALAVANCAR MINHA CLÍNICA
                </Button>
            </div>
        </section>

        <!-- SEO Local Schema -->
        <script type="application/ld+json">
        [
          {
            "@context": "https://schema.org",
            "@type": "Dentist",
            "name": "Nome da Sua Clínica",
            "description": "Especialistas em marketing odontológico e SEO para dentistas. Clínica premium com foco em implantes, estética e ortodontia invisível.",
            "image": "/assets/clinica_system_tech_mockup.png",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Centro",
              "addressLocality": "Rio de Janeiro",
              "addressRegion": "RJ",
              "postalCode": "20000-000",
              "addressCountry": "BR"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": -22.906847,
              "longitude": -43.172896
            },
            "url": "https://seusite.com.br",
            "telephone": "+5511999999999",
            "openingHoursSpecification": [
              {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday"
                ],
                "opens": "09:00",
                "closes": "18:00"
              }
            ]
          },
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Como o SEO para dentistas funciona?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Otimizamos seu site para aparecer quando pacientes buscam por procedimentos como implantes, clareamento ou dentista perto de mim no Google."
                }
              },
              {
                "@type": "Question",
                "name": "Por que minha clínica precisa de um site premium?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "O design de luxo transmite autoridade imediata, permitindo que você justifique valores de consulta particular mais altos e atraia um público qualificado."
                }
              }
            ]
          }
        ]
        </script>
    </div>
</Layout>

<style>
    .solution-page {
        padding-top: 100px;
        background: #050505;
        color: #fff;
        overflow-x: hidden;
    }
    .ambient-glow {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100vw;
        height: 100vh;
        background: radial-gradient(
            circle at 20% 30%,
            rgba(37, 99, 235, 0.08),
            transparent 50%
        );
        pointer-events: none;
        z-index: 0;
    }
    .hero-section {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 60px;
        align-items: center;
        padding-bottom: 100px;
        position: relative;
        z-index: 1;
    }
    .badge {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(37, 99, 235, 0.1);
        border: 1px solid rgba(37, 99, 235, 0.3);
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 2rem;
    }
    h1 {
        font-size: 4rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-weight: 800;
    }
    .hero-desc {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.6);
        max-width: 600px;
        margin-bottom: 3rem;
        line-height: 1.6;
    }
    .cta-group {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    .price-tag {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.4);
    }
    .price-tag strong {
        color: #fff;
        font-size: 1.1rem;
    }
    .main-mockup {
        width: 140%;
        height: auto;
        filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.8));
    }
    .pain-section {
        padding: 100px 0;
        background: rgba(255, 255, 255, 0.02);
    }
    .stats-grid, .specialties-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 40px;
        margin-top: 60px;
    }
    .stat-card, .spec-card {
        padding: 40px;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        text-align: center;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .stat-card:hover, .spec-card:hover {
        transform: translateY(-10px);
        border-color: rgba(37, 99, 235, 0.3);
    }
    .stat-icon, .spec-icon {
        font-size: 3rem;
        margin-bottom: 1.5rem;
    }
    .spec-card h3 {
        margin-bottom: 1rem;
        color: #fff;
    }
    .spec-card p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.95rem;
        line-height: 1.5;
    }
    .keywords-cloud {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
        margin-top: 40px;
    }
    .keywords-cloud span {
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.7);
        transition: all 0.3s ease;
    }
    .keywords-cloud span:hover {
        background: rgba(37, 99, 235, 0.1);
        border-color: #2563eb;
        color: #fff;
    }
    .treatments-list {
        padding: 80px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .specialties-section, .faq-section {
        padding: 100px 0;
    }
    .faq-grid {
        max-width: 800px;
        margin: 60px auto 0;
        display: flex;
        flex-direction: column;
        gap: 30px;
    }
    .faq-item {
        padding-bottom: 30px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .faq-item h3 {
        color: #2563eb;
        font-size: 1.3rem;
        margin-bottom: 1rem;
    }
    .faq-item p {
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.6;
    }
    .cta-box {
        border: 1px solid rgba(37, 99, 235, 0.3);
        padding: 80px 40px;
        border-radius: 40px;
        backdrop-filter: blur(10px);
    }
    @media (max-width: 992px) {
        .hero-section {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .hero-desc {
            margin: 0 auto 3rem;
        }
        .hero-image {
            order: -1;
            margin-bottom: 40px;
        }
        .main-mockup {
            width: 100%;
        }
        h1 {
            font-size: 3rem;
        }
    }
</style>
