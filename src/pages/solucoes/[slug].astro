---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/sections/Hero.astro";
import TrustBar from "../../components/sections/TrustBar.astro";
import Features from "../../components/sections/Features.astro";
import Audience from "../../components/sections/Audience.astro";
import Projects from "../../components/sections/Projects.astro";
import Testimonials from "../../components/sections/Testimonials.astro";
import Services from "../../components/sections/Services.astro";
import Plans from "../../components/sections/Plans.astro";
import About from "../../components/sections/About.astro";
import FAQ from "../../components/sections/Faq.astro";
import { buildSEOTitle, buildSEODescription } from "../../utils/seo";
import Contact from "../../components/sections/Contact.astro";
import DynamicContent from "../../components/sections/DynamicContent.astro";
import SocialProofGrid from "../../components/sections/SocialProofGrid.astro";
import FaqAccordion from "../../components/ui/FaqAccordion.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import SiteRoiCalculator from "../../components/ui/SiteRoiCalculator.astro";
import { niches } from "../../data/niches";

export function getStaticPaths() {
    const customPages = ['advogados', 'arquitetos', 'contadores', 'medicos', 'dentistas', 'psicologos', 'clinica-premium', 'pizzaria-premium', 'lanchonete-premium', 'energia-solar', 'manutencao'];
    return niches
        .filter((niche) => !customPages.includes(niche.slug))
        .map((niche) => ({
            params: { slug: niche.slug },
            props: { niche },
        }));
}

const { niche } = Astro.props;

// Sobrescrever metadados
const title = buildSEOTitle(niche.title);
const description = buildSEODescription(niche.metaFormulas.formula1); // Use formula 1 for general description

export const prerender = true;
---

<BaseLayout
    title={title}
    description={description}
    noIndex={false}
    keywords={niche.keywords}
>

    <Hero
        title={niche.heroTitle}
        description={niche.heroDesc}
        badge={niche.badge}
        ctaText={niche.ctaText}
    />

    <SocialProofGrid />

    <TrustBar />

    <div class="bg-gradient-to-b from-[#050505] to-black py-10 text-center">
        <p class="text-gray-400 mb-6 max-w-2xl mx-auto px-4">
            Mais de 90% dos profissionais do nicho de <strong class="text-white"
                >{niche.name}</strong
            > perdem clientes todos os dias por não terem uma presença digital de
            elite. Não seja mais um na média.
        </p>
        <CTAButton
            text="QUERO MEU ORÇAMENTO EM 24H"
            href="#contact"
            variant="primary"
            size="lg"
        />
    </div>

    <Features />

    <DynamicContent
        title={`Estratégia Digital para ${niche.name}`}
        content={niche.detailedContent}
        benefits={niche.benefits}
    />

    <section class="py-20 bg-[#080808]">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2
                    class="text-3xl md:text-5xl font-black text-white mb-4 font-outfit"
                >
                    Perguntas Frequentes
                </h2>
                <p class="text-gray-400">
                    Tudo o que você precisa saber para começar seu projeto de {
                        niche.name
                    }
                </p>
            </div>
            <FaqAccordion niche={niche} />
        </div>
    </section>

    <Audience title={`Público-alvo para ${niche.name}`} />

    <Projects />
    <Testimonials />
    <Services />

    <div class="text-center py-20 bg-primary/5">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-6">
            Pronto para ser a maior autoridade em {niche.name}?
        </h2>
        <CTAButton
            text="FALAR COM ESPECIALISTA AGORA"
            href={`https://wa.me/5521999064502?text=Vi%20a%20p%C3%A1gina%20sobre%20${niche.name}%20e%20quero%20um%20orcamento`}
            variant="primary"
            size="lg"
        />
    </div>

    <Plans />
    <About />

    <!-- ROI SECTION -->
    <section class="py-24 bg-alt overflow-hidden relative">
        <div class="container relative z-10">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div data-aos="fade-right">
                    <span
                        class="text-primary font-black tracking-widest text-sm uppercase mb-4 block"
                        >Diferencial Estratégico</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-black text-white mb-8 font-outfit leading-tight"
                    >
                        Quanto vale um novo <span class="text-primary"
                            >paciente qualificado</span
                        > para você?
                    </h2>
                    <p class="text-xl text-gray-400 mb-8 leading-relaxed">
                        Muitos profissionais investem em redes sociais mas
                        esquecem do ponto de conversão final. Com a tecnologia
                        Alpha, seu site não é apenas um "cartão de visitas", mas
                        um <strong>vendedor incansável</strong>.
                    </p>
                    <ul class="space-y-4 mb-10">
                        <li class="flex items-start gap-3">
                            <div
                                class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 shrink-0"
                            >
                                <svg
                                    class="w-4 h-4 text-primary"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="3"
                                        d="M5 13l4 4L19 7"></path></svg
                                >
                            </div>
                            <span class="text-gray-300"
                                >Carregamento em menos de 1 segundo (Astro.js)</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <div
                                class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 shrink-0"
                            >
                                <svg
                                    class="w-4 h-4 text-primary"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="3"
                                        d="M5 13l4 4L19 7"></path></svg
                                >
                            </div>
                            <span class="text-gray-300"
                                >SEO Local para dominar sua região</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <div
                                class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 shrink-0"
                            >
                                <svg
                                    class="w-4 h-4 text-primary"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="3"
                                        d="M5 13l4 4L19 7"></path></svg
                                >
                            </div>
                            <span class="text-gray-300"
                                >Copywriting focado em autoridade e medo de
                                perder a vaga</span
                            >
                        </li>
                    </ul>
                </div>
                <div data-aos="fade-left">
                    <SiteRoiCalculator />
                </div>
            </div>
        </div>
    </section>
    <Contact />
</BaseLayout>

<style is:global>
    /* Pequeno ajuste para garantir que a transição seja suave */
    .niche-context #hero {
        animation: fadeIn 0.8s ease-out;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
