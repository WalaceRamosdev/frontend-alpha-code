---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import RelatedContent from "../../components/seo/RelatedContent.astro";

const slug = "arquitetos";

const faq = [
    {
        q: "O site vai valorizar meu portfólio?",
        a: "Sim, nossos sites para arquitetos são desenvolvidos com uma estética 'Gallery-First', focada em apresentar seus projetos em altíssima resolução sem perda de velocidade."
    },
    {
        q: "Vou aparecer no Google?",
        a: "Sim, aplicamos técnicas de SEO voltadas para o mercado de arquitetura de alto padrão, garantindo que clientes busquem por projetos na sua região encontrem o seu escritório."
    },
    {
        q: "O site ajuda a fugir da briga por preço?",
        a: "Com certeza. Um posicionamento digital de elite transmite valor imediato. O cliente percebe a qualidade do seu trabalho antes mesmo de solicitar um orçamento."
    },
    {
        q: "O site funciona bem no celular?",
        a: "Totalmente. O design responsivo garante que as fotos dos seus projetos mantenham o impacto visual mesmo em telas de smartphones."
    }
];
---

<BaseLayout
    title="Site para Arquitetos: Atraia Projetos de Alto Padrão"
    description="Atraia mais projetos de alto padrão todos os dias com um site profissional para arquitetos. Focado em conversão, portfólio premium e autoridade em design."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="arquitetos" slot="head" />

    <div class="niche-page architect-theme">
        
        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/arquitetos-hero.webp" alt="Escritório de Arquitetura Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> POSICIONAMENTO ARQUITETÔNICO DE ELITE
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Atraia projetos de alto padrão todos os dias com um <span class="text-gradient">site profissional para arquitetos</span>
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Crie uma presença online que transmite requinte, valoriza o seu traço e faz com que clientes buscando projetos autorais encontrem o seu escritório no Google.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero atrair mais projetos de arquitetura com um site de elite." variant="primary" size="lg" class="glow-button px-8">👉 QUERO MAIS PROJETOS</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">FALAR NO WHATSAPP</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">4K</span>
                        <span class="stat-txt">Portfólio em Alta Resolução</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+100</span>
                        <span class="stat-txt">Studios Atendidos</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">TOP 1</span>
                        <span class="stat-txt">Posicionamento Orgânico</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Seus projetos são incríveis... <br/> <span class="text-primary italic">mas seu escritório ainda briga por preço?</span></h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-tags text-primary"></i></div>
                        <h3>Guerra de Orçamentos</h3>
                        <p>O cliente pede inúmeros orçamentos porque não consegue perceber o valor único do seu traço.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-users-slash text-primary"></i></div>
                        <h3>Dependência de Indicações</h3>
                        <p>A captação fica limitada ao círculo social, impedindo o escritório de escalar de forma previsível.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-compress-arrows-alt text-primary"></i></div>
                        <h3>Invisibilidade de Mercado</h3>
                        <p>Ao buscar termos como 'arquiteto alto padrão', seu escritório não aparece nos resultados principais do Google.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-images text-primary"></i></div>
                        <h3>Portfólio Desvalorizado</h3>
                        <p>PDFs pesados ou um Instagram desorganizado não conseguem traduzir a verdadeira qualidade das suas entregas.</p>
                    </div>
                </div>
                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-2xl">
                        <p class="text-2xl font-bold">💡 A realidade do mercado: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">se o seu digital não transmite luxo, seu projeto não será valorizado.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">A SOLUÇÃO PREMIUM</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Nós criamos um <span class="text-primary">site estratégico para arquitetos</span> que eleva o valor do seu trabalho.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Seu escritório passa a:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🚀</span> Aparecer no Google para clientes de alto padrão
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">👑</span> Transmitir uma estética refinada e autoridade imediata
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🖼️</span> Exibir um portfólio imersivo que encanta os visitantes
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">💎</span> Converter curiosidade estética em contratos assinados
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">ARCHITECT ELITE</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img loading="lazy" src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Exemplo site arquitetura" class="project-preview-img" style="filter: sepia(0.8) hue-rotate(5deg) saturate(1.5);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Impactos Reais no seu Business</h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Aumento de captação de clientes qualificados</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Maior aceitação dos honorários propostos</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Menos tempo justificando orçamentos baixos</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Apresentação impecável de projetos autorais</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Posicionamento firme de studio de luxo</h4>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="process-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl font-black">O Caminho para a Alta Renda</h2>
                </div>
                <div class="grid md:grid-cols-4 gap-8 stagger-container">
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">1</div>
                        <h4>Entendemos seu estilo</h4>
                        <p>Analisamos a identidade visual exclusiva da sua arquitetura.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">2</div>
                        <h4>Criamos um design 'Gallery-First'</h4>
                        <p>Estrutura focada em valorizar a imersão visual dos seus projetos 3D e renderizações.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">3</div>
                        <h4>Otimizamos para o Google</h4>
                        <p>SEO estratégico para atrair investidores e clientes residenciais premium.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">4</div>
                        <h4>Lançamento de Alto Impacto</h4>
                        <p>Sua nova vitrine digital passa a trabalhar pelo crescimento do seu escritório.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Difference Section -->
        <section class="differences py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Não criamos vitrines genéricas.</h2>
                        <p class="text-xl text-gray-400 mb-8">Criamos experiências pensadas para a arquitetura, com foco em:</p>
                        <ul class="diff-list space-y-4">
                            <li class="flex items-center gap-3">
                                <div class="dot-arch"></div> Estética sofisticada e minimalista
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-arch"></div> Performance técnica para imagens de alta resolução
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-arch"></div> Experiência de transição suave e sofisticada
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-arch"></div> Gatilhos visuais que inspiram confiança e exclusividade
                            </li>
                        </ul>
                    </div>
                    <div class="reveal-up bg-white/5 p-12 rounded-3xl border border-primary/20">
                        <h3 class="text-3xl font-black mb-6">🔥 Mas isso converte vendas?</h3>
                        <p class="text-lg text-gray-300 mb-8">A arquitetura é movida pelo desejo. Um site premium não apenas exibe, ele encanta. É um funil projetado para:</p>
                        <div class="flex flex-col gap-4">
                            <span class="badge-v3">👉 ATIRAR O OLHAR ESTÉTICO</span>
                            <span class="badge-v3">👉 JUSTIFICAR O PREÇO PELA QUALIDADE</span>
                            <span class="badge-v3">👉 ACELERAR A DECISÃO DE PROJETO</span>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero atrair projetos de alto padrão com um site arquitetônico." variant="primary" class="w-full mt-10 glow-button py-6 text-xl">🚀 QUERO MAIS PROJETOS AGORA</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Dúvidas Frequentes</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">O traço do seu sucesso <br/> <span class="text-primary font-outfit">começa no digital.</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button px-10">👉 QUERO MAIS PROJETOS</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">SOLICITAR CONSULTORIA DE POSICIONAMENTO</Button>
                </div>
            </div>
            <div class="glow-blur-arch"></div>
        </section>

        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert prose-yellow">
                <h2 class="text-3xl font-black text-white">Sofisticação total no melhor <span class="text-primary">site para arquitetos</span></h2>
                <p>Na arquitetura, a primeira impressão não é apenas visual; ela determina o valor do metro quadrado projetado. Ter um <strong>site para arquitetos</strong> é investir no alicerce digital do seu studio. Nós atuamos na <strong>criação de sites para arquitetos</strong> com o objetivo singular de evocar luxo, elegância e competência irrefutável. Nossa abordagem focada em <strong>atrair projetos e clientes premium</strong> utiliza estratégias avançadas de SEO e conversão.</p>
                <p>Implementamos tecnologias como Astro.js misturadas a animações GSAP de altíssimo requinte. Isso significa que mesmo ao hospedar dezenas de renders 4K dos seus projetos, o <strong>site para arquitetos</strong> carregará instantaneamente. O cliente que busca alto padrão julgará a sua meticulosidade técnica a partir do detalhismo empregado no seu próprio site. Eleve sua marca, feche contratos blindados e deixe a guerra burocrática de preços no passado.</p>
                
                <!-- Internal Linking -->
                <div class="mt-12 pt-8 border-t border-white/10 not-prose">
                    <h3 class="text-xl font-bold text-white mb-4">Leia no nosso Blog:</h3>
                    <ul class="flex flex-col gap-2 text-gray-400 font-medium mb-8">
                        <li><a href="/blog/psicologos-perdem-pacientes-por-falta-de-site" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Guia completo: Por que psicólogos perdem pacientes?</a></li>
                        <li><a href="/blog/como-o-seo-local-coloca-seu-consultorio-na-frente-da-concorrencia" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Como o SEO Local traz mais pacientes</a></li>
                        <li><a href="/blog/landing-page-vs-site-institucional-qual-o-melhor-para-converter-leads" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Landing Page vs Site Institucional</a></li>
                    </ul>

                    <h3 class="text-xl font-bold text-white mb-4">Conheça outras Soluções Alpha Code:</h3>
                    <ul class="flex flex-wrap gap-4 text-sm text-gray-500 font-medium">
                        <li><a href="/solucoes/advogados" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Advogados</a></li>
                        <li><a href="/solucoes/medicos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Médicos</a></li>
                        <li><a href="/solucoes/dentistas" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Dentistas</a></li>
                        <li><a href="/solucoes/psicologos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Psicólogos</a></li>
                        <li><a href="/solucoes/arquitetos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2 bg-white/5 text-white">Sites para Arquitetos</a></li>
                        <li><a href="/solucoes/contadores" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Contadores</a></li>
                    </ul>
                </div>
            </div>
        </section>
        <RelatedContent
            type="niche"
            niche="arquitetos"
            title="Continue explorando soluções para arquitetos"
            limit={6}
        />


    </div>
</BaseLayout>

<style>
    .architect-theme {
        --color-primary: #d4af37; /* Gold/Brass for Premium Architecture */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.4; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.85) 70%, black 100%); }
    .hero-content-v2 { max-width: 900px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 50px; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: #facc15; }
    .hero-badge-v2 .dot { width: 8px; height: 8px; background: #d4af37; border-radius: 50%; box-shadow: 0 0 10px #d4af37; }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1.0; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 2rem; }
    .text-gradient { background: linear-gradient(135deg, #fef08a, #d4af37); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.3rem; color: #b0b0b0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 750px; font-weight: 500; }
    
    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Cards */
    .problem-card-v2 { background: #0c0c0c; padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; }
    .problem-card-v2:hover { border-color: var(--color-primary); transform: translateY(-10px); }
    .icon-circle { width: 70px; height: 70px; background: rgba(212, 175, 55, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 2rem; border: 1px solid rgba(212, 175, 55, 0.1); }
    .problem-card-v2 h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #eee; }
    .problem-card-v2 p { color: #888; line-height: 1.6; }

    .benefit-card-v3 { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; background: #0c0c0c; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .check-circle { width: 30px; height: 30px; background: #222; border: 1px solid var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; flex-shrink: 0; }
    .benefit-card-v3 h4 { font-size: 1.25rem; font-weight: 800; }

    .process-step-v3 .step-icon { width: 60px; height: 60px; background: rgba(255,255,255,0.02); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900; margin: 0 auto 2rem; color: var(--color-primary); }
    .process-step-v3 h4 { font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem; }
    .process-step-v3 p { color: #777; line-height: 1.6; }

    .badge-v3 { padding: 12px 20px; background: rgba(212, 175, 55, 0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); font-weight: 800; color: #fde047; font-size: 0.9rem; }
    .dot-arch { width: 8px; height: 8px; background: var(--color-primary); border-radius: 50%; }

    /* Comparison Card */
    .comparison-container { perspective: 1200px; display: flex; justify-content: center; }
    .comparison-card { background: #111; border-radius: 20px; overflow: hidden; border: 2px solid var(--color-primary); box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 40px rgba(212, 175, 55, 0.1); transform: rotateY(-15deg) rotateX(10deg); transition: 0.6s ease; width: 100%; max-width: 600px; aspect-ratio: 16/10; display: flex; flex-direction: column; }
    .comparison-card:hover { transform: none; }
    .project-preview-img { width: 100%; height: 100%; object-fit: cover; flex-grow: 1; }
