---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const painPoints = [
    {
        icon: "📐",
        title: "Projetos sem Valorização",
        desc: "Seu site atual é uma galeria confusa que não faz jus aos detalhes e ao luxo dos seus projetos.",
    },
    {
        icon: "🏛️",
        title: "Invisibilidade em Projetos de Luxo",
        desc: "Clientes de alto padrão não te encontram ou, quando encontram, não sentem confiança no seu site atual.",
    },
    {
        icon: "📸",
        title: "Portfólio Estático",
        desc: "Dificuldade em mostrar a tridimensionalidade e a história por trás de cada obra realizada.",
    },
];

const benefits = [
    {
        icon: "🎭",
        title: "Curadoria Visual Imersiva",
        desc: "Transformamos seu portfólio em uma experiência de galeria de luxo focada em converter leads.",
    },
    {
        icon: "✨",
        title: "Design de Nível Internacional",
        desc: "Sites que seguem as tendências mais modernas do design arquitetônico e design de interiores.",
    },
    {
        icon: "🚀",
        title: "Performance para Imagens Altas",
        desc: "Suas fotos em ultra-resolução carregam instantaneamente sem comprometer a velocidade.",
    },
];

const slug = "arquitetos";
---

<BaseLayout
    title="Marketing para Arquitetos e Designers de Interiores | Alpha Code"
    description="Exiba seu portfólio com o luxo que ele merece. Sites para arquitetos focados em impacto visual e atração de clientes premium."
    showHeader={true}
    showSocialProof={true}
>
    <NicheMeta slug="arquitetos" slot="head" />

    
    <div class="niche-page arch-theme">
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/arquitetos-hero.png" alt="Studio de Arquitetura Moderno" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot arch"></span> DESIGN DIGITAL PARA ARQUITETOS VISIONÁRIOS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua Obra de Arte <br/> em uma <span class="text-gradient-arch">Galeria Digital</span>.
                    </h1>
                    <p class="hero-sub-v2 reveal-up">
                        O primeiro projeto que seu cliente contrata é o seu site. Tenha uma presença digital sofisticada, minimalista e focada em valorizar cada detalhe da sua arquitetura.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button-arch">PROJETAR MEU SITE PREMIUM</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">4K</span>
                        <span class="stat-txt">Imagens Ultra-HD</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">&lt; 0.8s</span>
                        <span class="stat-txt">Tempo de Resposta</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Vanguarda</span>
                        <span class="stat-txt">Design de Interface</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problems -->
        <section class="problem-v2 py-24">
            <div class="container text-center">
                <h2 class="reveal-up text-4xl md:text-5xl font-black mb-16">Seu portfólio merece <span class="text-arch">mais que um template</span>.</h2>
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-drafting-compass text-arch"></i></div>
                        <h3>Projetos sem Valorização</h3>
                        <p>Seu site atual é uma galeria confusa que não faz jus aos detalhes e ao luxo das suas obras.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-eye-slash text-arch"></i></div>
                        <h3>Invisibilidade Premium</h3>
                        <p>Clientes de alto padrão não te encontram ou, quando encontram, não sentem confiança no seu site atual.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-tachometer-alt text-arch"></i></div>
                        <h3>Lentidão Visual</h3>
                        <p>Dificuldade em carregar imagens pesadas faz o cliente desistir antes mesmo de ver seu portfólio.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transformation -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2 arch">ESTÉTICA & FUNÇÃO</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Uma experiência <br/> visual <span class="text-arch">Sem Fronteiras</span>.</h2>
                        <div class="point-item success-arch mt-8">
                            <div class="point-icon"><i class="fas fa-check-circle"></i></div>
                            <div class="point-text">
                                <strong>Curadoria Premium:</strong>
                                Organização estratégica de projetos para elevar o valor percebido da sua assinatura.
                            </div>
                        </div>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (GENÉRICO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title" style="width: 70%; background: #222; height: 10px;"></div>
                                    <div class="skeleton-text" style="width: 95%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-text" style="width: 90%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-img" style="display: flex; align-items: center; justify-content: center; background: #111; border: 1px dashed #333; color: #222; font-size: 0.7rem; font-weight: 800;">IMAGE_NOT_FOUND.JPG</div>
                                    <div style="width: 80px; height: 25px; background: #222; border: 1px solid #333; margin-top: 10px;"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium bord-arch">
                                <div class="card-tag flagship-arch">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/arquiteto.svg" alt="Projeto Real Arquitetura" class="project-preview-img" />
                                <div class="project-info-overlay">
                                    <strong>Flagship: Studio ARQ</strong>
                                    <span>Vanguarda em Design Digital</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos que o valor de um único projeto de interiores para transformar seu posicionamento de mercado.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>BÁSICO</h3>
                            <p>Portfólio minimalista e elegante</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">O FAVORITO</div>
                        <div class="head">
                            <h3>Studio Autoridade</h3>
                            <p>Galeria imersiva e blog de design</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-arch">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE DESIGN</h3>
                            <p>Posicionamento de luxo e escala total</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">VER DETALHES</Button>
                    </div>
                </div>
            </div>
        </section>

        <section class="final-cta-v2 py-32 text-center bg-black/50 overflow-hidden relative">
            <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Onde o <span class="text-arch">Design</span> <br/> Encontra a <span class="text-arch">Estratégia</span></h2>
            <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn-arch uppercase font-black">ELEVAR MEU POSICIONAMENTO</Button>
            <div class="glow-arch-1"></div>
        </section>
    </div>
</BaseLayout>
<style>
    .arch-theme {
        --color-arch: #BF953F; /* Elegant Gold/Brass for architects */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background-color: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.9) 70%, black 100%); }
    .hero-content-v2 { max-width: 850px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(191, 149, 63, 0.1); border: 1px solid rgba(191, 149, 63, 0.2); border-radius: 50px; font-size: 0.8rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: var(--color-arch); }
    .hero-badge-v2 .dot.arch { width: 8px; height: 8px; background: var(--color-arch); border-radius: 50%; box-shadow: 0 0 10px var(--color-arch); }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 2rem; }
    .text-gradient-arch { background: linear-gradient(135deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.25rem; color: #a0a0a0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 680px; }
    .hero-actions-v2 { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    .hero-trust { font-size: 0.85rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .hero-trust i { color: var(--color-arch); }
    .text-arch { color: var(--color-arch); }
    .bg-arch { background: var(--color-arch) !important; color: black !important; }
    .tag-v2.arch { color: var(--color-arch); }
    .problem-card-v2:hover { border-color: var(--color-arch); transform: translateY(-8px); }
    .icon-circle { width: 80px; height: 80px; background: rgba(191, 149, 63, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 2rem; border: 1px solid rgba(191, 149, 63, 0.1); }
    .check-list { display: flex; flex-direction: column; gap: 1rem; }
    .check-list li { display: flex; align-items: center; gap: 12px; color: #bbb; }
    .check-list i { color: var(--color-arch); }
    .glow-btn-arch { background: var(--color-arch) !important; color: black !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(191, 149, 63, 0.3); }
    .glow-btn-arch:hover { box-shadow: 0 15px 50px rgba(191, 149, 63, 0.5); transform: translateY(-2px); }
    .glow-arch-1 { position: absolute; top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(191, 149, 63, 0.08) 0%, transparent 70%); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .stat-divider { display: none; }
    }

    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.85rem; color: #666; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255, 255, 255, 0.1); align-self: center; }

    /* Problem Cards */
    .problem-card-v2 { background: var(--color-accent); padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.05); transition: all 0.4s ease; text-align: center; }
    .problem-card-v2 h3 { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; }
    .problem-card-v2 p { color: #cecece; line-height: 1.6; }

    /* Transformation & Points */
    .bg-dark-accent { background-color: #080808; }
    .tag-v2 { font-weight: 900; font-size: 0.8rem; letter-spacing: 3px; text-transform: uppercase; display: block; margin-bottom: 1rem; }
    .point-item { display: flex; gap: 1rem; padding: 1.5rem; background: rgba(255, 255, 255, 0.02); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.05); }
    .point-icon { font-size: 1.25rem; color: var(--color-primary); }
    .point-text { font-size: 1rem; color: #999; line-height: 1.5; text-align: left; }
    .point-text strong { display: block; color: white; margin-bottom: 4px; }



    /* Advanced Transformation Styles */
    .comparison-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
        perspective: 1500px;
        margin-top: 2rem;
    }

    .comparison-card {
        background: #0f0f0f;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
        transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .comparison-card.legacy {
        opacity: 0.35;
        transform: scale(0.9) rotateY(15deg) translateX(-30px);
        filter: grayscale(1) blur(1px);
        z-index: 1;
    }

    .comparison-card.premium {
        z-index: 3;
        border: 2px solid var(--color-arch);
        box-shadow: 0 0 100px rgba(191, 149, 63, 0.2);
        transform: scale(1.1) rotateY(-10deg) translateX(30px) translateY(-20px);
    }

    .comparison-card:hover {
        transform: scale(1.05) translateZ(50px) !important;
        z-index: 10;
        opacity: 1 !important;
        filter: none !important;
    }

    .card-tag {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 15;
        padding: 6px 14px;
        font-size: 0.65rem;
        font-weight: 950;
        border-radius: 6px;
        background: rgba(0,0,0,0.8);
        color: white;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .card-tag.flagship-arch {
        background: var(--color-arch);
        color: black;
        border: none;
        box-shadow: 0 4px 20px rgba(191, 149, 63, 0.5);
    }

    .card-browser-mockup {
        height: 40px;
        background: #111;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 25px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .browser-dot-red { width: 10px; height: 10px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 10px; height: 10px; border-radius: 50%; background: #27c93f; }

    .legacy-content { 
        padding: 4rem 3rem; 
        display: flex; 
        flex-direction: column; 
        gap: 1.5rem; 
        background: #080808;
    }
    .skeleton-title { height: 12px; width: 35%; background: #222; border-radius: 2px; }
    .skeleton-text { height: 6px; width: 85%; background: #1a1a1a; border-radius: 1px; }
    .skeleton-text.short { width: 25%; }
    .skeleton-img { height: 140px; width: 100%; background: #151515; border-radius: 8px; border: 1px dashed #222; margin-top: 1rem; }

    .project-preview-img { 
        width: 100%; 
        height: auto; 
        display: block; 
        filter: brightness(1.05);
        transition: transform 0.8s ease;
    }

    .project-info-overlay {
        position: absolute;
        bottom: 30px;
        left: 30px;
        right: 30px;
        background: rgba(10, 10, 10, 0.6);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        padding: 20px 30px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        display: flex;
        flex-direction: column;
        gap: 6px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

    .project-info-overlay strong { 
        display: block; 
        font-size: 1.1rem; 
        font-family: var(--font-heading);
        font-weight: 800;
        letter-spacing: -0.01em;
    }
    .project-info-overlay span { 
        font-size: 0.8rem; 
        color: #4ade80; 
        font-weight: 700; 
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    @media (min-width: 1024px) {
        .comparison-container { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            align-items: center; 
            gap: 0; 
        }
        .comparison-card.legacy { 
            transform: translateX(60px) scale(0.85) rotateY(20deg);
        }
        .comparison-card.premium { 
            transform: scale(1.15) rotateY(-15deg) translateX(-20px);
            box-shadow: 0 60px 120px rgba(0,0,0,0.9);
        }
    }
    .reveal-up { opacity: 1; }
</style>

</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        ScrollTrigger.refresh();

        // Parallax Hero
        gsap.to(".hero-bg-image", { 
            scrollTrigger: { 
                trigger: ".hero-lp-v2", 
                start: "top top", 
                scrub: true 
            }, 
            y: 100, 
            opacity: 0.4 
        });

        // Reveal Up
        document.querySelectorAll(".reveal-up").forEach((el) => {
            gsap.fromTo(el, 
                { 
                    y: 40, 
                    opacity: 0 
                },
                {
                    scrollTrigger: {
                        trigger: el,
                        start: "top 90%",
                    },
                    y: 0,
                    opacity: 1,
                    duration: 1,
                    ease: "power3.out"
                }
            );
        });

        // Card stagger
        gsap.fromTo(".stagger-card", 
            { 
                y: 60, 
                opacity: 0 
            },
            {
                scrollTrigger: { 
                    trigger: ".stagger-container", 
                    start: "top 80%" 
                }, 
                y: 0, 
                opacity: 1, 
                duration: 0.8, 
                stagger: 0.15 
            }
        );
    });
</script>
