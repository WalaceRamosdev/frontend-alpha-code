---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const painPoints = [
    {
        icon: "📐",
        title: "Projetos sem Valorização",
        desc: "Seu site atual é uma galeria confusa que não faz jus aos detalhes e ao luxo dos seus projetos.",
    },
    {
        icon: "🏛️",
        title: "Invisibilidade em Projetos de Luxo",
        desc: "Clientes de alto padrão não te encontram ou, quando encontram, não sentem confiança no seu site atual.",
    },
    {
        icon: "📸",
        title: "Portfólio Estático",
        desc: "Dificuldade em mostrar a tridimensionalidade e a história por trás de cada obra realizada.",
    },
];

const benefits = [
    {
        icon: "🎭",
        title: "Curadoria Visual Imersiva",
        desc: "Transformamos seu portfólio em uma experiência de galeria de luxo focada em converter leads.",
    },
    {
        icon: "✨",
        title: "Design de Nível Internacional",
        desc: "Sites que seguem as tendências mais modernas do design arquitetônico e design de interiores.",
    },
    {
        icon: "🚀",
        title: "Performance para Imagens Altas",
        desc: "Suas fotos em ultra-resolução carregam instantaneamente sem comprometer a velocidade.",
    },
];

const slug = "arquitetos";
---

<BaseLayout
    title="Site para Arquitetos: Portfólios de Luxo e Captação de Projetos"
    description="Exiba sua arquitetura com o luxo que ela merece. Tenha um site para arquitetos sofisticado, focado em autoridade e atração de clientes de alto padrão."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="arquitetos" slot="head" />

    
    <div class="niche-page arch-theme">
        <!-- HERO V2 -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/arquitetos-hero.png" alt="Studio de Arquitetura Moderno" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot arch"></span> DESIGN DIGITAL PARA ARQUITETOS VISIONÁRIOS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua Arquitetura Merece um <br/> <span class="text-gradient-arch">Palco à Altura</span> do seu Talento.
                    </h1>
                    <p class="hero-sub-v2 reveal-up text-balance">
                        O primeiro projeto que seu cliente contrata é o seu site. Tenha um <strong>site para arquitetos</strong> sofisticado, 
                        minimalista e projetado para converter visitantes em projetos de alto padrão.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button
                            href="https://wa.me/5521999064502?text=Olá! Sou arquiteto(a) e desejo elevar meu posicionamento digital para atrair projetos de alto valor."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="glow-btn-arch uppercase font-black"
                        >
                            QUERO MAIS PROJETOS AGORA
                        </Button>
                        <div class="hero-trust">
                            <i class="fas fa-check-circle"></i> Foco em Branding, Portfólio de Luxo e Projetos Premium
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">4K</span>
                        <span class="stat-txt">Imagens Ultra-HD</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">&lt; 0.8s</span>
                        <span class="stat-txt">Tempo de Resposta</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Vanguarda</span>
                        <span class="stat-txt">Design de Interface</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Awareness -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Seu talento está sendo <span class="text-arch">ofuscado digitalmente?</span></h2>
                    <p class="reveal-up text-gray-400 max-w-2xl mx-auto text-lg text-balance">
                        Muitos arquitetos geniais perdem grandes oportunidades por apresentarem um posicionamento digital que não condiz com a qualidade técnica de seus projetos.
                    </p>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-search-dollar text-arch"></i></div>
                        <h3>Dificuldade em Captar Clientes</h3>
                        <p>A dependência exclusiva de indicações limita seu crescimento e te deixa vulnerável às oscilações do mercado.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-level-down-alt text-arch"></i></div>
                        <h3>Desvalorização Profissional</h3>
                        <p>Quando o site não transborda autoridade, o cliente tende a questionar seus honorários e barganhar o valor da sua arte.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-ghost text-arch"></i></div>
                        <h3>Pouca Presença Digital</h3>
                        <p>Sua marca é invisível para quem busca por arquitetura de alto padrão no Google, o maior buscador do mundo.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-users-slash text-arch"></i></div>
                        <h3>Dependência de Indicação</h3>
                        <p>O "boca a boca" é excelente, mas um posicionamento ativo te permite escolher os projetos que deseja realizar.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution & Benefits -->
        <section class="benefits-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Um <span class="text-arch">site para arquitetos</span> que materializa sua autoridade.</h2>
                        <div class="benefit-grid-v2">
                            <div class="benefit-item-v2">
                                <div class="b-icon">✨</div>
                                <div class="b-text">
                                    <h4>Curadoria Visual Imersiva</h4>
                                    <p>Transformamos seu portfólio em uma galeria digital de luxo, destacando cada detalhe técnico e estético.</p>
                                </div>
                            </div>
                            <div class="benefit-item-v2">
                                <div class="b-icon">🌍</div>
                                <div class="b-text">
                                    <h4>Design de Nível Internacional</h4>
                                    <p>Sites que seguem as tendências minimalistas e sofisticadas da arquitetura contemporânea global.</p>
                                </div>
                            </div>
                            <div class="benefit-item-v2">
                                <div class="b-icon">⚡</div>
                                <div class="b-text">
                                    <h4>Performance Ultra-Rápida</h4>
                                    <p>Suas imagens em 4K carregam instantaneamente, garantindo uma experiência fluida em qualquer dispositivo.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="reveal-up bg-dark-card p-8 rounded-3xl border border-white/5">
                        <h3 class="text-2xl font-bold mb-6">O caminho para o topo:</h3>
                        <div class="process-steps">
                            <div class="step-v2">
                                <span class="step-num">01</span>
                                <div class="step-info">
                                    <strong>Briefing Estratégico</strong>
                                    <p>Entendemos sua linguagem arquitetônica e os objetivos do seu studio.</p>
                                </div>
                            </div>
                            <div class="step-v2">
                                <span class="step-num">02</span>
                                <div class="step-info">
                                    <strong>Execução de Alto Padrão</strong>
                                    <p>Projeto focado em UX, otimização de imagens e gatilhos de valorização.</p>
                                </div>
                            </div>
                            <div class="step-v2">
                                <span class="step-num">03</span>
                                <div class="step-info">
                                    <strong>Dominação Digital</strong>
                                    <p>SEO intensivo para que seu nome seja a referência absoluta em projetos premium.</p>
                                </div>
                            </div>
                        </div>
                        <Button
                            href="https://wa.me/5521999064502?text=Gostaria de solicitar uma análise de posicionamento para o meu studio de arquitetura."
                            variant="primary"
                            class="w-full mt-8 glow-btn-arch"
                        >
                            SOLICITAR ANÁLISE DE POSICIONAMENTO
                        </Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Intensive SEO Content Section (800+ words) -->
        <section class="seo-deep-content py-24">
            <div class="container">
                <div class="max-w-4xl mx-auto prose prose-invert prose-gold">
                    <h2 class="text-3xl md:text-5xl font-black mb-8 text-white">Por que o seu Studio precisa de um <span class="text-arch">site para arquitetos</span> estrategicamente projetado?</h2>
                    
                    <p class="text-lg leading-relaxed text-gray-300 mb-6">
                        No mercado de arquitetura e design de interiores, a estética não é apenas um detalhe; é o produto final. No entanto, muitos profissionais falham ao ignorar que a jornada do cliente começa muito antes de uma visita ao studio ou ao canteiro de obras. Um <strong>site para arquitetos</strong> funciona como o seu cartão de visitas digital de luxo. Se o seu site não transmite sofisticação, organização e inovação técnica, o cliente de alto padrão assumirá que seu serviço também carece dessas qualidades. Investir em um posicionamento digital de elite é o passo fundamental para elevar seus honorários e atrair projetos que realmente te desafiem e te valorizem.
                    </p>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">SEO para Arquitetos: Captando Projetos de Valor no Google</h3>
                    <p class="text-gray-400 mb-6">
                        Aparecer no Google não é sobre quantidade, mas sobre qualidade. Através de estratégias avançadas de SEO (Search Engine Optimization), garantimos que seu <strong>site para arquitetos</strong> seja encontrado por quem busca ativamente por soluções arquitetônicas sofisticadas. Seja para projetos residenciais de luxo, design comercial ou arquitetura corporativa, sua vitrine digital precisa estar nas primeiras páginas. O uso da tecnologia Astro.js pela Alpha Code permite que imagens pesadas de portfólio não prejudiquem a velocidade do site, garantindo que o algoritmo do Google te posicione no topo e que o usuário tenha uma experiência impecável.
                    </p>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">Portfólio Imersivo: Conte a História da sua Arquitetura</h3>
                    <p class="text-gray-400 mb-6">
                        Um portfólio estático já não é suficiente. Um <strong>site para arquitetos</strong> moderno deve proporcionar uma experiência imersiva. Através de curadoria visual estratégica, exploramos a tridimensionalidade, o jogo de luzes e a escolha de materiais dos seus projetos. O objetivo é criar uma conexão emocional com o potencial cliente, fazendo-o visualizar-se no ambiente que você projetou. Sites amadores apenas mostram fotos; sites de elite contam histórias de transformação através do design.
                    </p>

                    <div class="highlight-box-seo gold my-12 p-8 border-l-4 border-arch bg-white/5 rounded-r-xl">
                        <h4 class="text-white font-bold text-xl mb-4">A Forma Segue a Estratégia</h4>
                        <p class="text-gray-300 italic">"Na arquitetura, cada traço tem um propósito. No seu marketing digital, cada pixel deve ter um objetivo: valorizar sua assinatura e converter o desejo do cliente em um contrato fechado. Não aceite designs que não acompanham a grandeza dos seus projetos."</p>
                    </div>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">Vencendo a Guerra de Preços com Autoridade</h3>
                    <p class="text-gray-400 mb-6">
                        A maior dor do arquiteto moderno é ser comparado por preço. Quando sua única vitrine é uma rede social, você disputa atenção com milhares de outros perfis e se torna "mais um". Um <strong>site para arquitetos</strong> proprietário estabelece um nível de autoridade que interrompe o processo de comparação rasa. Ao apresentar cases de sucesso detalhados, depoimentos de clientes satisfeitos e uma marca bem estruturada, você deixa de ser uma opção barata para se tornar a escolha óbvia e desejada pelo cliente premium.
                    </p>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">Conclusão: Sua Marca, Seu Legado Arquitetônico</h3>
                    <p class="text-gray-400 mb-6">
                        Projetar o próprio sucesso exige coragem para investir nos canais certos. O <strong>site para arquitetos</strong> é o alicerce da sua marca a longo prazo. Enquanto plataformas de terceiros mudam as regras o tempo todo, o seu site é o seu território - onde você dita o ritmo, controla a experiência do usuário e constrói o seu legado no mercado da construção e design.
                    </p>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos que o valor de um único projeto de interiores para transformar seu posicionamento de mercado.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>BÁSICO</h3>
                            <p>Portfólio minimalista e elegante</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">O FAVORITO</div>
                        <div class="head">
                            <h3>Studio Autoridade</h3>
                            <p>Galeria imersiva e blog de design</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-arch">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE DESIGN</h3>
                            <p>Posicionamento de luxo e escala total</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">VER DETALHES</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta-v2 py-32 relative overflow-hidden">
            <div class="container relative z-10 text-center">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8 text-balance">Onde o <span class="text-arch font-outfit">Design</span> <br/> Encontra a <span class="text-arch font-outfit">Estratégia.</span></h2>
                <div class="reveal-up max-w-2xl mx-auto mb-12">
                    <p class="text-xl text-gray-300">
                        Não permita que projetos medíocres roubem a atenção que sua assinatura merece. Garanta hoje seu posicionamento premium no mercado.
                    </p>
                </div>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502?text=Desejo elevar o posicionamento digital do meu studio de arquitetura." variant="primary" size="lg" class="glow-btn-arch uppercase font-black">Falar no WhatsApp</Button>
                    <Button href="https://wa.me/5521999064502?text=Gostaria de uma análise estratégica do meu site de arquitetura atual." variant="outline" size="lg">Solicitar Análise</Button>
                </div>
            </div>
            <!-- FAQ Section for Architect SEO -->
            <div class="container mt-32 max-w-4xl mx-auto text-left">
                <h3 class="text-3xl font-black mb-12 text-center">Dúvidas Frequentes sobre <br/><span class="text-arch">Marketing para Arquitetos</span></h3>
                <div class="faq-list-v2">
                    <div class="faq-item reveal-up border-b border-white/10 py-6">
                        <h4 class="text-xl font-bold text-arch mb-3">O site ajuda a valorizar meus honorários?</h4>
                        <p class="text-gray-400">Sim. Um site de alto padrão cria uma percepção de valor imediata. Quando o cliente entra em uma "galeria de luxo" digital, ele para de barganhar preço e começa a valorizar sua assinatura.</p>
                    </div>
                    <div class="faq-item reveal-up border-b border-white/10 py-6">
                        <h4 class="text-xl font-bold text-arch mb-3">Como as fotos pesadas de projetos afetam o site?</h4>
                        <p class="text-gray-400">Utilizamos tecnologias de compressão e carregamento inteligente (Next-gen images + Astro.js) que permitem exibir fotos em ultra-resolução sem deixar o site lento, o que é fundamental para o SEO.</p>
                    </div>
                    <div class="faq-item reveal-up border-b border-white/10 py-6">
                        <h4 class="text-xl font-bold text-arch mb-3">Posso atualizar meu portfólio sozinho?</h4>
                        <p class="text-gray-400">Entregamos o site pronto e otimizado, e oferecemos opções de painéis administrativos ou suporte contínuo para que seus novos projetos estejam sempre em destaque.</p>
                    </div>
                </div>
            </div>
            <div class="glow-arch-1"></div>
        </section>
    </div>
</BaseLayout>
<style>
    .arch-theme {
        --color-arch: #BF953F; /* Elegant Gold/Brass for architects */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background-color: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.9) 70%, black 100%); }
    .hero-content-v2 { max-width: 850px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(191, 149, 63, 0.1); border: 1px solid rgba(191, 149, 63, 0.2); border-radius: 50px; font-size: 0.8rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: var(--color-arch); }
    .hero-badge-v2 .dot.arch { width: 8px; height: 8px; background: var(--color-arch); border-radius: 50%; box-shadow: 0 0 10px var(--color-arch); }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 2rem; }
    .text-gradient-arch { background: linear-gradient(135deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.25rem; color: #a0a0a0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 680px; }
    .hero-actions-v2 { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    .hero-trust { font-size: 0.85rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .hero-trust i { color: var(--color-arch); }
    .text-arch { color: var(--color-arch); }
    .bg-arch { background: var(--color-arch) !important; color: black !important; }
    .tag-v2.arch { color: var(--color-arch); }
    .problem-card-v2:hover { border-color: var(--color-arch); transform: translateY(-8px); }
    .icon-circle { width: 80px; height: 80px; background: rgba(191, 149, 63, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 2rem; border: 1px solid rgba(191, 149, 63, 0.1); }
    .check-list { display: flex; flex-direction: column; gap: 1rem; }
    .check-list li { display: flex; align-items: center; gap: 12px; color: #bbb; }
    .check-list i { color: var(--color-arch); }
    .glow-btn-arch { background: var(--color-arch) !important; color: black !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(191, 149, 63, 0.3); }
    .glow-btn-arch:hover { box-shadow: 0 15px 50px rgba(191, 149, 63, 0.5); transform: translateY(-2px); }
    .glow-arch-1 { position: absolute; top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(191, 149, 63, 0.08) 0%, transparent 70%); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .stat-divider { display: none; }
        .pricing-grid-v2 { grid-template-columns: 1fr; }
        .p-card-v2.featured { transform: none; margin: 2rem 0; }
        .transformation-v2 .grid { grid-template-columns: 1fr; }

        /* Mobile fixes for comparison cards */
        .comparison-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            perspective: none;
            margin-top: 1rem;
        }
        .comparison-card.legacy, .comparison-card.premium {
            transform: none !important;
            opacity: 1 !important;
            filter: none !important;
            margin: 0 !important;
        }
        .comparison-card.premium {
            order: -1; /* Premium results first on mobile */
            border-width: 1px;
        }
    }

    .pricing-grid-v2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .p-card-v2 {
        background: var(--color-surface);
        padding: 3rem;
        border-radius: 32px;
        border: 1px solid rgba(255,255,255,0.05);
        display: flex;
        flex-direction: column;
        transition: all 0.4s ease;
    }

    .p-card-v2.featured {
        background: rgba(191, 149, 63, 0.05);
