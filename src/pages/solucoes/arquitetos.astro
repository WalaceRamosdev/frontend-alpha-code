---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";

const painPoints = [
    {
        icon: "📐",
        title: "Projetos sem Valorização",
        desc: "Seu site atual é uma galeria confusa que não faz jus aos detalhes e ao luxo dos seus projetos.",
    },
    {
        icon: "🏛️",
        title: "Invisibilidade em Projetos de Luxo",
        desc: "Clientes de alto padrão não te encontram ou, quando encontram, não sentem confiança no seu site atual.",
    },
    {
        icon: "📸",
        title: "Portfólio Estático",
        desc: "Dificuldade em mostrar a tridimensionalidade e a história por trás de cada obra realizada.",
    },
];

const benefits = [
    {
        icon: "🎭",
        title: "Curadoria Visual Imersiva",
        desc: "Transformamos seu portfólio em uma experiência de galeria de luxo focada em converter leads.",
    },
    {
        icon: "✨",
        title: "Design de Nível Internacional",
        desc: "Sites que seguem as tendências mais modernas do design arquitetônico e design de interiores.",
    },
    {
        icon: "🚀",
        title: "Performance para Imagens Altas",
        desc: "Suas fotos em ultra-resolução carregam instantaneamente sem comprometer a velocidade.",
    },
];

const slug = "arquitetos";
---

<BaseLayout
    title="Marketing para Arquitetos e Designers de Interiores | Alpha Code"
    description="Exiba seu portfólio com o luxo que ele merece. Sites para arquitetos focados em impacto visual e atração de clientes premium."
    showHeader={true}
    showSocialProof={true}
>
    <!-- animations same -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);
        document.addEventListener("astro:page-load", () => {
            gsap.to(".hero-bg-image", { scrollTrigger: { trigger: ".hero-lp-v2", start: "top top", scrub: true }, y: 100, opacity: 0.4 });
            document.querySelectorAll(".reveal-up").forEach((el) => { gsap.from(el, { scrollTrigger: { trigger: el, start: "top 90%" }, y: 40, opacity: 0, duration: 1, ease: "power3.out" }); });
            gsap.from(".stagger-card", { scrollTrigger: { trigger: ".stagger-container", start: "top 80%" }, y: 60, opacity: 0, duration: 0.8, stagger: 0.15 });
        });
    </script>
    
    <div class="niche-page arch-theme">
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/arquitetos-hero.png" alt="Studio de Arquitetura Moderno" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot arch"></span> DESIGN DIGITAL PARA ARQUITETOS VISIONÁRIOS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua Obra de Arte <br/> em uma <span class="text-gradient-arch">Galeria Digital</span>.
                    </h1>
                    <p class="hero-sub-v2 reveal-up">
                        O primeiro projeto que seu cliente contrata é o seu site. Tenha uma presença digital sofisticada, minimalista e focada em valorizar cada detalhe da sua arquitetura.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button-arch">PROJETAR MEU SITE PREMIUM</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">4K</span>
                        <span class="stat-txt">Imagens Ultra-HD</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">&lt; 0.8s</span>
                        <span class="stat-txt">Tempo de Resposta</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Vanguarda</span>
                        <span class="stat-txt">Design de Interface</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problems -->
        <section class="problem-v2 py-24">
            <div class="container text-center">
                <h2 class="reveal-up text-4xl md:text-5xl font-black mb-16">Seu portfólio merece <span class="text-arch">mais que um template</span>.</h2>
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-drafting-compass text-arch"></i></div>
                        <h3>Projetos sem Valorização</h3>
                        <p>Seu site atual é uma galeria confusa que não faz jus aos detalhes e ao luxo das suas obras.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-eye-slash text-arch"></i></div>
                        <h3>Invisibilidade Premium</h3>
                        <p>Clientes de alto padrão não te encontram ou, quando encontram, não sentem confiança no seu site atual.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-arch-sm"><i class="fas fa-tachometer-alt text-arch"></i></div>
                        <h3>Lentidão Visual</h3>
                        <p>Dificuldade em carregar imagens pesadas faz o cliente desistir antes mesmo de ver seu portfólio.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transformation -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2 arch">ESTÉTICA & FUNÇÃO</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Uma experiência <br/> visual <span class="text-arch">Sem Fronteiras</span>.</h2>
                        <div class="point-item success-arch mt-8">
                            <div class="point-icon"><i class="fas fa-check-circle"></i></div>
                            <div class="point-text">
                                <strong>Curadoria Premium:</strong>
                                Organização estratégica de projetos para elevar o valor percebido da sua assinatura.
                            </div>
                        </div>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (GENÉRICO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title"></div>
                                    <div class="skeleton-text"></div>
                                    <div class="skeleton-text short"></div>
                                    <div class="skeleton-img"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium bord-arch">
                                <div class="card-tag flagship-arch">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/arquiteto.svg" alt="Projeto Real Arquitetura" class="project-preview-img" />
                                <div class="project-info-overlay">
                                    <strong>Flagship: Studio ARQ</strong>
                                    <span>Vanguarda em Design Digital</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos que o valor de um único projeto de interiores para transformar seu posicionamento de mercado.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>BÁSICO</h3>
                            <p>Portfólio minimalista e elegante</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">O FAVORITO</div>
                        <div class="head">
                            <h3>Studio Autoridade</h3>
                            <p>Galeria imersiva e blog de design</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-arch">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE DESIGN</h3>
                            <p>Posicionamento de luxo e escala total</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">VER DETALHES</Button>
                    </div>
                </div>
            </div>
        </section>

        <section class="final-cta-v2 py-32 text-center bg-black/50 overflow-hidden relative">
            <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Onde o <span class="text-arch">Design</span> <br/> Encontra a <span class="text-arch">Estratégia</span></h2>
            <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn-arch uppercase font-black">ELEVAR MEU POSICIONAMENTO</Button>
            <div class="glow-arch-1"></div>
        </section>
    </div>
</BaseLayout>
<style>
    .arch-theme {
        --color-arch: #BF953F; /* Elegant Gold/Brass for architects */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
    }

    /* Advanced Transformation Styles */
    .comparison-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
    }

    .comparison-card {
        background: #0f0f0f;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
        box-shadow: 0 40px 80px rgba(0,0,0,0.4);
    }

    .comparison-card.legacy {
        opacity: 0.6;
        transform: scale(0.95);
        filter: grayscale(0.2);
    }

    .comparison-card.premium {
        z-index: 2;
        border: 2px solid var(--color-arch);
    }

    .card-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
        padding: 4px 10px;
        font-size: 0.65rem;
        font-weight: 900;
        border-radius: 4px;
        background: rgba(0,0,0,0.8);
        color: white;
        text-transform: uppercase;
        letter-spacing: 1px;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .card-tag.flagship-arch { background: var(--color-arch); color: black; border: none; }

    .card-browser-mockup {
        height: 30px;
        background: #222;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-left: 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .browser-dot-red { width: 8px; height: 8px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 8px; height: 8px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 8px; height: 8px; border-radius: 50%; background: #27c93f; }

    .legacy-content { padding: 3rem; display: flex; flex-direction: column; gap: 1rem; }
    .skeleton-title { height: 20px; width: 60%; background: #333; border-radius: 4px; }
    .skeleton-text { height: 12px; width: 90%; background: #222; border-radius: 4px; }
    .skeleton-text.short { width: 40%; }
    .skeleton-img { height: 100px; width: 100%; background: #222; border-radius: 8px; margin-top: 1rem; }

    .project-preview-img { 
        width: 100%; 
        height: auto; 
        display: block; 
        filter: brightness(1.05); 
        transition: transform 0.5s ease;
    }

    .comparison-card.premium::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 50%;
        height: 100%;
        background: linear-gradient(
            to right,
            transparent,
            rgba(255, 255, 255, 0.1),
            transparent
        );
        transform: skewX(-25deg);
        transition: 0.7s;
        pointer-events: none;
    }

    .comparison-card.premium:hover::after {
        left: 150%;
        transition: 0.7s;
    }

    .project-info-overlay {
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(15, 15, 15, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 12px 20px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        display: flex;
        flex-direction: column;
        gap: 2px;
        transform: translateY(0);
        transition: transform 0.3s ease;
    }

    .project-info-overlay strong { 
        display: block; 
        font-size: 0.95rem; 
        font-family: var(--font-heading);
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    .project-info-overlay span { 
        font-size: 0.7rem; 
        color: var(--color-arch); 
        font-weight: 900; 
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .problem-card-v2 p { color: #cecece; line-height: 1.6; }
    .shadow-arch-sm { box-shadow: 0 0 20px rgba(191, 149, 63, 0.1); }
    .bord-arch { border: 2px solid var(--color-arch) !important; }

    @media (min-width: 1024px) {
        .comparison-container { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 0; }
        .comparison-card.legacy { transform: translateX(30px) scale(0.9); z-index: 1; }
        .comparison-card.premium { transform: scale(1.05); }
    }
    .reveal-up { opacity: 1; }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll(".reveal-up").forEach((el) => {
            gsap.from(el, {
                scrollTrigger: {
                    trigger: el,
                    start: "top 90%",
                },
                y: 40,
                opacity: 0,
                duration: 1,
                ease: "power3.out"
            });
        });
    });
</script>
