---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import { Image } from "astro:assets";

const painPoints = [
    {
        faIcon: "fas fa-hospital-user",
        title: "Escassez de Particulares",
        desc: "Você depende de convênios que pagam pouco ou de indicações que não são constantes.",
    },
    {
        faIcon: "fas fa-bullseye",
        title: "Marketing que não Converte",
        desc: "Postar sobre doenças no Instagram não atrai o paciente que busca um especialista sério.",
    },
    {
        faIcon: "fas fa-search-plus",
        title: "Invisibilidade no Google",
        desc: "Pacientes qualificados buscam soluções no Google e encontram outros médicos, não você.",
    },
];

const benefits = [
    {
        icon: "🎖️",
        title: "Autoridade Digital",
        desc: "Um site que transmite a mesma credibilidade que você passa em seu consultório físico.",
    },
    {
        icon: "⏱️",
        title: "Agendamento Ágil",
        desc: "Facilite o contato e o agendamento de consultas particulares via WhatsApp estratégico.",
    },
    {
        icon: "📈",
        title: "Valorização da Consulta",
        desc: "Afirme seu valor no mercado. Quando o paciente entra num site premium, ele entende o preço.",
    },
];

const medicalProjects = [
    {
        name: "CTIM | Terapias Integradas",
        image: "/assets/imagens-de-paginas/ctim.svg",
        result: "Clínica de Referência",
        link: "https://ctim.vercel.app/"
    },
    {
        name: "Drª. Silvia Orlandi",
        image: "/assets/imagens-de-paginas/silviaOrlandi.svg",
        result: "Acolhimento Digital",
        link: "https://silvia-terapeuta.vercel.app/"
    }
];

const slug = "medicos";
---

<BaseLayout
    title="Sites para Médicos e Clínicas de Alto Padrão | Alpha Code"
    description="Transforme sua clínica em uma referência digital. Sites médicos profissionais, éticos e otimizados para atrair pacientes particulares."
    showHeader={true}
    showSocialProof={true}
>
    <NicheMeta slug="medicos" slot="head" />

    <!-- animations script same as others -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Ensure any previous triggers are cleaned/updated
            ScrollTrigger.refresh();

            // Parallax Hero
            gsap.to(".hero-bg-image", { 
                scrollTrigger: { 
                    trigger: ".hero-lp-v2", 
                    start: "top top", 
                    scrub: true 
                }, 
                y: 100, 
                opacity: 0.4 
            });

            // Reveal Up elements
            document.querySelectorAll(".reveal-up").forEach((el) => { 
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: { 
                            trigger: el, 
                            start: "top 90%" 
                        }, 
                        y: 0, 
                        opacity: 1, 
                        duration: 1, 
                        ease: "power3.out" 
                    }
                ); 
            });

            // Stagger Cards
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: { 
                        trigger: ".stagger-container", 
                        start: "top 80%" 
                    }, 
                    y: 0, 
                    opacity: 1, 
                    duration: 0.8, 
                    stagger: 0.15 
                }
            );
        });
    </script>

    <div class="niche-page medical-theme">
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/saude-hero.png" alt="Clínica Médica Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot medical"></span> ESTRATÉGIA DIGITAL PARA MÉDICOS E CLÍNICAS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua <span class="text-gradient-medical">Excelência Médica</span> <br/> Merece um Palco à Altura.
                    </h1>
                    <p class="hero-sub-v2 reveal-up">
                        Posicione-se como referência no seu campo. Um site premium é o pilar que faltava para atrair pacientes que buscam qualidade acima de convênio.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button-medical">ATRAIR PACIENTES PARTICULARES</Button>
                        <div class="hero-trust">
                            <i class="fas fa-stethoscope"></i> Foco total em Marketing Ético e CRM
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">100%</span>
                        <span class="stat-txt">Normas CFM Cumpridas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Score 100</span>
                        <span class="stat-txt">Velocidade Google Desktop</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+200</span>
                        <span class="stat-txt">Médicos Atendidos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Awareness -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">O Fim da <span class="text-medical">Dependência de Convênios</span></h2>
                </div>
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-medical-sm"><i class="fas fa-hospital-user text-medical"></i></div>
                        <h3>Dependência de Convênios</h3>
                        <p>Você trabalha muito, mas o lucro real nas consultas particulares é baixo devido às taxas de repasse.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-medical-sm"><i class="fas fa-mobile-alt text-medical"></i></div>
                        <h3>Falsa Exposição</h3>
                        <p>Postar conteúdo educativo no Instagram gera likes, mas não necessariamente agenda cheia de particulares.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-medical-sm"><i class="fas fa-search-minus text-medical"></i></div>
                        <h3>Invisibilidade Focal</h3>
                        <p>Pacientes buscam especialistas no Google, mas sua clínica não aparece nas primeiras posições locais.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transformation -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2 medical">TECNOLOGIA E CUIDADO</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Sua Clínica <br/> no <span class="text-medical">Nível 100</span>.</h2>
                        <p class="text-gray-400 mb-8">Nossos projetos não são apenas bonitos; eles são máquinas de performance médica, otimizados para busca e agendamento instantâneo.</p>
                        <Button href="/portfolio" variant="outline">VER NOSSA EXPERTISE EM SAÚDE</Button>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (LIMITADO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title" style="width: 70%; background: #222; height: 10px;"></div>
                                    <div class="skeleton-text" style="width: 95%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-text" style="width: 90%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-img" style="display: flex; align-items: center; justify-content: center; background: #111; border: 1px dashed #333; color: #222; font-size: 0.7rem; font-weight: 800;">IMAGE_NOT_FOUND.JPG</div>
                                    <div style="width: 80px; height: 25px; background: #222; border: 1px solid #333; margin-top: 10px;"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium bord-medical">
                                <div class="card-tag flagship-medical">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/ctim.svg" alt="Projeto Real CTIM" class="project-preview-img" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Portfolio Specialist -->
        <section class="niche-portfolio py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Sua <span class="text-medical">Banca de Atendimento</span></h2>
                </div>
                <div class="grid md:grid-cols-2 max-w-4xl mx-auto gap-8">
                    {medicalProjects.map((p) => (
                        <a href={p.link} target="_blank" class="psy-project-card reveal-up group border-medical-hover">
                            <div class="psy-img-wrapper">
                                <img src={p.image} alt={p.name} />
                                <div class="psy-overlay medical-bg">
                                    <span>VER SITE MÉDICO <i class="fas fa-external-link-alt"></i></span>
                                </div>
                            </div>
                            <div class="psy-info">
                                <h3>{p.name}</h3>
                                <p><span class="dot medical"></span> {p.result}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos do que o valor de um único procedimento particular para transformar sua clínica.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ESSENCIAL</h3>
                            <p>Presença digital ética e eficiente</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">RECOMENDADO</div>
                        <div class="head">
                            <h3>Clínica Autoridade</h3>
                            <p>Ecossistema de autoridade e blog médico</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-medical">QUERO SER REFERÊNCIA</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE HEALTH</h3>
                            <p>Marketing de alta escala e expansão</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CONSULTAR DETALHES</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta-v2 py-32 relative overflow-hidden">
            <div class="container relative z-10 text-center">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Digitalize sua <br/> <br/> <span class="text-medical font-outfit">Carreira Médica</span></h2>
                <div class="reveal-up">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn-medical uppercase font-black">Falar com especialista agora</Button>
                </div>
            </div>
            <div class="glow-medical-1"></div>
        </section>

    </div>
</BaseLayout>

<style>
    .medical-theme {
        --color-medical: #00f2ff;
        --color-primary: #8a1c26;
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background-color: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.45; filter: saturate(0.8) brightness(0.65); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.9) 70%, black 100%); }
    .hero-content-v2 { max-width: 850px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(0, 242, 255, 0.1); border: 1px solid rgba(0, 242, 255, 0.2); border-radius: 50px; font-size: 0.8rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: var(--color-medical); }
    .hero-badge-v2 .dot.medical { width: 8px; height: 8px; background: var(--color-medical); border-radius: 50%; box-shadow: 0 0 10px var(--color-medical); }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 2rem; }
    .text-gradient-medical { background: linear-gradient(135deg, #00f2ff 0%, #0072ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.25rem; color: #a0a0a0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 680px; }
    .hero-actions-v2 { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    .hero-trust { font-size: 0.85rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .hero-trust i { color: var(--color-medical); }
    .text-medical { color: var(--color-medical); }
    .bg-medical { background: var(--color-medical) !important; color: black !important; }
    .tag-v2.medical { color: var(--color-medical); }
    .problem-card-v2:hover { border-color: var(--color-medical); transform: translateY(-8px); }
    .icon-circle { width: 80px; height: 80px; background: rgba(0, 242, 255, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 2rem; border: 1px solid rgba(0, 242, 255, 0.1); }
    .border-medical-hover:hover { border-color: var(--color-medical) !important; }
    .medical-bg { background: rgba(0, 242, 255, 0.8) !important; }
    .dot.medical { background: var(--color-medical); box-shadow: 0 0 5px var(--color-medical); }
    .glow-btn-medical { background: var(--color-medical) !important; color: black !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(0, 242, 255, 0.3); }
    .glow-btn-medical:hover { box-shadow: 0 15px 50px rgba(0, 242, 255, 0.5); transform: translateY(-2px); }
    .glow-medical-1 { position: absolute; top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(0, 242, 255, 0.05) 0%, transparent 70%); }
    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .stats-bar-v2 { padding: 4rem 0; }
        .stat-divider { display: none; }
        .stats-wrapper-v2 { gap: 3rem; }
        .pricing-grid-v2 { grid-template-columns: 1fr; }
        .p-card-v2.featured { transform: none; margin: 2rem 0; }
        .transformation-v2 .grid { grid-template-columns: 1fr; }

        /* Mobile fixes for comparison cards */
        .comparison-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            perspective: none;
            margin-top: 1rem;
        }
        .comparison-card.legacy, .comparison-card.premium {
            transform: none !important;
            opacity: 1 !important;
            filter: none !important;
            margin: 0 !important;
        }
        .comparison-card.premium {
            order: -1; /* Premium results first on mobile */
            border-width: 1px;
        }
        .project-info-overlay {
            position: relative;
            bottom: auto;
            left: auto;
            right: auto;
            margin: 1rem;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: none;
            border-radius: 12px;
        }
        .project-info-overlay strong { font-size: 1rem; }
        .project-info-overlay span { font-size: 0.7rem; }
    }
    /* Advanced Transformation Styles */
    .comparison-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
        perspective: 1500px;
        margin-top: 2rem;
    }

    .comparison-card {
        background: #0f0f0f;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
        transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        min-height: 200px; /* Fallback height */
    }

    .comparison-card.legacy {
        opacity: 0.35;
        transform: scale(0.9) rotateY(15deg) translateX(-30px);
        filter: grayscale(1) blur(1px);
        z-index: 1;
    }

    .comparison-card.premium {
        z-index: 3;
        border: 2px solid var(--color-medical);
        box-shadow: 0 0 100px rgba(0, 242, 255, 0.15);
        transform: scale(1.1) rotateY(-10deg) translateX(30px) translateY(-20px);
    }

    .comparison-card:hover {
        transform: scale(1.05) translateZ(50px) !important;
        z-index: 10;
        opacity: 1 !important;
        filter: none !important;
    }

    .card-tag {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 15;
        padding: 6px 14px;
        font-size: 0.65rem;
        font-weight: 950;
        border-radius: 6px;
        background: rgba(0,0,0,0.8);
        color: white;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .card-tag.flagship-medical {
        background: var(--color-medical);
        color: black;
        border: none;
        box-shadow: 0 4px 15px rgba(0, 242, 255, 0.4);
    }

    .card-browser-mockup {
        height: 35px;
        background: #111;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-left: 20px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .browser-dot-red { width: 10px; height: 10px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 10px; height: 10px; border-radius: 50%; background: #27c93f; }

    .legacy-content { 
        padding: 4rem 3rem; 
        display: flex; 
        flex-direction: column; 
        gap: 1.5rem; 
        background: #080808;
    }
    .skeleton-title { height: 12px; width: 35%; background: #222; border-radius: 2px; }
    .skeleton-text { height: 6px; width: 85%; background: #1a1a1a; border-radius: 1px; }
    .skeleton-text.short { width: 25%; }
    .skeleton-img { height: 140px; width: 100%; background: #151515; border-radius: 8px; border: 1px dashed #222; margin-top: 1rem; }

    .project-preview-img { 
        width: 100%; 
        height: auto; 
        min-height: 250px; /* Ensure visibility during load */
        object-fit: cover;
        display: block; 
        filter: brightness(1.05);
        transition: transform 0.5s ease;
    }

    @media (min-width: 1024px) {
        .comparison-container { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            align-items: center; 
            gap: 0; 
        }
        .comparison-card.legacy { 
            transform: translateX(60px) scale(0.85) rotateY(20deg);
        }
        .comparison-card.premium { 
            transform: scale(1.15) rotateY(-15deg) translateX(-20px);
            box-shadow: 0 60px 120px rgba(0,0,0,0.9);
        }
    }
    .reveal-up { opacity: 1 !important; }
</style>


</style>
