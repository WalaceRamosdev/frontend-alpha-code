---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import RelatedContent from "../../components/seo/RelatedContent.astro";

const slug = "medicos";

const faq = [
    {
        q: "O site respeita as normas do CFM?",
        a: "Sim, todos os nossos sites para médicos são desenvolvidos seguindo rigorosamente o Manual de Publicidade Médica do CFM, garantindo um marketing ético e informativo."
    },
    {
        q: "Vou aparecer no Google?",
        a: "Sim, aplicamos técnicas avançadas de SEO local para que pacientes em busca de sua especialidade na sua cidade encontrem você primeiro."
    },
    {
        q: "O site integra com meu sistema de agendamento?",
        a: "Sim, podemos integrar o site diretamente com seu software de gestão de consultório ou via botão estratégico de WhatsApp."
    },
    {
        q: "O site funciona bem no celular?",
        a: "Totalmente. O site é 100% responsivo, garantindo que o paciente consiga encontrar suas informações e agendar uma consulta com facilidade pelo smartphone."
    }
];
---

<BaseLayout
    title="Site para Médicos: Atraia mais Pacientes e Domine sua Especialidade"
    description="Atraia mais pacientes todos os dias com um site profissional para médicos. Focado em conversão, ética do CRM/CFM e posicionamento de autoridade."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="medicos" slot="head" />

    <div class="niche-page medical-theme">
        
        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/saude-hero.webp" alt="Consultório Médico Moderno" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> MARKETING MÉDICO DE ALTA PERFORMANCE
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Atraia mais pacientes todos os dias com um <span class="text-gradient">site profissional para médicos</span>
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Crie uma presença online que transmite credibilidade, respeita as normas do CFM e faz com que pacientes que buscam sua especialidade encontrem você no Google.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero atrair mais pacientes particulares com um site profissional de médico." variant="primary" size="lg" class="glow-button px-8">👉 QUERO MAIS PACIENTES</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">FALAR NO WHATSAPP</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">100%</span>
                        <span class="stat-txt">Ética CFM</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+150</span>
                        <span class="stat-txt">Clínicas Atendidas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+400%</span>
                        <span class="stat-txt">Conversão Média</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Você é um médico brilhante... <br/> <span class="text-primary italic">mas ainda depende de convênios que pagam pouco?</span></h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-med-sm"><i class="fas fa-user-md text-primary"></i></div>
                        <h3>Agenda de Particulares Vazia</h3>
                        <p>Dificuldade em atrair o paciente que valoriza sua especialização e está disposto a pagar consulta particular.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-med-sm"><i class="fas fa-search-dollar text-primary"></i></div>
                        <h3>Dependência de Busca Presencial</h3>
                        <p>Sem um site, você perde o paciente que inicia toda a jornada de cura buscando por especialistas no Google.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-med-sm"><i class="fas fa-stethoscope text-primary"></i></div>
                        <h3>Dificuldade em Passar Credibilidade</h3>
                        <p>O paciente moderno checa seu site antes de agendar. Se o site é amador, ele assume que o atendimento também é.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-med-sm"><i class="fas fa-hospital-user text-primary"></i></div>
                        <h3>Presença Online Inexistente</h3>
                        <p>Deixar sua imagem nas mãos de diretórios de médicos genéricos impede você de construir sua própria marca pessoal.</p>
                    </div>
                </div>
                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-2xl">
                        <p class="text-2xl font-bold">💡 A verdade médica é clara: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">se você não é encontrado, você não é o escolhido.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">A SOLUÇÃO ALPHA</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Nós criamos um <span class="text-primary">site estratégico para médicos</span> que trabalha por você todos os dias.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Seu consultório passa a:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🚀</span> Aparecer no Google para pacientes locais
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🛡️</span> Transmitir credibilidade e autoridade médica
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">📅</span> Facilitar agendamentos diretos e informados
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">💎</span> Atrair pacientes particulares altamente qualificados
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">REFERÊNCIA DE MERCADO</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img loading="lazy" src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Exemplo site medicina" class="project-preview-img" style="filter: hue-rotate(180deg);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Excelência para seu Consultório</h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Mais pacientes particulares ativos</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Agenda mais preenchida e rentável</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Menos dependência de tabelas baixas</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Presença profissional de destaque</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Autoridade máxima na sua especialidade</h4>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="process-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl font-black">Sua nova presença digital</h2>
                </div>
                <div class="grid md:grid-cols-4 gap-8 stagger-container">
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">1</div>
                        <h4>Entendemos sua especialidade</h4>
                        <p>Analisamos seu nicho médico e público para atrair o paciente ideal.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">2</div>
                        <h4>Criamos um site estratégico</h4>
                        <p>Design focado em transmitir segurança, conhecimento e facilitar agendamentos.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">3</div>
                        <h4>Otimizamos para o Google</h4>
                        <p>Técnicas de SEO médico para que você seja autoridade nas buscas da região.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">4</div>
                        <h4>Colocamos para rodar</h4>
                        <p>Seu site passa a trabalhar por você 24h por dia, captando novos pacientes.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Difference Section -->
        <section class="differences py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Não criamos sites médicos genéricos.</h2>
                        <p class="text-xl text-gray-400 mb-8">Criamos páginas pensadas para médicos, com foco em:</p>
                        <ul class="diff-list space-y-4">
                            <li class="flex items-center gap-3">
                                <div class="dot-med"></div> Comunicação científica e acolhedora
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-med"></div> Respeito às normas éticas do CFM/CRM
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-med"></div> Estrutura que gera decisão de agendamento
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-med"></div> Experiência premium que transmite confiança
                            </li>
                        </ul>
                    </div>
                    <div class="reveal-up bg-white/5 p-12 rounded-3xl border border-primary/20">
                        <h3 class="text-3xl font-black mb-6">🔥 O resultado é garantido?</h3>
                        <p class="text-lg text-gray-300 mb-8">Nossa estrutura não é apenas um site visual — é uma ferramenta de decisão do paciente, pensada para:</p>
                        <div class="flex flex-col gap-4">
                            <span class="badge-v3">👉 ATRAIR O PACIENTE QUALIFICADO</span>
                            <span class="badge-v3">👉 CONVENCER PELA CREDIBILIDADE</span>
                            <span class="badge-v3">👉 GERAR AGENDAMENTO DIRETO</span>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero atrair mais pacientes particulares com um site médico profissional." variant="primary" class="w-full mt-10 glow-button py-6 text-xl">🚀 QUERO MAIS PACIENTES AGORA</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Dúvidas Frequentes</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Sua excelência médica <br/> <span class="text-primary font-outfit">agora é digital.</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button px-10">👉 QUERO MAIS PACIENTES</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">SOLICITAR ANÁLISE ESTRATÉGICA</Button>
                </div>
            </div>
            <div class="glow-blur-med"></div>
        </section>

        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert prose-blue">
                <h2 class="text-3xl font-black text-white">Referência em <span class="text-primary">site para médicos</span> e clínicas</h2>
                <p>Investir em um <strong>site para médicos</strong> é blindar seu consultório contra a desvalorização dos convênios. O paciente particular não busca médicos em livretos de planos de saúde; ele busca especialistas no Google. Nossos sites são desenhados para que pessoas que realmente precisam de sua especialidade encontrem você através da <strong>criação de sites para médicos</strong> de alta performance. Com o Alpha Code Medical Design, aplicamos táticas fundamentais para <strong>atrair pacientes particulares</strong> que buscam segurança, rapidez e autoridade médica.</p>
                <p>Todos os projetos respeitam o Manual de Publicidade Médica do CFM, focando no caráter informativo e educativo. A tecnologia Astro.js utilizada garante o site mais rápido do Brasil, crucial para que o paciente encontre seu endereço e telefone em segundos, seja na emergência ou para agendamentos de rotina.</p>
                
                <!-- Internal Linking -->
                <div class="mt-12 pt-8 border-t border-white/10 not-prose">
                    <h3 class="text-xl font-bold text-white mb-4">Leia no nosso Blog:</h3>
                    <ul class="flex flex-col gap-2 text-gray-400 font-medium mb-8">
                        <li><a href="/blog/psicologos-perdem-pacientes-por-falta-de-site" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Guia completo: Por que psicólogos perdem pacientes?</a></li>
                        <li><a href="/blog/como-o-seo-local-coloca-seu-consultorio-na-frente-da-concorrencia" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Como o SEO Local traz mais pacientes</a></li>
                        <li><a href="/blog/landing-page-vs-site-institucional-qual-o-melhor-para-converter-leads" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Landing Page vs Site Institucional</a></li>
                    </ul>

                    <h3 class="text-xl font-bold text-white mb-4">Conheça outras Soluções Alpha Code:</h3>
                    <ul class="flex flex-wrap gap-4 text-sm text-gray-500 font-medium">
                        <li><a href="/solucoes/advogados" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Advogados</a></li>
                        <li><a href="/solucoes/medicos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2 bg-white/5 text-white">Sites para Médicos</a></li>
                        <li><a href="/solucoes/dentistas" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Dentistas</a></li>
                        <li><a href="/solucoes/psicologos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Psicólogos</a></li>
                        <li><a href="/solucoes/arquitetos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Arquitetos</a></li>
                        <li><a href="/solucoes/contadores" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Contadores</a></li>
                    </ul>
                </div>
            </div>
        </section>
        <RelatedContent
            type="niche"
            niche="medicos"
            title="Continue explorando soluções para medicos"
            limit={6}
        />


    </div>
</BaseLayout>

<style>
    .medical-theme {
        --color-primary: #3b82f6;
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.8) 70%, black 100%); }
    .hero-content-v2 { max-width: 900px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 50px; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: #60a5fa; }
    .hero-badge-v2 .dot { width: 8px; height: 8px; background: #3b82f6; border-radius: 50%; box-shadow: 0 0 10px #3b82f6; }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1.0; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 2rem; }
    .text-gradient { background: linear-gradient(135deg, #60a5fa, #2563eb); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.3rem; color: #b0b0b0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 750px; font-weight: 500; }
    
    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Cards */
    .problem-card-v2 { background: #0c0c0c; padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; }
    .problem-card-v2:hover { border-color: var(--color-primary); transform: translateY(-10px); }
    .icon-circle { width: 70px; height: 70px; background: rgba(59, 130, 246, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 2rem; border: 1px solid rgba(59, 130, 246, 0.1); }
    .problem-card-v2 h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #eee; }
    .problem-card-v2 p { color: #888; line-height: 1.6; }

    .benefit-card-v3 { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; background: #0c0c0c; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .check-circle { width: 30px; height: 30px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; flex-shrink: 0; }
    .benefit-card-v3 h4 { font-size: 1.25rem; font-weight: 800; }

    .process-step-v3 .step-icon { width: 60px; height: 60px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900; margin: 0 auto 2rem; color: var(--color-primary); }
    .process-step-v3 h4 { font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem; }
    .process-step-v3 p { color: #777; line-height: 1.6; }

    .badge-v3 { padding: 12px 20px; background: rgba(59, 130, 246, 0.08); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); font-weight: 800; color: #93c5fd; font-size: 0.9rem; }
    .dot-med { width: 8px; height: 8px; background: var(--color-primary); border-radius: 50%; }

    /* Comparison Card */
    .comparison-container { perspective: 1200px; display: flex; justify-content: center; }
    .comparison-card { background: #111; border-radius: 20px; overflow: hidden; border: 2px solid var(--color-primary); box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 40px rgba(59, 130, 246, 0.1); transform: rotateY(-15deg) rotateX(10deg); transition: 0.6s ease; width: 100%; max-width: 600px; aspect-ratio: 16/10; display: flex; flex-direction: column; }
    .comparison-card:hover { transform: none; }
    .project-preview-img { width: 100%; height: 100%; object-fit: cover; flex-grow: 1; }
    .card-tag { position: absolute; top: 20px; left: 20px; z-index: 10; background: var(--color-primary); color: white; padding: 6px 12px; font-size: 0.7rem; font-weight: 900; border-radius: 4px; box-shadow: 0 4px 15px rgba(59,130,246,0.4); text-transform: uppercase; letter-spacing: 1px; }

    .glow-blur-med { position: absolute; bottom: 10%; right: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%); filter: blur(100px); z-index: 0; pointer-events: none; }

    .card-browser-mockup { height: 35px; background: #1a1a1a; display: flex; align-items: center; gap: 8px; padding-left: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
