---

<BaseLayout
    title="Site para Médicos: Atraia Pacientes Particulares com Autoridade"
    description="Precisa de um site para médicos focado em consultas particulares? Desenvolvemos sites médicos éticos, premium e otimizados para o Google. Lote sua agenda hoje!"
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="medicos" slot="head" />

    <!-- animations script same as others -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Ensure any previous triggers are cleaned/updated
            ScrollTrigger.refresh();

            // Parallax Hero
            gsap.to(".hero-bg-image", { 
                scrollTrigger: { 
                    trigger: ".hero-lp-v2", 
                    start: "top top", 
                    scrub: true 
                }, 
                y: 100, 
                opacity: 0.4 
            });

            // Reveal Up elements
            document.querySelectorAll(".reveal-up").forEach((el) => { 
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: { 
                            trigger: el, 
                            start: "top 90%" 
                        }, 
                        y: 0, 
                        opacity: 1, 
                        duration: 1, 
                        ease: "power3.out" 
                    }
                ); 
            });

            // Stagger Cards
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: { 
                        trigger: ".stagger-container", 
                        start: "top 80%" 
                    }, 
                    y: 0, 
                    opacity: 1, 
                    duration: 0.8, 
                    stagger: 0.15 
                }
            );
        });
    </script>

    <div class="niche-page medical-theme">
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/saude-hero.png" alt="Clínica Médica de Alto Padrão" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot medical"></span> MARKETING MÉDICO ÉTICO E DE ALTA CONVERSÃO
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua excelência médica merece uma <br/>
                        <span class="text-gradient-medical">Autoridade Digital</span> à Altura.
                    </h1>
                    <p class="hero-sub-v2 reveal-up text-balance">
                        Não seja refém apenas de indicações ou de convênios que pagam pouco. 
                        Tenha um <strong>site para médicos</strong> focado em atrair pacientes particulares que buscam 
                        especialistas de referência no Google.
