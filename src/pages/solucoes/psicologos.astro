---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";

const checklistItems = [
    "Estrutura alinhada ao código de ética",
    "Linguagem humanizada e profissional",
    "Design limpo que transmite confiança",
    "Otimização para anúncios no Google e Meta",
    "CTA estratégico sem pressão comercial",
    "Carregamento rápido e responsivo",
    "Foco em conversão, não em vaidade",
    "Presença online sem exposição pessoal",
];

const painPoints = [
    "Agenda vazia ou instável",
    "Dependência de indicações",
    "Medo de parecer antiético",
    "Insegurança com marketing digital",
    "Sensação de estar invisível online",
];
---

<BaseLayout
    title="Marketing Ético para Psicólogos | Alpha Code"
    description="Atraia mais pacientes particulares sem precisar se expor nas redes sociais. Sites profissionais e éticos para psicólogos."
    showHeader={false}
    showFooter={true}
    showSocialProof={true}
>
    <main class="landing-page-psych">
        <!-- Hero Section -->
        <section class="hero-lp">
            <div class="container">
                <div class="hero-content">
                    <span class="badge">Marketing Ético e Silencioso</span>
                    <h1>
                        Atraia mais pacientes com uma presença online <span
                            class="highlight"
                            >profissional, ética e feita para converter.</span
                        >
                    </h1>
                    <p class="subheadline">
                        Você não precisa fazer "dancinha" no Instagram, se expor
                        ou ferir sua ética profissional para ter pacientes.
                        <br />
                        <strong
                            >Discrição, segurança e respeito ao código de ética.</strong
                        >
                    </p>
                    <div class="cta-wrapper">
                        <Button
                            href="#contato"
                            variant="primary"
                            size="lg"
                            class="pulse-anim"
                        >
                            Quero atrair mais pacientes
                        </Button>
                        <span class="secure-text"
                            >🔒 Processo 100% sigiloso e ético</span
                        >
                    </div>
                </div>
            </div>
            <div class="hero-bg-glow"></div>
        </section>

        <!-- Pain Points (Dores) -->
        <section class="pain-section">
            <div class="container">
                <div class="pain-grid">
                    <div class="pain-text">
                        <h2>O desafio de crescer na psicologia hoje</h2>
                        <p>
                            Sabemos que você preza pela sua autoridade técnica.
                            Mas o mercado mudou, e apenas ser excelente não
                            garante agenda cheia.
                        </p>
                    </div>
                    <ul class="pain-list">
                        {
                            painPoints.map((point) => (
                                <li>
                                    <span class="icon-pain">⚠</span>
                                    {point}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </section>

        <!-- Solution (Posicionamento) -->
        <section class="solution-section">
            <div class="container">
                <div class="solution-content">
                    <h2>A solução não é "postar todo dia"</h2>
                    <p>
                        A solução é ter uma <strong
                            >Página Profissional de Alta Conversão</strong
                        >. Uma estrutura digital que trabalha para você 24 horas
                        por dia, gerando confiança instantânea em quem visita.
                        Não é sobre "ser famoso", é sobre <strong
                            >ser encontrado por quem precisa de ajuda</strong
                        >.
                    </p>
                    <p>
                        Nossas páginas são otimizadas para anúncios. O paciente
                        pesquisa, encontra você, sente segurança e agenda.
                        Simples.
                    </p>
                    <Button href="#contato" variant="outline" size="lg">
                        Ver se essa solução funciona para mim
                    </Button>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-section">
            <div class="container">
                <div class="pricing-header">
                    <h2>Investimento Transparente</h2>
                    <p>
                        Qualidade de agência grande, com preço justo e sem
                        "mensalidades eternas".
                    </p>
                </div>

                <div class="pricing-grid">
                    <!-- Card 1 -->
                    <div class="pricing-card">
                        <div class="card-header">
                            <h3>Essencial</h3>
                            <p class="card-desc">
                                Para quem quer começar com o pé direito.
                            </p>
                        </div>
                        <div class="price-box">
                            <span class="currency">R$</span>
                            <span class="amount">260</span>
                            <span class="payment-term">À vista (25% OFF)</span>
                            <span
                                class="original-price"
                                style="text-decoration: line-through; color: #666; font-size: 0.9rem;"
                                >De R$ 347</span
                            >
                        </div>
                        <ul class="features-list">
                            <li>
                                ✅ <strong>Site One-Page</strong> (Tudo em uma página)
                            </li>
                            <li>✅ Design Premium & Exclusivo</li>
                            <li>✅ Otimização Básica para Google (SEO)</li>
                            <li>✅ Botão WhatsApp Flutuante</li>
                            <li>✅ Hospedagem de Alta Performance</li>
                            <li class="disabled">🚫 Sistema de Blog</li>
                        </ul>
                        <div class="card-footer">
                            <Button
                                href="https://wa.me/5521999064502?text=Quero%20o%20plano%20Essencial%20(Bronze)"
                                target="_blank"
                                variant="outline"
                                class="w-full"
                            >
                                Escolher Essencial
                            </Button>
                        </div>
                    </div>

                    <!-- Card 2 (Featured) -->
                    <div class="pricing-card featured">
                        <div class="badge-popular">MAIS ESCOLHIDO</div>
                        <div class="card-header">
                            <h3>Autoridade</h3>
                            <p class="card-desc">
                                Para quem quer dominar a sua região.
                            </p>
                        </div>
                        <div class="price-box">
                            <span class="currency">R$</span>
                            <span class="amount">449</span>
                            <span class="payment-term">À vista (25% OFF)</span>
                            <span
                                class="original-price"
                                style="text-decoration: line-through; color: #888; font-size: 0.9rem;"
                                >De R$ 599</span
                            >
                        </div>
                        <ul class="features-list">
                            <li>
                                ✅ <strong>Site Multi-Páginas</strong> (Completo)
                            </li>
                            <li>
                                ✅ <strong>Blog de Artigos</strong> (Foco em SEO)
                            </li>
                            <li>✅ Design Premium & Exclusivo</li>
                            <li>✅ Otimização Avançada para Google</li>
                            <li>✅ Integração com Instagram</li>
                            <li>✅ Treinamento de Uso</li>
                        </ul>
                        <div class="card-footer">
                            <Button
                                href="https://wa.me/5521999064502?text=Quero%20dominar%20minha%20regi%C3%A3o%20com%20o%20plano%20Autoridade%20(Prata)"
                                target="_blank"
                                variant="primary"
                                class="w-full glow-effect"
                            >
                                Quero ser Autoridade
                            </Button>
                        </div>
                    </div>
                </div>

                <p class="guarantee-text">
                    🔒 Pagamento seguro via Link ou Cartão. Sem letras miúdas.
                </p>
            </div>
        </section>

        <!-- Visual Checklist -->
        <section class="checklist-section">
            <div class="container">
                <div class="checklist-card">
                    <h3>Checklist da Página Profissional para Psicólogos</h3>
                    <ul class="checklist-grid">
                        {
                            checklistItems.map((item) => (
                                <li>
                                    <span class="check-icon">✔</span>
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </section>

        <!-- Proof / Methodology -->
        <section class="proof-section">
            <div class="container">
                <h2>Metodologia Alpha Ethics™</h2>
                <div class="method-grid">
                    <div class="method-item">
                        <h3>1. Discrição</h3>
                        <p>
                            Seu site foca na sua especialidade e na dor do
                            paciente, não na sua vida pessoal.
                        </p>
                    </div>
                    <div class="method-item">
                        <h3>2. Acolhimento</h3>
                        <p>
                            Design calmo, cores que passam tranquilidade e
                            navegação intuitiva para quem está fragilizado.
                        </p>
                    </div>
                    <div class="method-item">
                        <h3>3. Conversão Ética</h3>
                        <p>
                            Textos que convidam ao tratamento sem promessas de
                            cura milagrosa ou sensacionalismo.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA Area -->
        <section id="contato" class="final-cta-section">
            <div class="container">
                <div class="final-cta-content">
                    <h2>
                        Sua presença online pode ser discreta, profissional e
                        eficiente.
                    </h2>
                    <p>
                        Você não precisa se expor para crescer. Deixe que sua
                        competência fale através de uma estrutura digital de
                        elite.
                    </p>

                    <div class="actions">
                        <Button
                            href="https://wa.me/5521999064502?text=Ol%C3%A1%2C%20sou%20psic%C3%B3logo%20e%20quero%20conhecer%20a%20estrat%C3%A9gia%20%C3%A9tica."
                            variant="primary"
                            size="lg"
                            class="glow-effect"
                        >
                            Agendar avaliação gratuita
                        </Button>
                    </div>
                    <p class="small-print">
                        Sem compromisso. Apenas uma conversa sobre sua carreira.
                    </p>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    /* Landing Page Styles */
    .landing-page-psych {
        color: #fff;
        font-family: "Plus Jakarta Sans", sans-serif;
    }

    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Hero */
    .hero-lp {
        padding: 120px 0 80px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    h1 {
        font-size: 3.5rem;
        line-height: 1.1;
        font-weight: 800;
        margin: 20px 0 30px;
        letter-spacing: -0.02em;
    }

    .highlight {
        color: var(--color-primary);
        display: block;
    }

    .subheadline {
        font-size: 1.25rem;
        color: #ccc;
        max-width: 700px;
        margin: 0 auto 40px;
        line-height: 1.6;
    }

    .subheadline strong {
        color: #fff;
        font-weight: 600;
    }

    .badge {
        background: rgba(255, 255, 255, 0.1);
        color: var(--color-primary);
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .secure-text {
        display: block;
        margin-top: 15px;
        font-size: 0.9rem;
        color: #888;
        opacity: 0.8;
    }

    /* Pain Section */
    .pain-section {
        padding: 80px 0;
        background: #0f0f0f;
    }

    .pain-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: center;
    }

    .pain-text h2 {
        font-size: 2.5rem;
        margin-bottom: 20px;
    }

    .pain-text p {
        color: #aaa;
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .pain-list {
        list-style: none;
        padding: 0;
    }

    .pain-list li {
        background: rgba(255, 50, 50, 0.05);
        border-left: 3px solid #ff4444;
        padding: 15px 20px;
        margin-bottom: 15px;
        border-radius: 0 8px 8px 0;
        font-weight: 500;
    }

    .icon-pain {
        margin-right: 10px;
    }

    /* Solution */
    .solution-section {
        padding: 100px 0;
        text-align: center;
        background: linear-gradient(to bottom, #0a0a0a, #141414);
    }

    .solution-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .solution-content h2 {
        font-size: 2.5rem;
        margin-bottom: 30px;
    }

    .solution-content p {
        font-size: 1.2rem;
        color: #ccc;
        margin-bottom: 30px;
        line-height: 1.7;
    }

    /* Checklist */
    .checklist-section {
        padding: 80px 0;
    }

    .checklist-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 50px;
    }

    .checklist-card h3 {
        text-align: center;
        font-size: 2rem;
        margin-bottom: 40px;
    }

    .checklist-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        list-style: none;
        padding: 0;
    }

    .checklist-grid li {
        display: flex;
        align-items: center;
        gap: 15px;
        font-size: 1.1rem;
        padding: 10px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 10px;
    }

    .check-icon {
        color: var(--color-primary);
        font-weight: bold;
        font-size: 1.2rem;
    }

    /* Proof */
    .proof-section {
        padding: 100px 0;
        text-align: center;
    }

    .proof-section h2 {
        font-size: 2.5rem;
        margin-bottom: 60px;
    }

    .method-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .method-item {
        background: #111;
        padding: 30px;
        border-radius: 16px;
        border: 1px solid #222;
    }

    .method-item h3 {
        font-size: 1.3rem;
        margin-bottom: 15px;
        color: #fff;
    }

    .method-item p {
        color: #888;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* Final CTA */
    .final-cta-section {
        padding: 120px 0;
        text-align: center;
        background: radial-gradient(
            circle at center,
            rgba(138, 28, 38, 0.1) 0%,
            transparent 70%
        );
    }

    .final-cta-content h2 {
        font-size: 3rem;
        max-width: 800px;
        margin: 0 auto 20px;
        line-height: 1.2;
    }

    .final-cta-content p {
        font-size: 1.4rem;
        color: #ccc;
        margin-bottom: 40px;
    }

    .small-print {
        font-size: 0.9rem !important;
        color: #555 !important;
        margin-top: 20px;
    }

    /* Pricing */
    .pricing-section {
        padding: 100px 0;
        background: #0d0d0d;
    }

    .pricing-header {
        text-align: center;
        margin-bottom: 60px;
    }

    .pricing-header h2 {
        font-size: 2.5rem;
        margin-bottom: 20px;
    }

    .pricing-header p {
        color: #ccc;
        font-size: 1.2rem;
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        max-width: 900px;
        margin: 0 auto;
    }

    .pricing-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: transform 0.3s ease;
    }

    .pricing-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.05);
    }

    .pricing-card.featured {
        border: 2px solid var(--color-primary);
        background: rgba(138, 28, 38, 0.05);
        box-shadow: 0 0 30px rgba(138, 28, 38, 0.2);
    }

    .badge-popular {
        position: absolute;
        top: -15px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--color-primary);
        color: white;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .card-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .card-header h3 {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .card-desc {
        color: #888;
        font-size: 0.95rem;
    }

    .price-box {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 30px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .currency {
        font-size: 1.5rem;
        vertical-align: top;
        color: #ccc;
    }

    .amount {
        font-size: 3.5rem;
        font-weight: 800;
        color: white;
    }

    .payment-term {
        display: block;
        color: var(--color-primary);
        font-weight: 700;
        margin-top: 5px;
    }

    .features-list {
        list-style: none;
        padding: 0;
        margin-bottom: 40px;
        flex-grow: 1;
    }

    .features-list li {
        margin-bottom: 15px;
        color: #ddd;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .features-list li.disabled {
        color: #555;
        text-decoration: line-through;
    }

    .w-full {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .guarantee-text {
        text-align: center;
        margin-top: 40px;
        color: #666;
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.2rem;
        }
        .pain-grid {
            grid-template-columns: 1fr;
        }
        .checklist-grid {
            grid-template-columns: 1fr;
        }
        .method-grid {
            grid-template-columns: 1fr;
        }
        .hero-lp {
            padding-top: 80px;
        }
        .final-cta-content h2 {
            font-size: 2rem;
        }
    }
</style>
