---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import SocialProofGrid from "../../components/sections/SocialProofGrid.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import FaqAccordion from "../../components/ui/FaqAccordion.astro";
import { niches } from "../../data/niches";
import { Image } from "astro:assets";

const niche = niches.find((n) => n.slug === "psicologos");

const painPoints = [
    {
        faIcon: "fas fa-chart-line",
        title: "Dependência de Indicações",
        desc: "Seu faturamento oscila porque você espera os pacientes chegarem até você.",
    },
    {
        faIcon: "fab fa-instagram",
        title: "Instagram não é Consultório",
        desc: "Você posta todo dia, ganha likes, mas sua agenda continua com horários vagos.",
    },
    {
        faIcon: "fas fa-eye-slash",
        title: "Invisibilidade Digital",
        desc: "Pacientes qualificados procuram no Google e encontram seu concorrente, não você.",
    },
];

const benefits = [
    {
        icon: "⚡",
        title: "Segurança em 5 Segundos",
        desc: "Um site que transmite autoridade imediata. O paciente entra e sente: 'é aqui que eu vou ser ajudado'.",
    },
    {
        icon: "🎯",
        title: "Filtro de Curiosos",
        desc: "Estrutura desenhada para afastar quem quer 'precinho' e atrair quem valoriza sua hora.",
    },
    {
        icon: "💎",
        title: "Valorização da Sessão",
        desc: "Quando você se posiciona como autoridade, o preço da sua sessão deixa de ser um problema.",
    },
];

const testimonials = [
    {
        name: "Ana Bottesi",
        role: "Psicóloga | Clínica de Ansiedade",
        result: "+340% em Velocidade e 98% de Pontuação SEO",
        quote: "O site anterior era lento e não convertia. Após a otimização da Alpha Code, meu PageSpeed saltou para 99/100 e hoje recebo contatos qualificados diariamente pelo Google.",
    },
    {
        name: "Dra. Juliana Mendes",
        role: "Psicóloga Clínica (TCC)",
        result: "De 3 para 15 particulares/mês",
        quote: "Eu achava que precisava fazer vídeos engraçados no TikTok. Com o site certo, lotei minha agenda em 45 dias sem me expor.",
    },
    {
        name: "Dr. Roberto Campos",
        role: "Psicanalista",
        result: "ROI de 500% em 2 meses",
        quote: "O retorno percebido pelos pacientes mudou. Hoje eles chegam já sabendo que o valor da minha consulta é diferenciado.",
    },
];

const psyProjects = [
    {
        name: "Dra. Nayanne Justiniano",
        image: "/assets/imagens-de-paginas/nayanneJustiniano.svg",
        result: "Autoridade e Agendamentos",
        link: "https://www.nayannejustiniano.com.br/"
    },
    {
        name: "Dra. Erika Spinola",
        image: "/assets/imagens-de-paginas/erikaSpinola.svg",
        result: "Presença Digital Premium",
        link: "https://www.erikaspinola.com.br"
    },
    {
        name: "Dra. Ana Bottesi",
        image: "/assets/imagens-de-paginas/anaBottesi.svg",
        result: "Conversão de Pacientes",
        link: "https://www.anabottesi.com.br"
    }
];

---

<BaseLayout
    title="Marketing Ético para Psicólogos | Alpha Code"
    description="Atraia mais pacientes particulares sem precisar se expor nas redes sociais. Sites profissionais e éticos para psicólogos."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="psicologos" slot="head" />
    
    <!-- GSAP / Animations -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Refresh ScrollTrigger as heights might change after navigation
            ScrollTrigger.refresh();

            // Hero parallax
            gsap.to(".hero-bg-image", {
                scrollTrigger: {
                    trigger: ".hero-lp-v2",
                    start: "top top",
                    end: "bottom top",
                    scrub: true
                },
                y: 100,
                opacity: 0.4
            });

            // Reveal animations
            const revealElements = document.querySelectorAll(".reveal-up");
            revealElements.forEach((el) => {
                // Use fromTo for rock-solid visibility regardless of CSS initial state
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: {
                            trigger: el,
                            start: "top 90%",
                            toggleActions: "play none none reverse"
                        },
                        y: 0,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.out"
                    }
                );
            });

            // Card stagger
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: {
                        trigger: ".stagger-container",
                        start: "top 80%"
                    },
                    y: 0,
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power2.out"
                }
            );
        });
    </script>

    <div class="niche-page psychology-theme">
        
        <!-- HERO V2: Immersive & Emotional -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/psicologia-hero.png" alt="Consultório de Psicologia Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot"></span> POSICIONAMENTO ESTRATÉGICO PARA PSICÓLOGOS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Transforme seu nome em uma <br/>
                        <span class="text-gradient">Autoridade Clínica</span> Inquestionável.
                    </h1>
                    <p class="hero-sub-v2 reveal-up text-balance">
                        Pare de depender apenas de indicações ou de postagens exaustivas. 
                        Tenha uma presença digital ética, elegante e otimizada para atrair os 
                        pacientes particulares que valorizam seu trabalho.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button
                            href="https://wa.me/5521999064502?text=Olá! Sou psicólogo(a) e quero um site que transmita autoridade e atraia pacientes qualificados."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="glow-button"
                        >
                            INICIAR MINHA TRANSFORMAÇÃO DIGITAL
                        </Button>
                        <div class="hero-trust">
                            <i class="fas fa-check-circle"></i> +200 psicólogos já confiam na Alpha Code
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="hero-scroll-indicator">
                <div class="mouse">
                    <div class="wheel"></div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">98%</span>
                        <span class="stat-txt">Score SEO Profissional</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">3 dias</span>
                        <span class="stat-txt">Prazo Médio de Entrega</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+150k</span>
                        <span class="stat-txt">Visitantes em Nossos Projetos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Awareness -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">O Ciclo da <span class="text-primary">Invisibilidade</span></h2>
                    <p class="reveal-up text-gray-400 max-w-2xl mx-auto text-lg text-balance">
                        Por que bons profissionais continuam com horários vagos enquanto o mercado digital explode?
                    </p>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    {painPoints.map((pain) => (
                        <div class="problem-card-v2 stagger-card">
                            <div class="icon-circle">
                                <i class={pain.faIcon} style="color: var(--color-primary);"></i>
                            </div>
                            <h3>{pain.title}</h3>
                            <p>{pain.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Transformation: Before vs After -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2">A SOLUÇÃO REAL</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">O Fim da Era Provisória. <br/> Comece a Era <span class="text-primary">Premium</span>.</h2>
                        <div class="transformation-points">
                            <div class="point-item">
                                <div class="point-icon"><i class="fas fa-times-circle"></i></div>
                                <div class="point-text">
                                    <strong>Como você está hoje:</strong>
                                    Website lento, amador ou sem identidade, que afasta pacientes de alto valor.
                                </div>
                            </div>
                            <div class="point-item success">
                                <div class="point-icon"><i class="fas fa-check-circle"></i></div>
                                <div class="point-text">
                                    <strong>O padrão Alpha Code:</strong>
                                    Experiência imersiva, rápida (Score 100) e desenhada para conversão ética.
                                </div>
                            </div>
                        </div>
                        <Button href="#investimento" variant="outline" class="mt-8">VER PLANOS E INVESTIMENTO</Button>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (GENÉRICO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title" style="width: 70%; background: #222; height: 10px;"></div>
                                    <div class="skeleton-text" style="width: 95%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-text" style="width: 90%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-img" style="display: flex; align-items: center; justify-content: center; background: #111; border: 1px dashed #333; color: #222; font-size: 0.7rem; font-weight: 800;">IMAGE_NOT_FOUND.JPG</div>
                                    <div style="width: 80px; height: 25px; background: #222; border: 1px solid #333; margin-top: 10px;"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/nayanneJustiniano.svg" alt="Projeto Real Dra. Nayanne Justiniano" class="project-preview-img" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Specialist Portfolio -->
        <section class="niche-portfolio py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Expertise em <span class="text-primary">Psicologia</span></h2>
                    <p class="reveal-up text-gray-400 max-w-2xl mx-auto text-lg">
                        Dominamos os códigos éticos e estéticos do seu nicho. Veja como alguns colegas já se posicionaram:
                    </p>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8">
                    {psyProjects.map((p) => (
                        <a href={p.link} target="_blank" class="psy-project-card reveal-up group">
                            <div class="psy-img-wrapper">
                                <img src={p.image} alt={p.name} />
                                <div class="psy-overlay">
                                    <span>CONHECER SITE <i class="fas fa-external-link-alt"></i></span>
                                </div>
                            </div>
                            <div class="psy-info">
                                <h3>{p.name}</h3>
                                <p><span class="dot"></span> {p.result}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- Social Proof (Testimonials) -->
        <section class="testimonials-v2 py-24 bg-black/50">
            <div class="container">
                <div class="grid md:grid-cols-3 gap-8">
                    {testimonials.map((t) => (
                        <div class="testi-card-v2 reveal-up">
                            <div class="stars">⭐⭐⭐⭐⭐</div>
                            <p class="quote">"{t.quote}"</p>
                            <div class="author">
                                <div class="avatar">{t.name.charAt(0)}</div>
                                <div class="info">
                                    <strong>{t.name}</strong>
                                    <span>{t.role}</span>
                                </div>
                            </div>
                            <div class="result-badge-v2">{t.result}</div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Solution Details -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Por que um site da Alpha Code é <span class="text-primary">diferente</span>?</h2>
                        <div class="benefit-grid-v2">
                            {benefits.map((b) => (
                                <div class="benefit-item-v2">
                                    <div class="b-icon">{b.icon}</div>
                                    <div class="b-text">
                                        <h4>{b.title}</h4>
                                        <p>{b.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                    <div class="reveal-up bg-dark-card p-8 rounded-3xl border border-white/5">
                        <h3 class="text-2xl font-bold mb-6">O que está incluído no seu projeto:</h3>
                        <ul class="check-list">
                            <li><i class="fas fa-check"></i> Design Exclusivo focado em Psicologia</li>
                            <li><i class="fas fa-check"></i> Otimização Google (SEO local)</li>
                            <li><i class="fas fa-check"></i> Botões de WhatsApp Estratégicos</li>
                            <li><i class="fas fa-check"></i> Hospedagem Profissional Inclusa</li>
                            <li><i class="fas fa-check"></i> Suporte Técnico Individualizado</li>
                            <li><i class="fas fa-check"></i> Integração com Blog para Autoridade</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos do que o valor de uma única sessão recorrente para transformar sua carreira.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <!-- Standard Plans Card (Summary) -->
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ESSENCIAL</h3>
                            <p>Presença básica e eficiente</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">O SEU FAVORITO</div>
                        <div class="head">
                            <h3>AUTORIDADE</h3>
                            <p>Ecossistema completo de conteúdo</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE</h3>
                            <p>Dominação total do mercado</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">FALAR COM ESPECIALISTA</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final Call -->
        <section class="final-cta-v2 py-32 relative overflow-hidden">
            <div class="container relative z-10 text-center">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Pronto para o próximo <br/> <span class="text-primary font-outfit">nível?</span></h2>
                <div class="reveal-up max-w-2xl mx-auto mb-12">
                    <p class="text-xl text-gray-300">
                        O custo de não se posicionar hoje é continuar perdendo os 
                        pacientes ideais para quem já tomou essa decisão. 
                        Vamos construir seu legado digital?
                    </p>
                </div>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn">FALAR COM UM ESPECIALISTA</Button>
                    <a href="/portfolio" class="btn-secondary-v2">Ver Portfólio Completo</a>
                </div>
            </div>
            <!-- Background glows -->
            <div class="glow-1"></div>
            <div class="glow-2"></div>
        </section>

    </div>
</BaseLayout>

<style>
    /* Theme Variables */
    .psychology-theme {
        --color-primary: #8a1c26; /* KEEP Alpha Code Red but with softer accents if needed */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }

    .niche-page {
        font-family: var(--font-main);
        background-color: var(--color-bg-dark);
        color: white;
        overflow-x: hidden;
    }

    .container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* Hero V2 */
    .hero-lp-v2 {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 100px 0;
        background-color: black;
    }

    .hero-bg-container {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .hero-bg-image {
        width: 100%;
        height: 110%;
        object-fit: cover;
        opacity: 0.6;
        filter: saturate(0.8) brightness(0.7);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.8) 50%, black 100%);
    }

    .hero-content-v2 {
        max-width: 850px;
    }

    .hero-badge-v2 {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 2rem;
        backdrop-filter: blur(10px);
    }

    .hero-badge-v2 .dot {
        width: 8px;
        height: 8px;
        background: var(--color-primary);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--color-primary);
    }

    .hero-title-v2 {
        font-family: var(--font-heading);
        font-size: clamp(2.5rem, 8vw, 5rem);
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -0.04em;
        margin-bottom: 2rem;
    }

    .text-gradient {
        color: var(--color-primary);
        background: linear-gradient(to right, var(--color-primary), #ff4d61);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-sub-v2 {
        font-size: 1.25rem;
        color: #a0a0a0;
        line-height: 1.6;
        margin-bottom: 3rem;
        max-width: 680px;
    }

    .hero-actions-v2 {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .hero-trust {
        font-size: 0.9rem;
        color: #666;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .hero-trust i {
        color: #4ade80;
    }

    /* Stats Bar */
    .stats-bar-v2 {
        background: var(--color-surface);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 2.5rem 0;
        position: relative;
        z-index: 10;
        margin-top: -40px;
    }

    .stats-wrapper-v2 {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .stat-item-v2 {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .stat-num {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        font-weight: 800;
        color: white;
    }

    .stat-txt {
        font-size: 0.85rem;
        color: #666;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .stat-divider {
        width: 1px;
        height: 40px;
        background: rgba(255, 255, 255, 0.1);
        align-self: center;
    }

    /* Problem Cards */
    .problem-card-v2 {
        background: var(--color-accent);
        padding: 3rem 2rem;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.4s ease;
        text-align: center;
    }

    .problem-card-v2:hover {
        background: #181818;
        border-color: rgba(255, 255, 255, 0.1);
        transform: translateY(-8px);
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
