---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import SocialProofGrid from "../../components/sections/SocialProofGrid.astro";
import CTAButton from "../../components/ui/CTAButton.astro";
import FaqAccordion from "../../components/ui/FaqAccordion.astro";
import { niches } from "../../data/niches";

const niche = niches.find((n) => n.slug === "psicologos");

const painPoints = [
    {
        icon: "📉",
        title: "Dependência de Indicações",
        desc: "Seu faturamento oscila porque você espera os pacientes chegarem até você.",
    },
    {
        icon: "📱",
        title: "Instagram não é Consultório",
        desc: "Você posta todo dia, ganha likes, mas sua agenda continua com horários vagos.",
    },
    {
        icon: "😶",
        title: "Invisibilidade Digital",
        desc: "Pacientes qualificados procuram no Google e encontram seu concorrente, não você.",
    },
];

const benefits = [
    {
        icon: "⚡",
        title: "Segurança em 5 Segundos",
        desc: "Um site que transmite autoridade imediata. O paciente entra e sente: 'é aqui que eu vou ser ajudado'.",
    },
    {
        icon: "🎯",
        title: "Filtro de Curiosos",
        desc: "Estrutura desenhada para afastar quem quer 'precinho' e atrair quem valoriza sua hora.",
    },
    {
        icon: "💎",
        title: "Valorização da Sessão",
        desc: "Quando você se posiciona como autoridade, o preço da sua sessão deixa de ser um problema.",
    },
];

const testimonials = [
    {
        name: "Dra. Juliana Mendes",
        role: "Psicóloga Clínica (TCC)",
        result: "De 3 para 15 particulares/mês",
        quote: "Eu achava que precisava fazer vídeos engraçados no TikTok. Com o site certo, lotei minha agenda em 45 dias sem me expor.",
    },
    {
        name: "Dr. Roberto Campos",
        role: "Psicanalista",
        result: "ROI de 500% em 2 meses",
        quote: "O retorno percebido pelos pacientes mudou. Hoje eles chegam já sabendo que o valor da minha consulta é diferenciado.",
    },
];
---

<BaseLayout
    title="Marketing Ético para Psicólogos | Alpha Code"
    description="Atraia mais pacientes particulares sem precisar se expor nas redes sociais. Sites profissionais e éticos para psicólogos."
    showHeader={false}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="psicologos" slot="head" />
    <!-- GSAP Scripts -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Hero Animation
            const tl = gsap.timeline();

            tl.from(".hero-badge", {
                y: -10,
                opacity: 0,
                duration: 1,
                ease: "power3.out",
            })
                .from(
                    ".hero-title",
                    {
                        y: 30,
                        opacity: 0,
                        duration: 1,
                        ease: "power3.out",
                    },
                    "-=0.6",
                )
                .from(
                    ".hero-sub",
                    {
                        y: 20,
                        opacity: 0,
                        duration: 0.8,
                        ease: "power3.out",
                    },
                    "-=0.4",
                )
                .from(
                    ".hero-cta",
                    {
                        scale: 0.95,
                        opacity: 0,
                        duration: 0.6,
                        ease: "back.out(1.7)",
                        delay: 0.2, // Small delay to force reading
                    },
                    "-=0.1",
                );

            // Scroll Animations for Sections
            gsap.utils.toArray(".anim-fade-up").forEach((elem: any) => {
                gsap.from(elem, {
                    scrollTrigger: {
                        trigger: elem,
                        start: "top 85%",
                        toggleActions: "play none none reverse",
                    },
                    y: 40,
                    opacity: 0,
                    duration: 0.8,
                    ease: "power3.out",
                });
            });

            // Stagger for cards
            gsap.utils
                .toArray(".stagger-container")
                .forEach((container: any) => {
                    const cards = container.querySelectorAll(".stagger-item");
                    gsap.from(cards, {
                        scrollTrigger: {
                            trigger: container,
                            start: "top 80%",
                        },
                        y: 50,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.2,
                        ease: "power2.out",
                    });
                });

            // Animation removed to prevent conflicts with component internal logic
        });
    </script>

    <div class="landing-page-psych">
        <!-- Hero Section -->
        <section class="hero-lp">
            <div class="container">
                <div class="hero-content">
                    <span class="hero-badge badge"
                        >Estratégia Digital para Psicólogos</span
                    >
                    <h1 class="hero-title">
                        Psicólogos que querem viver da clínica não podem <span
                            class="highlight">depender de sorte.</span
                        >
                    </h1>
                    <p class="hero-sub subheadline">
                        Você estudou muito para ficar refém de indicações. Tenha
                        uma presença digital que transmite autoridade e lota sua
                        agenda com pacientes particulares.
                    </p>
                    <div class="hero-cta cta-wrapper">
                        <Button
                            href="https://wa.me/5521999064502?text=Quero%20entender%20como%20um%20site%20pode%20me%20ajudar%20a%20atrair%20mais%20pacientes."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="pulse-anim main-cta-btn"
                        >
                            QUERO ATRAIR PACIENTES TODOS OS DIAS
                        </Button>
                        <span class="secure-text">
                            Atendemos apenas alguns projetos por mês
                        </span>
                    </div>
                </div>
            </div>
            <div class="hero-bg-glow"></div>
        </section>

        <SocialProofGrid />

        <!-- Social Proof (Resultados) -->
        <section class="social-proof-section anim-fade-up">
            <div class="container">
                <div class="proof-header">
                    <h2>Resultados Reais de Quem Decidiu Se Posicionar</h2>
                </div>
                <div class="testimonials-grid">
                    {
                        testimonials.map((t) => (
                            <div class="testimonial-card">
                                <div class="testimonial-header">
                                    <div class="avatar-placeholder">
                                        {t.name.charAt(0)}
                                    </div>
                                    <div>
                                        <h4>{t.name}</h4>
                                        <span class="role">{t.role}</span>
                                    </div>
                                </div>
                                <div class="result-badge">🚀 {t.result}</div>
                                <p class="quote">"{t.quote}"</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Pain Points: Why they don't convert -->
        <section class="problem-section">
            <div class="container">
                <div class="section-header anim-fade-up">
                    <span class="section-tag">O ERRO COMUM</span>
                    <h2>Por que a maioria dos psicólogos falha no digital?</h2>
                    <p>
                        O problema não é sua competência técnica. É como você é
                        percebido.
                    </p>
                </div>

                <div class="problems-grid">
                    {
                        painPoints.map((pain) => (
                            <div class="problem-card">
                                <div class="icon-box">{pain.icon}</div>
                                <h3>{pain.title}</h3>
                                <p>{pain.desc}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="mid-cta anim-fade-up" style="margin-top: 40px;">
                    <Button
                        href="https://wa.me/5521999064502?text=Quero%20entender%20como%20um%20site%20pode%20me%20ajudar%20a%20atrair%20mais%20pacientes."
                        target="_blank"
                        variant="outline"
                        class="w-full-mobile"
                    >
                        Quero corrigir isso agora
                    </Button>
                </div>
            </div>
        </section>

        <!-- Solution / Benefits -->
        <section class="solution-section">
            <div class="container">
                <div class="solution-wrapper">
                    <div class="solution-text anim-fade-up">
                        <h2>O que você recebe com a Alpha Code</h2>
                        <p class="lead">
                            Não entregamos apenas um site bonito. Entregamos uma
                            ferramenta de vendas éticas.
                        </p>

                        <div class="benefits-list">
                            {
                                benefits.map((benefit) => (
                                    <div class="benefit-item">
                                        <div class="benefit-icon">
                                            {benefit.icon}
                                        </div>
                                        <div class="benefit-content">
                                            <h4>{benefit.title}</h4>
                                            <p>{benefit.desc}</p>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Scarcity / Urgency -->
        <section class="scarcity-section anim-fade-up">
            <div class="container">
                <div class="scarcity-box">
                    <div class="scarcity-icon">⚠️</div>
                    <div class="scarcity-content">
                        <h3>
                            Para entregar o melhor para cada, trabalhamos em
                            poucos projetos por mês, e restam POUCAS VAGAS !
                        </h3>
                        <p>
                            Para garantir a qualidade premium e a atenção que
                            seu projeto merece, limitamos nossa agenda. <strong
                                >Não somos uma fábrica de sites massificados.</strong
                            ><br />
                            Somos uma agência que tem orgulho de entregar resultados.
                        </p>
                    </div>
                    <div class="scarcity-status">
                        <span class="status-dot"></span>
                        <span class="status-text"
                            >Vagas para este mês quase esgotadas</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-section" id="investimento">
            <div class="container">
                <div class="pricing-header anim-fade-up">
                    <h2>Quanto custa ter essa estrutura?</h2>
                    <p>
                        Muito menos do que você perde todos os meses com
                        horários vagos.
                    </p>
                </div>

                <div class="pricing-grid">
                    <!-- Card 1 -->
                    <div class="pricing-card">
                        <div class="card-header">
                            <h3>Essencial</h3>
                            <p class="card-desc">
                                Para quem quer começar AGORA a captar pacientes.
                            </p>
                        </div>
                        <div class="price-box">
                            <span class="old-price">De R$ 397</span>
                            <span class="save-badge">25% OFF</span>
                            <div class="flex items-baseline gap-1">
                                <span class="currency">R$</span>
                                <span class="amount">295</span>
                            </div>
                            <span class="payment-term">À visto no PIX</span>
                        </div>
                        <ul class="features-list">
                            <li>✅ <strong>Site One-Page</strong> Otimizado</li>
                            <li>✅ Design que passa Segurança</li>
                            <li>✅ Botão WhatsApp Estratégico</li>
                            <li>✅ Otimização Básica SEO</li>
                            <li>✅ Hospedagem Inclusa</li>
                        </ul>
                        <div class="card-footer">
                            <Button
                                href="https://wa.me/5521999064502?text=Quero%20entender%20como%20um%20site%20pode%20me%20ajudar%20a%20atrair%20mais%20pacientes."
                                target="_blank"
                                variant="outline"
                                class="w-full"
                            >
                                Verificar disponibilidade
                            </Button>
                        </div>
                    </div>

                    <!-- Card 2 (Featured) -->
                    <div class="pricing-card featured">
                        <div class="badge-popular">RECOMENDADO</div>
                        <div class="card-header">
                            <h3>Autoridade</h3>
                            <p class="card-desc" style="margin-bottom: 24px;">
                                A estrutura completa para quem quer ser
                                referência.
                            </p>
                        </div>
                        <div class="price-box">
                            <span class="old-price">De R$ 697</span>
                            <span class="save-badge">ECONOMIZE R$ 248</span>
                            <div class="flex items-baseline gap-1">
                                <span class="currency">R$</span>
                                <span class="amount">449</span>
                            </div>
                            <span class="payment-term">À vista no PIX</span>
                        </div>
                        <ul class="features-list">
                            <li>
                                ✅ <strong>Site Multi-Páginas</strong> (Site Completo)
                            </li>
                            <li>
                                ✅ <strong>Blog Profissional</strong> (Atraia pelo
                                Google)
                            </li>
                            <li>✅ Design Premium Exclusivo</li>
                            <li>✅ SEO Avançado (1ª página)</li>
                            <li>✅ Integração Instagram/Facebook</li>
                            <li>✅ Treinamento de Gestão</li>
                        </ul>
                        <div class="card-footer">
                            <Button
                                href="https://wa.me/5521999064502?text=Quero%20entender%20como%20um%20site%20pode%20me%20ajudar%20a%20atrair%20mais%20pacientes."
                                target="_blank"
                                variant="primary"
                                class="w-full glow-effect"
                            >
                                QUERO SER AUTORIDADE
                            </Button>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="pricing-card">
                        <div class="card-header">
                            <h3>Elite</h3>
                            <p class="card-desc">
                                Ecossistema completo para dominação total do nicho.
                            </p>
                        </div>
                        <div class="price-box">
                            <span class="old-price">De R$ 1.297</span>
                            <span class="save-badge">ECONOMIZE R$ 587</span>
                            <div class="flex items-baseline gap-1">
                                <span class="currency">R$</span>
                                <span class="amount">710</span>
                            </div>
                            <span class="payment-term">À vista no PIX</span>
                        </div>
                        <ul class="features-list">
                            <li>✅ Tudo do Plano Autoridade</li>
                            <li>✅ Funil de Vendas Automatizado</li>
                            <li>✅ SEO Técnico Nível 100</li>
                            <li>✅ Integração CRM Avançada</li>
                            <li>✅ Mentoria Estratégica Individual</li>
                        </ul>
                        <div class="card-footer">
                            <Button
                                href="https://wa.me/5521999064502?text=Olá! Quero saber mais sobre o Plano Elite para minha clínica."
                                target="_blank"
                                variant="outline"
                                class="w-full"
                            >
                                Consultar detalhes
                            </Button>
                        </div>
                    </div>
                </div>

                <p class="guarantee-text anim-fade-up">
                    🔒 Risco Zero: Garantia de satisfação ou ajustamos até ficar
                    perfeito.
                </p>
            </div>
        </section>

        <!-- Final CTA Area -->
        <section id="contato" class="final-cta-section anim-fade-up">
            <div class="container">
                <div class="final-cta-content">
                    <h2>
                        O custo de não ter esse site é continuar perdendo
                        pacientes para quem tem.
                    </h2>
                    <p>
                        Você estudou anos para ser uma excelente profissional. <br
                        />
                        Agora, deixe o mundo saber disso.
                    </p>

                    <div class="actions">
                        <Button
                            href="https://wa.me/5521999064502?text=Quero%20entender%20como%20um%20site%20pode%20me%20ajudar%20a%20atrair%20mais%20pacientes."
                            variant="primary"
                            target="_blank"
                            size="lg"
                            class="glow-effect pulse-anim"
                        >
                            FALAR COM UM ESPECIALISTA AGORA
                        </Button>
                    </div>
                    <p class="small-print">Resposta rápida via WhatsApp.</p>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    /* Landing Page Styles Typography & Commons */
    .landing-page-psych {
        color: #e0e0e0;
        font-family: "Plus Jakarta Sans", sans-serif;
        background-color: #050505;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .highlight {
        color: var(--color-primary);
        font-weight: 800;
        text-shadow: 0 0 20px rgba(var(--color-primary-rgb), 0.4);
    }

    section {
        position: relative;
    }

    /* Hero Section */
    .hero-lp {
        padding: 140px 0 100px;
        text-align: center;
        background: radial-gradient(
            circle at center top,
            #1a0505 0%,
            #000000 60%
        );
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .badge {
        background: rgba(255, 255, 255, 0.08);
        color: var(--color-primary);
        padding: 8px 18px;
        border-radius: 100px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 24px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(5px);
    }

    .hero-title {
        font-family: "Outfit", sans-serif;
        font-size: 3.8rem;
        line-height: 1.1;
        font-weight: 800;
        color: white;
        margin-bottom: 24px;
        letter-spacing: -0.03em;
    }

    .hero-sub {
        font-size: 1.35rem;
        color: #a0a0a0;
        max-width: 780px;
        margin-bottom: 48px;
        line-height: 1.6;
    }

    .main-cta-btn {
        box-shadow: 0 10px 40px rgba(var(--color-primary-rgb), 0.3);
        font-weight: 800 !important;
        letter-spacing: 0.5px;
    }

    .secure-text {
        font-size: 0.9rem;
        color: #666;
        margin-top: 16px;
        display: block;
        font-weight: 500;
    }

    /* Social Proof */
    .social-proof-section {
        padding: 80px 0;
        background: #0a0a0a;
        border-top: 1px solid #222;
        border-bottom: 1px solid #222;
    }

    .proof-header h2 {
        text-align: center;
        font-size: 2.2rem;
        margin-bottom: 50px;
        color: white;
    }

    .testimonials-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 32px;
    }

    .testimonial-card {
        background: #141414; /* Lighter background for better visibility */
        padding: 32px;
        border-radius: 20px;
        border: 1px solid #333; /* Stronger border */
        position: relative;
    }

    .testimonial-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
    }

    .avatar-placeholder {
        width: 50px;
        height: 50px;
        background: var(--color-primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
    }

    .testimonial-header h4 {
        margin: 0;
        color: white;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .role {
        font-size: 0.95rem;
        color: #999;
    }

    .result-badge {
        display: inline-block;
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 16px;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .quote {
        color: #ddd; /* Ligther text */
        font-style: italic;
        line-height: 1.6;
        font-size: 1.05rem;
    }

    /* Problem Section */
    .problem-section {
        padding: 100px 0;
        background: #050505;
        text-align: center;
    }

    .section-header {
        margin-bottom: 60px;
    }

    .section-tag {
        color: #ff4444;
        font-weight: 800;
        font-size: 0.9rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
        display: block;
    }

    .section-header h2 {
        font-size: 2.8rem;
        color: white;
        margin-bottom: 16px;
        font-weight: 700;
    }

    .problems-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 50px;
        align-items: stretch; /* Ensure cards stretch to same height */
    }

    .problem-card {
        background: #111;
        padding: 40px 24px;
        border-radius: 16px;
        border: 1px solid #222;
        transition: transform 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        height: 100%; /* Fill the grid cell */
        justify-content: space-between; /* Push content apart */
    }

    .problem-card:hover {
        transform: translateY(-5px);
        border-color: #444;
        background: #161616;
    }

    .icon-box {
        font-size: 2.5rem;
        margin-bottom: 20px;
        display: inline-block;
        padding: 15px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 50%;
    }

    .problem-card h3 {
        color: white;
        font-size: 1.3rem;
        margin-bottom: 12px;
        flex-grow: 0;
    }

    .problem-card p {
        color: #ccc;
        font-size: 1rem;
        line-height: 1.6;
        flex-grow: 1; /* Pushes content to fill space */
    }

    /* Solution Section */
    .solution-section {
        padding: 100px 0;
        background: linear-gradient(to right, #0d0d0d, #121212);
        position: relative;
    }

    .solution-text h2 {
        font-size: 3rem;
        color: white;
        margin-bottom: 20px;
    }

    .solution-text .lead {
        font-size: 1.3rem;
        color: #bbb;
        max-width: 600px;
        margin-bottom: 60px;
    }

    .benefits-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 24px;
        background: #141414; /* Higher visibility */
        padding: 30px;
        border-radius: 16px;
        border-left: 3px solid var(--color-primary);
        border: 1px solid #222; /* Add definition */
    }

    .benefit-icon {
        font-size: 2rem;
    }

    .benefit-content h4 {
        color: white;
        font-size: 1.4rem;
        margin-bottom: 8px;
    }

    .benefit-content p {
        color: #ccc;
        line-height: 1.6;
    }

    /* Scarcity */
    .scarcity-section {
        padding: 40px 0;
    }

    .scarcity-box {
        background: rgba(255, 215, 0, 0.05);
        border: 1px solid rgba(255, 215, 0, 0.2);
        border-radius: 16px;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    .scarcity-icon {
        font-size: 2.5rem;
    }

    .scarcity-content h3 {
        color: #ffd700;
        font-size: 1.3rem;
        margin-bottom: 6px;
    }

    .scarcity-content p {
        color: #ddd;
        font-size: 0.95rem;
    }

    .scarcity-status {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(0, 0, 0, 0.3);
        padding: 10px 20px;
        border-radius: 50px;
    }

    .status-dot {
