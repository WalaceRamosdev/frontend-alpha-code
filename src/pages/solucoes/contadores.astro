---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";


const painPoints = [
    {
        icon: "📉",
        title: "Perda de Clientes para o Digital",
        desc: "Escritórios de contabilidade online estão crescendo porque oferecem uma experiência digital que você ainda não tem.",
    },
    {
        icon: "🏢",
        title: "Imagem Burocrática",
        desc: "Seu site atual (ou a falta de um) transmite uma imagem de empresa antiga e pouco tecnológica.",
    },
    {
        icon: "⚖️",
        title: "Dificuldade em Leads B2B",
        desc: "Empresas modernas buscam parceiros contábeis que falem a língua da tecnologia e eficiência.",
    },
];

const benefits = [
    {
        icon: "🛡️",
        title: "Autoridade e Confiança Corporativa",
        desc: "Um posicionamento digital que transmite a segurança necessária para gerir o patrimônio do seu cliente.",
    },
    {
        icon: "⚙️",
        title: "Eficiência no Atendimento",
        desc: "Centralize documentos e facilite o contato inicial através de formulários e botões inteligentes.",
    },
    {
        icon: "📊",
        title: "Visibilidade Estratégica",
        desc: "Seja encontrado por empresários que buscam uma contoria contábil de excelência no Google.",
    },
];
---

<BaseLayout
    title="Marketing Contábil e Sites para Contadores | Alpha Code"
    description="Digitalize seu escritório de contabilidade. Sites modernos, eficientes e focados em prospecção de clientes B2B qualificados."
    showHeader={true}
    showSocialProof={true}
>
    <NicheMeta slug="contadores" slot="head" />

    <!-- animations script same -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            ScrollTrigger.refresh();

            // Parallax Hero
            gsap.to(".hero-bg-image", { 
                scrollTrigger: { 
                    trigger: ".hero-lp-v2", 
                    start: "top top", 
                    scrub: true 
                }, 
                y: 100, 
                opacity: 0.4 
            });

            // Reveal Up
            document.querySelectorAll(".reveal-up").forEach((el) => { 
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: { 
                            trigger: el, 
                            start: "top 90%" 
                        }, 
                        y: 0, 
                        opacity: 1, 
                        duration: 1, 
                        ease: "power3.out" 
                    }
                ); 
            });

            // Card stagger
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: { 
                        trigger: ".stagger-container", 
                        start: "top 80%" 
                    }, 
                    y: 0, 
                    opacity: 1, 
                    duration: 0.8, 
                    stagger: 0.15 
                }
            );
        });
    </script>

    <div class="niche-page accounting-theme">
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/contadores-hero.png" alt="Escritório de Contabilidade Moderno" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot accounting"></span> ESTRATÉGIA DIGITAL PARA ESCRITÓRIOS DE CONTABILIDADE
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua Contabilidade na <br/> <span class="text-gradient-accounting">Era da Eficiência</span>.
                    </h1>
                    <p class="hero-sub-v2 reveal-up">
                        Não deixe seu escritório ficar para trás. Tenha uma presença digital que transmite segurança absoluta e atrai empresas que buscam uma parceria contábil moderna.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button-accounting uppercase">Digitalizar meu Escritório</Button>
                        <div class="hero-trust">
                            <i class="fas fa-shield-alt"></i> Foco em Segurança, Credibilidade e Resultados B2B
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">99.9%</span>
                        <span class="stat-txt">Uptime de Sistemas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+1k</span>
                        <span class="stat-txt">Empresas Impactadas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">A+</span>
                        <span class="stat-txt">Autoridade Digital</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problems -->
        <section class="problem-v2 py-24">
            <div class="container text-center">
                <h2 class="reveal-up text-4xl md:text-5xl font-black mb-16">O mercado contábil <span class="text-accounting">mudou</span>. E você?</h2>
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-accounting-sm"><i class="fas fa-chart-line-down text-accounting"></i></div>
                        <h3>Perda para o Digital</h3>
                        <p>Contabilidades online crescem porque oferecem uma experiência digital que seu escritório ainda não tem.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-accounting-sm"><i class="fas fa-building text-accounting"></i></div>
                        <h3>Imagem Burocrática</h3>
                        <p>Seu site atual transmite uma imagem de empresa estagnada, o que afasta novos empresários modernos.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-accounting-sm"><i class="fas fa-user-tie text-accounting"></i></div>
                        <h3>Dificuldade em Leads B2B</h3>
                        <p>Empresas buscam parceiros contábeis que demonstrem tecnologia e eficiência logo no primeiro contato.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transformation -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2 accounting">CREDIBILIDADE 2.0</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">De Burocrático <br/> Para <span class="text-accounting">Inovador</span>.</h2>
                        <ul class="check-list mt-8">
                            <li><i class="fas fa-check"></i> Layout focado em conversão de empresas (B2B)</li>
                            <li><i class="fas fa-check"></i> SEO técnico para dominar buscas empresariais</li>
                            <li><i class="fas fa-check"></i> Integração com sistemas de atendimento</li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (ESTÁTICO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title" style="width: 70%; background: #222; height: 10px;"></div>
                                    <div class="skeleton-text" style="width: 95%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-text" style="width: 90%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-img" style="display: flex; align-items: center; justify-content: center; background: #111; border: 1px dashed #333; color: #222; font-size: 0.7rem; font-weight: 800;">IMAGE_NOT_FOUND.JPG</div>
                                    <div style="width: 80px; height: 25px; background: #222; border: 1px solid #333; margin-top: 10px;"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium">
                                <div class="card-tag flagship-accounting">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Projeto Real Contabilidade" class="project-preview-img" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos que o valor de um único honorário mensal recorrente para digitalizar seu escritório.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>BÁSICO</h3>
                            <p>Presença digital institucional</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">O MAIS COMPLETO</div>
                        <div class="head">
                            <h3>Contabilidade Autoridade</h3>
                            <p>Ecossistema de conteúdo e prospecção</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-accounting">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE B2B</h3>
                            <p>Escala total e automação de leads</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">FALAR COM ESPECIALISTA</Button>
                    </div>
                </div>
            </div>
        </section>

        <section class="final-cta-v2 py-32 text-center bg-black/50 overflow-hidden relative">
            <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Construa sua <br/> <span class="text-accounting font-outfit">Autoridade Contábil</span></h2>
            <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn-accounting uppercase font-black">Falar com especialista agora</Button>
            <div class="glow-accounting-1"></div>
        </section>
    </div>
</BaseLayout>
<style>
    .accounting-theme {
        --color-accounting: #3b82f6; /* Royal Blue for trust and corporate accounting */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background-color: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.9) 70%, black 100%); }
    .hero-content-v2 { max-width: 850px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 50px; font-size: 0.8rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: var(--color-accounting); }
    .hero-badge-v2 .dot.accounting { width: 8px; height: 8px; background: var(--color-accounting); border-radius: 50%; box-shadow: 0 0 10px var(--color-accounting); }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 2rem; }
    .text-gradient-accounting { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.25rem; color: #a0a0a0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 680px; }
    .hero-actions-v2 { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    .hero-trust { font-size: 0.85rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .hero-trust i { color: var(--color-accounting); }
    .text-accounting { color: var(--color-accounting); }
    .bg-accounting { background: var(--color-accounting) !important; color: white !important; }
    .tag-v2.accounting { color: var(--color-accounting); }
    .problem-card-v2:hover { border-color: var(--color-accounting); transform: translateY(-8px); }
    .icon-circle { width: 80px; height: 80px; background: rgba(59, 130, 246, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 2rem; border: 1px solid rgba(59, 130, 246, 0.1); }
    .check-list { display: flex; flex-direction: column; gap: 1rem; }
    .check-list li { display: flex; align-items: center; gap: 12px; color: #bbb; }
    .check-list i { color: var(--color-accounting); }
    .glow-btn-accounting { background: var(--color-accounting) !important; color: white !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(59, 130, 246, 0.3); }
    .glow-btn-accounting:hover { box-shadow: 0 15px 50px rgba(59, 130, 246, 0.5); transform: translateY(-2px); }
    .glow-accounting-1 { position: absolute; top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .stat-divider { display: none; }
        .pricing-grid-v2 { grid-template-columns: 1fr; }
        .p-card-v2.featured { transform: none; margin: 2rem 0; }
        .transformation-v2 .grid { grid-template-columns: 1fr; }

        /* Mobile fixes for comparison cards */
        .comparison-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            perspective: none;
            margin-top: 1rem;
        }
        .comparison-card.legacy, .comparison-card.premium {
            transform: none !important;
            opacity: 1 !important;
            filter: none !important;
            margin: 0 !important;
        }
        .comparison-card.premium {
            order: -1; /* Premium results first on mobile */
            border-width: 1px;
        }
    }

    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.85rem; color: #666; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255, 255, 255, 0.1); align-self: center; }

    /* Problem Cards */
    .problem-card-v2 { background: var(--color-accent); padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.05); transition: all 0.4s ease; text-align: center; }
    .problem-card-v2 h3 { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; }
    .problem-card-v2 p { color: #cecece; line-height: 1.6; }

    /* Transformation & Points */
    .bg-dark-accent { background-color: #080808; }
    .tag-v2 { font-weight: 900; font-size: 0.8rem; letter-spacing: 3px; text-transform: uppercase; display: block; margin-bottom: 1rem; }
    .point-item { display: flex; gap: 1rem; padding: 1.5rem; background: rgba(255, 255, 255, 0.02); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.05); }
    .point-icon { font-size: 1.25rem; color: var(--color-primary); }
    .point-text { font-size: 1rem; color: #999; line-height: 1.5; text-align: left; }
    .point-text strong { display: block; color: white; margin-bottom: 4px; }

    /* Advanced Transformation Styles */
    .comparison-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
        perspective: 1500px;
        margin-top: 2rem;
    }

    .comparison-card {
        background: #0f0f0f;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
        transition: all 0.8s cubic-bezier(0.23, 1, 1, 1);
        width: 100%;
        aspect-ratio: 16 / 9;
        display: flex;
        flex-direction: column;
    }

    .comparison-card.legacy {
        opacity: 0.35;
        transform: scale(0.9) rotateY(15deg) translateX(-30px);
        filter: grayscale(1) blur(1px);
        z-index: 1;
    }

    .comparison-card.premium {
        z-index: 3;
        border: 2px solid var(--color-accounting);
        box-shadow: 0 0 100px rgba(59, 130, 246, 0.15);
        transform: scale(1.1) rotateY(-10deg) translateX(30px) translateY(-20px);
    }

    .comparison-card:hover {
        transform: scale(1.05) translateZ(50px) !important;
        z-index: 10;
        opacity: 1 !important;
        filter: none !important;
    }

    .card-tag {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 15;
        padding: 6px 14px;
        font-size: 0.65rem;
        font-weight: 950;
        border-radius: 6px;
        background: rgba(0,0,0,0.8);
        color: white;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .card-tag.flagship-accounting {
        background: var(--color-accounting);
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    }

    .card-browser-mockup {
        height: 40px;
        background: #111;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 25px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .browser-dot-red { width: 10px; height: 10px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 10px; height: 10px; border-radius: 50%; background: #27c93f; }

    .legacy-content { 
        padding: 2rem; 
        display: flex; 
        flex-direction: column; 
        gap: 1rem; 
        background: #080808;
        flex-grow: 1;
        justify-content: center;
    }
    .skeleton-title { height: 12px; width: 35%; background: #222; border-radius: 2px; }
    .skeleton-text { height: 6px; width: 85%; background: #1a1a1a; border-radius: 1px; }
    .skeleton-text.short { width: 25%; }
    .skeleton-img { height: 140px; width: 100%; background: #151515; border-radius: 8px; border: 1px dashed #222; margin-top: 1rem; }

    .project-preview-img { 
        width: 100%; 
        height: 100%;
        object-fit: cover;
        display: block; 
        filter: brightness(1.05);
        transition: transform 0.8s ease;
        flex-grow: 1;
    }

    @media (min-width: 1024px) {
        .comparison-container { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            align-items: center; 
            gap: 0; 
        }
        .comparison-card.legacy { 
            transform: translateX(60px) scale(0.85) rotateY(20deg);
        }
        .comparison-card.premium { 
            transform: scale(1.15) rotateY(-15deg) translateX(-20px);
            box-shadow: 0 60px 120px rgba(0,0,0,0.9);
        }
    }
    .reveal-up { opacity: 1 !important; }
</style>

