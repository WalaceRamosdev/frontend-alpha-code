---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";

const painPoints = [
    {
        icon: "📉",
        title: "Perda de Clientes para o Digital",
        desc: "Escritórios de contabilidade online estão crescendo porque oferecem uma experiência digital que você ainda não tem.",
    },
    {
        icon: "🏢",
        title: "Imagem Burocrática",
        desc: "Seu site atual (ou a falta de um) transmite uma imagem de empresa antiga e pouco tecnológica.",
    },
    {
        icon: "⚖️",
        title: "Dificuldade em Leads B2B",
        desc: "Empresas modernas buscam parceiros contábeis que falem a língua da tecnologia e eficiência.",
    },
];

const benefits = [
    {
        icon: "🛡️",
        title: "Autoridade e Confiança Corporativa",
        desc: "Um posicionamento digital que transmite a segurança necessária para gerir o patrimônio do seu cliente.",
    },
    {
        icon: "⚙️",
        title: "Eficiência no Atendimento",
        desc: "Centralize documentos e facilite o contato inicial através de formulários e botões inteligentes.",
    },
    {
        icon: "📊",
        title: "Visibilidade Estratégica",
        desc: "Seja encontrado por empresários que buscam uma contoria contábil de excelência no Google.",
    },
];
---

<BaseLayout
    title="Marketing Contábil e Sites para Contadores | Alpha Code"
    description="Digitalize seu escritório de contabilidade. Sites modernos, eficientes e focados em prospecção de clientes B2B qualificados."
    showHeader={true}
    showSocialProof={true}
>
    <!-- animations script same -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);
        document.addEventListener("astro:page-load", () => {
            gsap.to(".hero-bg-image", { scrollTrigger: { trigger: ".hero-lp-v2", start: "top top", scrub: true }, y: 100, opacity: 0.4 });
            document.querySelectorAll(".reveal-up").forEach((el) => { gsap.from(el, { scrollTrigger: { trigger: el, start: "top 90%" }, y: 40, opacity: 0, duration: 1, ease: "power3.out" }); });
            gsap.from(".stagger-card", { scrollTrigger: { trigger: ".stagger-container", start: "top 80%" }, y: 60, opacity: 0, duration: 0.8, stagger: 0.15 });
        });
    </script>

    <div class="niche-page accounting-theme">
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/contadores-hero.png" alt="Escritório de Contabilidade Moderno" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot accounting"></span> ESTRATÉGIA DIGITAL PARA ESCRITÓRIOS DE CONTABILIDADE
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua Contabilidade na <br/> <span class="text-gradient-accounting">Era da Eficiência</span>.
                    </h1>
                    <p class="hero-sub-v2 reveal-up">
                        Não deixe seu escritório ficar para trás. Tenha uma presença digital que transmite segurança absoluta e atrai empresas que buscam uma parceria contábil moderna.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button-accounting uppercase">Digitalizar meu Escritório</Button>
                        <div class="hero-trust">
                            <i class="fas fa-shield-alt"></i> Foco em Segurança, Credibilidade e Resultados B2B
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">99.9%</span>
                        <span class="stat-txt">Uptime de Sistemas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+1k</span>
                        <span class="stat-txt">Empresas Impactadas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">A+</span>
                        <span class="stat-txt">Autoridade Digital</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problems -->
        <section class="problem-v2 py-24">
            <div class="container text-center">
                <h2 class="reveal-up text-4xl md:text-5xl font-black mb-16">O mercado contábil <span class="text-accounting">mudou</span>. E você?</h2>
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-accounting-sm"><i class="fas fa-chart-line-down text-accounting"></i></div>
                        <h3>Perda para o Digital</h3>
                        <p>Contabilidades online crescem porque oferecem uma experiência digital que seu escritório ainda não tem.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-accounting-sm"><i class="fas fa-building text-accounting"></i></div>
                        <h3>Imagem Burocrática</h3>
                        <p>Seu site atual transmite uma imagem de empresa estagnada, o que afasta novos empresários modernos.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-accounting-sm"><i class="fas fa-user-tie text-accounting"></i></div>
                        <h3>Dificuldade em Leads B2B</h3>
                        <p>Empresas buscam parceiros contábeis que demonstrem tecnologia e eficiência logo no primeiro contato.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transformation -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2 accounting">CREDIBILIDADE 2.0</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">De Burocrático <br/> Para <span class="text-accounting">Inovador</span>.</h2>
                        <ul class="check-list mt-8">
                            <li><i class="fas fa-check"></i> Layout focado em conversão de empresas (B2B)</li>
                            <li><i class="fas fa-check"></i> SEO técnico para dominar buscas empresariais</li>
                            <li><i class="fas fa-check"></i> Integração com sistemas de atendimento</li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (ESTÁTICO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title"></div>
                                    <div class="skeleton-text"></div>
                                    <div class="skeleton-text short"></div>
                                    <div class="skeleton-img"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium bord-accounting">
                                <div class="card-tag flagship-accounting">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Projeto Real Contabilidade" class="project-preview-img" />
                                <div class="project-info-overlay">
                                    <strong>Flagship: Nexus Contabilidade</strong>
                                    <span>Gestão e Eficiência Digital</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos que o valor de um único honorário mensal recorrente para digitalizar seu escritório.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>BÁSICO</h3>
                            <p>Presença digital institucional</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">O MAIS COMPLETO</div>
                        <div class="head">
                            <h3>Contabilidade Autoridade</h3>
                            <p>Ecossistema de conteúdo e prospecção</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-accounting">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE B2B</h3>
                            <p>Escala total e automação de leads</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">FALAR COM ESPECIALISTA</Button>
                    </div>
                </div>
            </div>
        </section>

        <section class="final-cta-v2 py-32 text-center bg-black/50 overflow-hidden relative">
            <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Construa sua <br/> <span class="text-accounting font-outfit">Autoridade Contábil</span></h2>
            <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn-accounting uppercase font-black">Falar com especialista agora</Button>
            <div class="glow-accounting-1"></div>
        </section>
    </div>
</BaseLayout>
<style>
    .accounting-theme {
        --color-accounting: #3b82f6; /* Royal Blue for trust and corporate accounting */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
    }

    /* Advanced Transformation Styles */
    .comparison-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
    }

    .comparison-card {
        background: #0f0f0f;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
        box-shadow: 0 40px 80px rgba(0,0,0,0.4);
    }

    .comparison-card.legacy {
        opacity: 0.6;
        transform: scale(0.95);
        filter: grayscale(0.2);
    }

    .comparison-card.premium {
        z-index: 2;
        border: 2px solid var(--color-accounting);
    }

    .card-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
        padding: 4px 10px;
        font-size: 0.65rem;
        font-weight: 900;
        border-radius: 4px;
        background: rgba(0,0,0,0.8);
        color: white;
        text-transform: uppercase;
        letter-spacing: 1px;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .card-tag.flagship-accounting { background: var(--color-accounting); color: white; border: none; }

    .card-browser-mockup {
        height: 30px;
        background: #222;
        display: flex;
        align-items: center; gap: 6px; padding-left: 15px; border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .browser-dot-red { width: 8px; height: 8px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 8px; height: 8px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 8px; height: 8px; border-radius: 50%; background: #27c93f; }

    .legacy-content { padding: 3rem; display: flex; flex-direction: column; gap: 1rem; }
    .skeleton-title { height: 20px; width: 60%; background: #333; border-radius: 4px; }
    .skeleton-text { height: 12px; width: 90%; background: #222; border-radius: 4px; }
    .skeleton-text.short { width: 40%; }
    .skeleton-img { height: 100px; width: 100%; background: #222; border-radius: 8px; margin-top: 1rem; }

    .project-preview-img { 
        width: 100%; 
        height: auto; 
        display: block; 
        filter: brightness(1.05); 
        transition: transform 0.5s ease;
    }

    .comparison-card.premium::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 50%;
        height: 100%;
        background: linear-gradient(
            to right,
            transparent,
            rgba(255, 255, 255, 0.1),
            transparent
        );
        transform: skewX(-25deg);
        transition: 0.7s;
        pointer-events: none;
    }

    .comparison-card.premium:hover::after {
        left: 150%;
        transition: 0.7s;
    }

    .project-info-overlay {
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(15, 15, 15, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 12px 20px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        display: flex;
        flex-direction: column;
        gap: 2px;
        transform: translateY(0);
        transition: transform 0.3s ease;
    }

    .project-info-overlay strong { 
        display: block; 
        font-size: 0.95rem; 
        font-family: var(--font-heading);
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    .project-info-overlay span { 
        font-size: 0.7rem; 
        color: var(--color-accounting); 
        font-weight: 900; 
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .problem-card-v2 p { color: #cecece; line-height: 1.6; }
    .shadow-accounting-sm { box-shadow: 0 0 20px rgba(59, 130, 246, 0.1); }
    .bord-accounting { border: 2px solid var(--color-accounting) !important; }

    @media (min-width: 1024px) {
        .comparison-container { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 0; }
        .comparison-card.legacy { transform: translateX(30px) scale(0.9); z-index: 1; }
        .comparison-card.premium { transform: scale(1.05); }
    }
    .reveal-up { opacity: 1; }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll(".reveal-up").forEach((el) => {
            gsap.from(el, {
                scrollTrigger: {
                    trigger: el,
                    start: "top 90%",
                },
                y: 40,
                opacity: 0,
                duration: 1,
                ease: "power3.out"
            });
        });
    });
</script>
