---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const slug = "contadores";

const faq = [
    {
        q: "Em quanto tempo o site fica pronto?",
        a: "Em poucos dias o seu escritório já pode estar online e pronto para receber contatos comerciais qualitativos."
    },
    {
        q: "Vou aparecer no Google?",
        a: "Sim. A aplicação de técnicas de SEO contábil garante que o empresário que busca por redução de custos tributários na região encontre o seu site rapidamente."
    },
    {
        q: "Preciso ter conteúdo pronto?",
        a: "Não é necessário. Estruturamos toda a copy de vendas para destacar as áreas do seu escritório (Fiscal, Contábil, DP e Legalização) com foco em B2B."
    },
    {
        q: "O site funciona bem no celular?",
        a: "Absolutamente. Como a maioria da prospecção hoje ocorre via dispositivos móveis, o site é estruturado para funcionar de forma leve e responsiva no celular."
    }
];
---

<BaseLayout
    title="Site para Contadores: Escala Digital e Captação B2B"
    description="Digitalize seu escritório e atraia boas empresas. Site para contadores focado em prospecção ativa de clientes e autoridade corporativa no Google."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="contadores" slot="head" />

    <div class="niche-page accounting-theme">
        
        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/contadores-hero.webp" alt="Escritório de Contabilidade Estratégico" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> MARKETING CONTÁBIL B2B
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Atraia empresas todos os dias com um <span class="text-gradient">site profissional para contadores</span>
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Crie uma presença online que transmite segurança corporativa, elimina objeções e faz com que empresários que buscam uma assessoria de excelência encontrem você no Google.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero modernizar meu escritório e atrair novas empresas." variant="primary" size="lg" class="glow-button px-8">👉 QUERO MAIS CLIENTES B2B</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">FALAR NO WHATSAPP</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">B2B</span>
                        <span class="stat-txt">Foco em Empresas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+95</span>
                        <span class="stat-txt">Escritórios Digitalizados</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">TOP 1</span>
                        <span class="stat-txt">Autoridade Local</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">A sua entrega contábil é impecável... <br/> <span class="text-primary italic">mas por que está difícil captar novas empresas?</span></h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-acc-sm"><i class="fas fa-hand-holding-usd text-primary"></i></div>
                        <h3>Dificuldade na Captação</h3>
                        <p>O fluxo de entrada de novos CNPJs não fecha a conta do investimento na estrutura do escritório mensalmente.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-acc-sm"><i class="fas fa-users text-primary"></i></div>
                        <h3>Dependência de Indicação</h3>
                        <p>Uma carteira estagnada: você só cresce quando um cliente satisfeito lembra de você.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-acc-sm"><i class="fas fa-laptop-house text-primary"></i></div>
                        <h3>Concorrência Online (Low Cost)</h3>
                        <p>Contabilidades 100% online estão crescendo de forma agressiva por terem uma aparência corporativa melhor que a sua.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-acc-sm"><i class="fas fa-eye-slash text-primary"></i></div>
                        <h3>Invisibilidade do Honorário</h3>
                        <p>Dificuldade de ser visto como um parceiro estratégico. Você se sente refém da "guerra de honorários".</p>
                    </div>
                </div>
                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-2xl">
                        <p class="text-2xl font-bold">💡 O mercado mudou: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">se você não tem uma fachada digital de confiança, empresa nenhuma entrega o patrimônio a você.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">A TRANSIÇÃO ESTRATÉGICA</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Nós criamos um <span class="text-primary">site estratégico para contabilidades</span> focado em fechamento de empresas.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Seu escritório passa a:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🚀</span> Aparecer no Google quando as empresas locais buscam por trocar de contador
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🏢</span> Transmitir governança, transparência e alta infraestrutura
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">📲</span> Facilitar a solicitação de proposta já de forma qualificada 
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🎯</span> Converter tráfego corporativo em clientes que pagam bem
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">CONTÁBIL ELITE PRO</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img loading="lazy" src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Exemplo site contábil" class="project-preview-img" style="filter: brightness(1.1);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Saúde Financeira para seu Negócio</h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Aumento no fluxo de empresas pedindo contato</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Carteira preenchida com tickets mais altos</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Menor dependência de indicações lentas</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Presença B2B absolutamente inquestionável</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Autoridade reconhecida como consultoria contábil</h4>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="process-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl font-black">Como operamos</h2>
                </div>
                <div class="grid md:grid-cols-4 gap-8 stagger-container">
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">1</div>
                        <h4>Análise do Escritório</h4>
                        <p>Checamos seu foco (lucro real, simples, indústrias, clínicas) para o posicionamento.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">2</div>
                        <h4>Construímos o Site Comercial</h4>
                        <p>Layout pensado exclusivamente para gerar segurança corporativa aos decisores.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">3</div>
                        <h4>Engenharia de Buscas</h4>
                        <p>Utilizamos SEO para contadores para bater a concorrência na primeira página do Google.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">4</div>
                        <h4>Motor de Novas Mensalidades</h4>
                        <p>O site passa a rodar para apresentar sua proposta e fechar contratos diários.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Difference Section -->
        <section class="differences py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Não criamos cartilhas de contabilidade.</h2>
                        <p class="text-xl text-gray-400 mb-8">Construímos portais estratégicos B2B, com foco em:</p>
                        <ul class="diff-list space-y-4">
                            <li class="flex items-center gap-3">
                                <div class="dot-acc"></div> Foco em vendas de serviços contábeis
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-acc"></div> Demonstração da conformidade legal e expertise de negócio
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-acc"></div> Funis de contato projetados para gestores financeiros e CEOs
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-acc"></div> Uma experiência ágil que mostra valor tecnológico imediato
                            </li>
                        </ul>
                    </div>
                    <div class="reveal-up bg-white/5 p-12 rounded-3xl border border-primary/20">
                        <h3 class="text-3xl font-black mb-6">🔥 Mas vale o investimento?</h3>
                        <p class="text-lg text-gray-300 mb-8">Um único contrato mensal conquistado pelo site já retorna todo o investimento nele. Nós construímos isso para:</p>
                        <div class="flex flex-col gap-4">
                            <span class="badge-v3">👉 ATIRAR A EMPRESA IDEAL</span>
                            <span class="badge-v3">👉 CONVENCER PELO EXPERTISE E SEGURANÇA</span>
                            <span class="badge-v3">👉 GERAR CONTATO COM DIRETORES</span>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero atrair empresas de alto valor para meu escritório contábil." variant="primary" class="w-full mt-10 glow-button py-6 text-xl">🚀 QUERO ESCALAR MEU ESCRITÓRIO</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Dúvidas Frequentes</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">O crescimento do seu <br/> escritório <span class="text-primary font-outfit">agora é digital.</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button px-10">👉 QUERO MAIS CLIENTES B2B</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">SOLICITAR ANÁLISE DO MEU ESCRITÓRIO</Button>
                </div>
            </div>
            <div class="glow-blur-acc"></div>
        </section>

        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert prose-blue">
                <h2 class="text-3xl font-black text-white">Domine o polo empresarial com excelente <span class="text-primary">site para contadores</span></h2>
                <p>Nenhuma empresa confia suas notas fiscais, faturamentos e planejamentos tributários a um escritório que aparenta estar parado no tempo. Fazer um <strong>site para contadores</strong> focado em B2B é separar sua empresa daqueles que apenas recebem malotes. O diferencial do investimento reside na <strong>criação de sites para contabilidades</strong> estruturados ativamente para <strong>atrair clientes contabilidade</strong> corporativos. É o marketing reverso perfeito: em vez de implorar por atenção, você se torna a escolha óbvia na busca orgânica.</p>
                <p>Garantimos a estrutura robusta que a contabilidade requer. Usando tecnologia como o Astro.js, entregamos sites estritamente rápidos, livres das tradicionais lentidões que amedrontam CEOs ao acessarem a página. O seu escritório ganha uma base sólida online e você deixa de perder capital intelectual tentando resolver marketing. Você passa a ter uma máquina que capta as avaliações comerciais e transforma-as em novos repasses mensuráveis na sua folha contábil.</p>
                
                <!-- Internal Linking -->
                <div class="mt-12 pt-8 border-t border-white/10 not-prose">
                    <h3 class="text-xl font-bold text-white mb-4">Leia no nosso Blog:</h3>
                    <ul class="flex flex-col gap-2 text-gray-400 font-medium mb-8">
                        <li><a href="/blog/psicologos-perdem-pacientes-por-falta-de-site" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Guia completo: Por que psicólogos perdem pacientes?</a></li>
                        <li><a href="/blog/como-o-seo-local-coloca-seu-consultorio-na-frente-da-concorrencia" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Como o SEO Local traz mais pacientes</a></li>
                        <li><a href="/blog/landing-page-vs-site-institucional-qual-o-melhor-para-converter-leads" class="hover:text-primary transition-colors flex items-center gap-2"><span class="text-primary">→</span> Landing Page vs Site Institucional</a></li>
                    </ul>

                    <h3 class="text-xl font-bold text-white mb-4">Conheça outras Soluções Alpha Code:</h3>
                    <ul class="flex flex-wrap gap-4 text-sm text-gray-500 font-medium">
                        <li><a href="/solucoes/advogados" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Advogados</a></li>
                        <li><a href="/solucoes/medicos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Médicos</a></li>
                        <li><a href="/solucoes/dentistas" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Dentistas</a></li>
                        <li><a href="/solucoes/psicologos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Psicólogos</a></li>
                        <li><a href="/solucoes/arquitetos" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2">Sites para Arquitetos</a></li>
                        <li><a href="/solucoes/contadores" class="hover:text-white transition-colors border border-white/10 rounded-full px-4 py-2 bg-white/5 text-white">Sites para Contadores</a></li>
                    </ul>
                </div>
            </div>
        </section>

    </div>
</BaseLayout>

<style>
    .accounting-theme {
        --color-primary: #3b82f6; /* Royal Blue */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.5); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.85) 70%, black 100%); }
    .hero-content-v2 { max-width: 900px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 50px; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: #60a5fa; }
    .hero-badge-v2 .dot { width: 8px; height: 8px; background: #3b82f6; border-radius: 50%; box-shadow: 0 0 10px #3b82f6; }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1.0; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 2rem; }
    .text-gradient { background: linear-gradient(135deg, #93c5fd, #2563eb); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.3rem; color: #b0b0b0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 750px; font-weight: 500; }
    
    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Cards */
    .problem-card-v2 { background: #0c0c0c; padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; }
    .problem-card-v2:hover { border-color: var(--color-primary); transform: translateY(-10px); }
    .icon-circle { width: 70px; height: 70px; background: rgba(59, 130, 246, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 2rem; border: 1px solid rgba(59, 130, 246, 0.1); }
    .problem-card-v2 h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #eee; }
    .problem-card-v2 p { color: #888; line-height: 1.6; }

    .benefit-card-v3 { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; background: #0c0c0c; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .check-circle { width: 30px; height: 30px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; flex-shrink: 0; }
    .benefit-card-v3 h4 { font-size: 1.25rem; font-weight: 800; }

    .process-step-v3 .step-icon { width: 60px; height: 60px; background: rgba(255,255,255,0.05); border: 1px solid rgba(59, 130, 246, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900; margin: 0 auto 2rem; color: var(--color-primary); }
    .process-step-v3 h4 { font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem; }
    .process-step-v3 p { color: #777; line-height: 1.6; }

    .badge-v3 { padding: 12px 20px; background: rgba(59, 130, 246, 0.08); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); font-weight: 800; color: #93c5fd; font-size: 0.9rem; }
    .dot-acc { width: 8px; height: 8px; background: var(--color-primary); border-radius: 50%; }

    /* Comparison Card */
    .comparison-container { perspective: 1200px; display: flex; justify-content: center; }
    .comparison-card { background: #111; border-radius: 20px; overflow: hidden; border: 2px solid var(--color-primary); box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 40px rgba(59, 130, 246, 0.1); transform: rotateY(-15deg) rotateX(10deg); transition: 0.6s ease; width: 100%; max-width: 600px; aspect-ratio: 16/10; display: flex; flex-direction: column; }
    .comparison-card:hover { transform: none; }
    .project-preview-img { width: 100%; height: 100%; object-fit: cover; flex-grow: 1; }
    .card-tag { position: absolute; top: 20px; left: 20px; z-index: 10; background: var(--color-primary); color: white; padding: 6px 12px; font-size: 0.7rem; font-weight: 900; border-radius: 4px; box-shadow: 0 4px 15px rgba(59,130,246,0.4); text-transform: uppercase; letter-spacing: 1px; }

