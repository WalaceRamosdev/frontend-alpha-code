---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const slug = "energia-solar";

const faq = [
    {
        q: "O site vai me trazer clientes de outros estados do Brasil?",
        a: "Sim! Desenvolvemos a arquitetura de conteúdo com SEO estratégico voltado para alcance nacional, incluindo páginas específicas para cada estado ou região prioritária de atuação da sua empresa instaladora."
    },
    {
        q: "Posso exibir meus projetos e instalações já realizadas?",
        a: "Com certeza. Incluímos uma seção de portfólio profissional com fotos antes e depois, dados técnicos do sistema instalado e depoimentos de clientes reais para gerar máxima credibilidade e confiança."
    },
    {
        q: "O site explica o retorno sobre o investimento (payback) para o cliente?",
        a: "Sim! Criamos seções estratégicas que educam o cliente sobre economia na conta de luz, tempo de retorno do investimento e benefícios fiscais disponíveis, eliminando objeções antes mesmo do orçamento."
    },
    {
        q: "Funciona bem no celular e em dispositivos móveis?",
        a: "100%. Mais de 80% das buscas por instalação de energia solar são feitas via smartphone. Nosso design é mobile-first, garantindo a melhor experiência possível em qualquer tela."
    },
    {
        q: "Quanto tempo leva para o site ficar pronto?",
        a: "O prazo médio para um site para empresa de energia solar de alto padrão é de 15 a 25 dias úteis após o briefing e aprovação do design."
    },
    {
        q: "O site aparece no Google para cidades específicas?",
        a: "Sim! Aplicamos SEO local e regional avançado para que sua empresa apareça nas buscas das cidades e estados onde você atende, além de palavras-chave nacionais de alto volume."
    }
];

const estados = [
    "São Paulo", "Minas Gerais", "Rio de Janeiro", "Bahia", "Goiás",
    "Paraná", "Santa Catarina", "Rio Grande do Sul", "Pernambuco", "Ceará",
    "Espírito Santo", "Mato Grosso", "Mato Grosso do Sul", "Pará", "Maranhão"
];
---

<BaseLayout
    title="Site para Empresa de Energia Solar | Instalação de Painéis Fotovoltaicos | Alpha Code"
    description="Site profissional para empresa de energia solar e instalação de painéis fotovoltaicos. SEO nacional, alta performance e design que gera orçamentos todos os dias. Orçamento em 24h!"
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="energia-solar" slot="head" />

    <!-- JSON-LD para SEO de nicho -->
    <script type="application/ld+json" slot="scripts" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Criação de Sites para Empresas de Energia Solar",
        "provider": {
            "@type": "Organization",
            "name": "Alpha Code",
            "url": "https://www.sitesalphacode.com.br"
        },
        "description": "Sites profissionais para instaladoras de painéis solares fotovoltaicos. SEO nacional, alta performance e design focado em geração de orçamentos.",
        "areaServed": "BR",
        "serviceType": "Web Design e Desenvolvimento",
        "keywords": "site para empresa de energia solar, marketing energia solar, instalação painéis solares, site empresa fotovoltaica"
    })} />

    <div class="niche-page solar-theme">

        <!-- Breadcrumb / Back Navigation -->
        <div class="container relative z-20 pt-32 pb-4">
            <a href="/solucoes" class="hub-breadcrumb">
                <span class="icon">⇠</span> Voltar para Todas as Soluções
            </a>
        </div>

        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <div class="hero-bg-solar"></div>
                <div class="solar-rays"></div>
                <div class="hero-overlay"></div>
            </div>

            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> MARKETING DIGITAL PARA ENERGIA SOLAR
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Sua empresa de energia solar merece um site que <span class="text-gradient">vende enquanto você instala</span>
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Sites de alta performance para instaladoras de painéis fotovoltaicos. Apareça no topo do Google em todo o Brasil, gere orçamentos 24h por dia e escale suas vendas sem depender só de indicações.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero um site profissional para minha empresa de energia solar e gerar mais orçamentos." variant="primary" size="lg" class="glow-button px-8">⚡ QUERO GERAR MAIS ORÇAMENTOS</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">FALAR NO WHATSAPP</Button>
                        </div>
                    </div>
                    <div class="hero-trust hero-reveal">
                        <span class="trust-item">✓ SEO Nacional</span>
                        <span class="trust-sep">·</span>
                        <span class="trust-item">✓ Portfólio de Projetos</span>
                        <span class="trust-sep">·</span>
                        <span class="trust-item">✓ Alta Performance</span>
                        <span class="trust-sep">·</span>
                        <span class="trust-item">✓ Gerador de Orçamentos</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">+30%</span>
                        <span class="stat-txt">Crescimento Anual do Setor</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+200%</span>
                        <span class="stat-txt">Aumento de Leads</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">1seg</span>
                        <span class="stat-txt">Tempo de Carregamento</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">100</span>
                        <span class="stat-txt">PageSpeed Score</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Sua empresa instala painéis excelentes...<br/> <span class="text-primary italic">mas seus concorrentes aparecem no Google antes de você?</span></h2>
                    <p class="reveal-up text-xl text-gray-400 max-w-3xl mx-auto">Com o mercado de energia solar em explosão, quem não é encontrado online perde contratos para empresas com menor capacidade técnica, mas com presença digital superior.</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-search text-primary"></i></div>
                        <h3>Invisível no Google</h3>
                        <p>Clientes buscam "instalação painéis solares + cidade" e encontram seus concorrentes, não você.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-handshake text-primary"></i></div>
                        <h3>Dependência de Indicações</h3>
                        <p>Sem site profissional, você depende 100% de indicações e não tem como escalar o volume de orçamentos.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-trophy text-primary"></i></div>
                        <h3>Falta de Autoridade</h3>
                        <p>Clientes comparam empresas online. Um site amador passa a mensagem errada sobre a qualidade da sua instalação.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-map-marker-alt text-primary"></i></div>
                        <h3>Alcance Limitado</h3>
                        <p>Sem presença digital, você só atende quem já te conhece. Perde todo o potencial de regiões vizinhas e outros estados.</p>
                    </div>
                </div>

                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-3xl">
                        <p class="text-2xl font-bold">☀️ A realidade do setor solar é clara: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">quem não aparece no Google, não fecha o contrato.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">A SOLUÇÃO ALPHA CODE</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Criamos um <span class="text-primary">site estratégico para sua instaladora</span> que gera orçamentos todos os dias.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Sua empresa passa a:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🔍</span> Aparecer no Google para clientes em todo o Brasil
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">📋</span> Receber pedidos de orçamento 24h por dia, 7 dias por semana
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🏆</span> Transmitir autoridade e qualidade técnica antes da visita
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">📈</span> Escalar vendas sem depender apenas de indicações
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🗺️</span> Expandir para novos estados e regiões de atuação
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="solar-mockup-container">
                            <div class="solar-mockup-card">
                                <div class="mockup-header">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                    <div class="mockup-url">sitesalphacode.com.br</div>
                                </div>
                                <div class="mockup-body">
                                    <div class="mockup-hero-bar">
                                        <div class="mockup-badge">☀️ ENERGIA SOLAR PREMIUM</div>
                                        <div class="mockup-title-line wide"></div>
                                        <div class="mockup-title-line medium"></div>
                                        <div class="mockup-sub-line"></div>
                                        <div class="mockup-sub-line short"></div>
                                        <div class="mockup-cta-row">
                                            <div class="mockup-btn primary">ORÇAMENTO GRÁTIS</div>
                                            <div class="mockup-btn outline">WHATSAPP</div>
                                        </div>
                                    </div>
                                    <div class="mockup-stats-row">
                                        <div class="mockup-stat">
                                            <span class="mstat-num">500+</span>
                                            <span class="mstat-lbl">Projetos</span>
                                        </div>
                                        <div class="mockup-stat">
                                            <span class="mstat-num">15 anos</span>
                                            <span class="mstat-lbl">Experiência</span>
                                        </div>
                                        <div class="mockup-stat">
                                            <span class="mstat-num">100%</span>
                                            <span class="mstat-lbl">Garantia</span>
                                        </div>
                                    </div>
                                    <div class="mockup-cards-row">
                                        <div class="mockup-proj-card">
                                            <div class="mcard-img"></div>
                                            <div class="mcard-txt">
                                                <div class="mcard-line"></div>
                                                <div class="mcard-line short"></div>
                                            </div>
                                        </div>
                                        <div class="mockup-proj-card">
                                            <div class="mcard-img alt"></div>
                                            <div class="mcard-txt">
                                                <div class="mcard-line"></div>
                                                <div class="mcard-line short"></div>
                                            </div>
                                        </div>
                                        <div class="mockup-proj-card">
                                            <div class="mcard-img alt2"></div>
                                            <div class="mcard-txt">
                                                <div class="mcard-line"></div>
                                                <div class="mcard-line short"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mockup-glow"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <span class="tag-v2 inline-block mb-6">O QUE SEU SITE TERÁ</span>
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Tudo que uma instaladora solar precisa <br/>para dominar o mercado digital</h2>
                </div>
                <div class="features-grid">
                    <div class="feature-card reveal-up">
                        <div class="feature-icon">🔍</div>
                        <h4>SEO Nacional e Local</h4>
                        <p>Palavras-chave com alto volume de busca para todo o Brasil, mais otimização por estado, cidade e região de atuação.</p>
                    </div>
                    <div class="feature-card reveal-up">
                        <div class="feature-icon">📸</div>
                        <h4>Portfólio de Instalações</h4>
                        <p>Galeria profissional com fotos dos seus projetos, tipo do sistema, potência instalada e depoimentos dos clientes.</p>
                    </div>
                    <div class="feature-card reveal-up">
                        <div class="feature-icon">💰</div>
                        <h4>Seção de Economia</h4>
                        <p>Conteúdo estratégico que apresenta o retorno do investimento, payback e redução na conta de luz para convencer antes do orçamento.</p>
                    </div>
                    <div class="feature-card reveal-up">
                        <div class="feature-icon">📝</div>
                        <h4>Formulário de Orçamento</h4>
                        <p>Formulário inteligente integrado ao WhatsApp e e-mail, com captura de dados essenciais para pré-qualificação do lead.</p>
                    </div>
                    <div class="feature-card reveal-up">
                        <div class="feature-icon">🗺️</div>
                        <h4>Páginas por Estado</h4>
                        <p>Criação de landing pages específicas por estado e cidade para dominar a busca local em cada região que você atende.</p>
                    </div>
                    <div class="feature-card reveal-up">
                        <div class="feature-icon">⚡</div>
                        <h4>Velocidade Extrema</h4>
                        <p>Score 100 no Google PageSpeed. Sites de energia solar que carregam em menos de 1 segundo em qualquer dispositivo.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="process-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <span class="tag-v2 inline-block mb-6">O PROCESSO</span>
                    <h2 class="reveal-up text-4xl font-black">Da conversa ao site que vende: <br/>em até 25 dias úteis</h2>
                </div>
                <div class="grid md:grid-cols-4 gap-8 stagger-container">
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">1</div>
                        <h4>Briefing Estratégico</h4>
                        <p>Entendemos sua empresa, seus diferenciais, área de atuação e metas de crescimento.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">2</div>
                        <h4>Pesquisa de Palavras-chave</h4>
                        <p>Mapeamos os termos de maior volume para energia solar em cada estado que você atende.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">3</div>
                        <h4>Desenvolvimento Premium</h4>
                        <p>Design de alto padrão, código limpo e SEO técnico integralmente implementado na estrutura.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">4</div>
                        <h4>Go-Live & Resultados</h4>
                        <p>Seu site entra ao ar e começa a trabalhar por você 24h por dia, gerando orçamentos.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- National Coverage -->
        <section class="coverage-section py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">SEO NACIONAL</span>
                        <h2 class="text-4xl font-black mb-8">Dominamos as buscas por energia solar em <span class="text-primary">todo o Brasil</span></h2>
                        <p class="text-xl text-gray-400 mb-8">Criamos páginas de alta performance otimizadas para cada estado, garantindo que sua empresa apareça para clientes onde quer que eles estejam:</p>
                        <div class="estado-grid">
                            {estados.map((estado) => (
                                <div class="estado-tag">{estado}</div>
                            ))}
                            <div class="estado-tag more">+12 estados</div>
                        </div>
                    </div>
                    <div class="reveal-up bg-white/5 p-12 rounded-3xl border border-primary/20">
                        <h3 class="text-3xl font-black mb-6">🔥 Por que sites de energia solar exigem SEO nacional?</h3>
                        <p class="text-lg text-gray-300 mb-8">Empresas instaladoras de médio e grande porte atendem múltiplos estados. Sem uma estratégia de SEO nacional, você deixa de ser encontrado em mercados imensos que já estão prontos para comprar.</p>
                        <div class="flex flex-col gap-4">
                            <span class="badge-v3">🌎 CLIENTES EM QUALQUER ESTADO</span>
                            <span class="badge-v3">📊 DOMINÂNCIA NAS BUSCAS LOCAIS</span>
                            <span class="badge-v3">💼 CONTRATOS CORPORATIVOS E INDUSTRIAIS</span>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero um site para minha empresa de energia solar com SEO nacional e gerar mais orçamentos." variant="primary" class="w-full mt-10 glow-button py-6 text-xl">⚡ QUERO DOMINAR O BRASIL</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Market Types -->
        <section class="market-types py-24 bg-[#050505]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <span class="tag-v2 inline-block mb-6">SEGMENTOS ATENDIDOS</span>
                    <h2 class="reveal-up text-4xl font-black">Criamos sites para todos os segmentos do mercado solar</h2>
                </div>
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="market-card stagger-card">
                        <div class="market-icon">🏠</div>
                        <h3>Residencial</h3>
                        <p>Sites focados em famílias que querem reduzir a conta de luz e conquistar independência energética. Copy com foco em economia e retorno rápido.</p>
                        <ul class="market-list">
                            <li>✓ Página de economia estimada</li>
                            <li>✓ Simulador de payback</li>
                            <li>✓ Depoimentos de famílias</li>
                        </ul>
                    </div>
                    <div class="market-card stagger-card featured">
                        <div class="market-badge">MAIS SOLICITADO</div>
                        <div class="market-icon">🏢</div>
                        <h3>Comercial e Industrial</h3>
                        <p>Sites para atrair empresas, indústrias e comércios que buscam redução fiscal e controle do custo energético em larga escala.</p>
                        <ul class="market-list">
                            <li>✓ ROI e análise de viabilidade</li>
                            <li>✓ Projetos de médio/grande porte</li>
                            <li>✓ Formulário B2B qualificado</li>
                        </ul>
                    </div>
                    <div class="market-card stagger-card">
                        <div class="market-icon">🌾</div>
                        <h3>Rural e Agronegócio</h3>
                        <p>Sites específicos para atender propriedades rurais, fazendas e cooperativas que buscam energia solar para irrigação e operações agrícolas.</p>
                        <ul class="market-list">
                            <li>✓ SEO rural e agro</li>
                            <li>✓ Projetos off-grid e on-grid</li>
                            <li>✓ Financiamento via PRONAF</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Perguntas Frequentes</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Sua instaladora solar <br/> <span class="text-primary font-outfit">começa a vender online.</span></h2>
                <p class="reveal-up text-xl text-gray-400 max-w-2xl mx-auto mb-12">Cada dia sem um site profissional é um orçamento que seu concorrente está fechando. Comece agora.</p>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502?text=Quero um site para minha empresa de energia solar e gerar mais orçamentos!" variant="primary" size="lg" class="glow-button px-10">⚡ QUERO MEU SITE AGORA</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">SOLICITAR ANÁLISE GRATUITA</Button>
                </div>
            </div>
            <div class="glow-blur-solar"></div>
        </section>

        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert">
                <h2 class="text-3xl font-black text-white">Referência em <span class="text-primary">site para empresa de energia solar</span> no Brasil</h2>
                <p>Investir em um <strong>site profissional para empresa de energia solar</strong> é a estratégia mais inteligente que uma instaladora fotovoltaica pode fazer em 2026. O mercado de <strong>energia solar no Brasil</strong> cresce acima de 30% ao ano, e a grande maioria dos clientes inicia sua busca por uma <strong>empresa de instalação de painéis solares</strong> diretamente no Google. Sem uma presença digital sólida, sua empresa perde esses contratos para concorrentes com menor capacidade técnica, mas com melhor posicionamento online.</p>
                <p>Na Alpha Code, desenvolvemos <strong>sites para instaladoras de painéis fotovoltaicos</strong> com foco em geração de orçamentos, autoridade digital e <strong>SEO nacional para energia solar</strong>. Nossa tecnologia Astro.js garante o carregamento mais rápido do mercado — essencial para o <strong>ranqueamento no Google</strong> e para a experiência do cliente que acessa pelo celular.</p>
