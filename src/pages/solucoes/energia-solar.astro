---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import { Image } from 'astro:assets';
import heroImage from '../../assets/hybrid-solar-2026.png';
import abstractBg from '../../assets/abstract-solar-bg.png';
import { buildSEOTitle, buildSEODescription } from "../../utils/seo";

const title = buildSEOTitle("Energia Solar 2026 | Sistemas Híbridos e Antiapagão", {
    suffix: " | Alpha Infinity",
});
const description = buildSEODescription("Proteja sua empresa contra apagões e restrições de rede em 2026. Sistemas híbridos de alta performance com instalação rápida e autonomia total.");

// Dados do cenário 2026 para o FAQ
const faq = [
    {
        q: "Com a saturação da rede em estados como MT, AC e RO, ainda vale a pena instalar?",
        a: "Sim. Nossos sistemas híbridos operam com foco em autoconsumo e armazenamento. Você não depende da aprovação de injeção na rede para economizar e ter segurança."
    },
    {
        q: "Quanto tempo leva para ter energia após a contratação?",
        a: "Para projetos padrão de elite, nossa equipe garante a implementação e funcionamento básico do sistema de backup em até 48h após a chegada dos equipamentos."
    },
    {
        q: "E se faltar luz da concessionária, meu sistema para?",
        a: "Não. Nossos kits antiapagão possuem comutação automática em aproximadamente 5ms. Suas máquinas e servidores nem perceberão a queda da rede externa."
    }
];

export const prerender = false;
---

<BaseLayout
    title={title}
    description={description}
    canonicalUrl={`${Astro.site}solucoes/energia-solar`}
    showWhatsApp={true}
>
    <!-- Schema Markup JSON-LD -->
    <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Sistemas de Energia Solar de Elite 2026",
      "description": "Soluções avançadas em energia solar híbrida e kits antiapagão para empresas e indústrias.",
      "provider": {
        "@type": "Organization",
        "name": "Alpha Infinity",
        "url": "https://www.sitesalphacode.com.br"
      },
      "areaServed": "Brazil",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Soluções Solares 2026",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Sistema Híbrido Premium"
            }
          }
        ]
      }
    }
    </script>

    <main class="solar-2026-theme overflow-x-hidden">
        
        <!-- 1. HERO SECTION (A Primeira Impressão) -->
        <section class="relative min-height-screen flex items-center pt-32 pb-20 md:pt-48 md:pb-32 hero-solar-bg overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div class="fade-up">
                        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 px-4 py-1.5 rounded-full text-amber-500 text-xs font-black mb-6 tracking-widest uppercase">
                            ⚡ SOLUÇÃO ANTICRISE ENERGÉTICA 2026
                        </div>
                        <h1 class="font-display text-4xl md:text-6xl font-black leading-tight mb-6 text-white">
                            Proteja sua Casa e Empresa contra <span class="text-amber-500">Apagões e Restrições</span> da Rede em 2026.
                        </h1>
                        <p class="text-lg md:text-xl text-slate-400 mb-8 max-w-xl leading-relaxed">
                            Implemente Sistemas Híbridos com comutação de 5ms e garanta autonomia total enquanto sua conta de luz cai 95%. <strong class="text-white">Projetos de elite entregues em 48h.</strong>
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 mb-10">
                            <Button href="https://wa.me/5521999064502?text=Quero simular minha economia e segurança com o sistema solar 2026" variant="primary" size="lg" class="cta-solar text-xl py-6 px-10 shadow-2xl shadow-amber-500/20">
                                SIMULAR ECONOMIA E SEGURANÇA AGORA
                            </Button>
                        </div>
                    </div>
                    <div class="relative lg:block hidden">
                        <div class="glass-solar p-4 rounded-3xl border-white/10 shadow-2xl relative z-10">
                            <Image 
                                src={heroImage} 
                                alt="Sistemas Solares Híbridos 2026 - Alpha Infinity" 
                                width={800}
                                height={450}
                                loading="eager"
                                fetchpriority="high"
                                class="rounded-2xl w-full h-auto shadow-glow-amber"
                            />
                            <!-- Overlay de status -->
                            <div class="absolute bottom-10 left-10 right-10 bg-black/80 backdrop-blur-md p-6 rounded-2xl border border-amber-500/30 flex justify-between items-center animate-pulse">
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                                    <span class="text-xs font-bold text-white uppercase tracking-tighter">Status da Rede: Estável (Bateria Ativa)</span>
                                </div>
                                <div class="text-amber-500 font-black text-sm">95% Economia</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Glow background -->
            <div class="absolute top-0 right-0 w-1/3 h-full bg-amber-500/5 blur-[120px] pointer-events-none"></div>
        </section>

        <!-- 2. SEÇÃO DE AUTORIDADE IMEDIATA (O "Porquê Agora") -->
        <section class="py-24 bg-zinc-950 border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="fade-up">
                        <h2 class="font-display text-3xl md:text-5xl font-black mb-8 leading-tight text-white underline decoration-amber-500/30">
                            O Cenário Energético de Maio 2026: <br/> <span class="text-amber-500 italic">Por que esperar é perigoso?</span>
                        </h2>
                        <p class="text-slate-400 text-lg mb-8 leading-relaxed">
                            O Brasil atingiu um ponto de saturação crítica. Enquanto o setor solar investiu R$ 300 bilhões, a infraestrutura da rede não acompanhou.
                        </p>
                    </div>
                    <div class="grid gap-6 fade-up">
                        <div class="flex gap-5 p-6 rounded-3xl bg-white/5 border border-white/5 hover:border-amber-500/30 transition-all group">
                            <div class="w-12 h-12 bg-amber-500/20 rounded-full flex items-center justify-center flex-shrink-0 text-amber-500 group-hover:bg-amber-500 group-hover:text-black transition-all">⚠️</div>
                            <div>
                                <h4 class="text-white font-bold mb-1">Atrasos Sistêmicos</h4>
                                <p class="text-sm text-slate-400 font-medium">327 projetos solares de grande porte com atrasos críticos na conexão à rede.</p>
                            </div>
                        </div>
                        <div class="flex gap-5 p-6 rounded-3xl bg-white/5 border border-white/5 hover:border-amber-500/30 transition-all group">
                            <div class="w-12 h-12 bg-amber-500/20 rounded-full flex items-center justify-center flex-shrink-0 text-amber-500 group-hover:bg-amber-500 group-hover:text-black transition-all">🚫</div>
                            <div>
                                <h4 class="text-white font-bold mb-1">Restrições Geográficas</h4>
                                <p class="text-sm text-slate-400 font-medium">Estados como MT, AC e RO já apresentam restrições severas para novas injeções na rede.</p>
                            </div>
                        </div>
                        <div class="flex gap-5 p-6 rounded-3xl bg-white/5 border border-white/5 hover:border-amber-500/30 transition-all group">
                            <div class="w-12 h-12 bg-amber-500/20 rounded-full flex items-center justify-center flex-shrink-0 text-amber-500 group-hover:bg-amber-500 group-hover:text-black transition-all">💎</div>
                            <div>
                                <h4 class="text-white font-bold mb-1">Investimento Recorde</h4>
                                <p class="text-sm text-slate-400 font-medium">R$ 300 bilhões investidos tornam a energia solar o ativo mais valioso de 2026.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. SOLUÇÕES SEGMENTADAS (Clareza Técnica) -->
        <section class="py-24 bg-black">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16 fade-up">
                    <h2 class="font-display text-3xl md:text-5xl font-black mb-4 text-white">Engenharia Solar de Alta Performance</h2>
                    <p class="text-slate-500 text-lg">Soluções sob medida para quem não pode parar.</p>
                </div>
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Card A -->
                    <div class="p-8 rounded-[32px] border border-amber-500/20 bg-amber-500/5 relative group fade-up overflow-hidden flex flex-col">
                        <div class="absolute -top-10 -right-10 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl"></div>
                        <div class="mb-auto">
                            <span class="inline-block bg-amber-500 text-black px-3 py-1 rounded-lg text-[10px] font-black mb-6 uppercase">Recomendado</span>
                            <h3 class="text-2xl font-black text-white mb-4">Sistema Híbrido</h3>
                            <p class="text-slate-400 text-sm mb-8 leading-relaxed">
                                O melhor de 2026: Economia máxima da rede + Backup inteligente por baterias. Ideal para contornar restrições da concessionária.
                            </p>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero saber mais sobre o sistema Híbrido" variant="outline" class="w-full border-amber-500/50 text-amber-500 hover:bg-amber-500 hover:text-black mt-4">SIMULAR HÍBRIDO</Button>
                    </div>
                    <!-- Card B -->
                    <div class="p-8 rounded-[32px] border border-white/5 bg-zinc-900/50 relative group fade-up flex flex-col">
                        <div class="mb-auto">
                            <h3 class="text-2xl font-black text-white mb-4">Sistema Off-Grid</h3>
                            <p class="text-slate-400 text-sm mb-8 leading-relaxed">
                                Independência Total. Perfeito para o agronegócio e locais remotos onde a rede é instável ou inexistente. Autonomia 100%.
                            </p>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero saber mais sobre o sistema Off-Grid" variant="outline" class="w-full border-white/20 text-white hover:bg-white hover:text-black mt-4">SOU OFF-GRID</Button>
                    </div>
                    <!-- Card C -->
                    <div class="p-8 rounded-[32px] border border-white/5 bg-zinc-900/50 relative group fade-up flex flex-col">
                        <div class="mb-auto">
                            <h3 class="text-2xl font-black text-white mb-4">Kit Antiapagão</h3>
                            <p class="text-slate-400 text-sm mb-8 leading-relaxed">
                                Comutação em ~5ms. Proteja data centers e equipamentos críticos. Suas luzes continuam acesas quando a cidade apaga.
                            </p>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero saber mais sobre o Kit Antiapagão" variant="outline" class="w-full border-white/20 text-white hover:bg-white hover:text-black mt-4">PROTEGER MINHA EMPRESA</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. PROVA SOCIAL ESPECÍFICA (Case de Sucesso) -->
        <section class="py-24 bg-zinc-950">
            <div class="max-w-7xl mx-auto px-6">
                <div class="bg-gradient-to-br from-amber-500/10 to-transparent p-8 md:p-16 rounded-[48px] border border-amber-500/20 flex flex-col md:flex-row gap-12 items-center fade-up">
                    <div class="w-48 h-48 rounded-3xl overflow-hidden shadow-2xl flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=400&q=80" alt="Empresário Satisfeito" class="w-full h-full object-cover">
                    </div>
                    <div>
                        <div class="flex text-amber-500 mb-4">★★★★★</div>
                        <p class="text-xl md:text-2xl text-white font-medium italic mb-8 leading-relaxed">
                            "Em Cuiabá, perdíamos quase R$ 50 mil por mês devido a oscilações e quedas de rede que paravam a produção. Com o Sistema Híbrido da Alpha, nossa economia foi imediata e o backup de baterias salvou nossa operação três vezes só no último mês."
                        </p>
                        <div class="flex flex-wrap gap-8">
                            <div>
                                <div class="text-amber-500 font-black text-2xl">40%</div>
                                <div class="text-[10px] uppercase text-slate-500 font-bold tracking-widest">Redução de Custos Extras</div>
                            </div>
                            <div>
                                <div class="text-amber-500 font-black text-2xl">0h</div>
                                <div class="text-[10px] uppercase text-slate-500 font-bold tracking-widest">Tempo de Interrupção</div>
                            </div>
                            <div>
                                <div class="text-white font-bold">Roberto Silva</div>
                                <div class="text-xs text-slate-500 uppercase">Diretor Industrial - MT</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. QUEBRA DE OBJEÇÕES (FAQ Inteligente) -->
        <section class="py-24 bg-black border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <div class="text-center mb-16 fade-up">
                    <h2 class="font-display text-3xl md:text-4xl font-black mb-4 text-white">Dúvidas Cruciais</h2>
                </div>
                <div class="space-y-6">
                    {faq.map((item, index) => (
                        <details class="group bg-zinc-900/50 border border-white/5 rounded-3xl overflow-hidden fade-up" style={`animation-delay: ${index * 0.1}s`}>
                            <summary class="flex justify-between items-center p-8 cursor-pointer list-none">
                                <span class="font-bold text-white md:text-lg pr-8">{item.q}</span>
                                <span class="text-amber-500 transition-transform group-open:rotate-180">▼</span>
                            </summary>
                            <div class="px-8 pb-8 text-slate-400 leading-relaxed text-sm md:text-base">
                                {item.a}
                            </div>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- 6. RODAPÉ COM CTA FINAL E GARANTIA -->
        <section class="py-32 relative bg-gradient-to-t from-amber-500/10 to-black overflow-hidden text-center">
            <div class="max-w-4xl mx-auto px-6 relative z-10 fade-up">
                <h2 class="font-display text-4xl md:text-6xl font-black mb-8 text-white">Não espere o próximo <span class="text-amber-500">apagão</span>.</h2>
                <p class="text-xl text-slate-400 mb-12">
                    Garantimos seu projeto de elite no ar e funcionando. Sem burocracia excessiva, apenas engenharia de ponta.
                </p>
                <div class="flex flex-col items-center gap-6">
                    <Button href="https://wa.me/5521999064502?text=Quero minha proposta personalizada de energia solar" variant="primary" size="lg" class="cta-solar px-12 py-6 text-2xl shadow-3xl shadow-amber-500/40">
                        QUERO MINHA PROPOSTA PERSONALIZADA
                    </Button>
                    <div class="flex items-center gap-8 text-[10px] text-slate-500 font-black uppercase tracking-widest">
                        <span>✓ Implantação em 48h</span>
                        <span>✓ Suporte de Elite 24/7</span>
                        <span>✓ Garantia Risco Zero</span>
                    </div>
                </div>
            </div>
            <!-- Glow blur footer -->
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-amber-500/10 blur-[120px] rounded-full"></div>
        </section>
    </main>
</BaseLayout>

<style>
    /* Design Tokens Energia Solar 2026 */
    .solar-2026-theme {
        --amber: #f59e0b;
        --amber-glow: rgba(245, 158, 11, 0.4);
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #000;
    }

    .font-display { font-family: 'Outfit', sans-serif; }

    .min-height-screen { min-height: 100vh; }

    .hero-solar-bg {
        background: 
            linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 100%),
            url('/assets/abstract-solar-bg.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .glass-solar {
        background: rgba(20, 20, 20, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .cta-solar {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
        color: #000 !important;
        font-weight: 900 !important;
        border: none !important;
    }

    .shadow-glow-amber {
        box-shadow: 0 0 60px rgba(245, 158, 11, 0.1);
    }

    /* Scroll Animations */
    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Typography Responsive */
    @media (max-width: 768px) {
        .max-w-7xl { padding-left: 20px; padding-right: 20px; }
        h1 { line-height: 1.1; }
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
        .fade-up, .animate-pulse {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
