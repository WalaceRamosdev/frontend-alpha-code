---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const painPoints = [
    {
        icon: "🦷",
        title: "Dependência de Convênios",
        desc: "Você trabalha muito atendendo planos, mas o lucro real nas consultas particulares é baixo.",
    },
    {
        icon: "📉",
        title: "Cadeira Vazia",
        desc: "Seus horários nobres estão vagos porque você não é encontrado por quem busca estética dental.",
    },
    {
        icon: "🏢",
        title: "Visual Amador",
        desc: "Seu site atual (ou a falta de um) não reflete a tecnologia e cuidado que você tem no consultório.",
    },
];

const benefits = [
    {
        icon: "✨",
        title: "Foco em Estética e Alto Valor",
        desc: "Atraia pacientes para procedimentos de ticket alto como lentes de contato e implantes.",
    },
    {
        icon: "🎯",
        title: "Autoridade Local Imediata",
        desc: "Seja o dentista número 1 no Google quando buscarem por especialistas em sua cidade.",
    },
    {
        icon: "💎",
        title: "Experiência Digital Premium",
        desc: "O paciente começa a confiar no seu 'sorriso' antes mesmo de sentar na sua cadeira.",
    },
];

const slug = "dentistas";
---

<BaseLayout
    title="Site para Dentistas: Atraia mais Pacientes e Lote sua Agenda"
    description="Para quem busca excelência em implantes, estética e ortodontia de alto padrão. Tenha um site para dentistas imponente e focado em agendamentos."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="dentistas" slot="head" />

    <!-- animations script same as others -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Update measurements for ScrollTrigger
            ScrollTrigger.refresh();

            // Parallax 
            gsap.to(".hero-bg-image", { 
                scrollTrigger: { 
                    trigger: ".hero-lp-v2", 
                    start: "top top", 
                    scrub: true 
                }, 
                y: 100, 
                opacity: 0.4 
            });

            // Reveal Up
            document.querySelectorAll(".reveal-up").forEach((el) => { 
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: { 
                            trigger: el, 
                            start: "top 90%" 
                        }, 
                        y: 0, 
                        opacity: 1, 
                        duration: 1, 
                        ease: "power3.out" 
                    }
                ); 
            });

            // Stagger
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: { 
                        trigger: ".stagger-container", 
                        start: "top 80%" 
                    }, 
                    y: 0, 
                opacity: 1, 
                    duration: 0.8, 
                    stagger: 0.15 
                }
            );
        });
    </script>

    <div class="niche-page dental-theme">
        <!-- HERO V2 -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/saude-hero.png" alt="Clínica Odontológica Moderna" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot dental"></span> ESTRATÉGIA DIGITAL PARA DENTISTAS DE ELITE
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        O Sorriso do seu Paciente <br/> Começa em um <span class="text-gradient-dental">Posicionamento de Elite.</span>
                    </h1>
                    <p class="hero-sub-v2 reveal-up text-balance">
                        Não dependa apenas de indicações. Tenha um <strong>site para dentistas</strong> imponente, 
                        totalmente otimizado para transformar buscas no Google em cadeiras cheias e pacientes particulares.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button
                            href="https://wa.me/5521999064502?text=Olá! Sou dentista e desejo um site que atraia mais pacientes particulares para minha clínica."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="glow-btn-dental uppercase font-black"
                        >
                            QUERO MAIS PACIENTES AGORA
                        </Button>
                        <div class="hero-trust">
                            <i class="fas fa-check-circle"></i> Foco em Implantes, Estética e Ortodontia de Alto Padrão
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">+10k</span>
                        <span class="stat-txt">Agendamentos Gerados</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">99%</span>
                        <span class="stat-txt">Satisfação Odontológica</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Elite</span>
                        <span class="stat-txt">Padrão Alpha Code</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Awareness -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Sua clínica está preparada para o <span class="text-dental">paciente digital?</span></h2>
                    <p class="reveal-up text-gray-400 max-w-2xl mx-auto text-lg text-balance">
                        Muitos dentistas de excelência ainda sofrem com agendas instáveis por falta de um posicionamento digital profissional.
                    </p>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dental-sm"><i class="fas fa-calendar-times text-dental"></i></div>
                        <h3>Agenda com Horários Vagos</h3>
                        <p>A instabilidade nos agendamentos prejudica o planejamento financeiro e o crescimento da clínica.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dental-sm"><i class="fas fa-eye-slash text-dental"></i></div>
                        <h3>Pouca Visibilidade Online</h3>
                        <p>O paciente busca "dentista perto de mim" no Google e encontra seu concorrente, mas não encontra você.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dental-sm"><i class="fas fa-share-alt text-dental"></i></div>
                        <h3>Dependência de Redes Sociais</h3>
                        <p>Ficar refém de algoritmos de redes sociais é perigoso. Você precisa de um terreno próprio que converta.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dental-sm"><i class="fas fa-user-plus text-dental"></i></div>
                        <h3>Dificuldade em Atrair Particulares</h3>
                        <p>A dependência de convênios que pagam pouco asfixia o lucro. É hora de focar em pacientes de alto valor.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution & Benefits -->
        <section class="benefits-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Um <span class="text-dental">site para dentistas</span> que trabalha 24h para sua clínica.</h2>
                        <div class="benefit-grid-v2">
                            <div class="benefit-item-v2">
                                <div class="b-icon">🎯</div>
                                <div class="b-text">
                                    <h4>Autoridade Clínica</h4>
                                    <p>O paciente começa a confiar no seu trabalho antes mesmo de entrar no consultório através de um design premium.</p>
                                </div>
                            </div>
                            <div class="benefit-item-v2">
                                <div class="b-icon">📊</div>
                                <div class="b-text">
                                    <h4>Agendamento Facilitado</h4>
                                    <p>Integração direta com WhatsApp e sistemas de agendamento online para reduzir o atrito do paciente.</p>
                                </div>
                            </div>
                            <div class="benefit-item-v2">
                                <div class="b-icon">📈</div>
                                <div class="b-text">
                                    <h4>SEO Local Dominante</h4>
                                    <p>Apareça para quem está buscando por dentistas na sua região exata no momento da necessidade.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="reveal-up bg-dark-card p-8 rounded-3xl border border-white/5">
                        <h3 class="text-2xl font-bold mb-6">Como transformamos sua agenda:</h3>
                        <div class="process-steps">
                            <div class="step-v2">
                                <span class="step-num">01</span>
                                <div class="step-info">
                                    <strong>Análise de Mercado</strong>
                                    <p>Estudamos sua região e concorrentes para encontrar brechas de crescimento.</p>
                                </div>
                            </div>
                            <div class="step-v2">
                                <span class="step-num">02</span>
                                <div class="step-info">
                                    <strong>Criação Estratégica</strong>
                                    <p>Desenvolvemos seu site com foco total em estética dental e conversão.</p>
                                </div>
                            </div>
                            <div class="step-v2">
                                <span class="step-num">03</span>
                                <div class="step-info">
                                    <strong>Crescimento Escalonado</strong>
                                    <p>Implementamos técnicas de SEO que aumentam sua visibilidade dia após dia.</p>
                                </div>
                            </div>
                        </div>
                        <Button
                            href="https://wa.me/5521999064502?text=Gostaria de agendar uma análise da presença digital da minha clínica odontológica."
                            variant="primary"
                            class="w-full mt-8 glow-btn-dental"
                        >
                            AGENDAR ANÁLISE ESTRATÉGICA
                        </Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Intensive SEO Content Section (800+ words) -->
        <section class="seo-deep-content py-24">
            <div class="container">
                <div class="max-w-4xl mx-auto prose prose-invert prose-emerald">
                    <h2 class="text-3xl md:text-5xl font-black mb-8 text-white">O impacto de um <span class="text-dental">site para dentistas</span> moderno no faturamento da clínica</h2>
                    
                    <p class="text-lg leading-relaxed text-gray-300 mb-6">
                        Para o dentista contemporâneo, a primeira impressão do paciente não acontece mais na sala de espera, mas na tela do smartphone. O desenvolvimento de um <strong>site para dentistas</strong> de alto impacto tornou-se o diferencial entre clínicas que lutam por convênios e aquelas que dominam o mercado de procedimentos particulares. Quando um paciente busca por procedimentos de alto valor, como lentes de contato dental, implantes ou ortodontia invisível, ele busca segurança e autoridade. Se o seu site não transmite isso de forma imediata, você está perdendo o paciente para a concorrência.
                    </p>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">SEO para Dentistas: Como dominar o Google Local</h3>
                    <p class="text-gray-400 mb-6">
                        Estar presente no Google é vital, mas estar posicionado de forma estratégica é o que gera lucro. O SEO (Search Engine Optimization) aplicado a um <strong>site para dentistas</strong> permite que sua clínica apareça nos resultados orgânicos exatamente quando o paciente tem uma dor ou um desejo estético. Através da tecnologia Astro.js, garantimos que seu site carregue instantaneamente, o que é um dos principais fatores de ranqueamento do Google. Além disso, estruturamos os conteúdos focando na sua geocalização, garantindo que você seja a autoridade odontológica número um da sua cidade e bairro.
                    </p>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">Conversão Odontológica: Transformando Cliques em Consultas</h3>
                    <p class="text-gray-400 mb-6">
                        Muitas agências focam apenas em design, mas na Alpha Code, focamos em conversão. Um <strong>site para dentistas</strong> eficiente precisa ter chamadas para ação (CTAs) estrategicamente posicionadas. Facilitamos o contato via WhatsApp e integramos formulários inteligentes que qualificam o lead antes mesmo de ele falar com sua secretária. Isso reduz o trabalho manual e aumenta a eficiência da sua recepção, permitindo que o foco seja o fechamento de orçamentos de alto ticket.
                    </p>

                    <div class="highlight-box-seo dental my-12 p-8 border-l-4 border-dental bg-white/5 rounded-r-xl">
                        <h4 class="text-white font-bold text-xl mb-4">A Estética Odontológica Digital</h4>
                        <p class="text-gray-300 italic">"Na odontologia moderna, sua vitrine digital deve ser tão impecável quanto o sorriso que você entrega aos seus pacientes. Sites amadores atraem pacientes que buscam apenas preço; sites de elite atraem pacientes que valorizam a sua arte e tecnologia."</p>
                    </div>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">Abandonando a Dependência de Convênios</h3>
                    <p class="text-gray-400 mb-6">
                        Sabemos que as taxas pagas pelos planos de saúde odontológicos muitas vezes não cobrem sequer o custo dos materiais premium utilizados. A única forma de se libertar dessa dependência é construindo uma marca forte e independente. Um <strong>site para dentistas</strong> profissional permite que você comunique o valor diferenciado do seu atendimento particular, focando em biossegurança, tecnologia de ponta e resultados estéticos superiores, atraindo um público que está disposto a investir na própria saúde e beleza.
                    </p>

                    <h3 class="text-2xl font-bold mt-12 mb-4 text-white">Conclusão: Tecnologia a favor do seu Consultório</h3>
                    <p class="text-gray-400 mb-6">
                        O investimento em um <strong>site para dentistas</strong> é o ativo digital mais importante que você pode construir para sua carreira. Enquanto posts em redes sociais desaparecem em horas, seu site continua atraindo pacientes no Google dia e noite, ano após ano. É a fundação sólida necessária para transformar seu consultório em uma clínica referência e lucrativa.
                    </p>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos do que o valor de um único implante para transformar o faturamento da sua clínica.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>DENTISTA ESSENCIAL</h3>
                            <p>Presença digital odontológica eficiente</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">QUERO MAIS PACIENTES</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">LOTE SUA AGENDA</div>
                        <div class="head">
                            <h3>SORRISO AUTORIDADE</h3>
                            <p>Foco em implantes, estética e blog</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-dental">DOMINAR O MERCADO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE ODONTOLÓGICA</h3>
                            <p>Dominação de mercado e alta escala</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">FALAR COM CONSULTOR</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta-v2 py-32 relative overflow-hidden">
            <div class="container relative z-10 text-center">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8 text-balance">Digitalize o seu <br/> <span class="text-dental font-outfit">Sucesso Odontológico.</span></h2>
                <div class="reveal-up max-w-2xl mx-auto mb-12">
                    <p class="text-xl text-gray-300">
                        O futuro da odontologia é digital. Pare de perder pacientes para quem já se posicionou corretamente no Google. Vamos lotar sua cadeira hoje?
                    </p>
                </div>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502?text=Desejo falar com um especialista sobre o site da minha clínica dental." variant="primary" size="lg" class="glow-btn-dental uppercase font-black">Falar no WhatsApp</Button>
                    <Button href="https://wa.me/5521999064502?text=Gostaria de agendar uma análise automática da minha presença digital dental." variant="outline" size="lg">Agendar Análise</Button>
                </div>
            </div>
            <!-- FAQ Section for Dental SEO -->
            <div class="container mt-32 max-w-4xl mx-auto text-left">
                <h3 class="text-3xl font-black mb-12 text-center">Dúvidas Frequentes sobre <br/><span class="text-dental">Marketing para Dentistas</span></h3>
                <div class="faq-list-v2">
                    <div class="faq-item reveal-up border-b border-white/10 py-6">
                        <h4 class="text-xl font-bold text-dental mb-3">O site ajuda a atrair pacientes para implantes e estética?</h4>
                        <p class="text-gray-400">Sim. Criamos seções específicas focadas em procedimentos de alto valor, utilizando gatilhos de autoridade e resultados que motivam o agendamento dessas especialidades.</p>
                    </div>
                    <div class="faq-item reveal-up border-b border-white/10 py-6">
                        <h4 class="text-xl font-bold text-dental mb-3">Como funciona a integração com agendamento online?</h4>
                        <p class="text-gray-400">Podemos integrar seu site com sistemas como Doctoralia, Simples Dental ou qualquer sistema que possua link de marcação, além do botão direto para WhatsApp da sua recepção.</p>
                    </div>
                    <div class="faq-item reveal-up border-b border-white/10 py-6">
                        <h4 class="text-xl font-bold text-dental mb-3">O site é otimizado para o Google da minha cidade?</h4>
                        <p class="text-gray-400">Sim. Utilizamos técnicas de SEO Local (Google Meu Negócio e palavras-chave regionais) para garantir que sua clínica apareça para as pessoas certas na sua região.</p>
                    </div>
                </div>
            </div>
            <div class="glow-dental-1"></div>
        </section>
    </div>
</BaseLayout>

<style>
    .dental-theme {
        --color-dental: #4ade80; /* Dental theme can be Green/Mint for health and freshness */
        --color-primary: #8a1c26;
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background-color: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.4; filter: saturate(0.8) brightness(0.65); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.9) 70%, black 100%); }
    .hero-content-v2 { max-width: 850px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(74, 222, 128, 0.1); border: 1px solid rgba(74, 222, 128, 0.2); border-radius: 50px; font-size: 0.8rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: var(--color-dental); }
    .hero-badge-v2 .dot.dental { width: 8px; height: 8px; background: var(--color-dental); border-radius: 50%; box-shadow: 0 0 10px var(--color-dental); }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 2rem; }
    .text-gradient-dental { background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.25rem; color: #a0a0a0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 680px; }
    .hero-actions-v2 { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    .hero-trust { font-size: 0.85rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .hero-trust i { color: var(--color-dental); }
    .text-dental { color: var(--color-dental); }
    .bg-dental { background: var(--color-dental) !important; color: black !important; }
    .tag-v2.dental { color: var(--color-dental); }
    .problem-card-v2:hover { border-color: var(--color-dental); transform: translateY(-8px); }
    .icon-circle { width: 80px; height: 80px; background: rgba(74, 222, 128, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 2rem; border: 1px solid rgba(74, 222, 128, 0.1); }
    .check-list { display: flex; flex-direction: column; gap: 1rem; }
    .check-list li { display: flex; align-items: center; gap: 12px; color: #bbb; }
    .check-list i { color: var(--color-dental); }
    .glow-btn-dental { background: var(--color-dental) !important; color: black !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(74, 222, 128, 0.3); }
    .glow-btn-dental:hover { box-shadow: 0 15px 50px rgba(74, 222, 128, 0.5); transform: translateY(-2px); }
    .glow-dental-1 { position: absolute; top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(74, 222, 128, 0.05) 0%, transparent 70%); }
    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .pricing-grid-v2 { grid-template-columns: 1fr; }
        .p-card-v2.featured { transform: none; margin: 2rem 0; }
        .transformation-v2 .grid { grid-template-columns: 1fr; }

        /* Mobile fixes for comparison cards */
        .comparison-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            perspective: none;
