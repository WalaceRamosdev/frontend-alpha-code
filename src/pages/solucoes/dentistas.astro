---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const slug = "dentistas";

const faq = [
    {
        q: "O site respeita as normas do CRO?",
        a: "Sim, todos os nossos sites para dentistas são desenvolvidos seguindo estritamente as diretrizes do Conselho Federal de Odontologia, garantindo um marketing ético e informativo."
    },
    {
        q: "Vou aparecer no Google?",
        a: "Sim, aplicamos técnicas de SEO odontológico para que pacientes em busca de tratamentos na sua região encontrem sua clínica com facilidade."
    },
    {
        q: "O site facilita o agendamento?",
        a: "Com certeza. Integramos botões estratégicos de WhatsApp e formulários de conversão para que o paciente consiga agendar uma avaliação em poucos segundos."
    },
    {
        q: "O site funciona no celular?",
        a: "Sim, totalmente otimizado para smartphones, essencial para pacientes que buscam soluções rápidas para saúde bucal via celular."
    }
];
---

<BaseLayout
    title="Site para Dentistas: Atraia mais Pacientes e Valorize seu Consultório"
    description="Atraia mais pacientes todos os dias com um site profissional para dentistas. Focado em conversão, ética do CRO e autoridade na odontologia."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="dentistas" slot="head" />

    <div class="niche-page dentistry-theme">
        
        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/saude-hero.png" alt="Consultório Odontológico Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> MARKETING ODONTOLÓGICO DE ELITE
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Atraia mais pacientes todos os dias com um <span class="text-gradient">site profissional para dentistas</span>
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Crie uma presença online que transmite confiança, respeita as normas do CRO e faz com que pessoas procurando por tratamentos encontrem você no Google.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero atrair mais pacientes para minha clínica com um site profissional." variant="primary" size="lg" class="glow-button px-8">👉 QUERO MAIS PACIENTES</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">FALAR NO WHATSAPP</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">100%</span>
                        <span class="stat-txt">Ética CRO</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+180</span>
                        <span class="stat-txt">Dentistas Atendidos</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+320%</span>
                        <span class="stat-txt">ROI em Consultas</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Você é um dentista de excelência... <br/> <span class="text-primary italic">mas sua agenda ainda tem janelas indesejadas?</span></h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dent-sm"><i class="fas fa-tooth text-primary"></i></div>
                        <h3>Agenda Oscilante</h3>
                        <p>A insegurança de não saber se a próxima semana terá pacientes suficientes para cobrir os custos fixos.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dent-sm"><i class="fas fa-mobile-alt text-primary"></i></div>
                        <h3>Dependência de Redes Sociais</h3>
                        <p>Gasta-se horas criando posts que geram curtidas, mas raramente convertem em uma avaliação na cadeira.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dent-sm"><i class="fas fa-search text-primary"></i></div>
                        <h3>Pouca Visibilidade Online</h3>
                        <p>O paciente busca por "implantes" ou "clareamento" no Google e encontra o vizinho, não você.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-dent-sm"><i class="fas fa-user-slash text-primary"></i></div>
                        <h3>Dificuldade em Atrair Novos Casos</h3>
                        <p>Sem um posicionamento de autoridade, você acaba atraindo apenas quem busca o menor preço.</p>
                    </div>
                </div>
                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-2xl">
                        <p class="text-2xl font-bold">💡 A verdade odontológica: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">se você não é visto como autoridade, você é comparado pelo preço.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">VALORIZAÇÃO CLÍNICA</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Nós criamos um <span class="text-primary">site estratégico para dentistas</span> que trabalha por você todos os dias.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Sua clínica passa a:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🚀</span> Ser encontrada no Google por pacientes qualificados
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">✨</span> Transmitir modernidade e higiene visual imediata
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">📅</span> Facilitar o agendamento de avaliações via WhatsApp
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">💎</span> Converter curiosos em tratamentos de alto valor
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">DENTISTRY DESIGN PRO</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Exemplo site dentista" class="project-preview-img" style="filter: hue-rotate(90deg);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Resultados para sua Clínica</h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Mais avaliações marcadas todos os meses</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Aumento na conversão de tratamentos premium</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Menos tempo desperdiçado com curiosos</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Presença digital profissional e moderna</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Autoridade máxima na sua região de atendimento</h4>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="process-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl font-black">Seu Novo Sorriso Digital</h2>
                </div>
                <div class="grid md:grid-cols-4 gap-8 stagger-container">
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">1</div>
                        <h4>Entendemos seu diferencial</h4>
                        <p>Analisamos suas especialidades (implantes, orto, estética) para alvo certeiro.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">2</div>
                        <h4>Criamos um site estratégico</h4>
                        <p>Design 'clean' e focado em gerar desejo pelos seus tratamentos odontológicos.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">3</div>
                        <h4>Dominação do Google local</h4>
                        <p>Otimizamos seu site para que sua clínica seja a primeira opção nos mapas e buscas.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">4</div>
                        <h4>Agenda no Piloto Automático</h4>
                        <p>Seu site trabalha 24h atraindo e facilitando o contato de novos pacientes.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Difference Section -->
        <section class="differences py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Não fazemos apenas sites bonitinhos.</h2>
                        <p class="text-xl text-gray-400 mb-8">Criamos páginas pensadas para dentistas, com foco em:</p>
                        <ul class="diff-list space-y-4">
                            <li class="flex items-center gap-3">
                                <div class="dot-dent"></div> Diferenciação visual de alto padrão
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-dent"></div> Respeito absoluto às normas do CRO
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-dent"></div> Estrutura que incentiva a marcação de consultas
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-dent"></div> Experiência de usuário fluida e confiável
                            </li>
                        </ul>
                    </div>
                    <div class="reveal-up bg-white/5 p-12 rounded-3xl border border-primary/20">
                        <h3 class="text-3xl font-black mb-6">🔥 Será que o investimento compensa?</h3>
                        <p class="text-lg text-gray-300 mb-8">Um único fechamento de tratamento premium (como implantes ou lentes) paga o site para sempre. Ele é feito para:</p>
                        <div class="flex flex-col gap-4">
                            <span class="badge-v3">👉 ATRAIR O PACIENTE IDEAL</span>
                            <span class="badge-v3">👉 CONVENCER PELA TECNOLOGIA</span>
                            <span class="badge-v3">👉 GERAR AGENDAMENTO AGORA</span>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero atrair mais pacientes qualificados para minha clínica odontológica." variant="primary" class="w-full mt-10 glow-button py-6 text-xl">🚀 QUERO MAIS PACIENTES AGORA</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Dúvidas Frequentes</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Destaque sua clínica <br/> <span class="text-primary font-outfit">no mercado digital.</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button px-10">👉 QUERO MAIS PACIENTES</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">SOLICITAR ANÁLISE ODONTOLÓGICA</Button>
                </div>
            </div>
            <div class="glow-blur-dent"></div>
        </section>

        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert prose-emerald">
                <h2 class="text-3xl font-black text-white">Domine as buscas com o melhor <span class="text-primary">site para dentistas</span></h2>
                <p>O mercado de odontologia é um dos mais pulverizados do Brasil. Ter um <strong>site para dentistas</strong> é o que separa a clínica "de bairro" da autoridade regional em implantes ou estética. Através da <strong>criação de sites para dentistas</strong> focada em <strong>atrair pacientes particulares</strong>, garantimos que sua estrutura seja encontrada exatamente por quem busca resolver um problema bucal. Nosso SEO odontológico é pensado para converter termos de busca técnica em avaliações presenciais na sua cadeira.</p>
                <p>Nossos projetos respeitam as normas do CRO e focam na valorização do seu trabalho clínico. Com tecnologia Astro.js, entregamos sites que carregam em menos de 1 segundo, garantindo que o paciente encontre sua clínica, entenda seus diferenciais e agende uma consulta direto pelo WhatsApp com o mínimo de cliques possíveis.</p>
            </div>
        </section>

    </div>
</BaseLayout>

<style>
    .dentistry-theme {
        --color-primary: #10b981; /* Emerald/Mint for Health and Dentistry */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.8) 70%, black 100%); }
    .hero-content-v2 { max-width: 900px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 50px; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: #34d399; }
    .hero-badge-v2 .dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; box-shadow: 0 0 10px #10b981; }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1.0; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 2rem; }
    .text-gradient { background: linear-gradient(135deg, #34d399, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.3rem; color: #b0b0b0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 750px; font-weight: 500; }
    
    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Cards */
    .problem-card-v2 { background: #0c0c0c; padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; }
    .problem-card-v2:hover { border-color: var(--color-primary); transform: translateY(-10px); }
    .icon-circle { width: 70px; height: 70px; background: rgba(16, 185, 129, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 2rem; border: 1px solid rgba(16, 185, 129, 0.1); }
    .problem-card-v2 h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #eee; }
    .problem-card-v2 p { color: #888; line-height: 1.6; }

    .benefit-card-v3 { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; background: #0c0c0c; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .check-circle { width: 30px; height: 30px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; flex-shrink: 0; }
    .benefit-card-v3 h4 { font-size: 1.25rem; font-weight: 800; }

    .process-step-v3 .step-icon { width: 60px; height: 60px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900; margin: 0 auto 2rem; color: var(--color-primary); }
    .process-step-v3 h4 { font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem; }
    .process-step-v3 p { color: #777; line-height: 1.6; }

    .badge-v3 { padding: 12px 20px; background: rgba(16, 185, 129, 0.08); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); font-weight: 800; color: #6ee7b7; font-size: 0.9rem; }
    .dot-dent { width: 8px; height: 8px; background: var(--color-primary); border-radius: 50%; }

    /* Comparison Card */
    .comparison-container { perspective: 1200px; display: flex; justify-content: center; }
    .comparison-card { background: #111; border-radius: 20px; overflow: hidden; border: 2px solid var(--color-primary); box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 40px rgba(16, 185, 129, 0.1); transform: rotateY(-15deg) rotateX(10deg); transition: 0.6s ease; width: 100%; max-width: 600px; aspect-ratio: 16/10; display: flex; flex-direction: column; }
    .comparison-card:hover { transform: none; }
    .project-preview-img { width: 100%; height: 100%; object-fit: cover; flex-grow: 1; }
    .card-tag { position: absolute; top: 20px; left: 20px; z-index: 10; background: var(--color-primary); color: white; padding: 6px 12px; font-size: 0.7rem; font-weight: 900; border-radius: 4px; box-shadow: 0 4px 15px rgba(16,185,129,0.4); text-transform: uppercase; letter-spacing: 1px; }

    .glow-blur-dent { position: absolute; top: 0; left: 0; width: 500px; height: 500px; background: radial-gradient(circle, rgba(16, 185, 129, 0.1) 0%, transparent 70%); filter: blur(100px); z-index: 0; pointer-events: none; }

    .card-browser-mockup { height: 35px; background: #1a1a1a; display: flex; align-items: center; gap: 8px; padding-left: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .browser-dot-red { width: 8px; height: 8px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 8px; height: 8px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 8px; height: 8px; border-radius: 50%; background: #27c93f; }

    .text-primary { color: #6ee7b7; }
    .glow-button { background: var(--color-primary) !important; color: white !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(16, 185, 129, 0.4); transition: 0.3s; }
    .glow-button:hover { box-shadow: 0 15px 50px rgba(16, 185, 129, 0.6); transform: translateY(-2px); }

    .faq-item-v3 { padding: 2rem; background: #0c0c0c; border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; }
    .highlight-truth { box-shadow: 0 0 60px rgba(16, 185, 129, 0.05); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .hero-actions-v2 { align-items: center; }
        .hero-actions-v2 .flex { flex-direction: column; width: 100%; }
        .hero-actions-v2 .flex Button { width: 100%; }
        .comparison-card { transform: none; }
        .stat-divider { display: none; }
        .stats-wrapper-v2 { flex-direction: column; }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        ScrollTrigger.refresh();

        // Parallax Hero
        gsap.to(".hero-bg-image", { 
            scrollTrigger: { trigger: ".hero-lp-v2", start: "top top", scrub: true }, 
            y: 100, opacity: 0.4 
        });

        // Hero animations (Load immediately)
        gsap.fromTo(".hero-reveal", { y: 40, opacity: 0 }, {
            y: 0, opacity: 1, duration: 1, stagger: 0.15, ease: "power3.out", delay: 0.2
        });

        // Reveal animations (Scroll)
        document.querySelectorAll(".reveal-up").forEach((el) => {
            gsap.fromTo(el, { y: 40, opacity: 0 }, {
                scrollTrigger: { trigger: el, start: "top 90%" },
                y: 0, opacity: 1, duration: 1, ease: "power3.out"
            });
        });

        // Stagger cards
        gsap.fromTo(".stagger-card", { y: 50, opacity: 0 }, {
            scrollTrigger: { trigger: ".stagger-container", start: "top 80%" },
            y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: "power2.out"
        });
    });
</script>
