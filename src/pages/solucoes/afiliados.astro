---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import RelatedContent from "../../components/seo/RelatedContent.astro";

const slug = "afiliados";

const faq = [
    {
        q: "Por que não usar Linktree ou agregadores gratuitos?",
        a: "Essas ferramentas não permitem o uso de Pixel, API de Conversão e muitas vezes são marcadas como spam pelas redes sociais, o que pode levar ao bloqueio da sua conta."
    },
    {
        q: "O site carrega rápido mesmo com muitos links?",
        a: "Sim, utilizamos o Astro.js, que remove todo o JavaScript desnecessário, garantindo que sua página abra instantaneamente no celular do cliente."
    },
    {
        q: "Vocês configuram o Pixel do Facebook e Google?",
        a: "Sim, entregamos a estrutura com o setup de dados completo para que você possa fazer retargeting e otimizar suas campanhas de tráfego pago."
    },
    {
        q: "Posso criar advertoriais e pré-sells?",
        a: "Sim, nossa estrutura permite criar páginas ilimitadas para produtos vencedores, com designs específicos para cada estratégia de venda."
    }
];
---

<BaseLayout
    title="Estrutura Própria para Afiliados: Escala, Dados e Liberdade Digital"
    description="Saia do básico. Tenha sua estrutura própria para afiliados Shopee e Mercado Livre com Astro.js. Pixel integrado, velocidade extrema e zero medo de bloqueios."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="afiliados" slot="head" />
    <link rel="preload" as="image" href="/assets/banners/psicologia-hero.webp" slot="head" fetchpriority="high" />

    <div class="niche-page affiliate-theme">
        
        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img 
                    src="/assets/banners/psicologia-hero.webp" 
                    alt="Estrutura Própria para Afiliados de Elite" 
                    class="hero-bg-image" 
                    loading="eager"
                    fetchpriority="high"
                    width="1920"
                    height="1080"
                />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> DOMINE O MERCADO DE AFILIADOS
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Pare de ser <span class="text-gradient">refém do algoritmo</span> e construa sua soberania digital
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Desenvolvemos a estrutura definitiva para afiliados Shopee e Mercado Livre. Fuja dos bloqueios, domine seus dados e escale com tecnologia de elite.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero construir minha estrutura própria para afiliados." variant="primary" size="lg" class="glow-button px-8">🚀 ESCALAR MINHAS VENDAS</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">VER ESTRUTURA</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">0.8s</span>
                        <span class="stat-txt">Tempo de Carga</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">100%</span>
                        <span class="stat-txt">Controle de Dados</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">ZERO</span>
                        <span class="stat-txt">Risco de Bloqueio</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Você está deixando <br/> <span class="text-primary italic">dinheiro na mesa todos os dias?</span></h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-aff-sm"><i class="fas fa-ban text-primary"></i></div>
                        <h3>Medo de Bloqueios</h3>
                        <p>Usar links diretos ou agregadores gratuitos aumenta as chances de banimento das suas redes sociais.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-aff-sm"><i class="fas fa-chart-line-down text-primary"></i></div>
                        <h3>Dados às Escuras</h3>
                        <p>Sem estrutura própria, você não sabe quem clicou, de onde veio ou por que não comprou.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-aff-sm"><i class="fas fa-hourglass-half text-primary"></i></div>
                        <h3>Lentidão Fatal</h3>
                        <p>Cada segundo de demora no carregamento do seu link é uma venda perdida para o concorrente.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-aff-sm"><i class="fas fa-user-slash text-primary"></i></div>
                        <h3>Falta de Autoridade</h3>
                        <p>Um "vendedor de links" amador não passa a confiança necessária para vender produtos caros.</p>
                    </div>
                </div>
                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-2xl">
                        <p class="text-2xl font-bold">💡 O segredo do Top 1% é simples: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">quem domina a estrutura, domina o lucro.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">A ENGENHARIA DO LUCRO</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Uma <span class="text-primary">máquina de vendas</span> rodando no seu próprio domínio.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Sua estrutura na Alpha Code entrega:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">⚡</span> Carregamento ultrarrápido (Astro.js)
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">📊</span> Pixel e API de Conversão configurados
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🛡️</span> Domínio profissional com autoridade
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🔄</span> Estrutura modular para centenas de produtos
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">PROJETO AFILIADO ELITE</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img 
                                    src="/assets/imagens-de-paginas/affiliate-mockup.svg" 
                                    alt="Mockup de estrutura para afiliados" 
                                    class="project-preview-img" 
                                    loading="lazy"
                                    width="600"
                                    height="400"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Por que somos o diferencial para Afiliados?</h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Retargeting que Vende de Verdade</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Páginas de Pre-sell Inabaláveis</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>SEO para "Achadinhos" Orgânicos</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Hospedagem de Performance Mundial</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Acompanhamento Técnico em Tempo Real</h4>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Dúvidas dos Afiliados</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Sua escala profissional <br/> <span class="text-primary font-outfit">começa aqui.</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button px-10">🚀 QUERO MINHA ESTRUTURA</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">FALAR COM ESPECIALISTA</Button>
                </div>
            </div>
            <div class="glow-blur-aff"></div>
        </section>
        
        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert prose-blue">
                <h2 class="text-3xl font-black text-white">Domine o mercado com a melhor <span class="text-primary">estrutura própria para afiliados</span></h2>
                <p>Ter uma <strong>estrutura própria para afiliados Shopee</strong> ou Mercado Livre é o divisor de águas entre quem joga o jogo dos amadores e quem escala para o nível profissional. Com a <strong>criação de sites para afiliados</strong> da Alpha Code, você garante que sua operação tenha velocidade, controle de dados e autoridade de domínio.</p>
                <p>Nossa tecnologia baseada em <strong>Astro.js</strong> garante que suas páginas de pré-sell e advertoriais carreguem instantaneamente, maximizando a retenção de cliques e o ROI dos seus anúncios. Além disso, implementamos o <strong>Pixel do Facebook e a API de Conversão</strong>, permitindo que você faça retargeting agressivo e reduza o custo por venda.</p>
            </div>
        </section>
        <RelatedContent
            type="niche"
            niche="afiliados"
            title="Continue explorando soluções para afiliados"
            limit={6}
        />


    </div>
</BaseLayout>

<style>
    .affiliate-theme {
        --color-primary: #007bff;
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { 
        position: relative; 
        min-height: 100vh; 
        display: flex; 
        align-items: center; 
        padding: 100px 0; 
        background: radial-gradient(circle at 50% 50%, #001a33 0%, #000000 100%); 
    }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.4; filter: saturate(0.8) brightness(0.7); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.8) 70%, black 100%); }
    .hero-content-v2 { max-width: 900px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; background: rgba(0, 123, 255, 0.1); border: 1px solid rgba(0, 123, 255, 0.2); border-radius: 50px; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: #4da3ff; }
    .hero-badge-v2 .dot { width: 8px; height: 8px; background: #4da3ff; border-radius: 50%; box-shadow: 0 0 10px #4da3ff; }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1.0; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 2rem; }
    .text-gradient { background: linear-gradient(135deg, #4da3ff, #007bff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.3rem; color: #b0b0b0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 750px; font-weight: 500; }
    
    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Cards */
    .problem-card-v2 { background: #0c0c0c; padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; }
    .problem-card-v2:hover { border-color: var(--color-primary); transform: translateY(-10px); }
    .icon-circle { width: 70px; height: 70px; background: rgba(0, 123, 255, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 2rem; border: 1px solid rgba(0, 123, 255, 0.1); }
    .problem-card-v2 h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #eee; }
    .problem-card-v2 p { color: #888; line-height: 1.6; }

    .benefit-card-v3 { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; background: #0c0c0c; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .check-circle { width: 30px; height: 30px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; flex-shrink: 0; }
    .benefit-card-v3 h4 { font-size: 1.25rem; font-weight: 800; }

    /* Comparison Card */
    .comparison-container { perspective: 1200px; display: flex; justify-content: center; }
    .comparison-card { background: #111; border-radius: 20px; overflow: hidden; border: 2px solid var(--color-primary); box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 40px rgba(0, 123, 255, 0.1); transform: rotateY(-15deg) rotateX(10deg); transition: 0.6s ease; width: 100%; max-width: 600px; aspect-ratio: 16/10; display: flex; flex-direction: column; }
    .comparison-card:hover { transform: none; }
    .project-preview-img { width: 100%; height: 100%; object-fit: cover; flex-grow: 1; }
    .card-tag { position: absolute; top: 20px; left: 20px; z-index: 10; background: var(--color-primary); color: white; padding: 6px 12px; font-size: 0.7rem; font-weight: 900; border-radius: 4px; box-shadow: 0 4px 15px rgba(0,123,255,0.4); text-transform: uppercase; letter-spacing: 1px; }

    .glow-blur-aff { position: absolute; top: 20%; left: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(0, 123, 255, 0.1) 0%, transparent 70%); filter: blur(100px); z-index: 0; pointer-events: none; }

    .card-browser-mockup { height: 35px; background: #1a1a1a; display: flex; align-items: center; gap: 8px; padding-left: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .browser-dot-red { width: 8px; height: 8px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 8px; height: 8px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 8px; height: 8px; border-radius: 50%; background: #27c93f; }

    .text-primary { color: #4da3ff; }
    .glow-button { background: var(--color-primary) !important; color: white !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(0, 123, 255, 0.4); transition: 0.3s; }
    .glow-button:hover { box-shadow: 0 15px 50px rgba(0, 123, 255, 0.6); transform: translateY(-2px); }

    .faq-item-v3 { padding: 2rem; background: #0c0c0c; border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; }
    .highlight-truth { box-shadow: 0 0 60px rgba(0, 123, 255, 0.05); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .hero-actions-v2 .flex { flex-direction: column; width: 100%; }
        .hero-actions-v2 .flex Button { width: 100%; }
        .comparison-card { transform: none; }
        .stat-divider { display: none; }
        .stats-wrapper-v2 { flex-direction: column; }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
        ScrollTrigger.refresh();

        gsap.to(".hero-bg-image", { 
            scrollTrigger: { 
                trigger: ".hero-lp-v2", 
                start: "top top", 
                scrub: true,
                invalidateOnRefresh: true
            }, 
            y: 100, 
            opacity: 0.3 
        });

        gsap.fromTo(".hero-reveal", { y: 30, opacity: 0 }, {
            y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", delay: 0.1
        });

        const revealElements = document.querySelectorAll(".reveal-up");
        revealElements.forEach((el) => {
            gsap.fromTo(el, { y: 30, opacity: 0 }, {
                scrollTrigger: { 
                    trigger: el, 
                    start: "top 92%",
                    toggleActions: "play none none none"
                },
                y: 0, opacity: 1, duration: 0.8, ease: "power3.out"
            });
        });

        gsap.fromTo(".stagger-card", { y: 40, opacity: 0 }, {
            scrollTrigger: { 
                trigger: ".stagger-container", 
                start: "top 85%" 
            },
            y: 0, opacity: 1, duration: 0.6, stagger: 0.1, ease: "power2.out"
        });
    };

    document.addEventListener('astro:page-load', () => {
        if (window.innerWidth > 768) {
            requestAnimationFrame(() => {
                setTimeout(initAnimations, 50);
            });
        } else {
            gsap.set(".hero-reveal, .reveal-up, .stagger-card", { opacity: 1, y: 0 });
        }
    });
</script>
