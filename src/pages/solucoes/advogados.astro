---

<BaseLayout
    title="Site para Advogados: Posicionamento de Elite e Autoridade Jurídica"
    description="Eleve o patamar do seu escritório de advocacia. Sites éticos, imponentes e otimizados para atrair clientes de alto valor. Conformidade total com a OAB."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="advogados" slot="head" />

    <!-- GSAP / Animations -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Force refresh for height changes
            ScrollTrigger.refresh();

            // Parallax Hero
            gsap.to(".hero-bg-image", {
                scrollTrigger: { 
                    trigger: ".hero-lp-v2", 
                    start: "top top", 
                    scrub: true 
                },
                y: 100, 
                opacity: 0.4
            });

            // Reveal animations
            document.querySelectorAll(".reveal-up").forEach((el) => {
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: { 
                            trigger: el, 
                            start: "top 90%", 
                            toggleActions: "play none none reverse" 
                        },
                        y: 0,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.out"
                    }
                );
            });

            // Staggered cards
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: { 
                        trigger: ".stagger-container", 
                        start: "top 80%" 
                    },
                    y: 0,
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power2.out"
                }
            );
        });
    </script>

    <div class="niche-page law-theme">
        
        <!-- HERO V2 -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/advogados-hero.png" alt="Escritório de Advocacia Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot gold"></span> POSICIONAMENTO DIGITAL DE ELITE PARA ADVOGADOS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Onde a Excelência Jurídica Encontra um <br/>
                        <span class="text-gradient-gold">Posicionamento de Elite.</span>
                    </h1>
                    <p class="hero-sub-v2 reveal-up text-balance">
                        Não seja apenas mais um no mercado. Tenha um <strong>site para advogados</strong> imponente, 
                        totalmente ético e focado em atrair clientes que valorizam sua expertise jurídica.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button
                            href="https://wa.me/5521999064502?text=Olá! Sou advogado(a) e desejo um site que transmita autoridade e seriedade para meu escritório."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="glow-btn-gold uppercase font-black"
                        >
                            QUERO MAIS CLIENTES AGORA
                        </Button>
                        <div class="hero-trust">
                            <i class="fas fa-balance-scale"></i> Projetos 100% em conformidade com o Código de Ética da OAB
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">OAB OK</span>
                        <span class="stat-txt">Ética e Conformidade</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">3 dias</span>
                        <span class="stat-txt">Implementação Ágil</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Premium</span>
                        <span class="stat-txt">Design de Alto Padrão</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Awareness -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Por que grandes escritórios <span class="text-gold">ainda perdem espaço no digital?</span></h2>
                    <p class="reveal-up text-gray-400 max-w-2xl mx-auto text-lg text-balance">
                        A advocacia mudou. Ter apenas um "cartão de visitas" online não é mais suficiente para garantir uma banca próspera.
                    </p>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-user-friends text-gold"></i></div>
                        <h3>Dificuldade em Captar Clientes</h3>
                        <p>A dependência exclusiva de indicações torna o faturamento do escritório imprevisível e instável.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-chess-knight text-gold"></i></div>
                        <h3>Concorrência Desleal e Forte</h3>
                        <p>Escritórios menores, mas com melhor presença digital, acabam captando clientes que deveriam ser seus.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-globe-americas text-gold"></i></div>
                        <h3>Baixa Presença Digital</h3>
