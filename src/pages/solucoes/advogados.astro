        </section>

        <!-- Solution & Benefits -->
        <section class="benefits-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Sua nova fronteira digital: Um <span class="text-gold">site para advogados</span> de alto nível.</h2>
                        <div class="benefit-grid-v2">
                            <div class="benefit-item-v2">
                                <div class="b-icon">🏛️</div>
                                <div class="b-text">
                                    <h4>Autoridade Instantânea</h4>
                                    <p>O cliente decide confiar em sua banca em segundos. Nosso design transmite solidez absoluta.</p>
                                </div>
                            </div>
                            <div class="benefit-item-v2">
                                <div class="b-icon">🛡️</div>
                                <div class="b-text">
