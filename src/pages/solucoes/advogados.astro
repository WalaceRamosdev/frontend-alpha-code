---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";

const slug = "advogados";

const faq = [
    {
        q: "O site respeita as normas da OAB?",
        a: "Sim, todos os nossos sites para advogados são desenvolvidos seguindo rigorosamente o Código de Ética e Disciplina da OAB, focando no caráter informativo e na sobriedade necessária à profissão."
    },
    {
        q: "Vou aparecer no Google?",
        a: "Sim, implementamos estratégias de SEO jurídico para que potenciais clientes que buscam por soluções legais na sua área de atuação encontrem seu escritório."
    },
    {
        q: "Preciso produzir conteúdo para o site?",
        a: "Não é obrigatório, mas recomendável. Nós estruturamos o site para que sua autoridade seja transmitida através do design e da organização das suas áreas de atuação."
    },
    {
        q: "O site funciona no celular?",
        a: "Sim, os sites são 100% responsivos e otimizados para dispositivos móveis, garantindo que o cliente consiga entrar em contato de forma rápida e segura."
    }
];
---

<BaseLayout
    title="Site para Advogados: Posicionamento de Autoridade e Captação Ética"
    description="Atraia mais clientes qualificados todos os dias com um site profissional para advogados. Focado em conversão, ética da OAB e autoridade jurídica."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="advogados" slot="head" />

    <div class="niche-page legal-theme">
        
        <!-- HERO -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/advogados-hero.png" alt="Escritório de Advocacia Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 hero-reveal">
                        <span class="dot"></span> POSICIONAMENTO JURÍDICO DE ELITE
                    </div>
                    <h1 class="hero-title-v2 hero-reveal">
                        Atraia mais clientes todos os dias com um <span class="text-gradient">site profissional para advogados</span>
                    </h1>
                    <p class="hero-sub-v2 hero-reveal">
                        Crie uma presença online que transmite autoridade, respeita as normas da OAB e faz com que pessoas em busca de soluções jurídicas encontrem você no Google.
                    </p>
                    <div class="hero-actions-v2 hero-reveal">
                        <div class="flex flex-wrap gap-4">
                            <Button href="https://wa.me/5521999064502?text=Quero atrair mais clientes qualificados com um site jurídico profissional." variant="primary" size="lg" class="glow-button px-8">👉 QUERO MAIS CLIENTES</Button>
                            <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-8">FALAR NO WHATSAPP</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">100%</span>
                        <span class="stat-txt">Ética OAB</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">+120</span>
                        <span class="stat-txt">Advogados Atendidos</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">B2B/B2C</span>
                        <span class="stat-txt">Alta Conversão</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Você é um advogado de alto nível... <br/> <span class="text-primary italic">mas seu escritório ainda é invisível digitalmente?</span></h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-legal-sm"><i class="fas fa-balance-scale text-primary"></i></div>
                        <h3>Dificuldade em captar clientes</h3>
                        <p>A captação passiva não é suficiente para sustentar o crescimento de um escritório moderno.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-legal-sm"><i class="fas fa-handshake-slash text-primary"></i></div>
                        <h3>Dependência de indicações</h3>
                        <p>O "boca a boca" é excelente, mas lento demais para quem busca dominar o mercado local.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-legal-sm"><i class="fas fa-gavel text-primary"></i></div>
                        <h3>Forte Concorrência Online</h3>
                        <p>Grandes escritórios já dominam as buscas. Se você não aparecer, você não existirá para o mercado.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle shadow-legal-sm"><i class="fas fa-shield-alt text-primary"></i></div>
                        <h3>Insegurança no Marketing</h3>
                        <p>O medo de infringir o código de ética da OAB impede muitos advogados de terem um posicionamento forte.</p>
                    </div>
                </div>
                <div class="text-center mt-16 reveal-up">
                    <div class="highlight-truth p-8 bg-white/5 border border-white/10 rounded-3xl inline-block max-w-2xl">
                        <p class="text-2xl font-bold">💡 A verdade jurídica é absoluta: <br/> <span class="text-primary font-black uppercase tracking-tighter text-3xl">se você não é encontrado, seu concorrente é escolhido.</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solution Section -->
        <section class="solution-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <span class="tag-v2">ESTRATÉGIA JURÍDICA</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Nós criamos um <span class="text-primary">site estratégico para advogados</span> que trabalha por você todos os dias.</h2>
                        <p class="text-xl text-gray-400 mb-8 font-medium">Seu escritório passa a:</p>
                        <ul class="solution-list space-y-6">
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🚀</span> Aparecer no Google para quem busca soluções legais
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">🔱</span> Transmitir autoridade e sobriedade imediata
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">⚖️</span> Facilitar o contato qualificado via WhatsApp/Forms
                            </li>
                            <li class="flex items-center gap-4 text-lg">
                                <span class="check-icon">💎</span> Converter interessados em clientes fidelizados
                            </li>
                        </ul>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card premium">
                                <div class="card-tag flagship">PADRÃO ELITE OAB</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/nexusContabilidade.svg" alt="Exemplo site advocacia" class="project-preview-img" style="filter: contrast(1.2) brightness(0.8);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section class="benefits-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Autoridade para seu Escritório</h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Mais clientes qualificados entrando em contato</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Carteira de clientes mais estável e lucrativa</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Menos dependência de indicações lentas</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Presença profissional jurídica incontestável</h4>
                    </div>
                    <div class="benefit-card-v3 reveal-up">
                        <div class="check-circle">✔</div>
                        <h4>Autoridade máxima em suas áreas de atuação</h4>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="process-v2 py-24 bg-[#0a0a0a]">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl font-black">A Jornada Digital Jurídica</h2>
                </div>
                <div class="grid md:grid-cols-4 gap-8 stagger-container">
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">1</div>
                        <h4>Entendemos suas áreas</h4>
                        <p>Analisamos suas teses jurídicas e público-alvo para atrair causas qualificadas.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">2</div>
                        <h4>Criamos um site estratégico</h4>
                        <p>Design sóbrio e moderno focado em gerar autoridade técnica e conversão imediata.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">3</div>
                        <h4>Otimizamos para o Google</h4>
                        <p>SEO Jurídico especializado para que seu escritório lidere as buscas na sua região.</p>
                    </div>
                    <div class="process-step-v3 stagger-card text-center">
                        <div class="step-icon">4</div>
                        <h4>Colocamos para rodar</h4>
                        <p>Seu escritório passa a captar novas demandas 24h por dia via plataforma digital.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Difference Section -->
        <section class="differences py-24">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal-up">
                        <h2 class="text-4xl font-black mb-8">Não criamos sites jurídicos genéricos.</h2>
                        <p class="text-xl text-gray-400 mb-8">Criamos páginas pensadas para advogados, com foco em:</p>
                        <ul class="diff-list space-y-4">
                            <li class="flex items-center gap-3">
                                <div class="dot-law"></div> Comunicação sóbria e altamente profissional
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-law"></div> Respeito integral ao código de ética da OAB
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-law"></div> Estrutura técnica que facilita a consulta inicial
                            </li>
                            <li class="flex items-center gap-3">
                                <div class="dot-law"></div> Experiência premium que transmite segurança jurídica
                            </li>
                        </ul>
                    </div>
                    <div class="reveal-up bg-white/5 p-12 rounded-3xl border border-primary/20">
                        <h3 class="text-3xl font-black mb-6">🔥 O digital funciona no Direito?</h3>
                        <p class="text-lg text-gray-300 mb-8">Sim — porque o cliente jurídico busca confiança e prova de competência antes de contratar, e seu site deve:</p>
                        <div class="flex flex-col gap-4">
                            <span class="badge-v3">👉 ATRAIR O CLIENTE DE VALOR</span>
                            <span class="badge-v3">👉 CONVENCER PELA AUTORIDADE TÉCNICA</span>
                            <span class="badge-v3">👉 GERAR CONTATO QUALIFICADO</span>
                        </div>
                        <Button href="https://wa.me/5521999064502?text=Quero atrair mais clientes para meu escritório com um site jurídico de elite." variant="primary" class="w-full mt-10 glow-button py-6 text-xl">🚀 QUERO MAIS CLIENTES AGORA</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="faq-v2 py-24 bg-black/50">
            <div class="container max-w-4xl">
                <h3 class="text-3xl font-black mb-12 text-center text-primary">Dúvidas Frequentes</h3>
                <div class="faq-grid space-y-6">
                    {faq.map((f) => (
                        <div class="faq-item-v3 reveal-up">
                            <h4 class="text-xl font-bold mb-3">{f.q}</h4>
                            <p class="text-gray-400 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta py-32 text-center relative overflow-hidden">
            <div class="container relative z-10">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Seu legado jurídico <br/> <span class="text-primary font-outfit">ganha força online.</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-button px-10">👉 QUERO MAIS CLIENTES</Button>
                    <Button href="https://wa.me/5521999064502" variant="outline" size="lg" class="px-10">SOLICITAR ANÁLISE JURÍDICA GRATUITA</Button>
                </div>
            </div>
            <div class="glow-blur-law"></div>
        </section>

        <!-- Deep SEO Content -->
        <section class="seo-text py-24 border-t border-white/5">
            <div class="container max-w-4xl mx-auto prose prose-invert prose-indigo">
                <h2 class="text-3xl font-black text-white">Liderança em <span class="text-primary">site para advogados</span></h2>
                <p>O mercado jurídico mudou com a digitalização dos processos e da busca por defesa legal. Ter um <strong>site para advogados</strong> é obrigatório para quem deseja captar causas de alto ticket e empresas. Através de um design sóbrio e tecnológico, garantimos a <strong>criação de sites para advogados</strong> que projetam a seriedade de sua banca. Nossa consultoria em <strong>atrair clientes advocacia</strong> foca em SEO Jurídico, garantindo que sua marca seja a primeira resposta do Google para problemas legais complexos.</p>
                <p>Nossos projetos respeitam 100% o Código de Ética e Disciplina da OAB, focando em um marketing de conteúdo puramente informativo e técnico. Utilizamos a infraestrutura Astro.js para entregar sites extremamente rápidos e seguros, preservando a integridade das informações e garantindo a melhor experiência para o cliente que busca seus serviços advocatícios.</p>
            </div>
        </section>

    </div>
</BaseLayout>

<style>
    .legal-theme {
        --color-primary: #c0c0c0; /* Silver/Navy Blue for Law */
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }
    .niche-page { font-family: var(--font-main); background: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.8) 70%, black 100%); }
    .hero-content-v2 { max-width: 900px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; background: rgba(192, 192, 192, 0.1); border: 1px solid rgba(192, 192, 192, 0.2); border-radius: 50px; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: #e5e7eb; }
    .hero-badge-v2 .dot { width: 8px; height: 8px; background: #c0c0c0; border-radius: 50%; box-shadow: 0 0 10px #c0c0c0; }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1.0; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 2rem; }
    .text-gradient { background: linear-gradient(135deg, #facc15, #b45309); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.3rem; color: #b0b0b0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 750px; font-weight: 500; }
    
    /* Stats Bar */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-item-v2 { display: flex; flex-direction: column; align-items: center; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: white; }
    .stat-txt { font-size: 0.8rem; color: #666; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Cards */
    .problem-card-v2 { background: #0c0c0c; padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255,255,255,0.05); transition: 0.4s; }
    .problem-card-v2:hover { border-color: var(--color-primary); transform: translateY(-10px); }
    .icon-circle { width: 70px; height: 70px; background: rgba(255, 255, 255, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 2rem; border: 1px solid rgba(255, 255, 255, 0.1); }
    .problem-card-v2 h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #eee; }
    .problem-card-v2 p { color: #888; line-height: 1.6; }

    .benefit-card-v3 { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; background: #0c0c0c; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .check-circle { width: 30px; height: 30px; background: #222; border: 1px solid var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; flex-shrink: 0; }
    .benefit-card-v3 h4 { font-size: 1.25rem; font-weight: 800; }

    .process-step-v3 .step-icon { width: 60px; height: 60px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900; margin: 0 auto 2rem; color: #fff; }
    .process-step-v3 h4 { font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem; }
    .process-step-v3 p { color: #777; line-height: 1.6; }

    .badge-v3 { padding: 12px 20px; background: rgba(255, 255, 255, 0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); font-weight: 800; color: #dfdfdf; font-size: 0.9rem; }
    .dot-law { width: 8px; height: 8px; background: var(--color-primary); border-radius: 50%; }

    /* Comparison Card */
    .comparison-container { perspective: 1200px; display: flex; justify-content: center; }
    .comparison-card { background: #111; border-radius: 20px; overflow: hidden; border: 2px solid #333; box-shadow: 0 30px 60px rgba(0,0,0,0.8); transform: rotateY(-15deg) rotateX(10deg); transition: 0.6s ease; width: 100%; max-width: 600px; aspect-ratio: 16/10; display: flex; flex-direction: column; }
    .comparison-card:hover { transform: none; border-color: var(--color-primary); }
    .project-preview-img { width: 100%; height: 100%; object-fit: cover; flex-grow: 1; }
    .card-tag { position: absolute; top: 20px; left: 20px; z-index: 10; background: #fff; color: #000; padding: 6px 12px; font-size: 0.7rem; font-weight: 900; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; }

    .glow-blur-law { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 700px; height: 700px; background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 70%); filter: blur(100px); z-index: 0; pointer-events: none; }

    .card-browser-mockup { height: 35px; background: #1a1a1a; display: flex; align-items: center; gap: 8px; padding-left: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .browser-dot-red { width: 8px; height: 8px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 8px; height: 8px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 8px; height: 8px; border-radius: 50%; background: #27c93f; }

    .text-primary { color: #fff; }
    .glow-button { background: #fff !important; color: #000 !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(255, 255, 255, 0.2); transition: 0.3s; }
    .glow-button:hover { box-shadow: 0 15px 50px rgba(255, 255, 255, 0.4); transform: translateY(-2px); }

    .faq-item-v3 { padding: 2rem; background: #0c0c0c; border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; }
    .highlight-truth { box-shadow: 0 0 60px rgba(255, 255, 255, 0.02); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .hero-actions-v2 { align-items: center; }
        .hero-actions-v2 .flex { flex-direction: column; width: 100%; }
        .hero-actions-v2 .flex Button { width: 100%; }
        .comparison-card { transform: none; }
        .stat-divider { display: none; }
        .stats-wrapper-v2 { flex-direction: column; }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        ScrollTrigger.refresh();

        // Parallax Hero
        gsap.to(".hero-bg-image", { 
            scrollTrigger: { trigger: ".hero-lp-v2", start: "top top", scrub: true }, 
            y: 100, opacity: 0.4 
        });

        // Hero animations (Load immediately)
        gsap.fromTo(".hero-reveal", { y: 40, opacity: 0 }, {
            y: 0, opacity: 1, duration: 1, stagger: 0.15, ease: "power3.out", delay: 0.2
        });

        // Reveal animations (Scroll)
        document.querySelectorAll(".reveal-up").forEach((el) => {
            gsap.fromTo(el, { y: 40, opacity: 0 }, {
                scrollTrigger: { trigger: el, start: "top 90%" },
                y: 0, opacity: 1, duration: 1, ease: "power3.out"
            });
        });

        // Stagger cards
        gsap.fromTo(".stagger-card", { y: 50, opacity: 0 }, {
            scrollTrigger: { trigger: ".stagger-container", start: "top 80%" },
            y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: "power2.out"
        });
    });
</script>
