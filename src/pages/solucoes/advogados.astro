---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import NicheMeta from "../../components/seo/NicheMeta.astro";
import SocialProofGrid from "../../components/sections/SocialProofGrid.astro";
import { Image } from "astro:assets";

const nicheName = "Advogados";
const slug = "advogados";

const painPoints = [
    {
        faIcon: "fas fa-gavel",
        title: "Prospecção Ética",
        desc: "Você quer crescer, mas precisa respeitar os limites do código de ética da OAB.",
    },
    {
        faIcon: "fas fa-building",
        title: "Escritório Fantasma",
        desc: "Seu site atual é amador e não transmite a robustez e seriedade que sua banca exige.",
    },
    {
        faIcon: "fas fa-user-slash",
        title: "Leads de Baixa Qualidade",
        desc: "Muitos curiosos entram em contato, mas poucos são os clientes ideais para o seu escritório.",
    },
];

const benefits = [
    {
        icon: "📜",
        title: "Conformidade Total OAB",
        desc: "Marketing jurídico focado em informação e autoridade, respeitando 100% o código de ética.",
    },
    {
        icon: "🏛️",
        title: "Design de Autoridade",
        desc: "Estética imponente que transmite segurança, confiança e competência técnica imediata.",
    },
    {
        icon: "📍",
        title: "SEO Jurídico Local",
        desc: "Seja a primeira resposta no Google quando um cliente busca por um especialista em sua região.",
    },
];

const testimonials = [
    {
        name: "Dr. Ricardo Oliveira",
        role: "Direito Tributário",
        result: "Autoridade Digital Estabelecida",
        quote: "A Alpha Code entendeu exatamente a seriedade que meu escritório precisava. Hoje meu site é minha principal ferramenta de apresentação para grandes clientes.",
    },
    {
        name: "Dra. Patrícia Silveira",
        role: "Direito de Família",
        result: "Dobro de consultas agendadas",
        quote: "O SEO local foi um divisor de águas. Sou encontrada por pessoas que realmente precisam de ajuda jurídica qualificada na minha região.",
    },
];

const lawProjects = [
    {
        name: "Aline Barbosa",
        image: "/assets/imagens-de-paginas/alineBarbosa.svg",
        result: "Estrategia e Conversão",
        link: "https://advogada-aline-barbosa.vercel.app/"
    },
    {
        name: "Elegance Advocacia",
        image: "/assets/imagens-de-paginas/eleganceAdvocacia.svg",
        result: "Banca de Alto Padrão",
        link: "https://eleganceadvocacia.vercel.app/"
    }
];
---

<BaseLayout
    title="Sites para Advogados e Escritórios de Advocacia | Alpha Code"
    description="Eleve o patamar do seu escritório jurídico. Sites éticos, imponentes e otimizados para atrair clientes de alto valor."
    showHeader={true}
    showFooter={true}
    showSocialProof={true}
>
    <NicheMeta slug="advogados" slot="head" />

    <!-- GSAP / Animations -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("astro:page-load", () => {
            // Force refresh for height changes
            ScrollTrigger.refresh();

            // Parallax Hero
            gsap.to(".hero-bg-image", {
                scrollTrigger: { 
                    trigger: ".hero-lp-v2", 
                    start: "top top", 
                    scrub: true 
                },
                y: 100, 
                opacity: 0.4
            });

            // Reveal animations
            document.querySelectorAll(".reveal-up").forEach((el) => {
                gsap.fromTo(el, 
                    { 
                        y: 40, 
                        opacity: 0 
                    },
                    {
                        scrollTrigger: { 
                            trigger: el, 
                            start: "top 90%", 
                            toggleActions: "play none none reverse" 
                        },
                        y: 0,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.out"
                    }
                );
            });

            // Staggered cards
            gsap.fromTo(".stagger-card", 
                { 
                    y: 60, 
                    opacity: 0 
                },
                {
                    scrollTrigger: { 
                        trigger: ".stagger-container", 
                        start: "top 80%" 
                    },
                    y: 0,
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power2.out"
                }
            );
        });
    </script>

    <div class="niche-page law-theme">
        
        <!-- HERO V2 -->
        <section class="hero-lp-v2">
            <div class="hero-bg-container">
                <img src="/assets/banners/advogados-hero.png" alt="Escritório de Advocacia Premium" class="hero-bg-image" />
                <div class="hero-overlay"></div>
            </div>
            
            <div class="container relative z-10">
                <div class="hero-content-v2">
                    <div class="hero-badge-v2 reveal-up">
                        <span class="dot gold"></span> POSICIONAMENTO DE ELITE PARA ADVOGADOS
                    </div>
                    <h1 class="hero-title-v2 reveal-up">
                        Sua Banca com a <br/>
                        <span class="text-gradient-gold">Autoridade Máxima</span> que o Direito Exige.
                    </h1>
                    <p class="hero-sub-v2 reveal-up">
                        Não seja apenas mais um no diretório. Tenha um ecossistema digital que transmite seriedade inquestionável e atrai clientes que valorizam sua expertise.
                    </p>
                    <div class="hero-actions-v2 reveal-up">
                        <Button
                            href="https://wa.me/5521999064502?text=Olá! Sou advogado(a) e desejo um site que transmita autoridade e seriedade para meu escritório."
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="glow-button-gold"
                        >
                            SOLICITAR DIAGNÓSTICO DE AUTORIDADE
                        </Button>
                        <div class="hero-trust">
                            <i class="fas fa-balance-scale"></i> Projetos 100% em conformidade com a OAB
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="stats-bar-v2">
            <div class="container">
                <div class="stats-wrapper-v2">
                    <div class="stat-item-v2">
                        <span class="stat-num">OAB OK</span>
                        <span class="stat-txt">Ética e Conformidade</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">3 dias</span>
                        <span class="stat-txt">Implementação Ágil</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item-v2">
                        <span class="stat-num">Premium</span>
                        <span class="stat-txt">Design de Alto Padrão</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Problem Awareness -->
        <section class="problem-v2 py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">O Desafio do <span class="text-gold">Posicionamento</span></h2>
                    <p class="reveal-up text-gray-400 max-w-2xl mx-auto text-lg">
                        Escritórios de excelência não podem ser representados por sites genéricos.
                    </p>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8 stagger-container">
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-gavel text-gold"></i></div>
                        <h3>Site "Cartão de Visitas"</h3>
                        <p>Sites que só têm o nome e telefone não convencem o cliente moderno a confiar sua causa a você.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-user-slash text-gold"></i></div>
                        <h3>Ausência Consultiva</h3>
                        <p>O cliente busca autoridade. Se o seu site não educa e acolhe, ele busca o próximo especialista.</p>
                    </div>
                    <div class="problem-card-v2 stagger-card">
                        <div class="icon-circle"><i class="fas fa-hourglass-half text-gold"></i></div>
                        <h3>Morosidade Digital</h3>
                        <p>Websites lentos passam uma imagem de desorganização que o cliente projeta no seu serviço jurídico.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transformation -->
        <section class="transformation-v2 py-24 bg-dark-accent">
            <div class="container">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="content-side reveal-up">
                        <span class="tag-v2 gold">A BANCA DO FUTURO</span>
                        <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">Sua vitrine jurídica <br/> em <span class="text-gold">Nível Global</span>.</h2>
                        <div class="transformation-points">
                            <div class="point-item">
                                <div class="point-icon"><i class="fas fa-times-circle"></i></div>
                                <div class="point-text">
                                    <strong>Cenário Comum:</strong>
                                    Websites confusos, lentos e que não passam a segurança necessária para grandes causas.
                                </div>
                            </div>
                            <div class="point-item success-gold">
                                <div class="point-icon"><i class="fas fa-shield-alt"></i></div>
                                <div class="point-text">
                                    <strong>Sua Nova Realidade:</strong>
                                    Presença imponente, SEO jurídico técnico e total foco em autoridade e prospecção ética.
                                </div>
                            </div>
                        </div>
                        <Button href="#investimento" variant="outline" class="mt-8">VER ESTRUTURA E INVESTIMENTO</Button>
                    </div>
                    <div class="image-side reveal-up">
                        <div class="comparison-container">
                            <div class="comparison-card legacy">
                                <div class="card-tag">ANTES (GENÉRICO)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <div class="legacy-content">
                                    <div class="skeleton-title" style="width: 70%; background: #222; height: 10px;"></div>
                                    <div class="skeleton-text" style="width: 95%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-text" style="width: 90%; background: #1a1a1a; height: 6px;"></div>
                                    <div class="skeleton-img" style="display: flex; align-items: center; justify-content: center; background: #111; border: 1px dashed #333; color: #222; font-size: 0.7rem; font-weight: 800;">IMAGE_NOT_FOUND.JPG</div>
                                    <div style="width: 80px; height: 25px; background: #222; border: 1px solid #333; margin-top: 10px;"></div>
                                </div>
                            </div>
                            
                            <div class="comparison-card premium bord-gold">
                                <div class="card-tag flagship-gold">DEPOIS (ALPHA CODE)</div>
                                <div class="card-browser-mockup">
                                    <div class="browser-dot-red"></div>
                                    <div class="browser-dot-yellow"></div>
                                    <div class="browser-dot-green"></div>
                                </div>
                                <img src="/assets/imagens-de-paginas/eleganceAdvocacia.svg" alt="Projeto Real Elegance Advocacia" class="project-preview-img" />
                                <div class="project-info-overlay">
                                    <strong>Flagship: Elegance Advocacia</strong>
                                    <span>Presença Jurídica de Impacto</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Portfolio Specialist -->
        <section class="niche-portfolio py-24">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black mb-6">Cases de <span class="text-gold">Sucesso Jurídico</span></h2>
                </div>
                <div class="grid md:grid-cols-2 max-w-4xl mx-auto gap-8">
                    {lawProjects.map((p) => (
                        <a href={p.link} target="_blank" class="psy-project-card reveal-up group border-gold-hover">
                            <div class="psy-img-wrapper">
                                <img src={p.image} alt={p.name} />
                                <div class="psy-overlay gold-bg">
                                    <span>CONHECER SITE <i class="fas fa-external-link-alt"></i></span>
                                </div>
                            </div>
                            <div class="psy-info">
                                <h3>{p.name}</h3>
                                <p><span class="dot gold"></span> {p.result}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="pricing-v2 py-24" id="investimento">
            <div class="container">
                <div class="section-header-v2 text-center mb-16">
                    <h2 class="reveal-up text-4xl md:text-5xl font-black">Investimento Estratégico</h2>
                    <p class="reveal-up text-gray-400 mt-4">Menos do que o valor de uma única consultoria para elevar o patamar do seu escritório.</p>
                </div>
                
                <div class="pricing-grid-v2">
                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ESSENCIAL</h3>
                            <p>Presença jurídica digital eficiente</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 397</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">295</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CHECKOUT SEGURO</Button>
                    </div>

                    <div class="p-card-v2 featured reveal-up">
                        <div class="pop">MAIS PROCURADO</div>
                        <div class="head">
                            <h3>Banca Autoridade</h3>
                            <p>Ecossistema de autoridade e blog</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 697</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">449</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="primary" class="w-full glow-btn-gold">QUERO ESTE PLANO</Button>
                    </div>

                    <div class="p-card-v2 reveal-up">
                        <div class="head">
                            <h3>ELITE JURÍDICA</h3>
                            <p>Marketing de alta escala e prospecção</p>
                        </div>
                        <div class="price">
                            <span class="old font-outfit">R$ 1.297</span>
                            <div class="current">
                                <span class="curr">R$</span>
                                <span class="val">710</span>
                            </div>
                            <span class="method">À vista no PIX</span>
                        </div>
                        <Button href="https://wa.me/5521999064502" variant="outline" class="w-full">CONSULTAR DETALHES</Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="final-cta-v2 py-32 relative overflow-hidden">
            <div class="container relative z-10 text-center">
                <h2 class="reveal-up text-5xl md:text-7xl font-black mb-8">Construa seu <br/> <span class="text-gold font-outfit">Legado Digital</span></h2>
                <div class="reveal-up flex flex-wrap justify-center gap-6">
                    <Button href="https://wa.me/5521999064502" variant="primary" size="lg" class="glow-btn-gold">FALAR COM UM ESPECIALISTA</Button>
                </div>
            </div>
            <div class="glow-gold-1"></div>
        </section>

    </div>
</BaseLayout>

<style>
    .law-theme {
        --color-gold: #D4AF37;
        --color-primary: #8a1c26;
        --color-bg-dark: #050505;
        --color-surface: #0a0a0a;
        --color-accent: #111111;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-heading: 'Outfit', sans-serif;
    }

    .niche-page { font-family: var(--font-main); background-color: var(--color-bg-dark); color: white; overflow-x: hidden; }
    .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }

    /* Hero */
    .hero-lp-v2 { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; background-color: black; }
    .hero-bg-container { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-bg-image { width: 100%; height: 110%; object-fit: cover; opacity: 0.5; filter: saturate(0.6) brightness(0.6); }
    .hero-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, transparent 0%, rgba(0,0,0,0.9) 70%, black 100%); }
    .hero-content-v2 { max-width: 850px; }
    .hero-badge-v2 { display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(212, 175, 55, 0.1); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 50px; font-size: 0.8rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 2.5rem; color: var(--color-gold); }
    .hero-badge-v2 .dot.gold { width: 8px; height: 8px; background: var(--color-gold); border-radius: 50%; box-shadow: 0 0 10px var(--color-gold); }
    .hero-title-v2 { font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 2rem; }
    .text-gradient-gold { background: linear-gradient(135deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-sub-v2 { font-size: 1.25rem; color: #a0a0a0; line-height: 1.6; margin-bottom: 3.5rem; max-width: 680px; }
    .hero-actions-v2 { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    .hero-trust { font-size: 0.9rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .hero-trust i { color: var(--color-gold); }

    /* Stats */
    .stats-bar-v2 { background: var(--color-surface); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 2.5rem 0; margin-top: -40px; position: relative; z-index: 10; }
    .stats-wrapper-v2 { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; }
    .stat-num { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--color-gold); }
    .stat-txt { font-size: 0.85rem; color: #666; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255, 255, 255, 0.1); }

    /* Problem */
    .problem-card-v2 { background: var(--color-accent); padding: 3rem 2rem; border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.05); transition: all 0.4s ease; text-align: center; }
    .problem-card-v2:hover { border-color: var(--color-gold); transform: translateY(-8px); }
    .icon-circle { width: 80px; height: 80px; background: rgba(212, 175, 55, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 2rem; border: 1px solid rgba(212, 175, 55, 0.1); }
    .text-gold { color: var(--color-gold); }

    /* Transformation */
    .bg-gold { background: var(--color-gold) !important; color: black !important; }
    .tag-v2.gold { color: var(--color-gold); }
    .success-gold { border-color: rgba(212, 175, 55, 0.2) !important; background: rgba(212, 175, 55, 0.02) !important; }
    .success-gold i { color: var(--color-gold) !important; }
    .comparison-frame { border-radius: 24px; overflow: hidden; border: 1px solid rgba(212, 175, 55, 0.2); box-shadow: 0 40px 80px rgba(0,0,0,0.6); }

    /* Portfolio */
    .border-gold-hover:hover { border-color: var(--color-gold) !important; }
    .gold-bg { background: rgba(212, 175, 55, 0.9) !important; }
    .dot.gold { background: var(--color-gold); box-shadow: 0 0 5px var(--color-gold); }

    /* CTA */
    .final-cta-v2 { background: radial-gradient(circle at center, #0a0a0a 0%, black 100%); }
    .glow-btn-gold { background: var(--color-gold) !important; color: black !important; font-weight: 900 !important; box-shadow: 0 10px 40px rgba(212, 175, 55, 0.3); }
    .glow-btn-gold:hover { box-shadow: 0 15px 50px rgba(212, 175, 55, 0.5); transform: translateY(-2px); }
    .glow-gold-1 { position: absolute; top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 70%); }

    @media (max-width: 768px) {
        .hero-title-v2 { font-size: 2.8rem; }
        .stat-divider { display: none; }
    }
    /* Advanced Transformation Styles */
    .comparison-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
        perspective: 1500px;
        margin-top: 2rem;
    }

    .comparison-card {
        background: #0f0f0f;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
        transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .comparison-card.legacy {
        opacity: 0.35;
        transform: scale(0.9) rotateY(15deg) translateX(-30px);
        filter: grayscale(1) blur(1px);
        z-index: 1;
    }

    .comparison-card.premium {
        z-index: 3;
        border: 2px solid var(--color-gold);
        box-shadow: 0 0 100px rgba(212, 175, 55, 0.15);
        transform: scale(1.1) rotateY(-10deg) translateX(30px) translateY(-20px);
    }

    .comparison-card:hover {
        transform: scale(1.05) translateZ(50px) !important;
        z-index: 10;
        opacity: 1 !important;
        filter: none !important;
    }

    .card-tag {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 15;
        padding: 6px 14px;
        font-size: 0.65rem;
        font-weight: 950;
        border-radius: 6px;
        background: rgba(0,0,0,0.8);
        color: white;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .card-tag.flagship-gold {
        background: var(--color-gold);
        color: black;
        border: none;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
    }

    .card-browser-mockup {
        height: 40px;
        background: #111;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 25px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .browser-dot-red { width: 10px; height: 10px; border-radius: 50%; background: #ff5f56; }
    .browser-dot-yellow { width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e; }
    .browser-dot-green { width: 10px; height: 10px; border-radius: 50%; background: #27c93f; }

    .legacy-content { 
        padding: 4rem 3rem; 
        display: flex; 
        flex-direction: column; 
        gap: 1.5rem; 
        background: #080808;
    }
    .skeleton-title { height: 12px; width: 35%; background: #222; border-radius: 2px; }
    .skeleton-text { height: 6px; width: 85%; background: #1a1a1a; border-radius: 1px; }
    .skeleton-text.short { width: 25%; }
    .skeleton-img { height: 140px; width: 100%; background: #151515; border-radius: 8px; border: 1px dashed #222; margin-top: 1rem; }

    .project-preview-img { 
        width: 100%; 
        height: auto; 
        display: block; 
        filter: brightness(1.05);
        transition: transform 0.8s ease;
    }

    .project-info-overlay {
        position: absolute;
        bottom: 30px;
        left: 30px;
        right: 30px;
        background: rgba(10, 10, 10, 0.6);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        padding: 20px 30px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        display: flex;
        flex-direction: column;
        gap: 6px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.5);
    }

    .project-info-overlay strong { 
        display: block; 
        font-size: 1.1rem; 
        font-family: var(--font-heading);
        font-weight: 800;
        letter-spacing: -0.01em;
    }
    .project-info-overlay span { 
        font-size: 0.8rem; 
        color: #4ade80; 
        font-weight: 700; 
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    @media (min-width: 1024px) {
        .comparison-container { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            align-items: center; 
            gap: 0; 
        }
        .comparison-card.legacy { 
            transform: translateX(60px) scale(0.85) rotateY(20deg);
        }
        .comparison-card.premium { 
            transform: scale(1.15) rotateY(-15deg) translateX(-20px);
            box-shadow: 0 60px 120px rgba(0,0,0,0.9);
        }
    }
    .reveal-up { opacity: 1; }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll(".reveal-up").forEach((el) => {
            gsap.from(el, {
                scrollTrigger: {
                    trigger: el,
                    start: "top 90%",
                },
                y: 40,
                opacity: 0,
                duration: 1,
                ease: "power3.out"
            });
        });
    });
</script>
