---
import { getAllCities, type CityContent } from "../../data/cities";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import SchemaMarkup from "../../components/seo/SchemaMarkup.astro";
import RelatedContent from "../../components/seo/RelatedContent.astro";
import { buildSEOTitle, buildSEODescription } from "../../utils/seo";

export const prerender = true;

export function getStaticPaths() {
    return getAllCities().map((city) => ({
        params: { slug: city.slug },
        props: { city },
    }));
}

interface Props {
    city: CityContent;
}

const { city } = Astro.props;

const painPoints = [
    {
        icon: "📉",
        title: "Falta de Credibilidade",
        desc: `Uma empresa em ${city.name} sem site profissional transmite menos confiança que a concorrência. No Google, quem não tem presença digital simplesmente não existe.`,
    },
    {
        icon: "📱",
        title: "Ausência de Presença Digital",
        desc: "Redes sociais são terreno alugado. Um site próprio é o único ativo digital que você controla e que transmite a seriedade da sua marca.",
    },
    {
        icon: "😶",
        title: "Falta de Autoridade Local",
        desc: `Para ser reconhecido como a principal referência em ${city.name}, você precisa aparecer no topo do Google quando o cliente pesquisa pelo seu serviço.`,
    },
];

const benefits = [
    {
        icon: "🚀",
        title: "SEO Local Agressivo",
        desc: "Técnicas avançadas de SEO para colocar o seu negócio na frente de quem já quer comprar na sua região.",
    },
    {
        icon: "💬",
        title: "Conversão via WhatsApp",
        desc: "Botões estratégicos de ação direcionados para o WhatsApp do seu atendimento, com mensagem pré-preenchida.",
    },
    {
        icon: "💎",
        title: "Apresentação Premium",
        desc: "Espaço para mostrar seus diferenciais, atuando como um filtro de qualidade para clientes e pacientes.",
    },
];

const features = [
    {
        icon: "🎨",
        title: "Design Moderno e Profissional",
        desc: "Causamos uma primeira impressão perfeita com visual harmônico que transmite confiança e profissionalismo.",
    },
    {
        icon: "⚡",
        title: "Site Rápido e Otimizado",
        desc: "Desenvolvemos com código limpo para carregamento instantâneo, vital para clientes e para o ranqueamento no Google.",
    },
    {
        icon: "📱",
        title: "Versão Mobile Premium",
        desc: "Mais de 85% das pesquisas locais são feitas pelo celular. Seu site funcionará como um app intuitivo.",
    },
    {
        icon: "🔍",
        title: "Estrutura para SEO Local",
        desc: "Boas práticas, meta tags completas, schema LocalBusiness e otimização para dominar as buscas na sua cidade.",
    },
];

const targetAudiences = [
    {
        title: "Psicólogos e terapeutas",
        benefit: `Atraia pacientes que buscam exatamente sua abordagem terapêutica em ${city.name}.`,
    },
    {
        title: "Médicos e dentistas",
        benefit: "Mostre suas especialidades, estrutura e diferenciais para pacientes da região.",
    },
    {
        title: "Clínicas e consultórios",
        benefit: "Facilite o agendamento online e transmita confiança desde o primeiro contato.",
    },
    {
        title: "Advogados",
        benefit: `Apareça no Google quando alguém precisar do seu escritório com urgência em ${city.name}.`,
    },
    {
        title: "Arquitetos e engenheiros",
        benefit: "Exiba seu portfólio de forma sofisticada e atraia novos projetos.",
    },
    {
        title: "Contadores",
        benefit: "Demonstre credibilidade e atraia empresas que buscam regularização e planejamento.",
    },
];

const breadcrumbs = [
    { name: "Início", url: "https://www.sitesalphacode.com.br/" },
    {
        name: `Criação de Sites em ${city.name}`,
        url: `https://www.sitesalphacode.com.br/cidades/${city.slug}/`,
    },
];

const canonicalUrl = `https://www.sitesalphacode.com.br/cidades/${city.slug}/`;
---

<BaseLayout
    title={buildSEOTitle(city.seoTitle)}
    description={buildSEODescription(city.seoDescription)}
    canonicalUrl={canonicalUrl}
    keywords={city.localKeywords}
    schemaType={city.schemaType}
    schemaName={city.seoTitle}
    schemaDescription={city.seoDescription}
    faqItems={city.faq}
>
    <SchemaMarkup
        type={city.schemaType}
        name={city.name}
        description={city.seoDescription}
        addressLocality={city.nap.addressLocality}
        addressRegion={city.nap.addressRegion}
        addressCountry={city.nap.addressCountry}
        faqItems={city.faq}
        breadcrumbs={breadcrumbs}
    />

    <article class="local-landing-wrapper">
        <!-- HERO -->
        <section class="hero-local">
            <div class="hero-bg-visuals">
                <div class="orb-main"></div>
                <div class="orb-secondary"></div>
                <div class="grid-mesh"></div>
            </div>

            <div class="container relative z-10">
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <a href="/">Início</a>
                    <span class="separator">›</span>
                    <span aria-current="page">Criação de Sites em {city.name}</span>
                </nav>

                <div class="hero-content-box">
                    <span class="hero-badge">Alpha Code {city.name}</span>
                    <h1 class="hero-title">
                        Criação de Sites de <br />
                        <span class="text-gradient">Alta Performance</span> <br />
                        em {city.name}
                    </h1>
                    <p class="hero-sub">{city.heroIntro}</p>
                    <div class="hero-cta">
                        <Button
                            href={`https://wa.me/5521999064502?text=Quero%20um%20site%20profissional%20em%20${encodeURIComponent(city.name)}.`}
                            target="_blank"
                            variant="primary"
                            size="lg"
                            class="glow-effect"
                        >
                            FALAR COM UM ESPECIALISTA
                        </Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- PROBLEMAS -->
        <section class="concise-problems">
            <div class="container">
                <div class="section-header">
                    <h2>Seu negócio em {city.name} <br /><span class="highlight">não pode ser invisível</span></h2>
                    <p>O mercado mudou. Se você não é encontrado quando o cliente pesquisa no Google, você simplesmente não existe para ele.</p>
                </div>
                <div class="problems-grid">
                    {painPoints.map((p) => (
                        <div class="problem-card-modern">
                            <div class="card-icon">{p.icon}</div>
                            <h3>{p.title}</h3>
                            <p>{p.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- BENEFÍCIOS -->
        <section class="visual-benefits">
            <div class="container">
                <div class="benefits-layout">
                    <div class="benefits-image-placeholder">
                        <div class="portfolio-showcase-container">
                            <div class="glass-mockup project-active showcase-item">
                                <div class="mockup-header">
                                    <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
                                    <span class="project-tag">Psicologia</span>
                                </div>
                                <div class="mockup-img-v2">
                                    <img loading="lazy" src="/assets/imagens-de-paginas/nayanneJustiniano.svg" alt="Case de sucesso - Psicologia" />
                                    <div class="mockup-badge">CLIENTE REAL</div>
                                </div>
                            </div>
                            <div class="glass-mockup project-hidden showcase-item">
                                <div class="mockup-header">
                                    <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
                                    <span class="project-tag">Jurídico</span>
                                </div>
                                <div class="mockup-img-v2">
                                    <img loading="lazy" src="/assets/imagens-de-paginas/eleganceAdvocacia.svg" alt="Case de sucesso - Advocacia" />
                                    <div class="mockup-badge">CLIENTE REAL</div>
                                </div>
                            </div>
                            <div class="glass-mockup project-hidden showcase-item">
                                <div class="mockup-header">
                                    <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
                                    <span class="project-tag">Gastronomia</span>
                                </div>
                                <div class="mockup-img-v2">
                                    <img loading="lazy" src="/assets/imagens-de-paginas/pizzaria.svg" alt="Case de sucesso - Pizzaria" />
                                    <div class="mockup-badge">CLIENTE REAL</div>
                                </div>
                            </div>
                            <div class="showcase-nav">
                                <button class="nav-dot showcase-dot active" data-target="0"></button>
                                <button class="nav-dot showcase-dot" data-target="1"></button>
                                <button class="nav-dot showcase-dot" data-target="2"></button>
                            </div>
                        </div>
                    </div>
                    <div class="benefits-content">
                        <h2>Por que somos a <br /><span class="text-gradient">escolha lógica em {city.name}?</span></h2>
                        <div class="benefits-stack">
                            {benefits.map((b) => (
                                <div class="benefit-row">
                                    <div class="benefit-row-icon">{b.icon}</div>
                                    <div class="benefit-row-text">
                                        <h3>{b.title}</h3>
                                        <p>{b.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FEATURES -->
        <section class="features-modern">
            <div class="container">
                <div class="section-header text-center">
                    <h2>O que o seu <span class="highlight">Site Alpha</span> terá:</h2>
                </div>
                <div class="features-modern-grid">
                    {features.map((f) => (
                        <div class="feature-item-modern">
                            <div class="feature-header">
                                <span class="feature-icon-box">{f.icon}</span>
                                <h3>{f.title}</h3>
                            </div>
                            <p>{f.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- PÚBLICO-ALVO -->
        <section class="audiences-section">
            <div class="container">
                <div class="section-header text-center">
                    <h2>Soluções para todos os nichos em {city.name}</h2>
                </div>
                <div class="audiences-grid">
                    {targetAudiences.map((aud) => (
                        <div class="audience-card-modern">
                            <h3>{aud.title}</h3>
                            <p>{aud.benefit}</p>
                            <div class="card-arrow">→</div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- CONTEÚDO ÚNICO (único por cidade) -->
        <section class="long-content">
            <div class="container text-content">
                <div class="seo-prose" set:html={city.longContent}></div>

                <!-- FAQ local -->
                <div class="faq-local">
                    <h2>Perguntas Frequentes sobre sites em {city.name}</h2>
                    <div class="faq-list">
                        {city.faq.map((f) => (
                            <details class="faq-item-local">
                                <summary>{f.question}</summary>
                                <p>{f.answer}</p>
                            </details>
                        ))}
                    </div>
                </div>

                <!-- Cidades relacionadas -->
                <div class="related-cities">
                    <h3>Cidades próximas que também atendemos</h3>
                    <div class="cities-grid">
                        {getAllCities()
                            .filter((c) => c.slug !== city.slug)
                            .slice(0, 8)
                            .map((c) => (
                                <a href={`/cidades/${c.slug}/`} class="city-link">
                                    {c.name} - {c.state}
                                </a>
                            ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA FINAL -->
        <section class="final-cta-section">
            <div class="container">
                <div class="final-cta-content text-center">
                    <h2>Pronto para dominar o digital em {city.name}?</h2>
                    <p>Agende uma conversa estratégica e descubra como podemos elevar sua marca.</p>
                    <div class="actions" style="margin-top: 32px;">
                        <Button
                            href="https://wa.me/5521999064502"
                            variant="primary"
                            size="lg"
                            class="glow-effect pulse-anim"
                        >
                            FALAR COM UM ESPECIALISTA AGORA
                        </Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Hub-and-Spoke: linkagem interna automática -->
        <RelatedContent
            type="city"
            city={city.name}
            citySlug={city.slug}
            title={`Mais conteúdos e cidades próximas de ${city.name}`}
            limit={6}
        />
    </article>
</BaseLayout>

<style>
    .local-landing-wrapper {
        background-color: #050505;
        color: #e0e0e0;
        font-family: "Plus Jakarta Sans", sans-serif;
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .relative { position: relative; }
    .z-10 { z-index: 10; }
    .text-center { text-align: center; }

    .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: #888;
        margin-bottom: 24px;
        text-align: left;
    }
    .breadcrumbs a {
        color: var(--color-primary, #d42838);
        text-decoration: none;
    }
    .breadcrumbs a:hover { text-decoration: underline; }
    .breadcrumbs .separator { opacity: 0.5; }

    .highlight {
        color: var(--color-primary, #d42838);
        font-weight: 800;
    }
    .text-gradient {
        background: linear-gradient(135deg, #fff 0%, #d42838 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
    section { padding: 80px 0; }

    /* HERO */
    .hero-local {
        min-height: 80vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 160px 0 80px;
        text-align: center;
    }
    .hero-bg-visuals {
        position: absolute;
        inset: 0;
        z-index: 1;
    }
    .orb-main {
        position: absolute;
        width: 800px;
        height: 800px;
        background: radial-gradient(circle, rgba(212, 40, 56, 0.3) 0%, transparent 75%);
        top: -200px;
        right: -200px;
        filter: blur(120px);
        animation: float 20s infinite alternate ease-in-out;
    }
    .orb-secondary {
        position: absolute;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 75%);
        bottom: -150px;
        left: -150px;
        filter: blur(100px);
    }
    .grid-mesh {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 50px 50px;
        mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
    }
    @keyframes float {
        0% { transform: translate(0, 0); }
        100% { transform: translate(-30px, 40px); }
    }
    .hero-badge {
        display: inline-block;
        padding: 8px 20px;
        background: rgba(212, 40, 56, 0.1);
        border: 1px solid rgba(212, 40, 56, 0.3);
        border-radius: 100px;
        color: #d42838;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 24px;
        letter-spacing: 1px;
    }
    .hero-title {
        font-family: "Outfit", sans-serif;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.1;
        font-weight: 800;
        color: white;
        margin-bottom: 32px;
    }
    .hero-sub {
        font-size: 1.15rem;
        color: #a0a0a0;
        max-width: 800px;
        margin: 0 auto 32px;
        line-height: 1.7;
    }

    /* SECTION HEADERS */
    .section-header { margin-bottom: 60px; }
    .section-header h2 {
        font-family: "Outfit", sans-serif;
        font-size: 2.4rem;
        font-weight: 800;
        color: white;
        line-height: 1.2;
        margin-bottom: 16px;
    }
    .section-header p {
        font-size: 1.1rem;
        color: #888;
        max-width: 700px;
    }
    .text-center .section-header p { margin: 0 auto; }

    /* PROBLEMS */
    .problems-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }
    .problem-card-modern {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 40px 30px;
        border-radius: 24px;
        transition: all 0.3s;
    }
    .problem-card-modern:hover {
        background: rgba(255, 255, 255, 0.05);
        transform: translateY(-6px);
    }
    .card-icon { font-size: 2.5rem; margin-bottom: 16px; }
    .problem-card-modern h3 {
        color: #fff;
        font-size: 1.3rem;
        margin-bottom: 12px;
        font-weight: 800;
    }
    .problem-card-modern p { color: #aaa; line-height: 1.6; }

    /* BENEFITS */
    .benefits-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }
    .portfolio-showcase-container {
        position: relative;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 24px;
        padding: 20px;
        min-height: 400px;
    }
    .glass-mockup {
        background: #111;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 16px;
    }
    .project-hidden { display: none; }
    .project-active { display: block; }
    .mockup-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 12px;
        background: #0a0a0a;
        border-bottom: 1px solid #222;
    }
    .mockup-header span:not(.project-tag) {
        width: 8px; height: 8px; border-radius: 50%;
    }
    .dot-red { background: #ff5f57; }
    .dot-yellow { background: #ffbd2e; }
    .dot-green { background: #28c840; }
    .project-tag {
        margin-left: auto;
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .mockup-img-v2 {
        position: relative;
        aspect-ratio: 16/10;
        overflow: hidden;
    }
    .mockup-img-v2 img { width: 100%; height: 100%; object-fit: cover; }
    .mockup-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 4px 10px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 700;
    }
    .showcase-nav {
        display: flex;
        justify-content: center;
        gap: 8px;
    }
    .nav-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #333;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
    }
    .nav-dot.active { background: #d42838; }
    .benefits-content h2 {
        font-family: "Outfit", sans-serif;
        font-size: 2.4rem;
        font-weight: 800;
        color: white;
        line-height: 1.2;
        margin-bottom: 32px;
    }
    .benefits-stack { display: flex; flex-direction: column; gap: 24px; }
    .benefit-row { display: flex; gap: 16px; align-items: flex-start; }
    .benefit-row-icon { font-size: 2rem; }
    .benefit-row-text h3 {
        color: #fff;
        font-size: 1.2rem;
        margin-bottom: 6px;
    }
    .benefit-row-text p { color: #aaa; line-height: 1.6; }

    /* FEATURES */
    .features-modern-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }
    .feature-item-modern {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 30px;
        border-radius: 20px;
    }
    .feature-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }
    .feature-icon-box { font-size: 1.8rem; }
    .feature-item-modern h3 {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 700;
    }
    .feature-item-modern p { color: #aaa; line-height: 1.6; font-size: 0.95rem; }

    /* AUDIENCES */
    .audiences-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
    }
    .audience-card-modern {
        background: #111;
        padding: 24px;
        border-radius: 16px;
        border-left: 3px solid #d42838;
    }
    .audience-card-modern h3 {
        color: #fff;
        margin-bottom: 10px;
        font-size: 1.15rem;
    }
    .audience-card-modern p { color: #aaa; line-height: 1.5; }
    .card-arrow { color: #d42838; margin-top: 12px; font-size: 1.4rem; }

    /* LONG CONTENT */
    .long-content { padding: 60px 0; }
    .text-content { max-width: 900px; margin: 0 auto; }
    .seo-prose { color: #ccc; line-height: 1.8; font-size: 1.05rem; }
    .seo-prose :global(p) { margin-bottom: 1.5rem; }
    .seo-prose :global(h3) {
        color: #fff;
        font-size: 1.5rem;
        margin: 2rem 0 1rem;
        font-weight: 700;
    }
    .seo-prose :global(ul) { margin: 1rem 0 1.5rem; padding-left: 24px; }
    .seo-prose :global(li) { margin-bottom: 8px; }
    .seo-prose :global(strong) { color: #fff; }
    .seo-prose :global(code) {
        background: #1a1a1a;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
    }

    /* FAQ */
    .faq-local { margin-top: 60px; }
    .faq-local h2 {
        color: #fff;
        font-size: 1.8rem;
        margin-bottom: 24px;
    }
    .faq-list { display: flex; flex-direction: column; gap: 12px; }
    .faq-item-local {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 16px 20px;
    }
    .faq-item-local summary {
        cursor: pointer;
        color: #fff;
        font-weight: 600;
        list-style: none;
        position: relative;
        padding-right: 30px;
    }
    .faq-item-local summary::after {
        content: "+";
        position: absolute;
        right: 0;
        color: #d42838;
        font-weight: 700;
        font-size: 1.4rem;
    }
    .faq-item-local[open] summary::after { content: "−"; }
    .faq-item-local p { color: #aaa; line-height: 1.7; margin-top: 12px; }

    /* CIDADES RELACIONADAS */
    .related-cities {
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .related-cities h3 {
