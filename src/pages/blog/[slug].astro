---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

// SSR: o filtro de data precisa ser avaliado a cada requisição.
// Com prerender=true o `now` é congelado no build e artigos agendados
// para datas futuras só apareceriam após um novo deploy.
export const prerender = false;

const { slug } = Astro.params;
const now = new Date();

const post = (await getCollection("blog")).find(
    (entry) => entry.slug === slug,
);

if (!post || post.data.draft === true || post.data.pubDate > now) {
    return Astro.redirect("/404");
}

const { Content } = await post.render();
---

<BlogLayout
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    heroImage={post.data.heroImage}
    author={post.data.author}
    content={post.body}
    slug={post.slug}
    ctaType={post.data.ctaType}
    categories={post.data.categories ?? []}
    tags={post.data.tags ?? []}
    caseClient={post.data.caseClient}
    caseRating={post.data.caseRating}
    caseReview={post.data.caseReview}
>
    <Content />
</BlogLayout>
