---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Proof from "../components/sections/Proof.astro";
import Portfolio from "../components/sections/Portfolio.astro";
import Features from "../components/sections/Features.astro";
import Process from "../components/sections/Process.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Pricing from "../components/sections/Pricing.astro";
import Faq from "../components/sections/Faq.astro";
import CTA from "../components/sections/CTA.astro";
import SEOContent from "../components/sections/SEOContent.astro";

const title = "Criação de Sites Profissionais de Elite | Alpha Code";
const description = "Transformamos seu negócio em uma autoridade digital. Criação de sites de alta performance (Astro.js) com foco em conversão e SEO. Orçamento em 24h.";

const keywords = [
  "criação de sites",
  "sites profissionais",
  "landing page",
  "site para médicos",
  "site para advogados",
  "alpha code",
];

export const prerender = false;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- 1. ATENÇÃO: Hero de Alto Impacto -->
  <Hero />

  <!-- 2. INTERESSE: Autoridade e Números Reais -->
  <Proof />

  <!-- 3. DESEJO: Portfólio de Elite (3 Projetos Fortes) -->
  <Portfolio />

  <!-- 4. DIFERENCIAIS: Por que somos a escolha lógica -->
  <Features />

  <!-- 5. CLAREZA: Processo Profissional em 5 Etapas -->
  <Process />

  <!-- 6. PROVA SOCIAL: Depoimentos de Clientes Reais -->
  <Testimonials />

  <!-- 7. DECISÃO: Planos e Oferta Estratégica -->
  <Pricing />

  <!-- 8. OBJEÇÃO: FAQ para quebrar barreiras -->
  <Faq />
  
  <!-- 9. AÇÃO: CTA Final Inescapável -->
  <CTA />

  <!-- SEO Técnico (Escondido por padrão para UX) -->
  <div class="opacity-80">
    <SEOContent />
  </div>
</BaseLayout>
