---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import Features from "../components/sections/Features.astro";
import Audience from "../components/sections/Audience.astro";
import Projects from "../components/sections/Projects.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Services from "../components/sections/Services.astro";
import Plans from "../components/sections/Plans.astro";
import Process from "../components/sections/Process.astro";
import Investment from "../components/sections/Investment.astro";
import About from "../components/sections/About.astro";
import FAQ from "../components/sections/FAQ.astro";
import SEOContent from "../components/sections/SEOContent.astro";
import RecentPosts from "../components/sections/RecentPosts.astro";
import Contact from "../components/sections/Contact.astro";
import ServiceSegments from "../components/sections/ServiceSegments.astro";
import { createSEOMeta } from "../utils/seo";

const title = "Criação de Sites Profissionais e Landing Pages";
const description =
  "Especialistas em sites de alta performance para profissionais da saúde e negócios que precisam de presença digital profissional. Aumente sua autoridade e vendas com um site rápido, bonito e otimizado para o Google.";

const keywords = [
  "criação de sites",
  "sites profissionais",
  "landing page",
  "site para médicos",
  "site para advogados",
  "site institucional empresas",
  "site profissional clínicas",
  "site para escola particular",
  "site para escritório advocacia",
  "desenvolvimento web",
  "criação de sites rj",
  "agência de sites",
  "sites rápidos",
  "seo para sites",
  "alpha code",
  "portfólio online",
];

export const prerender = false;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <Hero />
  <div class="desktop-only">
    <TrustBar />
  </div>
  <Features />
  <!-- Why Section -->
  <Audience />
  <div class="desktop-only">
    <ServiceSegments />
  </div>
  <Projects />
  <Process />
  <Testimonials />
  <Services />
  <Plans />
  <Investment />
  <About />
  <SEOContent />
  <RecentPosts />
  <FAQ />
  <Contact />
</BaseLayout>
