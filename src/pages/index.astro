---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Proof from "../components/sections/Proof.astro";
import Process from "../components/sections/Process.astro";
import Audience from "../components/sections/Audience.astro";
import Features from "../components/sections/Features.astro";
import Pricing from "../components/sections/Pricing.astro";
import CTA from "../components/sections/CTA.astro";
import Faq from "../components/sections/Faq.astro";
import SEOContent from "../components/sections/SEOContent.astro";

const title = "Criação de Sites Profissionais que Geram Clientes | Alpha Code";
const description = "Transformamos seu site em uma máquina de gerar clientes. Criação de sites profissionais para empresas com foco em conversão imediata e SEO de Elite.";

const keywords = [
  "criação de sites profissionais",
  "criação de sites para empresas",
  "site que gera clientes",
  "marketing digital",
  "landing page de alta conversão",
  "alpha code",
];

export const prerender = false;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- 1. HERO: Headline de Impacto + CTA Forte -->
  <Hero />

  <!-- 2. PROVA/AUTORIDADE: Números que trazem confiança -->
  <Proof />

  <!-- 3. COMO FUNCIONA: O caminho claro para o resultado -->
  <Process />

  <!-- 4. PARA QUEM É: Segmentação e identificação -->
  <Audience />

  <!-- 5. BENEFÍCIOS: Diferenciais que matam a concorrência -->
  <Features />

  <!-- 6. OFERTA: Planos estratégicos para cada fase -->
  <Pricing />

  <!-- 7. CTA REPETIDO: Captura após a oferta -->
  <CTA />

  <!-- 8. FAQ: Quebrando objeções e ajudando no SEO -->
  <Faq />
  
  <!-- SEO Técnico e Conteúdo Profundo -->
  <div class="opacity-80">
    <SEOContent />
  </div>
</BaseLayout>
