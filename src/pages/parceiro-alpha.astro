---
import Layout from "../layouts/BaseLayout.astro";
---

<Layout title="Parceiro Alpha | A Sua Nova Sede Digital" showWhatsApp={true}>
    <main class="partner-page">
        <!-- Scroll Progress Bar -->
        <div class="scroll-progress"></div>

        <!-- Hero Section -->
        <section class="partner-hero">
            <div class="hero-particles" id="particles-js"></div>
            <div class="ambient-glow"></div>
            <div class="container hero-content">
                <div class="badge-animated" data-aos="fade-down">
                    ✨ PROGRAMA EXCLUSIVO 2025
                </div>
                <h1 data-aos="zoom-out-up" data-aos-delay="200">
                    Transforme sua <span class="highlight">Influência</span> em <span
                        class="highlight">Autoridade</span
                    >
                </h1>
                <p class="subtitle" data-aos="fade-up" data-aos-delay="400">
                    Sua rede social é terreno alugado. O <span
                        class="text-white">Parceiro Alpha</span
                    > é a sua chance de ter uma sede digital de alto padrão sem custo
                    de desenvolvimento.
                </p>
                <div
                    class="hero-actions"
                    data-aos="fade-up"
                    data-aos-delay="600"
                >
                    <a href="#application-form" class="btn-premium">
                        <span>Candidatar-me Agora</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="#how-it-works" class="btn-outline"
                        >Ver como funciona</a
                    >
                </div>
            </div>

            <div class="hero-scroll-indicator">
                <div class="mouse"></div>
            </div>
        </section>

        <!-- Stats Section (Interactive Counter) -->
        <section class="quick-stats">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat-item" data-aos="fade-up">
                        <span class="stat-num">R$ 0</span>
                        <span class="stat-desc">Custo de Criação</span>
                    </div>
                    <div
                        class="stat-item"
                        data-aos="fade-up"
                        data-aos-delay="100"
                    >
                        <span class="stat-num">100%</span>
                        <span class="stat-desc">Foco em Performance</span>
                    </div>
                    <div
                        class="stat-item"
                        data-aos="fade-up"
                        data-aos-delay="200"
                    >
                        <span class="stat-num">Site</span>
                        <span class="stat-desc">Propriedade Sua</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it Works (Visual Timeline) -->
        <section id="how-it-works" class="workflow-section">
            <div class="container">
                <div class="section-header" data-aos="fade-up">
                    <span class="sub-badge">PASSO A PASSO</span>
                    <h2>O Caminho da <span class="highlight">Aliança</span></h2>
                </div>

                <div class="workflow-timeline">
                    <div class="timeline-step" data-aos="fade-right">
                        <div class="step-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <div class="step-content">
                            <h3>1. Candidatura</h3>
                            <p>
                                Preencha nosso formulário de perfil. Analisamos
                                seu nicho e potencial de parceria.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-step" data-aos="fade-left">
                        <div class="step-icon">
                            <i class="fas fa-comments"></i>
                        </div>
                        <div class="step-content">
                            <h3>2. Alinhamento</h3>
                            <p>
                                Conversamos via WhatsApp para definir os
                                detalhes da sua Landing Page e das regras de
                                indicação.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-step" data-aos="fade-right">
                        <div class="step-icon">
                            <i class="fas fa-magic"></i>
                        </div>
                        <div class="step-content">
                            <h3>3. Design & Deploy</h3>
                            <p>
                                Nossa equipe cria seu site com tecnologia Alpha.
                                Você aprova e colocamos no ar.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-step" data-aos="fade-left">
                        <div class="step-icon">
                            <i class="fas fa-handshake"></i>
                        </div>
                        <div class="step-content">
                            <h3>4. Ativação</h3>
                            <p>
                                Você divulga seu novo site e começa a jornada de
                                indicações para manter o benefício.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Rules (Glass Cards) -->
        <section id="rules" class="rules-section">
            <div class="container">
                <div class="section-header" data-aos="fade-up">
                    <h2>Regras do <span class="highlight">Jogo</span></h2>
                    <p>Sem letras miúdas. Apenas parcerias ganha-ganha.</p>
                </div>

                <div class="rules-grid">
                    <div class="rule-card" data-aos="flip-left">
                        <div class="card-bg"></div>
                        <div class="rule-icon"><i class="fas fa-gift"></i></div>
                        <h4>Presente Premium</h4>
                        <p>
                            Você ganha o design e desenvolvimento. Estimado em
                            mais de R$ 2.500 no mercado tradicional.
                        </p>
                    </div>

                    <div
                        class="rule-card special"
                        data-aos="flip-right"
                        data-aos-delay="100"
                    >
                        <div class="card-bg"></div>
                        <div class="rule-icon">
                            <i class="fas fa-bullhorn"></i>
                        </div>
                        <h4>Missão Mensal</h4>
                        <p>
                            Sua contrapartida: <strong>Indicar 02 (duas)</strong
                            > empresas ou profissionais por mês para a Alpha Code.
                        </p>
                    </div>

                    <div
                        class="rule-card"
                        data-aos="flip-left"
                        data-aos-delay="200"
                    >
                        <div class="card-bg"></div>
                        <div class="rule-icon">
                            <i class="fas fa-server"></i>
                        </div>
                        <h4>Seu Quartel General</h4>
                        <p>
                            O domínio e hospedagem ficam sob sua gestão,
                            garantindo que o site seja SEMPRE seu.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Profile Analysis Form (THE HEART) -->
        <section id="application-form" class="application-section">
            <div class="container">
                <div class="form-wrapper">
                    <div class="form-info" data-aos="fade-right">
                        <h3>
                            Solicite seu <span class="highlight"
                                >Voucher Alpha</span
                            >
                        </h3>
                        <p>
                            O Programa é limitado. Analisamos cada perfil para
                            garantir que a parceria seja sustentável para ambos
                            os lados.
                        </p>

                        <div class="benefit-pills">
                            <div class="pill">
                                <i class="fas fa-check"></i> Landing Page Inclusa
                            </div>
                            <div class="pill">
                                <i class="fas fa-check"></i> SEO Ativado
                            </div>
                            <div class="pill">
                                <i class="fas fa-check"></i> Grupo VIP de Parceiros
                            </div>
                        </div>

                        <div class="analysis-meter">
                            <span>Status das Vagas:</span>
                            <div class="meter">
                                <div class="fill" style="width: 85%"></div>
                            </div>
                            <small>85% preenchidas este mês</small>
                        </div>
                    </div>

                    <div class="form-container" data-aos="fade-left">
                        <form id="partner-apply-form" class="glass-form">
                            <div class="input-group">
                                <label for="form-name">Seu Nome</label>
                                <input
                                    type="text"
                                    id="form-name"
                                    placeholder="Como quer ser chamado?"
                                    required
                                />
                            </div>

                            <div class="input-row">
                                <div class="input-group">
                                    <label for="form-email">E-mail</label>
                                    <input
                                        type="email"
                                        id="form-email"
                                        placeholder="contato@voce.com"
                                        required
                                    />
                                </div>
                                <div class="input-group">
                                    <label for="form-whatsapp">WhatsApp</label>
                                    <input
                                        type="text"
                                        id="form-whatsapp"
                                        placeholder="(00) 00000-0000"
                                        class="phone-mask"
                                        required
                                    />
                                </div>
                            </div>

                            <div class="input-group">
                                <label for="form-insta"
                                    >Instagram (@usuario)</label
                                >
                                <input
                                    type="text"
                                    id="form-insta"
                                    placeholder="Link ou @ para análise"
                                    required
                                />
                            </div>

                            <div class="input-group">
                                <label for="form-area">O que você faz?</label>
                                <select id="form-area" required>
                                    <option value="">Selecione sua área</option>
                                    <option value="creator"
                                        >Criador de Conteúdo</option
                                    >
                                    <option value="ads"
                                        >Gestor de Tráfego</option
                                    >
                                    <option value="copy"
                                        >Copywriter / Designer</option
                                    >
                                    <option value="consultant"
                                        >Consultor / Mentor</option
                                    >
                                    <option value="other"
                                        >Outro Profissional Digital</option
                                    >
                                </select>
                            </div>

                            <div class="input-group">
                                <label for="form-msg"
                                    >Por que quer ser um Parceiro Alpha?</label
                                >
                                <textarea
                                    id="form-msg"
                                    rows="3"
                                    placeholder="Conte um pouco sobre seu público e sua rede."
                                ></textarea>
                            </div>

                            <button type="submit" class="btn-submit">
                                <span>Enviar para Análise</span>
                                <div class="loader-form hidden"></div>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <div class="container">
                <div class="section-header" data-aos="fade-up">
                    <h2>Perguntas <span class="highlight">Frequentes</span></h2>
                </div>

                <div class="accordion-container">
                    <details data-aos="fade-up">
                        <summary
                            >O site é meu para sempre? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Sim, o código e o design são seus. Caso decida sair
                            do programa de indicações no futuro, você pode
                            manter o site apenas migrando para um plano pago de
                            manutenção ou mantê-lo sob sua gestão.
                        </div>
                    </details>
                    <details data-aos="fade-up" data-aos-delay="100">
                        <summary
                            >E se eu não conseguir indicar 2 pessoas em um mês? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Nós entendemos que oscilações acontecem. Temos um
                            sistema de "crédito de parceria". O importante é a
                            constância e o interesse real em ajudar a rede a
                            crescer.
                        </div>
                    </details>
                    <details data-aos="fade-up" data-aos-delay="200">
                        <summary
                            >Posso colocar anúncios no meu site? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Sim! O site é seu. Você pode usar pixels de
                            rastreio, Google Adsense ou links de afiliados
                            normalmente.
                        </div>
                    </details>
                </div>
            </div>
        </section>
    </main>
</Layout>

<!-- Particles & AOS LIBRARY -->
<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
<script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/@tsparticles/all@3.1.0/tsparticles.all.bundle.min.js"
></script>

<script is:inline>
    // Initialize Particles
    tsParticles.load({
        id: "particles-js",
        options: {
            fpsLimit: 60,
            particles: {
                number: { value: 60, density: { enable: true, area: 800 } },
                color: { value: "#8a1c26" },
                shape: { type: "circle" },
                opacity: {
                    value: 0.25,
                    random: true,
                    anim: {
                        enable: true,
                        speed: 0.5,
                        opacity_min: 0.1,
                        sync: false,
                    },
                },
                size: {
                    value: 2,
                    random: true,
                    anim: {
                        enable: false,
                        speed: 40,
                        size_min: 0.1,
                        sync: false,
                    },
                },
                links: {
                    enable: true,
                    distance: 150,
                    color: "#8a1c26",
                    opacity: 0.1,
                    width: 1,
                },
                move: {
                    enable: true,
                    speed: 0.8,
                    direction: "none",
                    random: true,
                    straight: false,
                    outModes: { default: "out" },
                },
            },
            interactivity: {
                detectsOn: "canvas",
                events: {
                    onHover: { enable: true, mode: "grab" },
                    resize: true,
                },
                modes: {
                    grab: { distance: 160, links: { opacity: 0.3 } },
                },
            },
            retina_detect: true,
        },
    });
    // Initialize AOS
    AOS.init({
        duration: 1000,
        once: true,
        offset: 100,
    });

    // Scroll Progress
    window.addEventListener("scroll", () => {
        const winScroll =
            document.body.scrollTop || document.documentElement.scrollTop;
        const height =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        document.querySelector(".scroll-progress").style.width = scrolled + "%";
    });

    // Form Handling
    const form = document.getElementById("partner-apply-form");
    const btn = form?.querySelector(".btn-submit");
    const loader = form?.querySelector(".loader-form");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        btn.disabled = true;
        btn.querySelector("span").innerText = "Analisando...";
        loader.classList.remove("hidden");

        const formData = {
            nome: document.getElementById("form-name").value,
            email: document.getElementById("form-email").value,
            whatsapp: document.getElementById("form-whatsapp").value,
            instagram: document.getElementById("form-insta").value,
            area: document.getElementById("form-area").value,
            mensagem: document.getElementById("form-msg").value,
        };

        // Simulating processing
        setTimeout(() => {
            const waMsg = `Olá! Acabei de enviar minha candidatura para Parceiro Alpha.%0A%0A*Dados:*%0ANome: ${formData.nome}%0AÁrea: ${formData.area}%0AInsta: ${formData.instagram}`;
            window.location.href = `https://wa.me/5521999064502?text=${waMsg}`;
        }, 1500);
    });

    // Phone Mask
    document.querySelector(".phone-mask")?.addEventListener("input", (e) => {
        let x = e.target.value
            .replace(/\D/g, "")
            .match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
        e.target.value = !x[2]
            ? x[1]
            : "(" + x[1] + ") " + x[2] + (x[3] ? "-" + x[3] : "");
    });
</script>

<style>
    :root {
        --color-primary: #8a1c26;
        --glass-bg: rgba(255, 255, 255, 0.03);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: rgba(255, 255, 255, 0.5);
    }

    .partner-page {
        color: #fff;
        background: #050505;
        font-family: "Outfit", sans-serif;
        color-scheme: dark;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .highlight {
        color: var(--color-primary);
        background: linear-gradient(
            135deg,
            #fff 30%,
            var(--color-primary) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Scroll Progress */
    .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--color-primary);
        z-index: 9999;
        width: 0;
        box-shadow: 0 0 10px var(--color-primary);
    }

    .hero-particles {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }

    #particles-js {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }

    /* Hero Section */
    .partner-hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 120px 0;
        position: relative;
        text-align: center;
        overflow: hidden;
    }

    .ambient-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 150%;
        height: 150%;
        background: radial-gradient(
            circle at 50% 50%,
            rgba(138, 28, 38, 0.15) 0%,
            transparent 50%
        );
        pointer-events: none;
        z-index: -1;
    }

    .badge-animated {
        display: inline-block;
        padding: 8px 20px;
        background: rgba(138, 28, 38, 0.1);
        border: 1px solid rgba(138, 28, 38, 0.3);
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: var(--color-primary);
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    }

    .partner-hero h1 {
        font-size: clamp(2.5rem, 8vw, 5rem);
        font-weight: 900;
        line-height: 1;
        margin-bottom: 2rem;
        letter-spacing: -2px;
    }

    .subtitle {
        font-size: clamp(1.1rem, 2vw, 1.4rem);
        color: var(--text-muted);
        max-width: 800px;
        margin: 0 auto 3.5rem;
        line-height: 1.6;
    }

    .hero-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-premium {
        background: var(--color-primary);
        color: #fff;
        padding: 1.2rem 2.5rem;
        border-radius: 14px;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: 0.3s;
        box-shadow: 0 15px 35px rgba(138, 28, 38, 0.4);
    }

    .btn-premium:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 45px rgba(138, 28, 38, 0.6);
        background: #a31525;
    }

    .btn-outline {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--glass-border);
        color: #fff;
        padding: 1.2rem 2.5rem;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-outline:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
    }

    /* Stats Quick Access */
    .quick-stats {
        padding: 80px 0;
        border-top: 1px solid var(--glass-border);
        border-bottom: 1px solid var(--glass-border);
        background: rgba(255, 255, 255, 0.01);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem;
        text-align: center;
    }

    .stat-num {
        display: block;
        font-size: 3rem;
        font-weight: 900;
        color: var(--color-primary);
        margin-bottom: 0.5rem;
    }

    .stat-desc {
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Workflow Timeline */
    .workflow-section {
        padding: 120px 0;
    }

    .section-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .sub-badge {
        color: var(--color-primary);
        font-weight: 800;
        font-size: 0.8rem;
        letter-spacing: 3px;
        margin-bottom: 1rem;
        display: block;
    }

    .section-header h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 900;
    }

    .workflow-timeline {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
    }

    .workflow-timeline::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(
            to bottom,
            transparent,
            var(--glass-border) 10%,
            var(--glass-border) 90%,
            transparent
        );
        transform: translateX(-50%);
    }

    .timeline-step {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4rem;
        width: 50%;
        position: relative;
    }

    .timeline-step:nth-child(odd) {
        flex-direction: row-reverse;
        margin-left: auto;
        padding-left: 50px;
        text-align: left;
    }

    .timeline-step:nth-child(even) {
        margin-right: auto;
        padding-right: 50px;
        text-align: right;
    }

    .step-icon {
        width: 60px;
        height: 60px;
        background: #111;
        border: 2px solid var(--color-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--color-primary);
        position: absolute;
        top: 0;
        z-index: 2;
        box-shadow: 0 0 20px rgba(138, 28, 38, 0.2);
    }

    .timeline-step:nth-child(odd) .step-icon {
        left: -30px;
    }

    .timeline-step:nth-child(even) .step-icon {
        right: -30px;
    }

    .step-content h3 {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
    }

    .step-content p {
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* Rules Grid */
    .rules-section {
        padding: 120px 0;
        background: rgba(138, 28, 38, 0.02);
    }

    .rules-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .rule-card {
        padding: 3rem 2rem;
        background: #0a0a0a;
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: 0.4s;
    }

    .rule-card.special {
        border-color: var(--color-primary);
        background: linear-gradient(135deg, #0a0a0a 0%, #150505 100%);
        transform: scale(1.05);
    }

    .rule-icon {
        width: 70px;
        height: 70px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--color-primary);
        margin: 0 auto 2rem;
        transition: 0.3s;
    }

    .rule-card:hover .rule-icon {
        background: var(--color-primary);
        color: white;
        transform: rotate(10deg);
    }

    .rule-card h4 {
        font-size: 1.4rem;
        font-weight: 800;
        margin-bottom: 1rem;
    }

    .rule-card p {
