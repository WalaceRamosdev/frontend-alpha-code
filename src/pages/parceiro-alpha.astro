---
import Layout from "../layouts/BaseLayout.astro";
import AlgorithmPain from "../components/sections/AlgorithmPain.astro";
import PartnerTestimonials from "../components/sections/PartnerTestimonials.astro";
import VagasCounter from "../components/sections/VagasCounter.astro";
import BackgroundEffects from "../components/ui/BackgroundEffects.astro";
import MouseEffects from "../components/ui/MouseEffects.astro";
import StatCard from "../components/ui/StatCard.astro";
import PartnerValueCalc from "../components/ui/PartnerValueCalc.astro";

const title =
    "Parceiro Alpha | Site Grátis para Criadores de Conteúdo e Gestores de Tráfego";
const description =
    "Pare de ser refém do algoritmo. Tenha sua própria sede digital com o Programa Parceiro Alpha. Landing Pages exclusivas para gestores de tráfego, social medias e criadores.";
const keywords = [
    "site para criador de conteúdo",
    "landing page grátis para gestor de tráfego",
    "site próprio para social media",
    "sair do algoritmo",
];
const canonicalUrl = "https://www.sitesalphacode.com.br/parceiro-alpha";

const schema = {
    "@context": "https://schema.org/",
    "@type": "Product",
    name: "Programa Parceiro Alpha",
    image: "https://www.sitesalphacode.com.br/assets/logo3d.svg",
    description:
        "Programa de parceria para criação de sites profissionais sem custo para criadores de conteúdo e profissionais digitais.",
    brand: {
        "@type": "Brand",
        name: "Alpha Code",
    },
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "BRL",
        availability: "https://schema.org/LimitedAvailability",
    },
};
---

<Layout
    title={title}
    description={description}
    keywords={keywords}
    canonicalUrl={canonicalUrl}
    showWhatsApp={true}
    showSocialProof={true}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
        slot="head"
    />
    <div class="partner-page">
        <BackgroundEffects />
        <MouseEffects />

        <!-- Scroll Progress Bar -->
        <div class="scroll-progress"></div>

        <!-- Hero Section -->
        <section class="partner-hero">
            <div class="container hero-layout">
                <div class="hero-content-side">
                    <div class="badge-animated" data-aos="fade-right">
                        ✨ PROGRAMA EXCLUSIVO 2026
                    </div>
                    <h1 data-aos="fade-right" data-aos-delay="200">
                        Transforme sua <span class="highlight">Influência</span> em
                        <span class="gradient-text-animated">Autoridade</span>
                    </h1>
                    <p
                        class="subtitle"
                        data-aos="fade-right"
                        data-aos-delay="400"
                    >
                        Sua rede social é <span class="strikethrough"
                            >terreno alugado</span
                        >. O <span class="text-white">Parceiro Alpha</span> é a sua
                        chance de ter uma <span class="glow-text"
                            >sede digital de alto padrão</span
                        > sem custo de desenvolvimento.
                    </p>

                    <div
                        class="hero-actions"
                        data-aos="fade-up"
                        data-aos-delay="600"
                    >
                        <a href="#application-form" class="btn-premium">
                            <span class="btn-text">Candidatar-me Agora</span>
                            <i class="fas fa-arrow-right"></i>
                            <span class="btn-glow"></span>
                        </a>
                        <a href="#how-it-works" class="btn-outline">
                            <span>Ver como funciona</span>
                        </a>
                    </div>

                    <div
                        class="social-proof-mini"
                        data-aos="fade-up"
                        data-aos-delay="800"
                    >
                        <!--<div class="avatars-group">
                            <img loading="lazy" src="https://i.pravatar.cc/150?u=1" alt="Parceiro" />
                            <img loading="lazy" src="https://i.pravatar.cc/150?u=2" alt="Parceiro" />
                            <img loading="lazy" src="https://i.pravatar.cc/150?u=3" alt="Parceiro" />
                        </div>
                         <p><strong>+127 parceiros</strong> já saíram do terreno alugado</p> -->
                    </div>
                </div>

                <div
                    class="hero-visual-side"
                    data-aos="zoom-in"
                    data-aos-delay="500"
                >
                    <div class="handshake-wrapper">
                        <img loading="lazy"
                            src="/assets/images/parceiro-alpha/handshake.png"
                            alt="Parceria Alpha"
                            class="handshake-img"
                        />
                        <div class="img-glow"></div>
                        <div class="glass-overlay"></div>
                    </div>
                </div>
            </div>

            <div class="hero-scroll-indicator">
                <div class="mouse"></div>
            </div>
        </section>

        <!-- Stats Section (Interactive Counter) -->
        <section class="quick-stats">
            <div class="container">
                <div class="stats-grid">
                    <div data-aos="fade-up" data-aos-delay="100">
                        <StatCard
                            valor="0"
                            prefixo="R$ "
                            label="Custo de Criação"
                        />
                    </div>
                    <div data-aos="fade-up" data-aos-delay="200">
                        <StatCard
                            valor="100"
                            label="Foco em Performance"
                            sufixo="%"
                        />
                    </div>
                    <div data-aos="fade-up" data-aos-delay="300">
                        <StatCard
                            valor="100"
                            label="Site Propriedade Sua"
                            sufixo="%"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Algorithm Pain Section -->
        <AlgorithmPain />

        <!-- How it Works (Visual Timeline) -->
        <section id="how-it-works" class="workflow-section">
            <div class="container">
                <div class="section-header" data-aos="fade-up">
                    <span class="sub-badge">PASSO A PASSO</span>
                    <h2>O Caminho da <span class="highlight">Aliança</span></h2>
                </div>

                <div class="interactive-timeline">
                    <div class="timeline-node" data-aos="fade-up">
                        <div class="timeline-dot pulse"></div>
                        <div class="timeline-card">
                            <span class="step-num">01</span>
                            <div class="step-icon">
                                <i class="fas fa-paper-plane"></i>
                            </div>
                            <h3>Candidatura</h3>
                            <p>
                                Preencha nosso formulário de perfil. Analisamos
                                seu nicho e potencial em 24h.
                            </p>
                        </div>
                    </div>

                    <div
                        class="timeline-node"
                        data-aos="fade-up"
                        data-aos-delay="100"
                    >
                        <div class="timeline-dot pulse"></div>
                        <div class="timeline-card">
                            <span class="step-num">02</span>
                            <div class="step-icon">
                                <i class="fas fa-comments"></i>
                            </div>
                            <h3>Alinhamento</h3>
                            <p>
                                Conversamos via WhatsApp para definir os
                                detalhes da sua Landing Page.
                            </p>
                        </div>
                    </div>

                    <div
                        class="timeline-node"
                        data-aos="fade-up"
                        data-aos-delay="200"
                    >
                        <div class="timeline-dot pulse"></div>
                        <div class="timeline-card">
                            <span class="step-num">03</span>
                            <div class="step-icon">
                                <i class="fas fa-magic"></i>
                            </div>
                            <h3>Design & Deploy</h3>
                            <p>
                                Nossa equipe cria seu site com tecnologia Alpha.
                                Você aprova e colocamos no ar.
                            </p>
                        </div>
                    </div>

                    <div
                        class="timeline-node"
                        data-aos="fade-up"
                        data-aos-delay="300"
                    >
                        <div class="timeline-dot pulse"></div>
                        <div class="timeline-card">
                            <span class="step-num">04</span>
                            <div class="step-icon">
                                <i class="fas fa-handshake"></i>
                            </div>
                            <h3>Ativação</h3>
                            <p>
                                Você divulga seu novo site e inicia sua jornada
                                de autoridade digital.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Fidelity Tiers Section -->
        <section class="tiers-section">
            <div class="container">
                <div class="section-header" data-aos="fade-up">
                    <span class="sub-badge">RECOMPENSAS</span>
                    <h2>Níveis de <span class="highlight">Fidelidade</span></h2>
                    <p>
                        Quanto mais você indica, mais benefícios você e seus
                        indicados recebem.
                    </p>
                </div>

                <div class="tiers-grid">
                    <div class="tier-card bronze" data-aos="fade-up">
                        <div class="tier-badge">🥉</div>
                        <h3>Bronze</h3>
                        <div class="tier-req">02 indicações/mês</div>
                        <ul class="tier-benefits">
                            <li>
                                <i class="fas fa-check"></i> Site Profissional Grátis
                            </li>
                            <li>
                                <i class="fas fa-check"></i> Suporte Standard
                            </li>
                        </ul>
                    </div>
                    <div
                        class="tier-card silver"
                        data-aos="fade-up"
                        data-aos-delay="100"
                    >
                        <div class="tier-badge">🥈</div>
                        <h3>Silver</h3>
                        <div class="tier-req">04 indicações/mês</div>
                        <ul class="tier-benefits">
                            <li><i class="fas fa-check"></i> Tudo do Bronze</li>
                            <li>
                                <i class="fas fa-check"></i> 10% de Cashback em Vendas
                            </li>
                            <li>
                                <i class="fas fa-check"></i> 01 Upgrade de Site Grátis
                            </li>
                        </ul>
                    </div>
                    <div
                        class="tier-card gold"
                        data-aos="fade-up"
                        data-aos-delay="200"
                    >
                        <div class="tier-badge">🥇</div>
                        <h3>Gold</h3>
                        <div class="tier-req">08+ indicações/mês</div>
                        <ul class="tier-benefits">
                            <li><i class="fas fa-check"></i> Tudo do Silver</li>
                            <li>
                                <i class="fas fa-check"></i> 20% de Cashback em Vendas
                            </li>
                            <li>
                                <i class="fas fa-check"></i> Consultoria VIP Mensal
                            </li>
                            <li>
                                <i class="fas fa-check"></i> Selo Embaixador Alpha
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Rule & Calculator Section -->
        <section id="rules" class="rules-section">
            <div class="container rules-layout">
                <div class="rules-info" data-aos="fade-right">
                    <div class="section-header">
                        <h2>Regras do <span class="highlight">Jogo</span></h2>
                        <p>Sem letras miúdas. Apenas parcerias ganha-ganha.</p>
                    </div>

                    <div class="rules-list">
                        <div class="rule-item">
                            <div class="rule-icon">
                                <i class="fas fa-gift"></i>
                            </div>
                            <div>
                                <h4>Presente Premium</h4>
                                <p>
                                    Você ganha o design e desenvolvimento
                                    completo do seu site.
                                </p>
                            </div>
                        </div>
                        <div class="rule-item special">
                            <div class="rule-icon">
                                <i class="fas fa-bullhorn"></i>
                            </div>
                            <div>
                                <h4>Missão Mensal</h4>
                                <p>
                                    Sua contrapartida: Indicar 02 empresas ou
                                    profissionais por mês.
                                </p>
                            </div>
                        </div>
                        <div class="rule-item">
                            <div class="rule-icon">
                                <i class="fas fa-server"></i>
                            </div>
                            <div>
                                <h4>Seu Quartel General</h4>
                                <p>
                                    O domínio e hospedagem ficam sob sua gestão
                                    (propriedade sua).
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="rules-visual" data-aos="fade-left">
                    <PartnerValueCalc />
                </div>
            </div>
        </section>

        <!-- Testimonials Section -->
        <PartnerTestimonials />

        <!-- Profile Analysis Form (THE HEART) -->
        <section id="application-form" class="application-section">
            <div class="container">
                <div class="form-wrapper">
                    <div class="form-info" data-aos="fade-right">
                        <h3>
                            Solicite seu <span class="highlight"
                                >Voucher Alpha</span
                            >
                        </h3>
                        <p>
                            O Programa é limitado. Analisamos cada perfil para
                            garantir que a parceria seja sustentável para ambos
                            os lados.
                        </p>

                        <div class="benefit-pills">
                            <div class="pill">
                                <i class="fas fa-check"></i> Landing Page Inclusa
                            </div>
                            <div class="pill">
                                <i class="fas fa-check"></i> SEO Ativado
                            </div>
                            <div class="pill">
                                <i class="fas fa-check"></i> Grupo VIP de Parceiros
                            </div>
                        </div>

                        <VagasCounter />
                    </div>

                    <div class="form-container" data-aos="fade-left">
                        <form id="partner-apply-form" class="glass-form">
                            <div class="input-group">
                                <label for="form-name">Seu Nome</label>
                                <input
                                    type="text"
                                    id="form-name"
                                    placeholder="Como quer ser chamado?"
                                    required
                                />
                            </div>

                            <div class="input-row">
                                <div class="input-group">
                                    <label for="form-email">E-mail</label>
                                    <input
                                        type="email"
                                        id="form-email"
                                        placeholder="contato@voce.com"
                                        required
                                    />
                                </div>
                                <div class="input-group">
                                    <label for="form-whatsapp">WhatsApp</label>
                                    <input
                                        type="text"
                                        id="form-whatsapp"
                                        placeholder="(00) 00000-0000"
                                        class="phone-mask"
                                        required
                                    />
                                </div>
                            </div>

                            <div class="input-group">
                                <label for="form-insta"
                                    >Instagram (@usuario)</label
                                >
                                <input
                                    type="text"
                                    id="form-insta"
                                    placeholder="Link ou @ para análise"
                                    required
                                />
                            </div>

                            <div class="input-group">
                                <label for="form-area">O que você faz?</label>
                                <select id="form-area" required>
                                    <option value="">Selecione sua área</option>
                                    <option value="creator"
                                        >Criador de Conteúdo</option
                                    >
                                    <option value="ads"
                                        >Gestor de Tráfego</option
                                    >
                                    <option value="copy"
                                        >Copywriter / Designer</option
                                    >
                                    <option value="consultant"
                                        >Consultor / Mentor</option
                                    >
                                    <option value="other"
                                        >Outro Profissional Digital</option
                                    >
                                </select>
                            </div>

                            <div class="input-group">
                                <label for="form-msg"
                                    >Por que quer ser um Parceiro Alpha?</label
                                >
                                <textarea
                                    id="form-msg"
                                    rows="3"
                                    placeholder="Conte um pouco sobre seu público e sua rede."
                                ></textarea>
                            </div>

                            <button type="submit" class="btn-submit">
                                <span>Enviar para Análise</span>
                                <div class="loader-form hidden"></div>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <div class="container">
                <div class="section-header" data-aos="fade-up">
                    <h2>Perguntas <span class="highlight">Frequentes</span></h2>
                </div>

                <div class="accordion-container">
                    <details data-aos="fade-up">
                        <summary
                            >O site é meu para sempre? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Sim, o código e o design são seus. Caso decida sair
                            do programa de indicações no futuro, você pode
                            manter o site apenas migrando para um plano pago de
                            manutenção ou mantê-lo sob sua gestão.
                        </div>
                    </details>
                    <details data-aos="fade-up" data-aos-delay="100">
                        <summary
                            >E se eu não conseguir indicar 2 pessoas em um mês? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Nós entendemos que oscilações acontecem. Temos um
                            sistema de "crédito de parceria". O importante é a
                            constância e o interesse real em ajudar a rede a
                            crescer.
                        </div>
                    </details>
                    <details data-aos="fade-up" data-aos-delay="200">
                        <summary
                            >Existem prêmios por indicação? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Sim! Além da manutenção gratuita do seu site, o
                            Programa tem níveis (Bronze, Silver e Gold). No
                            nível Silver, você começa a receber 10% de cashback
                            sobre as vendas fechadas, e no Gold, essa comissão
                            sobe para 20% + consultoria VIP.
                        </div>
                    </details>
                    <details data-aos="fade-up" data-aos-delay="300">
                        <summary
                            >Posso colocar anúncios no meu site? <i
                                class="fas fa-chevron-down"></i></summary
                        >
                        <div class="content">
                            Sim! O site é seu. Você pode usar pixels de
                            rastreio, Google Adsense ou links de afiliados
                            normalmente.
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- Final CTA Section -->
        <section class="final-cta-section">
            <div class="container">
                <div class="cta-box" data-aos="zoom-in">
                    <h2>
                        Pronto para Ter Sua <span class="highlight"
                            >Sede Digital?</span
                        >
                    </h2>
                    <p>
                        Não deixe sua autoridade nas mãos do acaso. Candidate-se
                        hoje e mude o jogo do seu negócio.
                    </p>
                    <a href="#application-form" class="btn-premium">
                        <span>Quero ser um Parceiro</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
    </div>

    <!-- AOS LIBRARY via head slot -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" slot="head" />

    <!-- AOS fallback: ensure elements are ALWAYS visible even if AOS fails -->
    <style slot="head">
        /* If AOS script hasn't run or is blocked, make all [data-aos] elements visible */
        [data-aos] { opacity: 1 !important; transform: none !important; }
    </style>

    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script is:inline>
        function initAOS() {
            if (typeof AOS !== "undefined") {
                AOS.init({
                    duration: 800,
                    once: true,
                    offset: 50,
                    mirror: false,
                    anchorPlacement: "top-bottom",
                });
            }
        }

        // Init on first load
        if (document.readyState === "complete") {
            initAOS();
        } else {
            window.addEventListener("load", initAOS);
        }

        // Re-init on Astro View Transitions
        document.addEventListener("astro:page-load", initAOS);

        // Scroll Progress
        window.addEventListener("scroll", () => {
            const el = document.querySelector(".scroll-progress");
            if (!el) return;
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            el.style.width = ((winScroll / height) * 100) + "%";
        });

        // Form Handling
        const form = document.getElementById("partner-apply-form");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const currentBtn = form.querySelector(".btn-submit");
            const currentLoader = form.querySelector(".loader-form");
            const btnText = currentBtn.querySelector("span");

            currentBtn.disabled = true;
            btnText.innerText = "Processando...";
            currentLoader?.classList.remove("hidden");

            const formData = {
                nome: document.getElementById("form-name").value,
                email: document.getElementById("form-email").value,
                whatsapp: document.getElementById("form-whatsapp").value,
                instagram: document.getElementById("form-insta").value,
                area: document.getElementById("form-area").value,
                mensagem: document.getElementById("form-msg").value,
            };

            try {
                const response = await fetch("/api/cadastro-parceiro", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(formData),
                });

                const result = await response.json();

                if (result.success) {
                    btnText.innerText = "Candidatura Enviada!";
                    setTimeout(() => {
                        const waMsg = `Olá! Acabei de enviar minha candidatura para Parceiro Alpha.%0A%0A*Dados:*%0ANome: ${formData.nome}%0AÁrea: ${formData.area}%0AInsta: ${formData.instagram}`;
                        window.location.href = `https://wa.me/5521999064502?text=${waMsg}`;
                    }, 1000);
                } else {
                    throw new Error(result.message || "Erro desconhecido");
                }
            } catch (error) {
                console.error("Erro no formulário:", error);
                if (window.showToast) {
                    window.showToast("Erro ao enviar. Tente novamente ou use o WhatsApp direto.", "error");
                } else {
                    alert("Erro ao enviar candidatura. Por favor, tente falar direto pelo WhatsApp.");
                }
                const submitBtn = form.querySelector(".btn-submit");
                const submitLoader = form.querySelector(".loader-form");
                const submitBtnText = submitBtn.querySelector("span");
                submitBtn.disabled = false;
                submitBtnText.innerText = "Enviar para Análise";
                submitLoader?.classList.add("hidden");
            }
        });

        // Phone Mask
        document.querySelector(".phone-mask")?.addEventListener("input", (e) => {
            let x = e.target.value.replace(/\D/g, "").match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
            e.target.value = !x[2] ? x[1] : "(" + x[1] + ") " + x[2] + (x[3] ? "-" + x[3] : "");
        });
    </script>

    <style>
        :root {
            --color-primary: #8a1c26;
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --text-muted: rgba(255, 255, 255, 0.5);
        }

        .partner-page {
            color: #fff;
            background: transparent;
            font-family: "Outfit", sans-serif;
            color-scheme: dark;
            position: relative;
            z-index: 1;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            position: relative;
            z-index: 2;
        }

        .highlight {
            color: var(--color-primary);
            font-weight: 800;
        }

        .gradient-text-animated {
            background: linear-gradient(
                135deg,
                #fff 0%,
                var(--color-primary) 50%,
                #fff 100%
            );
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
            display: inline-block;
        }

        @keyframes shine {
            to {
                background-position: 200% center;
            }
        }

        .strikethrough {
            text-decoration: line-through;
            opacity: 0.5;
            font-weight: 400;
        }

        .glow-text {
            color: #fff;
            text-shadow: 0 0 15px rgba(138, 28, 38, 0.6);
            font-weight: 700;
        }

        /* Scroll Progress */
        .scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: var(--color-primary);
            z-index: 9999;
            width: 0;
            box-shadow: 0 0 10px var(--color-primary);
        }

        /* Hero Section Refactor */
        .partner-hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 120px 0;
            position: relative;
            z-index: 10;
        }

        .hero-layout {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 4rem;
            align-items: center;
        }

        .hero-content-side {
            text-align: left;
        }

        .badge-animated {
            display: inline-block;
            padding: 8px 20px;
            background: rgba(138, 28, 38, 0.1);
            border: 1px solid rgba(138, 28, 38, 0.3);
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--color-primary);
            margin-bottom: 2rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }

        .partner-hero h1 {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 2rem;
            letter-spacing: -2px;
        }

        .subtitle {
            font-size: clamp(1.1rem, 2vw, 1.3rem);
            color: var(--text-muted);
            max-width: 650px;
            margin: 0 0 3.5rem;
            line-height: 1.6;
        }

        .hero-actions {
            display: flex;
            gap: 1.5rem;
            justify-content: flex-start;
            flex-wrap: wrap;
            margin-bottom: 3rem;
        }

        .social-proof-mini {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .avatars-group {
            display: flex;
        }

        .avatars-group img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid #000;
            margin-left: -12px;
            object-fit: cover;
        }

        .avatars-group img:first-child {
            margin-left: 0;
        }

        .social-proof-mini p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Hero Visual Side handshake */
        .hero-visual-side {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .handshake-wrapper {
            position: relative;
            width: 100%;
            max-width: 500px;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transform: perspective(1000px) rotateY(-5deg);
            transition: transform 0.5s ease;
        }

        .handshake-wrapper:hover {
            transform: perspective(1000px) rotateY(0deg) scale(1.02);
        }

        .handshake-img {
            width: 100%;
            height: auto;
            display: block;
            filter: contrast(1.1) brightness(0.9);
        }

        .img-glow {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(
                circle at center,
                rgba(138, 28, 38, 0.2),
                transparent 70%
            );
            pointer-events: none;
        }

        .glass-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 30%;
            background: linear-gradient(
                to top,
                rgba(0, 0, 0, 0.8),
                transparent
            );
            pointer-events: none;
        }

        .btn-premium {
            position: relative;
            background: var(--color-primary);
            color: #fff !important;
            padding: 1.2rem 2.5rem;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
            overflow: hidden;
            z-index: 1;
            box-shadow: 0 15px 35px rgba(138, 28, 38, 0.4);
        }

        .btn-premium:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 45px rgba(138, 28, 38, 0.6);
            background: #a31525;
        }

        .btn-glow {
            position: absolute;
            top: -20%;
            left: -20%;
            width: 140%;
            height: 140%;
            background: radial-gradient(
                circle at 30% 30%,
                rgba(255, 255, 255, 0.2),
                transparent 70%
            );
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
            z-index: -1;
        }

        .btn-premium:hover .btn-glow {
            opacity: 1;
            animation: rotate-btn 4s linear infinite;
        }

        @keyframes rotate-btn {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .btn-outline {
            position: relative;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: #fff !important;
            padding: 1.2rem 2.5rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            overflow: hidden;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.2);
        }

        /* Stats Quick Access */
        .quick-stats {
            padding: 80px 0;
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
            background: rgba(255, 255, 255, 0.01);
            position: relative;
            z-index: 20;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
            text-align: center;
        }

        .stat-num {
            display: block;
            font-size: 3rem;
            font-weight: 900;
            color: var(--color-primary);
            margin-bottom: 0.5rem;
        }

        .stat-desc {
            color: var(--text-muted);
            font-weight: 500;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Interactive Timeline */
        .workflow-section {
            padding: 120px 0;
            position: relative;
            z-index: 15;
        }

        .interactive-timeline {
            max-width: 800px;
            margin: 4rem auto 0;
            position: relative;
        }

        .interactive-timeline::before {
            content: "";
            position: absolute;
            left: 31px;
            top: 0;
            width: 2px;
            height: 100%;
            background: linear-gradient(
                to bottom,
                var(--color-primary),
                rgba(138, 28, 38, 0.1),
                transparent
            );
            z-index: 1;
        }

        .timeline-node {
            position: relative;
            margin-bottom: 4rem;
            padding-left: 80px;
        }

        .timeline-dot {
            position: absolute;
            left: 32px;
            top: 30px;
            width: 20px;
            height: 20px;
            background: var(--color-primary);
            border-radius: 50%;
            transform: translateX(-50%);
            z-index: 2;
            box-shadow: 0 0 20px var(--color-primary);
        }

        .pulse {
            animation: pulse-ring 2s infinite;
        }

        @keyframes pulse-ring {
            0% {
                box-shadow: 0 0 0 0 rgba(138, 28, 38, 0.7);
            }
            70% {
                box-shadow: 0 0 0 15px rgba(138, 28, 38, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(138, 28, 38, 0);
            }
        }

        .timeline-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 24px;
            padding: 2.5rem;
            position: relative;
            transition: 0.3s;
        }

        .timeline-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(138, 28, 38, 0.3);
            transform: translateX(10px);
        }

        .step-num {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            font-size: 3rem;
            font-weight: 900;
            color: rgba(255, 255, 255, 0.03);
            line-height: 1;
        }

        .timeline-card .step-icon {
            width: 50px;
            height: 50px;
            background: rgba(138, 28, 38, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: var(--color-primary);
            margin-bottom: 1.5rem;
            border: 1px solid rgba(138, 28, 38, 0.2);
        }

        .timeline-card h3 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
        }

        .timeline-card p {
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Tiers Section */
        .tiers-section {
            padding: 120px 0;
            background: linear-gradient(
                180deg,
                transparent,
                rgba(138, 28, 38, 0.05),
                transparent
            );
        }

        .tiers-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 4rem;
        }

        .tier-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 30px;
            padding: 3rem 2rem;
            text-align: center;
            transition: 0.4s;
            position: relative;
        }

        .tier-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .tier-badge {
            font-size: 3rem;
            margin-bottom: 1.5rem;
            display: block;
        }

        .tier-card h3 {
            font-size: 1.75rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }

        .tier-req {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--color-primary);
            margin-bottom: 2rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .tier-benefits {
            list-style: none;
            padding: 0;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .tier-benefits li {
            font-size: 0.95rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tier-benefits li i {
            color: var(--color-primary);
            font-size: 0.8rem;
        }

        .tier-card.silver {
            border-color: rgba(192, 192, 192, 0.3);
            background: rgba(192, 192, 192, 0.02);
        }

        .tier-card.gold {
            border-color: rgba(255, 215, 0, 0.3);
            background: rgba(255, 215, 0, 0.02);
            box-shadow: 0 0 30px rgba(255, 215, 0, 0.05);
        }

        /* Rules Layout Update */
        .rules-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }

        .rules-list {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            margin-top: 3rem;
        }

        .rule-item {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
        }

        .rule-item .rule-icon {
            margin: 0;
            flex-shrink: 0;
        }

        .rule-item h4 {
            font-size: 1.25rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #fff;
        }

        .rule-item p {
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        /* Rules Grid (Old Styles preserved for fallback if needed, but not used in new layout) */
        .rules-section {
            padding: 120px 0;
            background: rgba(138, 28, 38, 0.02);
        }

        /* Application Section */
        .application-section {
            padding: 120px 0;
        }

        .form-wrapper {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 5rem;
            align-items: center;
        }

        .form-info h3 {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 1.5rem;
        }

        .form-info p {
            color: var(--text-muted);
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 2.5rem;
        }

        .benefit-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 3rem;
        }

        .pill {
            background: rgba(255, 255, 255, 0.05);
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--glass-border);
        }

        .pill i {
            color: #10b981;
        }

        .analysis-meter {
            background: rgba(255, 255, 255, 0.02);
            padding: 1.5rem;
            border-radius: 16px;
        }

        .meter {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            margin: 10px 0;
            overflow: hidden;
        }

        .meter .fill {
            height: 100%;
            background: var(--color-primary);
            box-shadow: 0 0 15px var(--color-primary);
        }

        .form-container {
            position: relative;
        }

        .glass-form {
            background: rgba(15, 15, 15, 0.8);
            border: 1px solid var(--glass-border);
            padding: 3rem;
            border-radius: 30px;
            backdrop-filter: blur(20px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
        }

        .input-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .input-group input,
        .input-group select,
        .input-group textarea {
            width: 100%;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1rem;
            color: #fff;
            font-family: inherit;
            transition: 0.3s;
        }

        .input-group select option {
            background: #0f0f0f;
            color: #fff;
        }

        .input-group input:focus,
        .input-group select:focus,
        .input-group textarea:focus {
            border-color: var(--color-primary);
            background: rgba(255, 255, 255, 0.06);
            outline: none;
        }

        .btn-submit {
            width: 100%;
            background: var(--color-primary);
            color: #fff !important;
            border: none;
            padding: 1.2rem;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-submit span {
            color: #fff !important;
        }

        .btn-submit:hover {
            background: #a31525;
            transform: translateY(-3px);
        }

        /* FAQ */
        .faq-section {
            padding: 120px 0;
            position: relative;
            z-index: 10;
        }

        .accordion-container {
            max-width: 800px;
            margin: 0 auto;
        }

        details {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            margin-bottom: 1rem;
            overflow: hidden;
        }

        summary {
            padding: 1.5rem;
            cursor: pointer;
            font-weight: 700;
            list-style: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: 0.3s;
        }

        summary::-webkit-details-marker {
            display: none;
        }

        summary:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        details[open] summary {
            color: var(--color-primary);
            border-bottom: 1px solid var(--glass-border);
        }

        .content {
            padding: 1.5rem;
            color: var(--text-muted);
            line-height: 1.6;
            background: rgba(0, 0, 0, 0.2);
        }

        /* Final CTA */
        .final-cta-section {
            padding: 100px 0;
            text-align: center;
        }

        .final-cta-section .cta-box {
            background: linear-gradient(
                135deg,
                rgba(138, 28, 38, 0.1),
                rgba(10, 10, 10, 0.9)
            );
            padding: 5rem 2rem;
            border-radius: 40px;
            border: 1px solid rgba(138, 28, 38, 0.3);
            max-width: 900px;
            margin: 0 auto;
        }

        .final-cta-section h2 {
            font-size: 3rem;
            font-weight: 900;
            margin-bottom: 1.5rem;
        }

        .final-cta-section p {
            font-size: 1.25rem;
            color: var(--text-muted);
            margin-bottom: 3rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .final-cta-section .btn-premium {
            display: inline-flex;
            margin: 0 auto;
        }

        /* Aura effect in Hero */
        .partner-hero::after {
            content: "";
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(
                circle,
                rgba(138, 28, 38, 0.15) 0%,
                transparent 70%
            );
            filter: blur(50px);
            pointer-events: none;
            z-index: 0;
        }

        /* Responsive */
        @media (max-width: 968px) {
            .hero-layout {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 2rem;
            }
            .hero-content-side {
                text-align: center;
            }
            .hero-actions {
                justify-content: center;
            }
            .subtitle {
                margin: 0 auto 2.5rem;
            }
            .social-proof-mini {
                justify-content: center;
            }
            .hero-visual-side {
                height: 300px;
            }
            .mini-card {
                padding: 0.8rem 1.2rem;
                font-size: 0.85rem;
            }
            .form-wrapper {
                grid-template-columns: 1fr !important;
                gap: 3rem;
            }
            .rules-grid,
            .rules-layout {
                grid-template-columns: 1fr !important;
            }
            .stats-grid,
            .tiers-grid {
                grid-template-columns: 1fr !important;
                gap: 2rem;
            }
            .interactive-timeline::before {
                left: 20px;
            }
            .timeline-node {
                padding-left: 50px;
                margin-bottom: 3rem;
            }
            .timeline-dot {
                left: 21px;
            }
            .timeline-card {
                padding: 1.5rem;
            }
            .step-num {
                font-size: 2rem;
                top: 1rem;
                right: 1rem;
            }
            .input-row {
                grid-template-columns: 1fr;
            }
            .rule-card.special {
                transform: none;
            }
        }
    </style>
</Layout>
