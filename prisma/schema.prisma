datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  company       String?
  password      String?
  plan          String    @default("BRONZE")
  siteUrl       String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String    @id @default(cuid())
  name         String
  clientName   String?
  type         String
  plan         String?   @default("BRONZE")
  category     String
  imageUrl     String
  projectUrl   String
  status       String    @default("Em Andamento")
  startDate    DateTime?
  deliveryDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MaintenanceRequest {
  id            String    @id @default(cuid())
  clientName    String
  email         String?
  phone         String?
  serviceType   String    // 'MANUTENCAO' or 'SEO_TURBINADO'
  description   String?
  amount        Float     @default(0.0)
  status        String    @default("PENDENTE") // PENDENTE, EM_EXECUCAO, CONCLUIDO
  paymentStatus String    @default("PENDENTE") // PENDENTE, PAGO
  startDate     DateTime? 
  endDate       DateTime?
  financialId   String?   // Reference to FinancialRecord if paid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FinancialRecord {
  id          String   @id @default(cuid())
  description String
  category    String   
  amount      Float
  hostingCost Float?   @default(0.0)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  whatsapp        String
  email           String
  projectLevel    String?
  complexity      String?
  investmentRange String?
  diagnosisData   Json?
  createdAt       DateTime @default(now())
}