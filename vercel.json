{
    "buildCommand": "npm cache clean --force && prisma generate && astro build",
    "headers": [
        {
            "source": "/(assets|fonts|images)/(.+)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.+).(js|css|webp|svg|png|jpg|jpeg|woff|woff2)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}